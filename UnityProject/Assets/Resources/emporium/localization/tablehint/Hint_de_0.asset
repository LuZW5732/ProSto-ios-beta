  m_TableData:
  - m_Id: 79625502720
    m_Localized: Telefon
    m_Metadata:
      m_Items: []
  - m_Id: 104598388736
    m_Localized: Mit dem Telefon kannst du deine Kontakte anrufen.
    m_Metadata:
      m_Items: []
  - m_Id: 125435691008
    m_Localized: Schaufenster
    m_Metadata:
      m_Items: []
  - m_Id: 146742755328
    m_Localized: Hier kannst du Waren ausstellen, um interessierte Kunden anzulocken.
    m_Metadata:
      m_Items: []
  - m_Id: 188882927616
    m_Localized: Zeigt an, wie viele Kunden heute noch Schlange stehen.
    m_Metadata:
      m_Items: []
  - m_Id: 166976077824
    m_Localized: Verbleibende Kunden
    m_Metadata:
      m_Items: []
  - m_Id: 202543775744
    m_Localized: Verkaufstresen
    m_Metadata:
      m_Items: []
  - m_Id: 256063094784
    m_Localized: Platziere hier den Gegenstand, den du kaufen oder verkaufen willst, und öffne das Verhandlungsfenster.
    m_Metadata:
      m_Items: []
  - m_Id: 292633231360
    m_Localized: Zum Öffnen/Schließen des Hinweis-Overlays „O“ drücken
    m_Metadata:
      m_Items: []
  - m_Id: 352905379840
    m_Localized: Du kannst den Tag nicht beenden, solange noch wichtige Personen in der Schlange warten.
    m_Metadata:
      m_Items: []
  - m_Id: 309112651776
    m_Localized: Tag beginnen/beenden
    m_Metadata:
      m_Items: []
  - m_Id: 411323645952
    m_Localized: Rufe den nächsten Kunden auf oder schicke den aktuellen fort.
    m_Metadata:
      m_Items: []
  - m_Id: 388569546752
    m_Localized: Nächsten Kunden aufrufen
    m_Metadata:
      m_Items: []
  - m_Id: 465782489088
    m_Localized: Gegenstände auf dem Verkaufstresen können im Verhandlungsfenster ver-/gekauft werden.
    m_Metadata:
      m_Items: []
  - m_Id: 432559407104
    m_Localized: Verhandlungsfenster
    m_Metadata:
      m_Items: []
  - m_Id: 511542345728
    m_Localized: Hör dir aufgezeichnete Dialoge an.
    m_Metadata:
      m_Items: []
  - m_Id: 486678511616
    m_Localized: Diktiergerät
    m_Metadata:
      m_Items: []
  - m_Id: 523219288064
    m_Localized: Schlafsack
    m_Metadata:
      m_Items: []
