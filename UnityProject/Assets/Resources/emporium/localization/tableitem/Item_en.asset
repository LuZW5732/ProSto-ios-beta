    m_Localized: Metal Printing
    m_Metadata:
      m_Items: []
  - m_Id: 140582836813831
    m_Localized: Gain +{0} reputation per night
    m_Metadata:
      m_Items: []
  - m_Id: 140582836813832
    m_Localized: "Increased Input Used \n -Increased Output Per Night\n -Decreased Purity"
    m_Metadata:
      m_Items: []
