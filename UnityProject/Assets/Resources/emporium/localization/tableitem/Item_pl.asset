    m_Localized: Zapakowana żebronapka
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619656
    m_Localized: Limitowana edycja kanapki o przedłużonej ważności. Zawiera restrukturyzowany kotlet wieprzowy w kształcie żeberek. Kultowa.
    m_Metadata:
      m_Items: []
