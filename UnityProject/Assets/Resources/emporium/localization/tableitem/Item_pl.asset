%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Item_pl
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 58be4cb0b849ac14ba59a0c571d49f34, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 82432951786979328
    m_Localized: Działanie wielu farm wilgoci zmniejsza efektywność każdej z nich.
    m_Metadata:
      m_Items: []
  - m_Id: 158976881508352
    m_Localized: „Starożytne relikty obcych”
    m_Metadata:
      m_Items: []
  - m_Id: 159203780771840
    m_Localized: Wyglądają jak złom… Starożytny złom obcych?
    m_Metadata:
      m_Items: []
  - m_Id: 158979263873024
    m_Localized: 100% odwodniona czysta woda
    m_Metadata:
      m_Items: []
  - m_Id: 158981042257920
    m_Localized: Wpis ze złomiarskiego dziennika
    m_Metadata:
      m_Items: []
  - m_Id: 159205794037760
    m_Localized: '   Wędruje głęboko w Opuszczone Sekcje. Inne miejsca na Stacji zostały obrane do czysta, ale to… jest inne. Znam oczywiście plotki, ale jak na razie, łup jest dobry. Czuję w powietrzu dziwny ciężar, jakby tuż poza polem widzenia coś się czaiło.'
    m_Metadata:
      m_Items: []
  - m_Id: 5225789046784
    m_Localized: Serum odmładzające WIECZNOŚĆ
    m_Metadata:
      m_Items: []
  - m_Id: 5296811196416
    m_Localized: Elegancki, szklany słój z błyszczącym serum.
    m_Metadata:
      m_Items: []
  - m_Id: 5267547537408
    m_Localized: Pożądane, luksusowe serum do odmładzania skóry przy użyciu pozyskiwanych etycznie komórek macierzystych.
    m_Metadata:
      m_Items: []
  - m_Id: 140582820036608
    m_Localized: Pudełko tamponów PAX
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230912
    m_Localized: Zapewniające bezpieczeństwo i dyskrecję produkty higieniczne to luksus, na który stać niewiele osób z Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230913
    m_Localized: Paczka papierosów Hemingway
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230914
    m_Localized: Najbardziej luksusowe papierosy, jakie można kupić. Na długo zapamiętasz ich smak. I cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230915
    m_Localized: Paczka kondomów REX
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230916
    m_Localized: Zaskakująco popularne na Niższych Poziomach dzięki systemowi dotowanej dystrybucji. Kontrola urodzeń jest przecież tańsza od rozpędzania zamieszek.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230917
    m_Localized: Żel 4 w 1
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230918
    m_Localized: Szampon, odżywka, żel do ciała i pasta do zębów w jednej butelce z dodatkiem odświeżającego ekstraktu z Pożywnowocu.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230919
    m_Localized: Tubka pasty do zębów
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230920
    m_Localized: Miętowy żel z obietnicą świeżego oddechu.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230921
    m_Localized: Rolka ręcznika papierowego
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230922
    m_Localized: Rolka papieru toaletowego
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230923
    m_Localized: Papier toaletowy oferujący wytrzymałość i niezawodność w przystępnej cenie. Dwie warstwy to rzadkość na Niższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230924
    m_Localized: Zestaw do sprawdzania wody
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230925
    m_Localized: Mała buteleczka kolorowych pasków do testowania jakości wody.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230926
    m_Localized: Papierek wskaźnikowy do wody
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230927
    m_Localized: Papierek wskaźnikowy, który dokładnie określa jakość próbki wody.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230928
    m_Localized: Lampa ultrafioletowa
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230929
    m_Localized: Można użyć na pojemniku na wodę.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230930
    m_Localized: Emituje światło ultrafioletowe, które zabija bakterie i inne mikroorganizmy.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230931
    m_Localized: AquaScan
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230932
    m_Localized: Urządzenie do dokładnego określania jakości próbki wody. Wyświetla wykryte zanieczyszczenia.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230933
    m_Localized: Skaner złomiarski
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230934
    m_Localized: Urządzenie, które zwiększa szanse znalezienia wartościowych przedmiotów podczas szukania złomu. (W danym momencie może pomagać tylko jeden skaner złomiarski).
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230935
    m_Localized: Potrzebujesz trzeciego oka? Drugiego nosa? Wyostrz zmysły ze skanerem złomiarskim!
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230936
    m_Localized: Butelka tabletek do uzdatniania wody
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230937
    m_Localized: Mała butelka z tabletkami do uzdatniania wody.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230938
    m_Localized: Tabletka do uzdatniania wody
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230939
    m_Localized: Eliminuje duże ilości zanieczyszczeń mikrobiologicznych oraz część chemicznych. Nie wpływa na inne rodzaje zanieczyszczeń.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230940
    m_Localized: Tabletka z odżywką hydroponiczną
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230941
    m_Localized: Zawiera minerały kluczowe do wzrostu roślin. Można dodać do pojemnika na wodę.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230942
    m_Localized: Nie spożywać. Używać jedynie w hydroponice.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230943
    m_Localized: Butelka tabletek z odżywką hydroponiczną
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230944
    m_Localized: Butelka zawierające tabletki z odżywką hydroponiczną.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230945
    m_Localized: Nie spożywać. Używać jedynie w hydroponice.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230946
    m_Localized: Tkanina z baxełny
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230948
    m_Localized: Wszechstronna tkanina z włókien organicznych. Często używana do produkcji wzmocnionych ubrań roboczych i opakowań amortyzujących.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230949
    m_Localized: Filtr do wody
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230950
    m_Localized: Nieznacznie polepsza jakość wody po użyciu w systemie filtracji. Nie działa poniżej pewnego progu.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230951
    m_Localized: Lekki filtr konsumencki.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230952
    m_Localized: Filtr hydrotrzcinowy
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425216
    m_Localized: Usuwa pewne rodzaje zanieczyszczeń w systemie filtracji.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425217
    m_Localized: Filtr biologiczny z hydrotrzciny.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425218
    m_Localized: Los na loterię
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425219
    m_Localized: Wylosowane numery są ogłaszane w niedzielne poranki.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425220
    m_Localized: Szóstka może zapewnić luksusowe życie na bezpiecznych i komfortowych Wyższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425221
    m_Localized: Stary los na loterię
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425222
    m_Localized: Bezwartościowy los na Loterię Niższych Poziomów. Żadnych zwycięskich numerów, tylko pusta nadzieja.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425223
    m_Localized: Szóstka może zapewnić luksusowe życie na bezpiecznych i komfortowych Wyższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425224
    m_Localized: Neuroaktywne perfumy SYNC
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425225
    m_Localized: Użyj, aby zwiększyć premię sprzedażową z bieżącym klientem o 15%. W danym momencie może działać efekt tylko jednych perfum.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425226
    m_Localized: Te perfumy stworzono w oparciu o badania terapii żałoby. Wykorzystuję one technologię adapcyjnego mapowania zapachu w celu przywoływania pozytywnych wspomnień. Często używane przez pracowników branży hotelarskiej, którzy szybko odkrywają, że napiwki z nawiązką spłacają wysoką cenę tych perfum.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425227
    m_Localized: Feromonowe perfumy L'ESSENCE
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425228
    m_Localized: Użyj, aby zwiększyć premię sprzedażową z bieżącym klientem o 25%. W danym momencie może działać efekt tylko jednych perfum.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425229
    m_Localized: Nielegalny zapach z wyprodukowanych sztucznie ludzkich feromonów. Wzmacnia atrakcyjność i responsywność emocjonalną. Mimo wątpliwego statusu prawnego pożądany przez nuworyszy Wyższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425230
    m_Localized: Śrubokręt
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425231
    m_Localized: Skromny śrubokręt, mieszkaniec szuflad z różnościami w mieszkaniach na Wyższych i Niższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425232
    m_Localized: Kiedy go posiadasz, szukanie złomu na śmietnisku zapewnia o 10% więcej śrub.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425233
    m_Localized: Przecinak plazmowy
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425234
    m_Localized: Przecinak plazmowy z zapłonem wysokiej częstotliwości. Zaprojektowany, by gwarantować stabilność i szybkie, gładkie cięcie.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425235
    m_Localized: Można użyć do zbierania złomu przez rozmontowywanie zepsutych maszyn. Kiedy go posiadasz, szukanie złomu na śmietnisku zapewnia o 10% więcej złomu.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425236
    m_Localized: Nożyce do drutu
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425237
    m_Localized: Mechanizm sprężynowy zapewnia mocny nacisk i ogranicza zmęczenie, a miękkie, gumowe rączki dają odpowiedni chwyt i komfort użycia.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425238
    m_Localized: Można użyć do zbierania drutu przez rozmontowywanie zepsutych maszyn. Kiedy go posiadasz, szukanie złomu na śmietnisku zapewnia o 10% więcej drutu.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425239
    m_Localized: Przenośny skaner rentgenowski
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425240
    m_Localized: Pokazuje zawartość zamkniętych pojemników.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425241
    m_Localized: Etykieciarka
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425242
    m_Localized: Służy do zmiany etykiety przedmiotu.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425243
    m_Localized: Szkło powiększające
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425244
    m_Localized: Służy do dokładnego sprawdzania przedmiotów.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425245
    m_Localized: Neon – woda
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425246
    m_Localized: Po umieszczeniu na wystawie neon przyciągnie osoby sprzedające wodę.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425247
    m_Localized: Znak ekspedycji
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425248
    m_Localized: Umieść na wystawie, by przyciągnąć nowych lub bieżących wykonawców gotowych na ekspedycję.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425249
    m_Localized: Jednorazowy turbowzmacniacz
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425250
    m_Localized: Narzędzie do natychmiastowego napędzenia maszyn, których uruchomienie wymaga czasu. Pamiętaj, by wstawić wcześniej wszystkie wymagane materiały wejściowe. Znika po użyciu.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425251
    m_Localized: Zaawansowany turbowzmacniacz
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425252
    m_Localized: Narzędzie do natychmiastowego napędzenia maszyn, których uruchomienie wymaga czasu. Pamiętaj, by wstawić wcześniej wszystkie wymagane materiały wejściowe. Odnawia się z czasem. Zaawansowana wersja, która nie znika po użyciu.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425253
    m_Localized: Plastik
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425254
    m_Localized: Zachować ostrożność.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425255
    m_Localized: Plastik (uzbrojony)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425256
    m_Localized: 3… 2… 1… BUM!
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425257
    m_Localized: Plecak (mały)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425258
    m_Localized: Niewielki, zużyty plecak ze wzmocnionym ściegiem. Lekki, ale zmieści podstawowe zapasy.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425259
    m_Localized: Plecak (podstawowy)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425260
    m_Localized: Plecak (wojskowy)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425261
    m_Localized: Wytrzymały plecak zaprojektowany dla armii. Materiały są bardzo wytrzymałe, więc niektórzy żołnierze podczas walki noszą plecaki z przodu, by zapewnić sobie dodatkową ochronę.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425262
    m_Localized: Plecak (duży)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425263
    m_Localized: Duży plecak wojskowy
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425264
    m_Localized: Wytrzymały plecak zaprojektowany dla armii. Materiały są bardzo wytrzymałe, więc niektórzy żołnierze podczas walki noszą plecaki z przodu, by zapewnić sobie dodatkową ochronę.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425265
    m_Localized: Chlebak (mały)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425266
    m_Localized: Pakiet nasion Pożywnowocu
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425267
    m_Localized: Skrzynia zaopatrzeniowa Wydziału Ochrony
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425268
    m_Localized: 'Zamknięta skrzynia. Oznaczenie: zbrojownia Wydziału Ochrony. Pełna zasobów. Wymaga karty dostępu.'
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425269
    m_Localized: Skrzynia zaopatrzeniowa Odlewni Inżynieryjnej
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425270
    m_Localized: 'Zamknięta skrzynia. Oznaczenie: Odlewnia Inżynieryjna Stacji. Pełna zasobów. Wymaga karty dostępu.'
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425271
    m_Localized: Inżynierowie jeszcze zatęsknią za narzędziami…
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425272
    m_Localized: Skrzynia zaopatrzeniowa Ambulatorium
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425273
    m_Localized: 'Zamknięta skrzynia. Oznaczenie: Ambulatorium Stacji. Pełna zasobów. Wymaga karty dostępu.'
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425274
    m_Localized: Brak tych zasobów nie będzie nikogo kosztował życia… prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425275
    m_Localized: Skrzynia dowodowa Wydziału Ochrony
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425276
    m_Localized: Dowodów wystarczy, by zamknąć całe Niższe Poziomy za kratkami.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425277
    m_Localized: 'Zamknięta skrzynia. Oznaczenie: sala dowodowa Wydziału Ochrony. Pełna zasobów. Wymaga karty dostępu.'
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425278
    m_Localized: Skrzynia zaopatrzeniowa Wydziału Serwisowego
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425279
    m_Localized: 'Zamknięta skrzynia. Oznaczenie: Wydział Serwisowy Stacji. Pełna zasobów. Wymaga karty dostępu.'
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425280
    m_Localized: Wydział Serwisowy Stacji rozdaje zasoby potrzebującym lub tym z pełnymi portfelami.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425281
    m_Localized: Kratka piwa Bordowy Bies
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425282
    m_Localized: Wytrzymałe sprężyny
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425283
    m_Localized: Zestaw zaawansowanych sprężyn. Poprawiają cykl pracy i zwiększają odporność na uszkodzenia pod wpływem obciążeń.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425284
    m_Localized: Zmodyfikowany mechanizm spustowy
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425285
    m_Localized: Mechanizm spustowy poprawiający kulturę pracy spustu. Obniża opór języka spustowego i poprawia jego ściąganie przed przełamaniem.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425286
    m_Localized: Lufa dopasowana
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425287
    m_Localized: Niezwykle precyzyjnie wykonana lufa, która zwiększa celność.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425288
    m_Localized: Zaczep spustu samoczynnego pistoletu
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425289
    m_Localized: Specjalna modyfikacja pistoletu. Po zamontowaniu modyfikuje działanie wewnętrzne broni, zapewniając ogień samoczynny przy wciśniętym spuście.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425290
    m_Localized: Licznik amunicji
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425291
    m_Localized: Mały wyświetlacz wskazujący bieżącą ilość i rodzaj amunicji.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425292
