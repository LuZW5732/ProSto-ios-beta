    m_Localized: 'Czip do drukarki 3D: (pistolet .22 x{0})'
    m_Metadata:
      m_Items: []
  - m_Id: 83474906205700105
    m_Localized: Szkielet Nestfire Compact
    m_Metadata:
      m_Items: []
  - m_Id: 83474906205700106
    m_Localized: Szkielet Ironcraft 10
    m_Metadata:
