  - m_Id: 83474906205700101
    m_Localized: Moduł seryjnej broni ręcznej
    m_Metadata:
      m_Items: []
  - m_Id: 83474906205700102
    m_Localized: Moduł drukarki dodający broń do każdej wydrukowanej broni ręcznej. Powolny i energochłonny.
    m_Metadata:
      m_Items: []
  - m_Id: 83474906205700103
    m_Localized: Liczba drukowanych broni ręcznych +{0}
    m_Metadata:
      m_Items: []
