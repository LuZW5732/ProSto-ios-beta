    m_Metadata:
      m_Items: []
  - m_Id: 140582828425297
    m_Localized: Drukowany kolimator z czerwoną diodą i plastikową soczewką. Dosyć zawodny, ale zaskakująco skuteczny.
    m_Metadata:
      m_Items: []
