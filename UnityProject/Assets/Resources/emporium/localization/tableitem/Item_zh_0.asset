%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Item_zh
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh
  m_SharedData: {fileID: 11400000, guid: 93fe472e9fd181141974a1f58c3bef9e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 158976881508352
    m_Localized: “远古外星遗物”
    m_Metadata:
      m_Items: []
  - m_Id: 159203780771840
    m_Localized: 怎么看都只是一堆废旧金属……“远古外星”废旧金属？
    m_Metadata:
      m_Items: []
  - m_Id: 158979263873024
    m_Localized: 100%脱水纯水
    m_Metadata:
      m_Items: []
  - m_Id: 140582820036608
    m_Localized: 一盒帕克斯卫生棉条
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230912
    m_Localized: 此类卫生用品主打安全与私密，是下层区鲜有人能消费得起的奢侈品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230913
    m_Localized: 一包海明威香烟
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230914
    m_Localized: 极致奢华的吸烟体验，它的口感和它的价格一样，绝对让你终生难忘。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230915
    m_Localized: 一盒瑞克斯避孕套
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230916
    m_Localized: 得益于一项补贴分发计划，这东西在下层区极为常见。毕竟，控制人口可比镇压暴乱便宜多了。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230917
    m_Localized: 一瓶四合一洗涤剂
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230918
    m_Localized: 集洗发水、护发素、沐浴露和牙膏于一瓶的便捷洗护产品，更添加了提神醒脑的营养果萃取物。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230919
    m_Localized: 一支牙膏
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230920
    m_Localized: 能带来清新口气的薄荷凝胶。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230921
    m_Localized: 一卷纸巾
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230922
    m_Localized: 一卷厕纸
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230923
    m_Localized: 价格亲民的厕纸，结实耐用。在下层区，双层纸也已然是一种奢侈。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230924
    m_Localized: 水质检测试剂盒
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230925
    m_Localized: 包含水质检测试纸的小瓶。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230926
    m_Localized: 水质检测试纸
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230927
    m_Localized: 用于准确测定水样质量的检测试纸。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230928
    m_Localized: 紫外线灯
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230929
    m_Localized: 可用于水容器。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230930
    m_Localized: 一种发射紫外线以杀灭细菌和其他微生物的灯具。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230931
    m_Localized: 水质扫描仪
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230932
    m_Localized: 一种用于准确测定水样质量的设备。可显示检测到的杂质。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230933
    m_Localized: 拾荒扫描仪
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230934
    m_Localized: 一种能提高你在拾荒时发现贵重物品几率的设备。（你同时只能获得一台拾荒扫描仪的增益效果。）
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230935
    m_Localized: 曾经幻想过拥有第三只眼吗？或者是第二只鼻子？用拾荒扫描仪穿透杂物，寻找宝藏吧！
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230936
    m_Localized: 一瓶净水药片
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230937
    m_Localized: 一小瓶用于净化水质的药片。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230938
    m_Localized: 净水药片
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230939
    m_Localized: 可消除大量微生物污染物，并部分减少化学污染物。对其他类型的污染物无效。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230946
    m_Localized: 韧棉织物
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230947
    m_Localized: 用于化学实验，可滤除液体中的大颗粒物。织孔太粗，完全无法用于净水。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230948
    m_Localized: 用途广泛的有机纤维布料。常用于制作加固工作服和减震内衬。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230949
    m_Localized: 滤水器
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230950
    m_Localized: 安装在过滤系统内使用时，可略微提高水质纯度。水质纯度超过一定阈值后将不再生效。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230951
    m_Localized: 轻量化的民用级过滤器。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425224
    m_Localized: “同步”神经活性香水
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425225
    m_Localized: 使用后，与当前顾客的交易收益将提升15%。你同时只能获得一种香水效果的增益。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425226
    m_Localized: 脱胎于心理创伤治疗研究，采用自适应气味映射技术来唤起个人的美好回忆。常见于高端服务场所，那里的员工发现，喷这款香水能换来的小费远超它的售价。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425227
    m_Localized: “本源”费洛蒙香水
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425228
    m_Localized: 使用后，与当前顾客的交易收益将提升25%。你同时只能获得一种香水效果的增益。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425229
    m_Localized: 以人工改造的人类信息素调制出的违禁香水，能增强吸引力与情感接受度。尽管属于违禁品，但它依然受到上层区那些攀附权贵者的极力追捧。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425230
    m_Localized: 螺丝刀
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425231
    m_Localized: 朴实无华的螺丝刀，不管是上层区还是下层区的公民都会在杂物抽屉里放上一件。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425232
    m_Localized: 携带此物品时，在垃圾场拾荒将获得10%的额外螺丝产量。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425233
    m_Localized: 等离子切割机
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425234
    m_Localized: 高频点火等离子切割机。经过精密制造以保证稳定性，切割速度快、威力大且切口平整。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425235
    m_Localized: 能够用来拆解损坏的机器以回收废金属。携带此物品时，在垃圾场拾荒将获得10%的额外废金属产量。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425236
    m_Localized: 剪线钳
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425237
    m_Localized: 弹簧装置确保了良好的杠杆作用，减轻使用者的手部负担，而柔软的橡胶手柄则提供了出色的抓握力与舒适度。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425238
    m_Localized: 能够用来拆解损坏的机器以回收线缆。携带此物品时，在垃圾场拾荒将获得10%的额外线缆产量。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425241
    m_Localized: 标签打印机
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425242
    m_Localized: 用于编辑物品的标签。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425243
    m_Localized: 放大镜
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425244
    m_Localized: 用于更仔细地检查某些物品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425245
    m_Localized: 水霓虹灯牌
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425246
    m_Localized: 一块霓虹灯牌。将其放置在展示柜中，可吸引有意出售水的顾客。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425249
    m_Localized: 一次性涡轮增压器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425250
    m_Localized: 能够立刻为需要耗时运作的机器提供动力的工具。使用前请确保目标机器已具备所有必要的输入材料。使用后即被消耗。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425251
    m_Localized: 高级涡轮增压器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425252
    m_Localized: 能够立刻为需要耗时运作的机器提供动力的工具。使用前请确保目标机器已具备所有必要的输入材料。随时间推移可自动充能。这一高级版本在使用后不会被消耗。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425253
    m_Localized: 塑性炸药
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425254
    m_Localized: 轻拿轻放。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425255
    m_Localized: 塑性炸药（已激活）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425256
    m_Localized: 3……2……1……轰！！
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425257
    m_Localized: 背包（小）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425258
    m_Localized: 款式紧凑、饱经磨砺的背包，配有加固缝线。重量虽轻，但足以装下各种基本物资。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425259
    m_Localized: 背包（基础）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425260
    m_Localized: 背包（军用）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425261
    m_Localized: 专为军事用途设计的重型背包。布料极为耐用，以至于有些士兵在战斗中会把它背在胸前当作额外护甲使用。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425262
    m_Localized: 背包（大）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425265
    m_Localized: 挎包（小）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425266
    m_Localized: 一包营养果种子
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425267
    m_Localized: 治安部物资箱
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425268
    m_Localized: 一个上锁的板条箱，标签上写着归空间站治安部军械库所有。里面装满了物资。需要识别卡才能打开。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425269
    m_Localized: 工程铸造厂物资箱
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425270
    m_Localized: 一个上锁的板条箱，标签上写着归空间站工程铸造厂所有。里面装满了物资。需要识别卡才能打开。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425271
    m_Localized: 那些戴安全帽的家伙一定会为弄丢了工具而追悔莫及……
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425272
    m_Localized: 医疗舱物资箱
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425273
    m_Localized: 一个上锁的板条箱，标签上写着归空间站医疗舱所有。里面装满了物资。需要识别卡才能打开。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425274
    m_Localized: 弄丢了这批物资应该不至于闹出人命吧……对吧？
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425275
    m_Localized: 治安部物证柜
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425276
    m_Localized: 这里面的东西足够把整个下层区的人都送进大牢了。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425277
    m_Localized: 一个上锁的板条箱，标签上写着归空间站治安部证物库所有。内含贵重物品。需要识别卡才能打开。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425278
    m_Localized: 后勤服务部物资箱
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425279
    m_Localized: 一个坚固的板条箱，标签上写着归空间站后勤服务部所有。里面装满了物资。需要识别卡才能打开。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425280
    m_Localized: 空间站后勤服务部负责将公共设施物资分发给那些有需要……或者说，付得起钱的人。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425342
    m_Localized: 化学用品（普通）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425343
    m_Localized: 拆开后可获得一批用于基础化学合成的实用物品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425344
    m_Localized: 一批你极有可能在空间站五金库里找到的常见化学用品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425345
    m_Localized: 化学用品（管制）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425346
    m_Localized: 拆开后可获得一批用于高级化学合成的实用物品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425347
    m_Localized: 一批用于制造麻醉品或炸药的管制化学用品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425348
    m_Localized: 医疗用品（普通）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425349
    m_Localized: 一批常见的医疗用品，主要是药房里的非处方类物品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425350
    m_Localized: 医疗用品（管制）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425351
    m_Localized: 一批受管制的医疗物品——用来救治空间站病患的必需品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425352
    m_Localized: 废金属
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425353
    m_Localized: 可冶炼成金属矿石。由于空间站上的资源极其有限，打捞和回收利用成为了尤为重要的生存习惯。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425354
    m_Localized: 垃圾
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425355
    m_Localized: 损坏的废料和毫无用处的垃圾。几乎无法回收，完全一文不值。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425356
    m_Localized: 金属矿石
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425358
    m_Localized: 电子元件（普通）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425359
    m_Localized: 各种虽说常见却很实用的的电子元件组合：连接器、开关、电容器、处理器以及处理单元……
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425360
    m_Localized: 电子元件（稀有）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425361
    m_Localized: 一批不常见的高端电子元件组合。某位发明家肯定会对此非常感兴趣……
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425362
    m_Localized: 线缆
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425363
    m_Localized: 一捆电线。看这模样，显然是从某个地方强行拆下来的……
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425364
    m_Localized: 3D打印耗材
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425365
    m_Localized: '用于3D打印机的优质耗材，尽可能地利用回收废旧塑料加工而成。 '
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425369
    m_Localized: 放射性废料
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425370
    m_Localized: 放射性废料。请小心处理。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425371
    m_Localized: 一批危险的核废料。没人愿意碰这玩意儿。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425372
    m_Localized: 助熔剂（基础）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425373
    m_Localized: 实用的添加剂，在冶炼时使用可提高金属矿石的纯度。会在过程中被消耗。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425374
    m_Localized: 助熔剂（高级）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425375
    m_Localized: '实用的添加剂，在冶炼时使用可提高金属矿石的纯度。可重复使用。 '
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425408
    m_Localized: 电击枪
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425409
    m_Localized: 用于自卫和执法的小型电击武器。能释放令人痛苦的电击。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425410
    m_Localized: 避孕药
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425411
    m_Localized: 用于防止怀孕的避孕药。它是雌激素和孕激素的结合体。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425421
    m_Localized: 一板零嚼
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425422
    m_Localized: 一板“零嚼”，一种廉价的食欲抑制剂。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425423
    m_Localized: 会被一些下层区居民用来少吃几顿正餐，好省下信用点。而在上层区，这东西则被包装成“纤体-X”减肥药进行营销。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425424
    m_Localized: 嗅盐
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425425
    m_Localized: 包含酒精和氨水的细玻璃管，有助于在昏厥后恢复意识。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425426
    m_Localized: 血袋
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425427
    m_Localized: 一袋500毫升的输血袋，采集自一位万能血型捐献者——尽管其本人未必出于自愿。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425428
    m_Localized: 一袋“蓝血”
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425429
    m_Localized: 可注射的生物凝胶，经专门设计，可随时间溶解动脉斑块和微小血栓。它能有效预防冠心病、缺血性中风以及高血压相关的并发症。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425430
    m_Localized: 实际上并非血液。即便是放在上层区也属于稀罕物。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425431
    m_Localized: 一小瓶“梦尘”
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425432
    m_Localized: 下层区自制的一种廉价兴奋粉。被用来暂时忘却生活在空间站里的残酷现实。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425433
    m_Localized: 一小瓶“梦魇尘”
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425434
    m_Localized: 兼具毒药和致幻剂双重作用的细粉末。吞食或吸入会导致严重的恶心、虚弱和意识混乱，随后产生可怕的幻觉。大剂量可致命。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425435
    m_Localized: 咖啡因药片
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425436
    m_Localized: 用上层区高档咖啡厅的残渣提炼而成，这些药片是下层区需长时间轮班的工人们的必需品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425437
    m_Localized: 南丁格尔软膏
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425438
    m_Localized: 由基因改良芦荟和医用级蜂蜜制成。该软膏具有抗菌特性，并能促进细胞的再生与生长。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425439
    m_Localized: 医用酒精
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425440
    m_Localized: 一种强效消毒剂，用于清洁伤口和物体表面。吞食具有剧毒，但这并不能阻止它在下层区被当作努特加的替代品饮用。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425441
    m_Localized: 基础绷带
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425442
    m_Localized: 一条简单、干净的绷带，用于包扎伤口。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425443
    m_Localized: 止血绷带
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425444
    m_Localized: 涂有强效止血剂的绷带，轻重度出血都能止住。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425445
    m_Localized: 外用药膏绷带
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425446
    m_Localized: 涂有温和局部医疗凝胶的绷带，有助于伤口愈合。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425447
    m_Localized: 免疫宁注射器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425448
    m_Localized: 一种高精度免疫调节剂，用于暂时抑制“哨兵崩溃综合征”引发的过度免疫反应。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425449
    m_Localized: 赛纳普斯注射器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425450
    m_Localized: 治疗药物成瘾的次世代疗法，旨在抑制大脑的奖励机制，减轻药瘾，辅助长期康复。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425451
    m_Localized: 与心理治疗和社会支持结合使用效果最佳。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425452
    m_Localized: 奥克西莫注射器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425453
    m_Localized: 奥克西莫是一种合法但危险的药物，用于缓解剧痛并产生快感。由于过度开具处方，奥克西莫成瘾和过量使用的情况极为普遍。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425454
    m_Localized: 奥克莫吸注射器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425455
    m_Localized: 奥克西莫的非成瘾性止痛替代品。提供有效的镇痛作用，且没有依赖或用药过量的风险。这是一支装在二次利用的注射器里的原型药。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425456
    m_Localized: 纳洛通注射器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425457
    m_Localized: 纳洛通是一种用于对抗奥克西莫用药过量的急救药物。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425460
    m_Localized: 玻璃刀
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425461
    m_Localized: 一块边缘锋利的碎玻璃，用布包裹着，可作为武器使用。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425462
    m_Localized: 战斗匕首
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425463
    m_Localized: 一把专为军事用途设计的格斗短刀，主要用于肉搏或近战，但作为工具也很方便。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425464
    m_Localized: 美工刀
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425465
    m_Localized: 结实且带有可伸缩刀片的多用途刀具，常用于建筑、手工和仓库作业。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425466
    m_Localized: 切肉刀
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425467
    m_Localized: 厨刀
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619520
    m_Localized: 一把不锈钢刀具。请置于儿童以及心怀鬼胎的上层区家庭主妇接触不到的地方。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619521
    m_Localized: 战斗砍刀
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619522
    m_Localized: 专为战斗与求生打造的重型砍刀。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619523
    m_Localized: 撬棍
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619524
    m_Localized: 空间站上每一位经验丰富的拾荒者和理论物理学家最可靠的工具。在紧要关头也可作为武器。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619525
    m_Localized: 短柄斧
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619526
    m_Localized: 小巧坚固。可在水培农场中移除当前种植的作物。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619527
    m_Localized: 铅管
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619528
    m_Localized: 一根沉重的铅管。在空间站大修供水管线后，数吨剩余的废旧铅管流入了拾荒者和小偷的手中。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619529
    m_Localized: 眩晕警棍
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619530
    m_Localized: 配有晕眩和致命两种模式的标准制式电击棍。负责维持空间站秩序的治安部警官的日常防身武器。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619531
    m_Localized: 能量电池
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619532
    m_Localized: 为了减少浪费，一次性电池已被共和国认定为非法。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619533
    m_Localized: 兼容多数机器的基础电源。可充电。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619534
    m_Localized: 能量电池（2型）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619535
    m_Localized: 作为标准型号的改良版，2型电池体积更大、效能更好，误吞窒息的风险也更高。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619536
    m_Localized: 兼容多数机器的进阶电源。可充电。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619537
    m_Localized: 自充电能量电池
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619538
    m_Localized: 能够自行充电的高级稀有能量电池。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619539
    m_Localized: 碎玻璃
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619543
    m_Localized: 手电筒
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619544
    m_Localized: 重型手电筒。携带此物品时，在垃圾场拾荒受伤的几率会降低。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619545
    m_Localized: 报纸
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619546
    m_Localized: 一份最新出炉的报纸。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619547
    m_Localized: 导师手册
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619548
    m_Localized: 专门收集整理导师给你的所有笔记的册子。非常方便！
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619549
    m_Localized: 海明威鉴定指南
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619550
    m_Localized: 帮助识别假冒海明威香烟的指南。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619551
    m_Localized: 海明威色卡
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619552
    m_Localized: 官方发行的海明威标准色卡。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619554
    m_Localized: 等离子燃料匣鉴定指南
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619555
    m_Localized: 用来给等离子燃料匣精准估价的指南。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619558
    m_Localized: 食品券鉴定手册
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619559
    m_Localized: 实用的指南，用于从赝品中辨别出真正的食品券。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619560
    m_Localized: 免疫宁检测指南
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619561
    m_Localized: 包含评估免疫宁注射器状况所需的所有信息。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619562
    m_Localized: 水资源交易手册
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619563
    m_Localized: 实用的手册，包含了关于水资源买卖的所有信息。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619568
    m_Localized: 冶金手册
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619571
    m_Localized: 租赁协议
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619572
    m_Localized: 你的租约。由你和你的房东共同签署。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619575
    m_Localized: 营业许可证
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619576
    m_Localized: 共和国颁发的许可证，在下层区合法经营商铺的必需品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619577
    m_Localized: 手写便签
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619578
    m_Localized: 普普通通的手写字条。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619579
    m_Localized: 拾荒者信物
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619580
    m_Localized: 一种认可的象征。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619581
    m_Localized: 拾荒者群体赠予的信物。每向展示柜中放置一枚，都会提升拾荒者前来光顾的几率。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619582
    m_Localized: 档案箱
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619583
    m_Localized: 可容纳各种文件、便签、书籍和放大镜。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619584
    m_Localized: 垃圾桶
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619585
    m_Localized: 里面的物品将在夜间被永久移除——只要你支付了清洁服务费。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619586
    m_Localized: 排水口
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619587
    m_Localized: 不想要的水可以倒入此处。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619588
    m_Localized: 水龙头
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619589
    m_Localized: 没有水……也许有人能帮忙把供水接通？
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619590
    m_Localized: 一次性钥匙卡（指挥）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619591
    m_Localized: 万能钥匙卡，仅限空间站指挥人员携带。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619592
    m_Localized: 供空间站指挥层使用的一次性钥匙卡。可开启大多数需要钥匙卡权限的锁。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619593
    m_Localized: 一次性钥匙卡（治安）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619594
    m_Localized: 如果落入歹人之手可能会很危险……
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619595
    m_Localized: 供空间站治安部使用的一次性钥匙卡。可开启需要治安部权限的锁。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619596
    m_Localized: 一次性钥匙卡（研发）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619597
    m_Localized: 空间站研发部官员携带的钥匙卡。非常有价值。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619598
    m_Localized: 供研发部使用的一次性钥匙卡。可开启需要科研部权限的锁。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619599
    m_Localized: 一次性钥匙卡（医疗）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619600
    m_Localized: 供空间站医疗部使用的一次性钥匙卡。可开启需要医疗权限的锁。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619601
    m_Localized: 一次性钥匙卡（工程）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619602
    m_Localized: 供空间站工程部使用的一次性钥匙卡。可开启需要工程权限的锁。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619603
    m_Localized: 一次性钥匙卡（补给）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619604
    m_Localized: 供空间站补给部门使用的一次性钥匙卡。可开启需要补给权限的锁。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619605
    m_Localized: 一次性钥匙卡（服务）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619606
    m_Localized: 供空间站服务部门使用的一次性钥匙卡。可开启需要服务权限的锁。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619607
    m_Localized: 一次性钥匙卡（空白）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619608
    m_Localized: 空间站内最接近万能钥匙的钥匙卡。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619609
    m_Localized: 未写入数据的钥匙卡。只要有合适的设备，就能为其写入不同的访问权限。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619610
    m_Localized: 名片（乔·王尔德）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619611
    m_Localized: 随时为您效劳。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619612
    m_Localized: 名片（红魔鬼酿酒厂）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619613
    m_Localized: 好喝到要命。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619614
    m_Localized: 名片（GP采矿合作社）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619615
    m_Localized: 已经没人知道GP到底代表什么了。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619616
