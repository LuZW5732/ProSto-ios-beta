    m_Localized: 水培营养片药瓶
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230944
    m_Localized: 装有水培营养片的瓶子。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230945
    m_Localized: 严禁吞食。仅限水培农业使用。
    m_Metadata:
      m_Items: []
