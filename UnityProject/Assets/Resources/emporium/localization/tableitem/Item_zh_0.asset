    m_Metadata:
      m_Items: []
  - m_Id: 140582828425385
    m_Localized: 哨兵3型。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425386
    m_Localized: 性能可靠的10毫米口径手枪，主要由治安部人员携带。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425404
    m_Localized: 10毫米弹药（穿甲弹）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425405
    m_Localized: 少量10毫米口径的高速脱壳穿甲弹（APDS）。能够击穿防弹衣。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425418
    m_Localized: 芬太片
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425419
    m_Localized: 一种极易成瘾、极度危险且廉价的合成阿片类药物，常用于治疗剧烈疼痛。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425420
    m_Localized: 药效比奥克西莫强50倍以上。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619540
    m_Localized: 治安部档案
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619541
