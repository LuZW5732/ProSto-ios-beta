%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Item_ja
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ja
  m_SharedData: {fileID: 11400000, guid: 58be4cb0b849ac14ba59a0c571d49f34, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 158976881508352
    m_Localized: 「古代異星の遺物」
    m_Metadata:
      m_Items: []
  - m_Id: 159203780771840
    m_Localized: ただの金属くずに見えるが……「古代異星」の金属くずなのだろうか？
    m_Metadata:
      m_Items: []
  - m_Id: 158979263873024
    m_Localized: 100%純粋な水（水分0%）
    m_Metadata:
      m_Items: []
  - m_Id: 140582820036608
    m_Localized: PAXタンポン
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230912
    m_Localized: しっかり守ってくれる衛生用品は、下層世界では手を出せる人の少ない贅沢品とされている。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230913
    m_Localized: Hemingwayのタバコ
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230914
    m_Localized: フレーバーでも価格でも、どちらを取っても忘れがたい贅沢な時間を過ごせる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230915
    m_Localized: REXコンドーム
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230916
    m_Localized: 政府からの配布プログラムのおかげで、下層世界では一般的なものとなっている。人口の抑制は暴動を鎮圧するよりも安上がりなのだ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230917
    m_Localized: 4in1 ウォッシュボトル
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230918
    m_Localized: シャンプー、コンディショナー、ボディソープが1本で済むうえに、歯磨きまでできるボトル。若返り効果のあるニュートリフルーツエキスを配合。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230919
    m_Localized: 歯磨き粉
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230920
    m_Localized: 息が爽やかになる、ミント味の歯磨き粉。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230921
    m_Localized: ペーパータオル
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230922
    m_Localized: トイレットペーパー
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230923
    m_Localized: 強度と信頼性を兼ね備えた、手頃な価格のトイレットペーパー。ダブルタイプは、下層世界では贅沢品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230924
    m_Localized: 水質検査キット
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230925
    m_Localized: 水質を色で調べる試験紙が入った、小さなボトル。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230926
    m_Localized: 水質試験紙
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230927
    m_Localized: 水サンプルの品質を正確に把握するために使われる試験紙。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230928
    m_Localized: UVランプ
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230929
    m_Localized: 水入れで使用可能。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230930
    m_Localized: 紫外線を発して、細菌やその他の微生物を殺せるランプ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230931
    m_Localized: アクアスキャン
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230932
    m_Localized: 水サンプルの品質を正確に把握するために使われる装置。検出された不純物を表示する。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230933
    m_Localized: 漁り屋スキャナー
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230934
    m_Localized: 廃品漁りをするときに高価なものが見つかる確率が上がる装置。（一度に効果を得られるスキャナーは1つのみ）
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230935
    m_Localized: 第三の目、第二の鼻が欲しいと思ったことはないだろうか？ このスキャナーを使えば、雑然とした状況も突破できる！
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230936
    m_Localized: 浄水タブレット入れ
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230937
    m_Localized: 浄水に使えるタブレットが入った、小さなボトル。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230938
    m_Localized: 浄水タブレット
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230939
    m_Localized: 微生物汚染を大量に除去し、化学汚染を部分的に減らせる。他の種類の汚染物質には効果なし。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230946
    m_Localized: コットン生地
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230947
    m_Localized: 液体から大きな粒子を除去するのに使える。粗すぎて浄水には使えない。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230948
    m_Localized: 有機繊維で作られた汎用性の高い生地。作業着の補強や、衝撃を和らげる包帯などに広く使われている。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230949
    m_Localized: ろ過器
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230950
    m_Localized: 取り付けることで、水の純度が少し上がる。一定のレベルを超えると効果がなくなる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230951
    m_Localized: 軽量で、一般家庭用。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425224
    m_Localized: SYNCニューロアクティブ香水
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425225
    m_Localized: 使用すると、その時点での客の取引ボーナスが15%上がる。一度に効果を得られる香水は1つのみ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425226
    m_Localized: 悲嘆療法の研究から開発された香水だ。適応型香気マッピング技術を用いて、個人のポジティブな記憶を呼び起こす。高級ホテルやレストランではよく使われており、従業員たちは、この香水を使った場合に得られる利益が値段を上回っていることを実感している。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425227
    m_Localized: L'ESSENCEフェロモン香水
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425228
    m_Localized: 使用すると、その時点での客の取引ボーナスが25%上がる。一度に効果を得られる香水は1つのみ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425229
    m_Localized: 人工的に作られた人間のフェロモンを配合した、違法な香水。魅力と感受性を高める効果がある。違法ではあるが、上層世界で成り上がりを目論む者たちからの需要が高い。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425230
    m_Localized: ドライバー
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425231
    m_Localized: 簡素なドライバー。上層・下層を問わず、市民があまり使わない引き出しに入れている定番アイテム。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425232
    m_Localized: 所持している場合、ゴミ捨て場で廃品漁りをしたときに得られるネジの量が10%増える。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425233
    m_Localized: プラズマカッター
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425234
    m_Localized: 高周波の点火式プラズマカッター。安定した性能が保証されており、高速かつ強力で滑らかに切断できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425235
    m_Localized: 壊れた機械を分解して金属くずにすることができる。所持している場合、ゴミ捨て場で廃品漁りをしたときに得られる金属くずの量が10%増える。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425236
    m_Localized: ワイヤーカッター
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425237
    m_Localized: バネのおかげでてこの力が働き、使用者の負担を軽減する。ゴム製の取っ手はやわらかく、握りやすい。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425238
    m_Localized: 壊れた機械を分解してワイヤーにすることができる。所持している場合、ゴミ捨て場で廃品漁りをしたときに得られるワイヤーの量が10%増える。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425241
    m_Localized: ラベラー
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425242
    m_Localized: アイテムのラベルを替えることができる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425243
    m_Localized: 虫眼鏡
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425244
    m_Localized: 特定のアイテムを詳しく調べることができる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425245
    m_Localized: ネオンサイン（水）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425246
    m_Localized: ショーケースに設置すると、水を売りたがっている客が来てくれるネオンサイン。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425249
    m_Localized: 使い捨てターボブースター
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425250
    m_Localized: 起動に時間を要する機械を即座に稼働させる道具。使用前に、対象の機械に必要な入力が済んでいることを確認するように。使用するとなくなる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425251
    m_Localized: 高度なターボブースター
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425252
    m_Localized: 起動に時間を要する機械を即座に稼働させる道具。使用前に、対象の機械に必要な入力が済んでいることを確認するように。時間が経つと、もう一度使えるようになる。高度なバージョンは、使用してもなくならない。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425253
    m_Localized: プラスチック爆発物
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425254
    m_Localized: 取り扱い注意。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425255
    m_Localized: プラスチック爆発物（起爆後）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425256
    m_Localized: 3……2……1……ドカン！！
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425257
    m_Localized: カバン（小）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425258
    m_Localized: 使い込まれてから縫って補強された、コンパクトなカバン。軽量だが、必需品を入れるのには十分な容量だ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425259
    m_Localized: カバン（基本）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425260
    m_Localized: カバン（軍用）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425261
    m_Localized: 軍用に設計された、丈夫なカバン。生地の耐久性が非常に高く、戦闘時に追加の防具として前に背負う兵士もいる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425262
    m_Localized: カバン（大）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425265
    m_Localized: 肩掛けバッグ（小）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425266
    m_Localized: ニュートリフルーツの種
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425267
    m_Localized: 保安部の物資箱
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425268
    m_Localized: 鍵のかかった箱。保安部の武器庫宛てになっており、物資がたくさん入っている。アクセスカードが必要。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425269
    m_Localized: 工学鋳造所の物資箱
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425270
    m_Localized: 鍵のかかった箱。工学鋳造所宛てになっており、物資がたくさん入っている。アクセスカードが必要。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425271
    m_Localized: 道具をなくした労働者は悔しがるだろう……
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425272
    m_Localized: 医務室の物資箱
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425273
    m_Localized: 鍵のかかった箱。医務室宛てになっており、物資がたくさん入っている。アクセスカードが必要。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425274
    m_Localized: これがなくなっても、誰かの命が奪われることはない……はずだ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425275
    m_Localized: 保安部の証拠品箱
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425276
    m_Localized: 下層世界の人間を丸ごと刑務所送りにできそうなほど、証拠が集まっている。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425277
    m_Localized: 鍵のかかった箱。保安部の証拠品保管庫宛てになっており、貴重。アクセスカードが必要。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425278
    m_Localized: 管理部の物資箱
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425279
    m_Localized: 鍵のかかった箱。ステーションの管理部宛てになっており、物資がたくさん入っている。アクセスカードが必要。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425280
    m_Localized: ステーションの管理部は、必要としている者や代金を支払った者に実用的な物資を配布している。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425342
    m_Localized: 化学用品（一般）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425343
    m_Localized: 基本的な化学系の製作に便利なアイテムが入っている。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425344
    m_Localized: ステーションのホームセンターでよく見かけるような、一般的な化学用品のセットだ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425345
    m_Localized: 化学用品（制限）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425346
    m_Localized: 高度な化学系の製作に便利なアイテムが入っている。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425347
    m_Localized: 麻薬や爆発物の製作に必要になる、制限付きの化学用品のセットだ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425348
    m_Localized: 医療用品（一般）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425349
    m_Localized: 薬局で売られていることが多い、一般的な医療用品のセットだ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425350
    m_Localized: 医療用品（制限）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425351
    m_Localized: ステーションの病人の治療に必要になる、制限付きの医療用品のセットだ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425352
    m_Localized: 金属くず
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425353
    m_Localized: 溶解して鉱石にできる。ステーションでは資源が限られているため、回収と再利用が大切だ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425354
    m_Localized: ガラクタ
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425355
    m_Localized: 壊れて何の役にも立たないゴミ。リサイクルもほとんど不可能で、価値はほぼない。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425356
    m_Localized: 鉱石
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425358
    m_Localized: 電子部品（一般）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425359
    m_Localized: ありふれてはいるが便利な電子部品の詰め合わせ。コネクター、スイッチ、コンデンサー、プロセッサー、処理ユニットなど。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425360
    m_Localized: 電子部品（希少）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425361
    m_Localized: 珍しく高性能な電子部品の詰め合わせ。とても興味を持ちそうな発明家がいる……
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425362
    m_Localized: ワイヤー
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425363
    m_Localized: 電線の束。どこかから取ってきたもののように見える……
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425364
    m_Localized: 3Dプリント用フィラメント
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425365
    m_Localized: '3Dプリンターで使用するための、高品質なフィラメント。可能な限り、再利用したプラスチックから作られる。 '
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425369
    m_Localized: 放射性廃棄物
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425370
    m_Localized: 放射性廃棄物。取り扱い注意。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425371
    m_Localized: 有害な核廃棄物が集まっている。こんなものを扱いたい人はいない。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425372
    m_Localized: 溶解用フラックス剤（基本）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425373
    m_Localized: 溶解中に使用すると、鉱石の純度が上がる便利な添加剤。使用するとなくなる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425374
    m_Localized: 溶解用フラックス剤（応用）
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425375
    m_Localized: '溶解中に使用すると、鉱石の純度が上がる便利な添加剤。再利用可能。 '
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425408
    m_Localized: テーザー銃
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425409
    m_Localized: 自己防衛や法執行に使用される、コンパクトなスタンガン。電気ショックを与える。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425410
    m_Localized: 避妊薬
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425411
    m_Localized: 妊娠を防ぐ避妊用の薬。エストロゲンとプロゲスチンのホルモンが配合されている。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425421
    m_Localized: ZeroChewタブレット
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425422
    m_Localized: 手頃な価格で食欲を抑えられる、ZeroChewのタブレット。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425423
    m_Localized: 食事を抜いて節約しようとする下層世界の住民が、愛用しているタブレット。上層世界では、ダイエットサプリ「Regime-X」として販売されている。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425424
    m_Localized: 気付け薬
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425425
    m_Localized: アルコールとアンモニアが入った、細いガラス管。失神後に意識を回復させる際に役立つ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425426
    m_Localized: 血液バッグ
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425427
    m_Localized: ユニバーサルドナーから採取した、500mlの血液バッグ。ドナーからの許可を得ているとは限らない。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425428
    m_Localized: 青の血液バッグ
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425429
    m_Localized: 動脈プラークや微小血栓を時間をかけて溶かすように作られた、注射用バイオゲル。冠動脈疾患、虚血性脳卒中、高血圧関連の合併症を効果的に予防する。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425430
    m_Localized: 実際には血液ではなく、上層世界でもあまり見かけない。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425431
    m_Localized: 「ドリームダスト」の小瓶
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425432
    m_Localized: 下層世界で作られた、安価で陶酔感が得られる粉末。ステーションで過酷な人生を送る中で、現実逃避するために使われる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425433
    m_Localized: 「ナイトメアダスト」の小瓶
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425434
    m_Localized: 毒物であり幻覚剤でもある、細かい粉末。摂取または吸入すると、激しい吐き気、脱力感、方向感覚の喪失を引き起こし、その後、恐ろしい幻覚を見る。大量に摂取すると死に至る恐れがある。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425435
    m_Localized: カフェイン錠剤
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425436
    m_Localized: 上層世界のエスプレッソバーから出る廃棄物から調合された。下層世界で長時間働く労働者には欠かせない。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425437
    m_Localized: Nightingaleの軟膏
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425438
    m_Localized: 加工されたアロエと医療用のハチミツから作られた軟膏。抗菌作用があり、細胞の再生と成長を促進する。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425439
    m_Localized: 消毒用アルコール
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425440
    m_Localized: 傷や表面の洗浄に使われる、強力な消毒薬。飲み込むと非常に危険だが、それでも下層世界ではNUDKAの代用とされている。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425441
    m_Localized: 基本の包帯
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425442
    m_Localized: 傷の手当てに使われる、簡素で清潔な包帯。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425443
    m_Localized: 止血包帯
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425444
    m_Localized: 強力な止血剤が塗布されており、重度の出血から軽度の出血まで止められる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425445
    m_Localized: 外用包帯
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425446
    m_Localized: 刺激の少ない外用医療ジェルが塗布されており、治癒を促進する。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425447
    m_Localized: Immunivaxの注射器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425448
    m_Localized: 「センチネル崩壊症候群」に伴う過剰な免疫反応を一時的に抑えるため開発された、高精度の免疫調整剤。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425449
    m_Localized: Synaprestの注射器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425450
    m_Localized: 薬物依存症に対する次世代治療薬。脳の報酬系を抑制して渇望を抑え、長期的な回復を支える。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425451
    m_Localized: 心理療法や社会的支援も行うことで、最大限の効果が得られる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425452
    m_Localized: Oxymoreの注射器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425453
    m_Localized: 激しい痛みを和らげ、多幸感を引き出す。合法ではあるが危険。過剰処方による依存症や過剰摂取が蔓延している。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425454
    m_Localized: Nomoreの注射器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425455
    m_Localized: Oxymoreの代わりとなる、依存性のない鎮痛剤。依存症や過剰摂取に至るリスクなく、効果的な鎮痛作用をもたらす。注射器を再利用した試作品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425456
    m_Localized: Naloxgoneの注射器
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425457
    m_Localized: Oxymoreの過剰摂取に対処するために使われる、緊急用の薬。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425460
    m_Localized: ガラスの刃物
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425461
    m_Localized: 鋭利なガラス片を布で包んだもの。武器として使える。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425462
    m_Localized: 戦闘ナイフ
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425463
    m_Localized: 軍用に設計されたナイフ。主に白兵戦や接近戦で使うことが想定されているが、実用的な用途にも使える。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425464
    m_Localized: カッターナイフ
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425465
    m_Localized: 刃先を引っ込められる、丈夫なカッターナイフ。建築や製作、倉庫作業でよく使われる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425466
    m_Localized: 肉切り包丁
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425467
    m_Localized: 包丁
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619520
    m_Localized: ステンレス鋼のナイフ。子供や上層世界の腹黒い主婦の手の届かないところに置くように。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619521
    m_Localized: 戦闘マチェット
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619522
    m_Localized: 戦い、生き残るために作られた頑丈なマチェット。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619523
    m_Localized: バール
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619524
    m_Localized: ステーションにいる熟練の漁り屋や理論物理学者が、頼りにしている道具。いざという時には武器にも使える。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619525
    m_Localized: 手斧
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619526
    m_Localized: 小型だが頑丈。水耕栽培園で、育てているものを取り除くのに使用できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619527
    m_Localized: 鉛管
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619528
    m_Localized: 重量のある鉛管。ステーションで水道管が全面改修されると、大量の余った鉛管が漁り屋と泥棒の手に渡った。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619529
    m_Localized: スタン警棒
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619530
    m_Localized: STUNモードとHARMモードを備えた、制式のスタン警棒。ステーション内の秩序維持に努める警察の必需品。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619531
    m_Localized: バッテリー
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619532
    m_Localized: 廃棄物を削減するため、使い捨てのバッテリーは共和国で違法とされている。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619533
    m_Localized: 大半の機械に対応する、基本的なエネルギー源。充電可能。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619534
    m_Localized: バッテリー（Mk. II）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619535
    m_Localized: 標準モデルを改良したもの。大きさも性能も向上し、口に入れた際の窒息の危険も高まっている。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619536
    m_Localized: 大半の機械に対応する、改良されたエネルギー源。充電可能。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619537
    m_Localized: 自己充電バッテリー
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619538
    m_Localized: 高度で希少なバッテリー。自己充電が可能。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619539
    m_Localized: ガラスの破片
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619543
    m_Localized: 懐中電灯
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619544
    m_Localized: 頑丈な懐中電灯。所持している場合、ゴミ捨て場で廃品漁りをしたときに怪我をする確率が低くなる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619545
    m_Localized: 新聞
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619546
    m_Localized: 新しい新聞。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619547
    m_Localized: 師匠の手引き
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619548
    m_Localized: 師匠から受け取ったメモをすべて保管できる本。便利！
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619549
    m_Localized: Hemingway識別ガイド
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619550
    m_Localized: 「Hemingway」の偽造タバコを見分けるためのガイド。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619551
    m_Localized: Hemingwayのカラーチェッカー
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619552
    m_Localized: 「Hemingway」公式の色見本。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619554
    m_Localized: プラズマカートリッジ鑑定ガイド
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619555
    m_Localized: プラズマカートリッジの適正価格を調べるためのガイド。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619558
    m_Localized: フードスタンプの識別についての手引き
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619559
    m_Localized: フードスタンプが本物か偽物かどうかを見分けるための、便利なガイド。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619560
    m_Localized: Immunivax評価ガイド
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619561
    m_Localized: 「Immunivax」注射器の状態を確実に調べるために必要な情報がそろっている。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619562
    m_Localized: 水の取引マニュアル
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619563
    m_Localized: 水の売買に関する情報がそろっている、便利なマニュアル。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619568
    m_Localized: 冶金マニュアル
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619571
    m_Localized: 賃貸契約書
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619572
    m_Localized: 大家と自分の署名が入った契約書。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619575
    m_Localized: 営業許可証
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619576
    m_Localized: 共和国から発行された許可証。下層世界で合法的に商売をするために必要。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619577
    m_Localized: 手書きメモ
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619578
    m_Localized: 手書きの簡単なメモ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619579
    m_Localized: 漁り屋のトークン
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619580
    m_Localized: 認められた証。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619581
    m_Localized: 漁り屋コミュニティから贈られたトークン。ショーケースに設置するたびに、漁り屋が来る確率が上がる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619582
    m_Localized: 書類入れ
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619583
    m_Localized: 書類、メモ、本、虫眼鏡などを収納できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619584
    m_Localized: ゴミ箱
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619585
    m_Localized: 清掃サービスを利用している場合、中に入れたアイテムが夜間に回収される。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619586
    m_Localized: 排水溝
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619587
    m_Localized: 不要な水はここに流せる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619588
    m_Localized: 蛇口
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619589
    m_Localized: 水が出ない……誰か、水道管につなげてくれないだろうか？
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619590
    m_Localized: 使い捨てカードキー（司令）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619591
    m_Localized: ステーションの司令部だけが所持している、マスターカードキー。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619592
    m_Localized: ステーションの司令部用の使い捨てカードキー。カードキーが必要な大半の仕組みを突破できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619593
    m_Localized: 使い捨てカードキー（警察）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619594
    m_Localized: 悪い人間の手に渡れば、危ないかもしれない……
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619595
    m_Localized: ステーションの警察用の使い捨てカードキー。保安部のアクセスが必要な仕組みを突破できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619596
    m_Localized: 使い捨てカードキー（研究開発）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619597
    m_Localized: ステーションの研究員が所持しているカードキー。貴重。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619598
    m_Localized: 研究開発用の使い捨てカードキー。科学部のアクセスが必要な仕組みを突破できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619599
    m_Localized: 使い捨てカードキー（医療）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619600
    m_Localized: ステーションの医療部用の使い捨てカードキー。医療部のアクセスが必要な仕組みを突破できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619601
    m_Localized: 使い捨てカードキー（エンジニア）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619602
    m_Localized: ステーションのエンジニア部用の使い捨てカードキー。エンジニア部のアクセスが必要な仕組みを突破できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619603
    m_Localized: 使い捨てカードキー（供給）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619604
    m_Localized: ステーションの供給部用の使い捨てカードキー。供給部のアクセスが必要な仕組みを突破できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619605
    m_Localized: 使い捨てカードキー（管理）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619606
    m_Localized: ステーションの管理部用の使い捨てカードキー。管理部のアクセスが必要な仕組みを突破できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619607
    m_Localized: 使い捨てカードキー（空白）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619608
    m_Localized: ステーションで見つかる中では、最もマスターカードキーに近い。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619609
    m_Localized: 何も書かれていないカードキー。適切な機械があれば、あらゆる種類のアクセス権を付与できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619610
    m_Localized: 名刺（ジョー・ワイルド）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619611
    m_Localized: 「何なりとお申し付けください」
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619612
    m_Localized: 名刺（レッド・インプ醸造所）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619613
    m_Localized: 「悪魔的なおいしさ！」
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619614
    m_Localized: 名刺（GP採掘協同組合）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619615
    m_Localized: GPが何の略なのか、もう誰も知らない。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619616
    m_Localized: 名刺（薬剤師）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619617
    m_Localized: 名前と電話番号だけが書かれた、とてもシンプルな名刺。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619618
    m_Localized: 名刺（化学者）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619619
    m_Localized: 電話番号が書かれた紙切れ。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619620
    m_Localized: 名刺（緑）
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619621
    m_Localized: 電話番号が書かれた、シンプルな緑の名刺。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619631
    m_Localized: 事案の控え
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619632
    m_Localized: 保安部が事案への対応後に出す控え。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619633
    m_Localized: 指名手配リスト
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619637
    m_Localized: フードスタンプ
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619638
    m_Localized: 売店で引き換えると、食品を購入できる。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619639
    m_Localized: 食料品の購入にだけ使えるプリペイドカード。下層世界の恵まれない住民を支援するための、福祉プログラムの一環。
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619640
    m_Localized: 鑑定委員会のジュニア認定証
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619644
    m_Localized: '音楽カセット - '
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619645
    m_Localized: ' （使用感なし）'
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619646
    m_Localized: ' （破損）'
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619647
    m_Localized: ' （損傷）'
    m_Metadata:
      m_Items: []
