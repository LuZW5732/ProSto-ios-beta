%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Item_de
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 93fe472e9fd181141974a1f58c3bef9e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 158976881508352
    m_Localized: „Uralte Alienrelikte“
    m_Metadata:
      m_Items: []
  - m_Id: 159203780771840
    m_Localized: Sieht aus wie Metallschrott. „Uralter Alien-Metallschrott“?
    m_Metadata:
      m_Items: []
  - m_Id: 158979263873024
    m_Localized: 100 % reines dehydriertes Wasser
    m_Metadata:
      m_Items: []
  - m_Id: 140582820036608
    m_Localized: Schachtel mit PAX-Tampons
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230912
    m_Localized: Hygieneartikel wie diese versprechen Schutz und Diskretion. Sie sind ein Luxus, den sich nur wenige Unterdeckler leisten können.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230913
    m_Localized: Schachtel mit Hemingway-Zigaretten
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230914
    m_Localized: Der luxuriöseste Nikotingenuss, den man sich vorstellen kann. Unvergesslich im Geschmack – und im Preis.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230915
    m_Localized: Schachtel mit REX-Kondomen
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230916
    m_Localized: Dank einem geförderten Verteilungsprogramm sind sie auf den Unterdecks überraschend verbreitet. Immerhin ist Geburtenkontrolle günstiger als die Bekämpfung von Unruhen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230917
    m_Localized: Flasche mit 4-in-1-Waschgel
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230918
    m_Localized: Shampoo, Spülung, Duschgel und Zahnpasta, alles in einer praktischen Flasche. Mit erfrischendem Nutrifrucht-Extrakt.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230919
    m_Localized: Zahnpastatube
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230920
    m_Localized: Eine hochwertige Zahnpasta für minzfrischen Atem.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230921
    m_Localized: Rolle Küchenkrepp
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230922
    m_Localized: Rolle Toilettenpapier
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230923
    m_Localized: Bezahlbares Toilettenpapier, reißfest und zuverlässig. Zweilagig ist auf den Unterdecks schon luxuriös.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230924
    m_Localized: Wassertestset
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230925
    m_Localized: Eine kleine Flasche mit Farbstreifen zum Testen von Wasserqualität.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230926
    m_Localized: Wasserteststreifen
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230927
    m_Localized: Ein Teststreifen, mit dem sich die Qualität einer Wasserprobe genauestens bestimmen lässt.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230928
    m_Localized: UV-Lampe
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230929
    m_Localized: Kann für Wasserbehälter verwendet werden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230930
    m_Localized: Eine Lampe, die ultraviolettes Licht ausstrahlt und damit Bakterien und andere Mikroorganismen abtötet.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230931
    m_Localized: AquaScan
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230932
    m_Localized: Ein Gerät, mit dem sich die Qualität einer Wasserprobe genauestens bestimmen lässt. Zeigt gefundene Verunreinigungen an.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230933
    m_Localized: Recycling-Scanner
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230934
    m_Localized: Ein Gerät, das deine Chance erhöht, bei deinen Recyclingtouren wertvolle Ausbeute zu finden. (Du kannst immer nur einen Recycling-Scanner verwenden.)
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230935
    m_Localized: Wolltest du schon immer mal ein drittes Auge? Oder eine zweite Nase? Mit dem Recycling-Scanner hast du das Gerümpel im Handumdrehen aussortiert!
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230936
    m_Localized: Flasche mit Wasserreinigungstabletten
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230937
    m_Localized: Eine kleine Flasche mit Tabletten zur Reinigung von Wasser.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230938
    m_Localized: Wasserreinigungstablette
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230939
    m_Localized: Eliminiert große Mengen mikrobieller Kontaminanten und reduziert chemische Verunreinigungen teilweise. Keine Wirkung gegen andere Kontaminierungsarten.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230946
    m_Localized: Kaumwollstoff
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230947
    m_Localized: Kann in chemischen Prozessen verwendet werden, um große Partikel aus Flüssigkeiten herauszufiltern. Nicht fein genug für die Wasserreinigung.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230948
    m_Localized: Ein vielseitiger Stoff aus organischen Fasern. Wird gewöhnlich zur Herstellung verstärkter Arbeitskleidung und schockabsorbierender Bandagen verwendet.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230949
    m_Localized: Wasserfilter
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230950
    m_Localized: Kann mit einem Filtersystem verwendet werden, um die Wasserreinheit geringfügig zu verbessern. Nur bis zu einem gewissen Grad effektiv.
    m_Metadata:
      m_Items: []
  - m_Id: 140582824230951
    m_Localized: Ein leichter Filter für den Privatgebrauch.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425224
    m_Localized: SYNC (Neuroaktiv-Parfüm)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425225
    m_Localized: Verbessert den Handelsbonus mit dem aktuellen Kunden um 15 %. Du kannst immer nur je ein Parfüm verwenden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425226
    m_Localized: Dieses Parfüm wurde von der Trauertherapieforschung entwickelt und verwendet eine adaptive Duft-Technologie, um positive persönliche Erinnerungen zu wecken. Wird gewöhnlich in der gehobenen Gastronomie vom Servicepersonal benutzt, da das damit erzielte Trinkgeld den hohen Preis des Parfüms mehr als wettmacht.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425227
    m_Localized: L’ESSENCE (Pheromonparfüm)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425228
    m_Localized: Verbessert den Handelsbonus mit dem aktuellen Kunden um 25 %. Du kannst immer nur je ein Parfüm verwenden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425229
    m_Localized: Ein illegaler Duft, der aus menschlichen Pheromonen hergestellt wurde. Er erhöht Attraktivität und emotionale Empfänglichkeit. Das Parfüm ist zwar illegal, wird aber von allen heiß begehrt, die sich in der gesellschaftlichen Hierarchie der Oberdecks nach oben arbeiten wollen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425230
    m_Localized: Schraubenzieher
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425231
    m_Localized: Der bescheidene Schraubenzieher, ein fester Bestandteil in den Schubladen von Bürgern der Unter- wie auch der Oberdecks.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425232
    m_Localized: Wenn du ihn bei dir trägst, erbeutest du beim Recyceln auf der Müllhalde 10 % mehr Schrauben.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425233
    m_Localized: Plasmaschneider
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425234
    m_Localized: Ein Hochfrequenz-Plasmaschneider. Garantiert stabil gefertigt, für einen schnellen, starken und sauberen Schnitt.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425235
    m_Localized: Kann zum Zerlegen von defekten Maschinen verwendet werden, um aus ihnen Metallschrott zu gewinnen. Wenn du ihn bei dir trägst, erbeutest du beim Recyceln auf der Müllhalde 10 % mehr Metallschrott.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425236
    m_Localized: Seitenschneider
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425237
    m_Localized: Die Federung sorgt für eine solide Hebelwirkung und reduziert den Druck für den Benutzer, während die weichen Gummigriffe guten Halt und Komfort gewährleisten.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425238
    m_Localized: Kann zum Zerlegen von defekten Maschinen verwendet werden, um aus ihnen Kabel zu gewinnen. Wenn du ihn bei dir trägst, erbeutest du beim Recyceln auf der Müllhalde 10 % mehr Kabel.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425241
    m_Localized: Etikettendrucker
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425242
    m_Localized: Damit kann das Etikett eines Gegenstands verändert werden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425243
    m_Localized: Lupe
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425244
    m_Localized: Damit können bestimmte Gegenstände näher untersucht werden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425245
    m_Localized: 'Neonschild: Wasser'
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425246
    m_Localized: Wenn du diesen Neonschriftzug in dein Schaufenster stellst, lockt er Kunden an, die Wasser verkaufen möchten.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425249
    m_Localized: Einweg-Turbobooster
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425250
    m_Localized: Ein Werkzeug, das sofort Geräte mit Strom versorgt, die über einen längeren Zeitraum arbeiten. Bevor du den Booster verwendest, solltest du alle nötigen Komponenten in das Gerät legen. Wird bei Benutzung verbraucht.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425251
    m_Localized: Fortschrittlicher Turbobooster
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425252
    m_Localized: Ein Werkzeug, das Geräte sofort mit Strom versorgt, die über einen längeren Zeitraum arbeiten. Bevor du den Booster verwendest, solltest du erst alle nötigen Komponenten in das Gerät legen. Lädt sich mit der Zeit wieder auf. Diese weiterentwickelte Version wird nach dem Einsatz nicht verbraucht.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425253
    m_Localized: Plastiksprengstoff
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425254
    m_Localized: Mit Vorsicht zu behandeln.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425255
    m_Localized: Plastiksprengstoff (scharf)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425256
    m_Localized: 3, 2, 1 … KAWUMM!!
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425257
    m_Localized: Rucksack (klein)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425258
    m_Localized: Ein kompakter, abgenutzter Rucksack mit verstärkten Nähten. Leicht, aber geräumig genug für essenzielle Vorräte.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425259
    m_Localized: Rucksack (normal)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425260
    m_Localized: Rucksack (Militär)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425261
    m_Localized: Ein strapazierfähiger Rucksack für Militärzwecke. Der Stoff ist so robust, dass manche Soldaten ihn im Kampf vor der Brust tragen, als zusätzlichen Schutz.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425262
    m_Localized: Rucksack (groß)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425265
    m_Localized: Tasche (klein)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425266
    m_Localized: Päckchen mit Nutrifruchtsamen
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425267
    m_Localized: Materialkiste (Security-Abteilung)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425268
    m_Localized: Eine verschlossene Kiste, laut Beschriftung für das Waffenlager der Security. Voller Zubehör. Öffnet sich nur mit Zugangskarte.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425269
    m_Localized: Materialkiste (Fertigungstechnik)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425270
    m_Localized: Eine verschlossene Kiste, laut Beschriftung für die Fertigungstechnik. Voller Zubehör. Öffnet sich nur mit Zugangskarte.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425271
    m_Localized: Die Helmträger dürften bereuen, ihr Werkzeug verloren zu haben …
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425272
    m_Localized: Materialkiste (Krankenstation)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425273
    m_Localized: Eine verschlossene Kiste, laut Beschriftung für die Krankenstation. Voller Zubehör. Öffnet sich nur mit Zugangskarte.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425274
    m_Localized: Wird schon niemanden das Leben kosten, wenn das hier verloren geht … oder?
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425275
    m_Localized: Asservatenschrank der Security
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425276
    m_Localized: Da ist genug drin, um die ganzen Unterdecks hinter Gitter zu bringen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425277
    m_Localized: Eine verschlossene Kiste, laut Beschriftung für den Asservatenschrank der Security. Wertvoll. Öffnet sich nur mit Zugangskarte.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425278
    m_Localized: Materialkiste (Service)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425279
    m_Localized: Eine Sicherheitskiste, laut Beschriftung für die Service-Abteilung der Station. Voller Zubehör. Öffnet sich nur mit Zugangskarte.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425280
    m_Localized: Die Service-Abteilung der Station verteilt Gebrauchsartikel an Bedürftige oder zahlende Bewohner.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425342
    m_Localized: Chemiezubehör (gewöhnlich)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425343
    m_Localized: Kann ausgepackt werden. Du erhältst Komponenten für einfache chemische Verfahren.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425344
    m_Localized: Eine Sammlung von gewöhnlichem Chemiezubehör, das man vermutlich im Baumarkt der Station finden könnte.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425345
    m_Localized: Chemiezubehör (reglementiert)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425346
    m_Localized: Kann ausgepackt werden. Du erhältst Komponenten für fortgeschrittene chemische Verfahren.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425347
    m_Localized: Eine Sammlung von nicht frei verkäuflichen Chemikalien zur Herstellung von Betäubungsmitteln oder Sprengstoff.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425348
    m_Localized: Medizinzubehör (gewöhnlich)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425349
    m_Localized: Eine Sammlung von gewöhnlichem Medizinzubehör, hauptsächlich frei verkäufliche Apothekenartikel.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425350
    m_Localized: Medizinzubehör (reglementiert)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425351
    m_Localized: Eine Sammlung von nicht frei verkäuflichem Medizinzubehör, das für die Krankenstation der Station benötigt wird.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425352
    m_Localized: Metallschrott
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425353
    m_Localized: Kann zu Metallerz eingeschmolzen werden. Da auf der Station nur begrenzt viele Ressourcen verfügbar sind, ist Wiederverwertung umso wichtiger.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425354
    m_Localized: Müll
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425355
    m_Localized: Defekter Schrott und nutzloser Unrat, der kaum zu recyceln ist und daher so gut wie keinen Wert hat.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425356
    m_Localized: Metallerz
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425358
    m_Localized: Elektronikteile (gewöhnlich)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425359
    m_Localized: 'Eine Auswahl diverser nützlicher, wenn auch alltäglicher Elektronik: Stecker, Schalter, Kondensatoren, Prozessoren und Verarbeitungseinheiten.'
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425360
    m_Localized: Elektronikteile (selten)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425361
    m_Localized: Eine Auswahl ungewöhnlicher, hochwertiger Elektronikteile. Ein gewisser Erfinder hätte daran sicher sehr großes Interesse.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425362
    m_Localized: Kabel
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425363
    m_Localized: Ein Bündel Stromkabel. Wurde wohl irgendwo „gefunden“ …
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425364
    m_Localized: 3D-Druck-Filament
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425365
    m_Localized: 'Eine Spule mit Premiumfilament, das in 3D-Druckern zum Einsatz kommt. Nach Möglichkeit aus recyceltem Plastik hergestellt. '
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425369
    m_Localized: Radioaktiver Abfall
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425370
    m_Localized: Radioaktiver Abfall. Mit Vorsicht zu behandeln.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425371
    m_Localized: Eine Ansammlung von gefährlichem radioaktiven Abfall. Um das Zeug will sich niemand kümmern.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425372
    m_Localized: Flussmittel (einfach)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425373
    m_Localized: Ein praktisches Zusatzmittel, das die Reinheit von Metallerz verbessert, wenn es während des Schmelzvorgangs zugeführt wird. Wird bei Benutzung verbraucht.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425374
    m_Localized: Flussmittel (fortgeschritten)
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425375
    m_Localized: 'Ein praktisches Zusatzmittel, das die Reinheit von Metallerz verbessert, wenn es während des Schmelzvorgangs zugeführt wird. Wiederverwendbar. '
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425408
    m_Localized: Taser
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425409
    m_Localized: Eine kompakte Elektroschockwaffe, die zur Selbstverteidigung und von Einsatzkräften verwendet wird. Verursacht einen schmerzhaften Stromschlag.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425410
    m_Localized: Antibabypille
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425411
    m_Localized: Ein Kontrazeptivum, das eine Schwangerschaft verhindern soll. Die Pille ist eine Kombination aus Östrogen und Progestinen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425421
    m_Localized: ZeroChew-Tablette
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425422
    m_Localized: Eine „ZeroChew“-Tablette; ein erschwinglicher Appetitzügler.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425423
    m_Localized: Wird von manchen Unterdecklern verwendet, um Credits zu sparen, indem sie Mahlzeiten auslassen. Auf den Oberdecks wird es unter dem Namen Regime-X als Medikament zur Gewichtsabnahme vermarktet.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425424
    m_Localized: Riechsalz
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425425
    m_Localized: Eine dünne Glasröhre, die Alkohol und Ammoniak enthält. Das Mittel hilft, nach einer Ohnmacht das Bewusstsein zurückzuerlangen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425426
    m_Localized: Blutkonserve
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425427
    m_Localized: Ein 500-ml-Beutel mit Transfusionsblut eines universellen, aber nicht unbedingt freiwilligen Spenders.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425428
    m_Localized: Beutel mit „blauem Blut“
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425429
    m_Localized: Ein injizierbares Biogel, das entwickelt wurde, um Arterienverkalkung und Mikrogerinnsel im Laufe der Zeit aufzulösen. Es verhindert effektiv Herzkranzgefäßerkrankungen, ischämische Schlaganfälle und Komplikationen bei Bluthochdruck.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425430
    m_Localized: Kein echtes Blut. Sogar auf den Oberdecks sehr selten.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425431
    m_Localized: Phiole mit „Traumstaub“
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425432
    m_Localized: Ein billiges, euphorisierendes Pulver, das auf den Unterdecks hergestellt wird. Wird verwendet, um der harten Realität des Stationslebens zumindest kurzzeitig zu entfliehen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425433
    m_Localized: Phiole mit „Albtraumstaub“
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425434
    m_Localized: Ein feines Pulver, das sowohl als Gift als auch als Halluzinogen dient. Einnahme oder Einatmen führt zu schwerer Übelkeit, Schwäche und Orientierungslosigkeit, gefolgt von entsetzlichen Halluzinationen. Hohe Dosen können tödlich sein.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425435
    m_Localized: Koffeinpille
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425436
    m_Localized: Diese Pillen wurden aus dem Abfall der Oberdeck-Espressobars hergestellt und sind unentbehrlich für lange Schichten auf den Unterdecks.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425437
    m_Localized: Nachtigallsalbe
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425438
    m_Localized: Hergestellt aus modifizierter Aloe und medizinischem Honig. Diese Salbe verfügt über antibakterielle Eigenschaften und fördert Zellgeneration und -wachstum.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425439
    m_Localized: Reinigungsalkohol
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425440
    m_Localized: Ein kraftvolles Desinfektionsmittel zum Reinigen von Wunden und Oberflächen. Obwohl es bei Einnahme hochgiftig ist, dient es auf den Unterdecks dennoch als Alternative zu Nudka.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425441
    m_Localized: Einfacher Verband
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425442
    m_Localized: Simples, sauberes Verbandsmaterial zum Bandagieren von Wunden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425443
    m_Localized: Blutstillender Verband
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425444
    m_Localized: Ein Verband mit einem starken hämostatischen Mittel, das schwere und leichte Blutungen stillen kann.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425445
    m_Localized: Topischer Verband
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425446
    m_Localized: Ein Verband mit einem milden topischen Gel, das den Heilvorgang beschleunigt.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425447
    m_Localized: Immunivax-Injektor
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425448
    m_Localized: Ein äußerst präziser Immuno-Regulator, der entwickelt wurde, um vorübergehend die hyperreaktive Immunantwort, die durch das Sentinel-Kollaps-Syndroms hervorgerufen wird, zu unterdrücken.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425449
    m_Localized: Synaprest-Injektor
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425450
    m_Localized: Eine hochmoderne Methode zur Behandlung von Drogenabhängigkeit. Sie wurde entwickelt, um das Belohnungssystem des Gehirns zu unterdrücken, das Suchtgefühl zu verringern und langfristige Genesung zu unterstützen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425451
    m_Localized: Optimal mit begleitender Psychotherapie und sozialer Unterstützung.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425452
    m_Localized: OxyMore-Injektor
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425453
    m_Localized: OxyMore ist ein legales, aber gefährliches Medikament, das zur Linderung starker Schmerzen dient und Euphorie auslöst. Aufgrund übermäßiger Verschreibung sind Sucht und Überdosen im Zusammenhang mit OxyMore weit verbreitet.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425454
    m_Localized: NoMore-Injektor
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425455
    m_Localized: Dient zur Schmerzlinderung, als nicht-suchterzeugende Alternative zu OxyMore. Bietet effektive schmerzstillende Wirkung, allerdings ohne das Risiko einer Abhängigkeit oder Überdosierung. Bei diesem Exemplar handelt es sich um einen Prototyp, der in einen umfunktionierten Injektor eingesetzt wurde.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425456
    m_Localized: Naloxgone-Injektor
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425457
    m_Localized: Naloxgone ist ein Notfallmedikament, das bei einer OxyMore-Überdosis als Gegenmaßnahme verwendet wird.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425460
    m_Localized: Glasmesser
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425461
    m_Localized: Eine scharfkantige Glasscherbe, die an einem Ende mit Stoff umwickelt wurde. Kann als Waffe verwendet werden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425462
    m_Localized: Kampfmesser
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425463
    m_Localized: Ein Kampfmesser, das primär für den Nahkampf bei militärischen Einsätzen entwickelt wurde, aber auch als Werkzeug nützlich sein kann.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425464
    m_Localized: Teppichmesser
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425465
    m_Localized: Ein robustes Werkzeugmesser mit ausfahrbarer Klinge, das gewöhnlich bei Handwerksarbeiten und in Lagerräumen verwendet wird.
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425466
    m_Localized: Fleischerbeil
    m_Metadata:
      m_Items: []
  - m_Id: 140582828425467
    m_Localized: Küchenmesser
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619520
    m_Localized: Ein Edelstahlmesser. Außer Reichweite von Kindern und durchtriebenen Hausfrauen auf den Oberdecks aufbewahren.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619521
    m_Localized: Kampfmachete
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619522
    m_Localized: Eine strapazierfähige Machete für Kampf -und Survivalzwecke.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619523
    m_Localized: Brechstange
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619524
    m_Localized: Das getreue Werkzeug jedes Recyclers und theoretischen Physikers auf der Station. Kann im Notfall auch als Waffe verwendet werden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619525
    m_Localized: Handbeil
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619526
    m_Localized: Klein, aber robust. Kann in Hydro-Farmen verwendet werden, um den aktuellen Bewuchs zu entfernen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619527
    m_Localized: Bleirohr
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619528
    m_Localized: Ein schweres Bleirohr. Nachdem die Wasserleitungen auf der Station ausgetauscht wurden, landeten tonnenweise Rohrreste in den Händen von Recyclern und Dieben.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619529
    m_Localized: Taserstock
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619530
    m_Localized: Ein Taserstock mit den Modi BETÄUBEN und VERLETZEN. Gehört zur Standardausrüstung von Security-Officers, die auf der Station die Ordnung aufrechterhalten.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619531
    m_Localized: Energiezelle
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619532
    m_Localized: Die Republik hat Einweg-Batterien verboten, um Müll zu reduzieren.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619533
    m_Localized: Eine einfache Energiequelle, die mit den meisten Geräten kompatibel ist. Wiederaufladbar.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619534
    m_Localized: Energiezelle (Typ II)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619535
    m_Localized: Die Typ-II-Zelle ist eine verbesserte Version des Standardmodells. Sie ist größer, besser und mit noch mehr Erstickungsgefahr verbunden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619536
    m_Localized: Eine verbesserte Energiequelle, die mit den meisten Geräten kompatibel ist. Wiederaufladbar.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619537
    m_Localized: Selbstladende Energiezelle
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619538
    m_Localized: Eine hochmoderne und seltene Energiezelle, die sich selbst aufladen kann.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619539
    m_Localized: Glasscherbe
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619543
    m_Localized: Taschenlampe
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619544
    m_Localized: Eine robuste Taschenlampe. Wenn du sie bei dir trägst, besteht bei deinen Recyclingtouren auf der Müllhalde ein geringeres Verletzungsrisiko.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619545
    m_Localized: Zeitung
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619546
    m_Localized: Eine aktuelle Zeitung.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619547
    m_Localized: Mentorenhandbuch
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619548
    m_Localized: Ein Buch, in dem du alle Notizen aufbewahren kannst, die der Mentor dir gegeben hat. Praktisch!
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619549
    m_Localized: 'Identifizierungsleitfaden: Hemingway'
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619550
    m_Localized: Ein Leitfaden, der dir dabei hilft, gefälschte Hemingway-Zigaretten zu erkennen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619551
    m_Localized: Hemingway-Farbkontrollkarte
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619552
    m_Localized: Eine offizielle Hemingway-Farbmusterkarte.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619554
    m_Localized: 'Leitfaden zur Wertermittlung: Plasmakartuschen'
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619555
    m_Localized: Ein Leitfaden, der helfen soll, den Wert von Plasmakartuschen abzuschätzen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619558
    m_Localized: 'Identifizierungsleitfaden: Lebensmittelmarken'
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619559
    m_Localized: Ein praktischer Leitfaden, mit dem sich echte Lebensmittelmarken von Fälschungen unterscheiden lassen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619560
    m_Localized: 'Leitfaden zur Wertermittlung: Immunivax'
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619561
    m_Localized: Enthält alle wichtigen Informationen, mit denen sich der Zustand von Immunivax-Injektoren zuverlässig einschätzen lässt.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619562
    m_Localized: Handbuch für Wasserhandel
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619563
    m_Localized: Ein praktisches Handbuch, das alle Informationen zum An- und Verkauf von Wasser enthält.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619568
    m_Localized: Handbuch für Metallurgie
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619571
    m_Localized: Mietvertrag
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619572
    m_Localized: Deine Mietvereinbarung, unterzeichnet von dir und deinem Vermieter.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619575
    m_Localized: Gewerbeschein
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619576
    m_Localized: Eine von der Republik ausgestellte Genehmigung. Du benötigst sie, um auf den Unterdecks ein Gewerbe ausüben zu dürfen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619577
    m_Localized: Notiz
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619578
    m_Localized: Eine einfache, handschriftliche Anmerkung.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619579
    m_Localized: Recycler-Symbol
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619580
    m_Localized: Eine Art Erkennungszeichen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619581
    m_Localized: Ein Symbol, das von der Recycler-Community verbreitet wird. Jedes Symbol, das du in deinem Schaufenster ausstellst, erhöht die Chance, dass Recycler deinen Laden besuchen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619582
    m_Localized: Dossier
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619583
    m_Localized: Zur Aufbewahrung von Dokumenten, Notizen, Büchern und Lupen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619584
    m_Localized: Mülleimer
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619585
    m_Localized: Alle enthaltenen Gegenstände werden nachts entfernt, solange du den Hausmeisterservice bezahlst.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619586
    m_Localized: Abfluss
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619587
    m_Localized: Hier kann überschüssiges Wasser entsorgt werden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619588
    m_Localized: Wasserhahn
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619589
    m_Localized: Kein Wasser. Vielleicht kann dir jemand helfen, an die Wasserleitung angeschlossen zu werden?
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619590
    m_Localized: Einweg-Keycard (Kommando)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619591
    m_Localized: Eine universelle Keycard, die dem Stationskommando vorbehalten sein sollte.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619592
    m_Localized: Eine Einweg-Keycard für das Stationskommando. Kann die meisten Schlösser öffnen, für die eine Keycard benötigt wird.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619593
    m_Localized: Einweg-Keycard (Security)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619594
    m_Localized: Gefährlich, wenn sie in die falschen Hände gerät.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619595
    m_Localized: Eine Einweg-Keycard für die Security der Station. Kann Schlösser öffnen, zu denen die Security-Abteilung Zugang hat.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619596
    m_Localized: Einweg-Keycard (Forschung)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619597
    m_Localized: Eine Keycard für Forscher der Station. Wertvoll.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619598
    m_Localized: Eine Einweg-Keycard des Forschungslabors. Kann Schlösser öffnen, zu denen die Forschungsabteilung Zugang hat.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619599
    m_Localized: Einweg-Keycard (Medizin)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619600
    m_Localized: Eine Einweg-Keycard für die Medizinabteilung der Station. Kann Schlösser öffnen, zu denen die Medizinabteilung Zugang hat.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619601
    m_Localized: Einweg-Keycard (Technik)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619602
    m_Localized: Eine Einweg-Keycard für die Technikabteilung der Station. Kann Schlösser öffnen, zu denen die Technikabteilung Zugang hat.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619603
    m_Localized: Einweg-Keycard (Versorgung)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619604
    m_Localized: Eine Einweg-Keycard für die Versorgungsabteilung der Station. Kann Schlösser öffnen, zu denen die Versorgungsabteilung Zugang hat.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619605
    m_Localized: Einweg-Keycard (Service)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619606
    m_Localized: Eine Einweg-Keycard für die Service-Abteilung der Station. Kann Schlösser öffnen, zu denen die Serviceabteilung Zugang hat.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619607
    m_Localized: Einweg-Keycard (blanko)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619608
    m_Localized: Quasi ein Generalschlüssel für die Station.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619609
    m_Localized: Eine noch unbenutzte Keycard. Mit dem passenden Gerät kann sie mit beliebigen Zugangsdaten neu programmiert werden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619610
    m_Localized: Visitenkarte (Joe Wild)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619611
    m_Localized: Stets zu Diensten.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619612
    m_Localized: Visitenkarte (Red-Imp-Brauerei)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619613
    m_Localized: Teuflisch gut.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619614
    m_Localized: Visitenkarte (GP Mining Coop)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619615
    m_Localized: Inzwischen weiß kaum noch jemand, wofür „GP“ eigentlich steht.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619616
    m_Localized: Visitenkarte (Apotheker)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619617
    m_Localized: Eine sehr schlichte Karte, auf der nur ein Name und eine Telefonnummer stehen.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619618
    m_Localized: Visitenkarte (Chemiker)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619619
    m_Localized: Eigentlich nur ein Zettel mit einer Telefonnummer.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619620
    m_Localized: Visitenkarte (grün)
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619621
    m_Localized: Eine schlichte grüne Visitenkarte mit einer Telefonnummer.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619631
    m_Localized: Vorfallmeldung
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619632
    m_Localized: Eine Bescheinigung der Security-Abteilung, nachdem sie auf einen Vorfall reagiert hat.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619633
    m_Localized: Fahndungsliste der Security
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619637
    m_Localized: Lebensmittelmarke
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619638
    m_Localized: Kann im Markt zum Kauf von Lebensmitteln eingelöst werden.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619639
    m_Localized: Eine Prepaidkarte, mit der nur Lebensmittel gekauft werden können. Teil einer Sozialhilfemaßnahme zur Unterstützung der Bedürftigen auf den Unterdecks.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619640
    m_Localized: Junior-Zertifikat des Gutachterausschusses
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619644
    m_Localized: 'Musikkassette '
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619645
    m_Localized: ' (tadellos)'
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619646
    m_Localized: ' (beschädigt)'
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619647
    m_Localized: ' (defekt)'
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619648
