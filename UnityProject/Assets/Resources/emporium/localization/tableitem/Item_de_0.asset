    m_Metadata:
      m_Items: []
  - m_Id: 79460289510948880
    m_Localized: Die sterilisierte Haut eines Transgen-Tilapias. Stillt Blutungen und sorgt dafür, dass Wunden sich schließen.
    m_Metadata:
      m_Items: []
