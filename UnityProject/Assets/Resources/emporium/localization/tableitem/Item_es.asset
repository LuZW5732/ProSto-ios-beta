      m_Items: []
  - m_Id: 140582832619577
    m_Localized: Nota
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619578
    m_Localized: Una notita escrita a mano.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619579
    m_Localized: Medalla de residuero
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619580
    m_Localized: Un símbolo de reconocimiento.
    m_Metadata:
      m_Items: []
  - m_Id: 140582832619581
    m_Localized: Una medalla otorgada por la comunidad de residueros. Cada medalla que pongas en el expositor aumentará las probabilidades de que aparezca un residuero por la tienda.
    m_Metadata:
      m_Items: []
