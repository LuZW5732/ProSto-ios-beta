    m_Localized: Startvorteile
    m_Metadata:
      m_Items: []
  - m_Id: 101041931161485312
    m_Localized: 'Verfügbare Vorteile:'
    m_Metadata:
      m_Items: []
  - m_Id: 101042014783324160
