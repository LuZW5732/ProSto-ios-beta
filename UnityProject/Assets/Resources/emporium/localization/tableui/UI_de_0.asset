      m_Items: []
  - m_Id: 184275725380796425
    m_Localized: '{0} enthält Assemblys mit dem gleichen Namen wie ihre Gegenstücke, die im Originalspiel selbst enthalten sind, und kann daher nicht aktiviert werden: {1}'
