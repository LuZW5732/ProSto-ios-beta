      m_Items: []
  - m_Id: 184275725384990721
    m_Localized: "{0} verwendet Funktionen, die nicht im Manifest gelistet sind:\n{1}\n\nErsteller*in muss das Manifest aktualisieren. Weitere Details siehe Konsole (Mod-Scan)."
    m_Metadata:
      m_Items: []
