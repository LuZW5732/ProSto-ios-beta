  - m_Id: 77168739401728
    m_Localized: すべてのアイテムを移動させる
    m_Metadata:
      m_Items: []
  - m_Id: 77365632614400
    m_Localized: 今は客を帰せない
    m_Metadata:
      m_Items: []
  - m_Id: 77786434551808
