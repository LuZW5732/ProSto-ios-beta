    m_Localized: Menu główne
    m_Metadata:
      m_Items: []
  - m_Id: 55856922935296
    m_Localized: Wyjdź z gry
    m_Metadata:
      m_Items: []
  - m_Id: 58797314588672
    m_Localized: Bieżąca liczba kredytów
    m_Metadata:
      m_Items: []
  - m_Id: 59349180137472
    m_Localized: Czekaj
    m_Metadata:
      m_Items: []
  - m_Id: 59446253109248
    m_Localized: Odeślij wszystkich oczekujących klientów i zakończ dzień
    m_Metadata:
      m_Items: []
  - m_Id: 59613819748352
    m_Localized: Nie możesz zakończyć dnia, w kolejce czekają ważne osoby
    m_Metadata:
      m_Items: []
  - m_Id: 59636871643136
    m_Localized: Zacznij dzień
    m_Metadata:
      m_Items: []
  - m_Id: 59652143104000
    m_Localized: Dzień się skończył
    m_Metadata:
      m_Items: []
  - m_Id: 60775671316480
    m_Localized: Sprawdź kalendarz
    m_Metadata:
      m_Items: []
  - m_Id: 62907535376384
    m_Localized: Otwórz tablet
    m_Metadata:
      m_Items: []
  - m_Id: 63130466828288
    m_Localized: Nie możesz teraz wezwać następnego klienta
    m_Metadata:
      m_Items: []
  - m_Id: 63189254193152
    m_Localized: Nie możesz wezwać następnego klienta, sklep jest zamknięty
    m_Metadata:
      m_Items: []
  - m_Id: 63233680261120
    m_Localized: Odpraw klienta i wezwij następnego
    m_Metadata:
      m_Items: []
  - m_Id: 63266530050048
    m_Localized: Nie możesz teraz odprawić klienta
    m_Metadata:
      m_Items: []
  - m_Id: 63322666614784
    m_Localized: Wezwij następnego klienta
    m_Metadata:
      m_Items: []
  - m_Id: 64156087402496
    m_Localized: 'Liczba klientów w kolejce: {count}'
    m_Metadata:
      m_Items: []
  - m_Id: 77168739401728
    m_Localized: Przenieś wszystkie przedmioty
    m_Metadata:
      m_Items: []
  - m_Id: 77365632614400
    m_Localized: Nie możesz teraz odprawić klienta
    m_Metadata:
      m_Items: []
  - m_Id: 77786434551808
    m_Localized: Odpraw klienta i nie wzywaj następnego
    m_Metadata:
      m_Items: []
  - m_Id: 78076277735424
    m_Localized: Klient został już zgłoszony
    m_Metadata:
      m_Items: []
  - m_Id: 78589987700736
    m_Localized: Klient nie może zostać zgłoszony
    m_Metadata:
      m_Items: []
  - m_Id: 78608509747200
    m_Localized: Poproś Ochronę o pomoc
    m_Metadata:
      m_Items: []
  - m_Id: 79608394072064
    m_Localized: Rejestrator
    m_Metadata:
      m_Items: []
  - m_Id: 79732914569216
