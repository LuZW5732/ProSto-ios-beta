  - m_Id: 1101928160083990
    m_Localized: Химическое загрязнение
    m_Metadata:
      m_Items: []
  - m_Id: 1101928160083991
    m_Localized: Физическое загрязнение
    m_Metadata:
      m_Items: []
  - m_Id: 1101928160083992
