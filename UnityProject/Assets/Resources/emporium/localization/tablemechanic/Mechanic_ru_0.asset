    m_Localized: Старая особь
    m_Metadata:
      m_Items: []
  - m_Id: 10105848266014722
    m_Localized: Взрослая особь
    m_Metadata:
      m_Items: []
  - m_Id: 10105848266014723
    m_Localized: Подросток
    m_Metadata:
      m_Items: []
  - m_Id: 10105848266014724
    m_Localized: Детёныш
    m_Metadata:
      m_Items: []
  - m_Id: 10105848266014725
    m_Localized: Младенец
    m_Metadata:
      m_Items: []
  - m_Id: 10105848266014726
    m_Localized: Неизвестно
    m_Metadata:
      m_Items: []
  - m_Id: 10105848266014727
