  - m_Id: 34255712394461188
    m_Localized: Menace
    m_Metadata:
      m_Items: []
  - m_Id: 36801691844919296
    m_Localized: Lancer la fermentation
    m_Metadata:
      m_Items: []
  - m_Id: 36801691865890816
    m_Localized: Fermentation en cours...
    m_Metadata:
      m_Items: []
  - m_Id: 36801691865890817
    m_Localized: Ingrédients
    m_Metadata:
      m_Items: []
  - m_Id: 36801691865890818
    m_Localized: Pas assez d'ingrédients
    m_Metadata:
      m_Items: []
  - m_Id: 36801691865890819
