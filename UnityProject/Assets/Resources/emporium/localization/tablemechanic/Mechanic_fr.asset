    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189843
    m_Localized: réussie
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189844
    m_Localized: médiocre
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189845
    m_Localized: catastrophique
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189846
    m_Localized: Ça me semble impeccable.
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189847
    m_Localized: Merci.
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189848
    m_Localized: Hmm, je vois.
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189849
    m_Localized: Je m'attendais à plus...
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189850
    m_Localized: Vous avez sans doute raison.
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189851
    m_Localized: C'est un peu moins que ce que je pensais.
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189852
    m_Localized: Ça me convient.
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189853
    m_Localized: Ça me va très bien.
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189854
    m_Localized: Je m'attendais à moins !
    m_Metadata:
      m_Items: []
  - m_Id: 1652355226189855
    m_Localized: C'est un peu plus que prévu.
    m_Metadata:
      m_Items: []
