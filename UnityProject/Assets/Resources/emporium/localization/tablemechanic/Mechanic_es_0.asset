    m_Localized: Fermentando… Faltan {0} días para terminar el proceso.
    m_Metadata:
      m_Items: []
  - m_Id: 40354925092061184
    m_Localized: Se acepta siempre.
    m_Metadata:
      m_Items: []
  - m_Id: 40354925159170048
    m_Localized: 'Probabilidad de aceptación: {0} %'
    m_Metadata:
      m_Items: []
  - m_Id: 40354925159170049
