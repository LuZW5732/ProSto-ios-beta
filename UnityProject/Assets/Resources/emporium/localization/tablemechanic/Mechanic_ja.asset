  - m_Id: 89091263672664064
    m_Localized: '{0}：{1}ul（-{2}ul/日）'
    m_Metadata:
      m_Items: []
  - m_Id: 89091263672664065
    m_Localized: 検査レポート
    m_Metadata:
      m_Items: []
  - m_Id: 89091263672664066
    m_Localized: 押収品1点：{0}。
    m_Metadata:
      m_Items: []
  - m_Id: 89091263672664067
    m_Localized: 押収品{0}点：{1}。
    m_Metadata:
      m_Items: []
