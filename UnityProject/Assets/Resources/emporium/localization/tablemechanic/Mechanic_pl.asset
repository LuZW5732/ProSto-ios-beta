    m_Metadata:
      m_Items: []
  - m_Id: 83314682731741188
    m_Localized: 'Wyjściowy rozmiar wyposażenia ({0}): {1}/{2}'
    m_Metadata:
      m_Items: []
  - m_Id: 84419578398818304
    m_Localized: 'Automatyczne mieszanie: wł.'
    m_Metadata:
