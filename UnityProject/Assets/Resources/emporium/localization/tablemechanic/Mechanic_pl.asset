    m_Metadata:
      m_Items: []
  - m_Id: 79300065948909568
    m_Localized: Filtry
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464002
    m_Localized: Wymieszaj
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464003
    m_Localized: Brak akwarium
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464005
    m_Localized: 'Odpady: {0}%'
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464006
    m_Localized: 'W środku: {0:plural:{} żyje|{} żyją|{} żyje}'
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464008
    m_Localized: '{0:plural:{} jajeczko|{} jajeczka|{} jajeczek}'
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464009
    m_Localized: '{0:plural:{} jajeczko wykluje|{} jajeczka wyklują|{} jajeczek wykluje} się za {1:plural:{} dzień|{} dni|{} dni}'
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464010
    m_Localized: '{0:plural:{} osobnik z narybku dojrzeje|{} osobniki z narybku dojrzeją|{} osobników z narybku dojrzeje} za {1:plural:{} dzień|{} dni|{} dni}'
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464014
    m_Localized: 'Dieta: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464021
    m_Localized: Kolejny etap życia za {0:plural:{} dzień|{} dni|{} dni}
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464022
    m_Localized: Starość za {0:plural:{} dzień|{} dni|{} dni}
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464027
    m_Localized: Głoduje
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464028
    m_Localized: Brak wody
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464029
    m_Localized: Mało wody
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464034
    m_Localized: Jakość śmieciowa
    m_Metadata:
      m_Items: []
  - m_Id: 79300065982464039
    m_Localized: 'Mięso: {0} kcal'
    m_Metadata:
      m_Items: []
  - m_Id: 82891237053218816
    m_Localized: Otrzymujesz dywidendę za udziały ({0}). Czeka na ladzie.
    m_Metadata:
      m_Items: []
  - m_Id: 82891237086773248
    m_Localized: Zamknięte
    m_Metadata:
