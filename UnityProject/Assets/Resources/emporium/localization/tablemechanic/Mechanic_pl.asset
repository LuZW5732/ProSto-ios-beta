  - m_Id: 1081528109809664
    m_Localized: '[Etykieta]'
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586880
    m_Localized: Te papierosy są podrabiane!
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586881
    m_Localized: Mamy tu problem z {0}. Widzisz?
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586882
    m_Localized: tekstem
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586883
    m_Localized: kolorystyką
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586884
    m_Localized: plombą
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586885
    m_Localized: logo
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586886
    m_Localized: pudełkiem
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586887
    m_Localized: Ach, tak, rzeczywiście.
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586888
    m_Localized: Obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586889
    m_Localized: Sprawdź jeszcze raz, wszystko się zgadza.
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586891
    m_Localized: Ach, Georgio nie miał o tym pojęcia.
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586892
    m_Localized: Georgio obniży cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586893
    m_Localized: Z tymi papierosami wszystko jest nie tak.
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586894
    m_Localized: Dobrze, już dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586895
    m_Localized: To =oryginał.
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586896
    m_Localized: Naprawdę? Dzięki za informację!
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586897
    m_Localized: Nie, nieprawda. Wszystko [g:sam sprawdziłem|sama sprawdziłam].
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586898
    m_Localized: Edycja {0}
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586899
    m_Localized: Kartka żywnościowa ({0:plural:{} kredyt|{} kredyty|{} kredytów})
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586900
    m_Localized: wartością
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586901
    m_Localized: czipem
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586903
    m_Localized: Naprawdę? Nie [g:miałem|miałam] pojęcia.
    m_Metadata:
      m_Items: []
  - m_Id: 1081528126586904
    m_Localized: Obniżę cenę.
    m_Metadata:
      m_Items: []
