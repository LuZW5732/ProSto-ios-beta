      m_Items: []
  - m_Id: 36801691865890817
    m_Localized: Zutat
    m_Metadata:
      m_Items: []
  - m_Id: 36801691865890818
    m_Localized: Nicht genug Zutaten, um Gärvorgang zu starten
    m_Metadata:
      m_Items: []
  - m_Id: 36801691865890819
    m_Localized: Nicht genug Wasser, um Gärvorgang zu starten
    m_Metadata:
      m_Items: []
