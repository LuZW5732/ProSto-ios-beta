    m_Metadata:
      m_Items: []
  - m_Id: 88617575483490315
    m_Localized: 'Ladetempo: {0} pro Zyklus (Stufe {1}), zieht {0} kJ aus seiner Energiezelle'
    m_Metadata:
      m_Items: []
  - m_Id: 88617575483490316
    m_Localized: Verwende einen fortschrittlichen Turbobooster darauf, um Ladetempo und Stromverbrauch dauerhaft zu erhöhen.
    m_Metadata:
      m_Items: []
