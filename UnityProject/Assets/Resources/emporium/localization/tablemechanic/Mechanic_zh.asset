    m_Metadata:
      m_Items: []
  - m_Id: 85507791909601284
    m_Localized: '{0}：加收估值的{1}%'
    m_Metadata:
      m_Items: []
  - m_Id: 85507791909601285
    m_Localized: '{0}：拒绝受理'
    m_Metadata:
      m_Items: []
  - m_Id: 85507791909601286
    m_Localized: 鉴定顾客来访概率：每天{0}%
    m_Metadata:
      m_Items: []
