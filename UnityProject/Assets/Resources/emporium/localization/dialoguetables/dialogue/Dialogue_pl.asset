%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Dialogue_pl
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: e74d80136420ae64d8590b92c6911c88, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 84253943287037952
    m_Localized: Roczne oprocentowanie wynosi {0}%
    m_Metadata:
      m_Items: []
  - m_Id: 84253943316398080
    m_Localized: Musisz płacić {0:plural:{} kredyt|{} kredyty|{} kredytów} co tydzień przez {1:plural:{} tydzień|{} tygodnie|{} tygodni}
    m_Metadata:
      m_Items: []
  - m_Id: 335890120228864
    m_Localized: Cześć! To ja, Georgio!
    m_Metadata:
      m_Items: []
  - m_Id: 336281029361664
    m_Localized: Tak, *ten* Georgio.
    m_Metadata:
      m_Items: []
  - m_Id: 420216455348224
    m_Localized: NAJLEPSZY złomiarz na Niższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542528
    m_Localized: Masz szczęście. Georgio przyniósł ci najnowszy skarb.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542529
    m_Localized: Popatrz! Relikty starożytnej cywilizacji obcych…
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542530
    m_Localized: Dobrze. Nawet fantastycznie!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542531
    m_Localized: Do następnego znaleziska!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542532
    m_Localized: Czekaj? Co Georgio zrobił?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542533
    m_Localized: Cicho, staruszku. Idziesz z nami.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542534
    m_Localized: Witam ponownie!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542535
    m_Localized: Pamiętasz mnie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542536
    m_Localized: Dzisiaj Georgio przynosi swój własny wynalazek…
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542537
    m_Localized: Georgio chciał dać ci szanse pierwokupu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542538
    m_Localized: Oto… woda przyszłości!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542539
    m_Localized: Georgio wrócił!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542540
    m_Localized: Znalazłem w 100% oryginalne papierosy heminwai,
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542541
    m_Localized: Chcesz kupić?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542542
    m_Localized: Specjalna cena dla przyjaciół.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542543
    m_Localized: Tak, tak!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542544
    m_Localized: Do zobaczenia wkrótce!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542545
    m_Localized: Nie, czekaj! Georgio jest niewinny!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542546
    m_Localized: Gadaj zdrów, idziesz z nami.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542547
    m_Localized: A kto to?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542548
    m_Localized: Georgio powraca!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542549
    m_Localized: Georgio grzebał na Wyższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542550
    m_Localized: A co można wygrzebać na Wyższych Poziomach?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542551
    m_Localized: Dla ciebie? Georgio da przecenę 25% na wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542552
    m_Localized: Tak, tak, bardzo dobrze!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542553
    m_Localized: Żegnaj!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542554
    m_Localized: Georgio przyniesie ci więcej skarbów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542555
    m_Localized: O, nie, nie, nie znowu!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542556
    m_Localized: Hej! To ten staruszek, który włamał się do damskiej łaźni na Wyższych Poziomach!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542557
    m_Localized: Pójdziesz z nami.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542558
    m_Localized: Witaj ponownie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542559
    m_Localized: Georgio powrócił.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542560
    m_Localized: Popatrz, co Georgio przyniósł.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542561
    m_Localized: Interesujące, co?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542562
    m_Localized: Skąd to masz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542563
    m_Localized: Porządny złomiarz nie zdradza sekretów!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542564
    m_Localized: Chcesz to? Czy nie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542565
    m_Localized: Georgio znajdzie innego kupca…
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542566
    m_Localized: Aha! Georgio wiedział, że kupisz!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542567
    m_Localized: Do zobaczenia!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542568
    m_Localized: Oszczędzaj kredyty dla Georgia!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542569
    m_Localized: Co? Donosisz na Georgia?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542570
    m_Localized: No proszę. Jesteś aresztowany.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542571
    m_Localized: Jak udaje ci się włamywać do magazynu dowodowego?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542572
    m_Localized: Georgio to przyjaciel, tak?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542573
    m_Localized: Zauważył zostawione przez ciebie rzeczy wczoraj na śmietnisku…
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542574
    m_Localized: Czy je sobie wziął? Nie! Przyniósł je tu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542575
    m_Localized: Nie trzeba, dziękuję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542576
    m_Localized: O, jesteś.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542577
    m_Localized: Georgio potrzebuje pomocy…
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542578
    m_Localized: Buduje statek kosmiczny! By myszkować po naszym układzie…
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542579
    m_Localized: Jest prawie skończony, ale… Georgiowi skończyły się kredyty.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542580
    m_Localized: Pomożesz Georgio, proszę?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542581
    m_Localized: Serio? Ale łatwo!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542582
    m_Localized: Proszę. Georgio nie będzie tego potrzebował…
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542583
    m_Localized: Odda ci to z nawiązką! To gwarancja Georgia!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542584
    m_Localized: Do zobaczenia wśród gwiazd.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542585
    m_Localized: Na pewno? Dziękuję, dziękuję!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542586
    m_Localized: Proszę, dla ciebie. Georgio już nie potrzebuje…
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542587
    m_Localized: Nie widzę… w tym problemu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542588
    m_Localized: Georgio znajdzie, czego potrzebuje do skończenia statku na śmietnisku!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542589
    m_Localized: Zdrowia życzę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542590
    m_Localized: Nie… proszę! Zlitujcie się nad Georgiem!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542591
    m_Localized: Możesz zachować milczenie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542592
    m_Localized: Pójdziesz z nami!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542593
    m_Localized: Nie, twoje oczy cię nie zwodzą!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542594
    m_Localized: Georgio powrócił z gwiazd!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542595
    m_Localized: Oto twoje kredyty, z nawiązką!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542596
    m_Localized: A teraz Georgio wróci na statek…
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542597
    m_Localized: Wszechświat sam się nie przeszuka!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542598
    m_Localized: Witaj, przybywam z Centralnych Sektorów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542599
    m_Localized: Chcę spróbować każdej potrawy w galaktyce.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542600
    m_Localized: Kupię po jednej sztuce każdego rodzaju żywności i picia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542601
    m_Localized: Dam ci dwa dni na przygotowanie się.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542602
    m_Localized: Dobre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542603
    m_Localized: Umowa stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542604
    m_Localized: Do zoba.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542605
    m_Localized: JA CHCĘ TYLKO KUPIĆ JEDZENIE!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542606
    m_Localized: Cisza, pójdziesz z nami!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542607
    m_Localized: To znowu ja.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542608
    m_Localized: Chcę spróbować każdej potrawy w galaktyce.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542609
    m_Localized: Kupię po jednej sztuce każdego rodzaju żywności i picia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542610
    m_Localized: Zapłacę więcej za różnorodność.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542611
    m_Localized: Hej, chcę to szybko sprzedać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542612
    m_Localized: Przyciągam za dużo uwagi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542613
    m_Localized: Witaj, tu oficer Lun.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542614
    m_Localized: Jestem na patrolu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542615
    m_Localized: Ale zapomniałem wałówki. Masz jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542616
    m_Localized: Pewnie, wezmę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542617
    m_Localized: Nie, chcę jedzenie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542618
    m_Localized: Wystarczy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542619
    m_Localized: Pomocy! Potrzebuję lekarstwa!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542620
    m_Localized: Napadł na mnie jakiś koleś w szarym dresie!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542621
    m_Localized: Daj mi coś mocnego, nieważne, czy to kontrabanda!
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542622
    m_Localized: Nieoficjalnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542623
    m_Localized: Tak, dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542624
    m_Localized: Nie, potrzebuję czegoś na ból.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542625
    m_Localized: Kurna, dobra!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736832
    m_Localized: To powinno pomóc.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736833
    m_Localized: Hej, ja… mam coś takiego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736834
    m_Localized: Kupujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736835
    m_Localized: Umowa stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736836
    m_Localized: Czekaj, co?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736837
    m_Localized: Hej! Ten koleś napadł na oficera Luna!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736838
    m_Localized: Brać go!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736839
    m_Localized: Kurde.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736840
    m_Localized: Cześć, wróciłem do pracy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736841
    m_Localized: Po krótkich wakacjach w ambulatorium.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736842
    m_Localized: Tu rutynowa kontrola.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736843
    m_Localized: A skoro tu jestem, kupię coś na ból.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736844
    m_Localized: Coś mocnego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736845
    m_Localized: Tylko awaryjnie, oczywiście…
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736846
    m_Localized: Umowa stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736847
    m_Localized: Dzięki. Chyba. Drogie to.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736848
    m_Localized: Nie, nie takich leków szukam.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736849
    m_Localized: Nie tego mi trzeba.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736850
    m_Localized: I nie stać mnie na to.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736851
    m_Localized: Pewnie, wezmę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736852
    m_Localized: Tak, dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736853
    m_Localized: Hej, to twój szczęśliwy dzień.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736854
    m_Localized: Zaopatrzenie zaaprobowało sprzedaż… zbędnych przedmiotów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736855
    m_Localized: Reflektujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736856
    m_Localized: Oczywiście w tajemnicy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736857
    m_Localized: Mogę dać ci zniżkę 33%, jeśli weźmiesz wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736858
    m_Localized: Bardzo dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736859
    m_Localized: Czekaj!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736860
    m_Localized: Oficerze Lun? Co się dzieje?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736861
    m_Localized: To brakujący sprzęt ze zbrojowni!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736862
    m_Localized: Czekaj… Wyjaśnię!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736863
    m_Localized: Tylko spokojnie, oficerze. Wiesz, co się może stać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736864
    m_Localized: Nagła kontrola!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736865
    m_Localized: Otwierać, teraz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736866
    m_Localized: Mam narkotyki, wszystko konfiskujemy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736867
    m_Localized: Hej, bez narzekania. Moglibyśmy i ciebie zabrać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736868
    m_Localized: '<i>*wzdycha*</i> Czysto.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736869
    m_Localized: Hmm?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736870
    m_Localized: Oficerze Lun, co tu robisz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736871
    m_Localized: Ja… eee… przeprowadzam nagłą kontrolę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736872
    m_Localized: Miałeś siedzieć za biurkiem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736873
    m_Localized: Wiemy, co kombinujesz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736874
    m_Localized: Aresztujemy cię za przekroczenie uprawnień.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736875
    m_Localized: Och, więc to tutaj uchodzi za sklep?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736876
    m_Localized: Czarujące. Ma sens, jeśli się nie widziało prawdziwej witryny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736877
    m_Localized: Ty tam, potrzebuję jedzenia, zanim wrócę na Wyższe Poziomy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736878
    m_Localized: Zrozumienie błędu nie zajmie im zbyt długo.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736879
    m_Localized: Aresztowali moją matkę, która zarządza największą farmą hydroponiczną na Stacji. Za defraudację.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736880
    m_Localized: Niedorzeczne, połowa Stacji ma jedzenie dzięki niej!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736881
    m_Localized: Masz coś? Najlepiej świeżego? I różnorodnego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736882
    m_Localized: Nie wierzę, że tu utknęłam.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736883
    m_Localized: Nie wiem, co się dzieje z matką i nie chcą mnie wpuścić na górę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736884
    m_Localized: Dlaczego to mi się przydarzyło?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736885
    m_Localized: Wstrętnie tu. To niesprawiedliwe.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736886
    m_Localized: '<i>*wzdycha*</i> Masz jakieś artykuły domowe?'
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736887
    m_Localized: Zostanę tu chyba na dłużej.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736888
    m_Localized: Znalazłam porządny pokój naprzeciwko Kantyny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736889
    m_Localized: Jest mały, ale przynajmniej nie śmierdzi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736890
    m_Localized: Trudno uwierzyć, że ludzie tak spędzają całe życie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736891
    m_Localized: Hej, wróciłam.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736892
    m_Localized: Kończą mi się fundusze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736893
    m_Localized: Nie pozwolili mi za dużo zabrać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736894
    m_Localized: Gdybym mogła wrócić na górę,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736895
    m_Localized: mogłabym wszystko wyjaśnić i oczyścić nazwisko
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736896
    m_Localized: i wszystko wróciłoby do normy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736897
    m_Localized: Nie musiałabym jeść codziennie Pożywnowoców.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736898
    m_Localized: Dobrze, chciałam sprzedać trochę rzeczy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736899
    m_Localized: Już nie mogę,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736900
    m_Localized: nie mam pieniędzy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736901
    m_Localized: Wczoraj w nocy zostałam obrabowana.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736902
    m_Localized: Nie wiem, co robić,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736903
    m_Localized: proces się skończył, a matka została skazana.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736904
    m_Localized: Utknęłam tu na wieczność, a mama zgnije w więzieniu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736905
    m_Localized: Nie wierzę, że o to proszę,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736906
    m_Localized: ale czy mogłabym dostać trochę jedzenia?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736907
    m_Localized: Wezmę cokolwiek, proszę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736908
    m_Localized: Dziękuję, nie zapomnę tego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736909
    m_Localized: Hej, wróciłam!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736910
    m_Localized: Po ostatniej rozmowie
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736911
    m_Localized: uznałam, że muszę iść dalej,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736912
    m_Localized: poza tym przyzwyczajam się do odoru.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736913
    m_Localized: Ktoś na Wyższych Poziomach wrobił moją matkę,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736914
    m_Localized: muszę stanąć na nogi i znaleźć sposób, by ją uwolnić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736915
    m_Localized: Pierwszy krok to znaleźć zarobek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736916
    m_Localized: Pomyślałam, że powinnam przeszukiwać śmietnisko,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736917
    m_Localized: Współlokatorka wprowadziła mnie, jak to robić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736918
    m_Localized: Przyznam, że poczucie wspólnoty jest tu odczuwalne.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736919
    m_Localized: No dobra, oto, co mam do zaoferowania!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736920
    m_Localized: Cześć! Kadet Serpico, nowy rekrut Ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736921
    m_Localized: Pierwszy dzień w pracy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736922
    m_Localized: Urodziłem się i wychowałem na Niższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736923
    m_Localized: Zawsze marzyła mi się ochrona Stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736924
    m_Localized: Pewnie, część rodziny myśli, że jestem zdrajcą…
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736925
    m_Localized: Ale zrobię, co mogę, by poprawić Ochronę od środka.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736926
    m_Localized: Masz może jakieś przekąski?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736927
    m_Localized: Dam je innym oficerom, żeby się zaprzyjaźnić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736928
    m_Localized: O, Boże, muszę się napić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736929
    m_Localized: Nie tego spodziewałem się po Ochronie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736931
    m_Localized: Funkcjonariusze biorą łapówki na Wyższych Poziomach. Od Kartelu, a nawet Rewolucjonistów!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736932
    m_Localized: Jak głęboko to sięga?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736933
    m_Localized: '*Bip bip*'
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736934
    m_Localized: Kurde, muszę lecieć, wezwali mnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736935
    m_Localized: Masz coś, co mogę ze sobą wziąć?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736936
    m_Localized: Ależ dobry dzień.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736937
    m_Localized: Rozmawiałem z przełożonym o łapówkarstwie, które widziałem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736938
    m_Localized: Otwierają pełne, wewnętrzne śledztwo.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736939
    m_Localized: Możliwe, że dostanę za to awans!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736940
    m_Localized: Sprzedasz mi jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736941
    m_Localized: Tym razem bez napojów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736942
    m_Localized: Witaj,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736943
    m_Localized: wiesz, gdzie jest kadet Ochrony o nazwisku Serpico?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736944
    m_Localized: Mamy nakaz jego aresztowania pod zarzutem korupcji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736945
    m_Localized: Do tego pił alkohol podczas służby.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736946
    m_Localized: Jeśli go zobaczysz, natychmiast to zgłoś.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736947
    m_Localized: Nie próbuj z nim rozmawiać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736948
    m_Localized: Jest uzbrojony i niebezpieczny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736949
    m_Localized: Oferujemy 300 kredytów nagrody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736950
    m_Localized: Hej, to ja, Serpico.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736951
    m_Localized: Próbują mnie wrobić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736952
    m_Localized: Musisz mi uwierzyć!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736953
    m_Localized: Muszę lecieć, szukają mnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736954
    m_Localized: Ukryję się na trochę na śmietnisku.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736955
    m_Localized: Nie, czekaj!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736956
    m_Localized: Sięga po broń!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736957
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736958
    m_Localized: Postrzelono podejrzanego!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736959
    m_Localized: Zabezpieczmy go.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736960
    m_Localized: Cześć! Dobrze, że sklep jest znowu otwarty.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736961
    m_Localized: Po jego zamknięciu ciężko było o przekąski.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736962
    m_Localized: Podobno poprzedniego sklepikarza porwali w środku nocy czy coś.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736963
    m_Localized: Jestem Główna Inżynier Nellis,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736964
    m_Localized: 'Tak, tak, *ta* Główna Inżynier. '
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736965
    m_Localized: Mówi mi Nellis.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736966
    m_Localized: Moim zadaniem jest konserwacja naszej blaszanej Stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736967
    m_Localized: Co? To takie zaskoczenie zobaczyć tu oficer Dowództwa?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736968
    m_Localized: Nie wszyscy siedzimy cały dzień na Mostku.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736969
    m_Localized: Nie jesteśmy przedstawicielami korporacji ani radnymi z Wyższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736970
    m_Localized: Ludzie nie pamiętają, że wszystkie kluczowe mechanizmy Stacji są na Niższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736971
    m_Localized: Masz może jakieś jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736972
    m_Localized: Hej, tu Nellis.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736973
    m_Localized: Masz piwo albo przekąski?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736974
    m_Localized: Skończyłam właśnie naprawy drugorzędnych systemów podtrzymywania życia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736975
    m_Localized: Kapitan będzie z tego zadowolony.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736976
    m_Localized: Ludzie tutaj nie cenią za bardzo kapitana.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736977
    m_Localized: Że niby przejmuje się jedynie Wyższymi Poziomami.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736978
    m_Localized: Ale on walczy, żeby utrzymać Stację w całości.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736979
    m_Localized: Wyższe Poziomy ciągle czegoś żądają, korporacje go cisną,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736980
    m_Localized: brakuje pomocy z zewnątrz od Republiki i jeszcze ci Rewolucjoniści.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736981
    m_Localized: Nie rozumieją tego. Niewiele osób widzi pełny obraz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736982
    m_Localized: Mów, co chcesz, ale jakość życia powoli się poprawia od kiedy przejął stery.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736983
    m_Localized: I nie było żadnych zbrojnych potyczek na Stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736984
    m_Localized: Hej, tu Nellis.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736985
    m_Localized: Mam tu zepsuty moduł, który wymieniłam.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736986
    m_Localized: Może masz ochotę go kupić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736987
    m_Localized: Hej, tu Nellis.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736988
    m_Localized: Właśnie wracam ze spotkania Dowództwa.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736989
    m_Localized: Nie znoszę tych radnych z Wyższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736990
    m_Localized: Są zupełnie odklejeni od wydarzeń na Stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736991
    m_Localized: Mają niesamowicie niedorzeczne propozycje.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736992
    m_Localized: Dobrze, że szefowie działów potrafią ich kontrolować.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736993
    m_Localized: Potrzebuję picia i przysmaków, żeby zapomnieć o tym spotkaniu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736994
    m_Localized: Poprzedni najemca zostawił kilka rzeczy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736995
    m_Localized: Więc należą do mnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736996
    m_Localized: Chcesz coś kupić?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736997
    m_Localized: Specjalnie dla ciebie zniżka, jeśli kupisz wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736998
    m_Localized: Ach, nowy sklep w okolicy. Dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736999
    m_Localized: Za dużo ludzi, za mało dobrych sklepów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737000
    m_Localized: Jestem Dziadek Cheng, też prowadzę mały sklep w tym sektorze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737001
    m_Localized: Miałem wczoraj otrzymać dostawę pożywienia,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737002
    m_Localized: ale dostawca się spóźnia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737003
    m_Localized: Niektórzy klienci nie mogą czekać. Sieroty. Starsi pracownicy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737004
    m_Localized: Chciałbym kupić od ciebie jedzenie, by sprzedać je u mnie w sklepie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737005
    m_Localized: Po cenie, w której je sprzedaję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737006
    m_Localized: Co znaczy… że dzisiaj na tym stracę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737007
    m_Localized: Nie podniosę cen, bo ktoś będzie głodować.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737008
    m_Localized: Masz jakieś jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737009
    m_Localized: Dzień dobry, wysłał mnie Dziadek Cheng.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737010
    m_Localized: Chcę kupić lekarstwa.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737011
    m_Localized: Dziadek Cheng ma leki po dacie ważności, które można jeszcze brać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737012
    m_Localized: I oferuje dobre ceny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737013
    m_Localized: Czasami sprzedaje je na kreskę, jeśli ktoś nie może zapłacić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737014
    m_Localized: Na kreskę! Na Niższych Poziomach! Uwierzysz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737015
    m_Localized: Ale teraz mu się skończyły.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737016
    m_Localized: Więc wysłał mnie do ciebie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737017
    m_Localized: Cześć, to ja.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737018
    m_Localized: Mój uzdatniacz wody zepsuł się w nocy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737019
    m_Localized: Miałem go od lat, to uparta, stara maszyna.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737020
    m_Localized: Trochę jak ja.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737021
    m_Localized: Dostawca mówił, żeby zastąpić go nowym.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737022
    m_Localized: Sugerował też, że to nie ja powinienem go naprawiać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737023
    m_Localized: Myśli, że powinienem odejść na emeryturę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737024
    m_Localized: Jestem zmęczony, ale klienci na mnie liczą.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737025
    m_Localized: A do tego nie stać mnie na to.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737026
    m_Localized: Masz może jakieś materiały do naprawy uzdatniacza?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737027
    m_Localized: Dzień dobry, to ja. <i>*kaszle*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737028
    m_Localized: Mam coś do sprzedania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737029
    m_Localized: Czasami ludzie dają mi rzeczy, chyba w ramach podziękowania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737030
    m_Localized: Ktoś zostawił w moim śmietniku luksusowe przedmioty!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737031
    m_Localized: Zebrałem trochę rzeczy, które nie interesują moich zwyczajnych klientów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737032
    m_Localized: Możesz spojrzeć? <i>*kaszle*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737033
    m_Localized: Hej, tu Sawyer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737034
    m_Localized: Znasz Dziadka Chenga, prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737035
    m_Localized: Staruszek dawał mi jedzenie, gdy żyłem na ulicy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737036
    m_Localized: Umarłbym z głodu bez niego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737037
    m_Localized: Podobno ostatnio coraz później otwiera sklep
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737038
    m_Localized: i ma w nim mniej towaru.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737039
    m_Localized: Szczerze mówiąc, martwię się o niego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737040
    m_Localized: Zwróć na niego uwagę, dobrze?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737041
    m_Localized: Dzień dobry, to ja. <i>*kaszle*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737042
    m_Localized: Chciałem prosić o przysługę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737043
    m_Localized: Zdiagnozowano mi chorobę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737044
    m_Localized: Można ją wyleczyć, ale ta kuracja w moim wieku może mnie zabić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737045
    m_Localized: Więc postanowiłem się nie leczyć.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737046
    m_Localized: Sprzedaję sklep i przekazuję oszczędności na akcje charytatywne Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737047
    m_Localized: Byłoby pięknie, gdyby ktoś przejął mój sklep,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737048
    m_Localized: ale wątpię, że przy moich marżach, ktoś go będzie chciał.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737049
    m_Localized: Zostało mi trochę jedzenia, możesz przekazać je za mnie do banków żywności?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737050
    m_Localized: Dzień dobry,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737051
    m_Localized: Mam smutne wieści.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737052
    m_Localized: Znasz Dziadka Chenga?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737053
    m_Localized: Zmarł we śnie wczorajszej nocy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737054
    m_Localized: Był dobrym człowiekiem, podporą społeczności Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737055
    m_Localized: Mam dla ciebie po nim pamiątkę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737056
    m_Localized: Hej, prowadzę firmę uzdatniania wody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737057
    m_Localized: Mam tu pełno podstawody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737058
    m_Localized: Dam ci dużą zniżkę, jeśli kupisz wszystko!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737059
    m_Localized: Hej, mam wodę do sprzedania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737060
    m_Localized: Słuchaj, mam wodę do sprzedania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737061
    m_Localized: Pilnie potrzebuję gotówki, więc kup wszystko, a ja obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737064
    m_Localized: Takie coś wypadło mi podczas przeszukiwania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737065
    m_Localized: Nazywa się to widmowoda. Przerażające.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737066
    m_Localized: Mam tu trochę wody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737067
    m_Localized: To wygląda jak podstawoda.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737068
    m_Localized: Mam trochę nieużywanych podzespołów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737069
    m_Localized: Chcesz coś?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737070
    m_Localized: 33% zniżki, jak weźmiesz wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737071
    m_Localized: Kurde
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737072
    m_Localized: STAĆ! To koleś, który napadał na funkcjonariuszy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931136
    m_Localized: Pójdziesz z nami!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931137
    m_Localized: Wracam z Opuszczonych Sekcji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931138
    m_Localized: Mam dobry towar, popatrz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931139
    m_Localized: 25% zniżki, jak weźmiesz wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931140
    m_Localized: Muszę kupić jedzenie i materiały
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931141
    m_Localized: Masz coś?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931142
    m_Localized: Nie naciskaj alarmu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931143
    m_Localized: Jestem Odin, Odin Haraldsson.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931144
    m_Localized: Mam propozycje biznesową.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931145
    m_Localized: Zgłoś mnie, a już się nie zobaczymy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931146
    m_Localized: Moi ludzie potrzebują zaopatrzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931147
    m_Localized: Chodzi o broń, amunicję, pancerze, trucizny, skrzynie zaopatrzeniowe i karty dostępu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931148
    m_Localized: Kontrabanda nam nie przeszkadza, ale nie zapłacimy ci tyle, ile inni.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931149
    m_Localized: Weź wizytówkę i zadzwoń, jak coś będziesz mieć.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931150
    m_Localized: Pożałujesz tego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931151
    m_Localized: Odin Haraldsson… w końcu. Aresztujemy cię.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931152
    m_Localized: Cześć, to ja.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931153
    m_Localized: Co dla mnie masz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931154
    m_Localized: Pamiętaj, szukamy broni, amunicji, skrzyń zaopatrzeniowych, trucizny i kart dostępu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931155
    m_Localized: Co? Ty zdrajco!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931156
    m_Localized: Ręce do góry! Aresztujemy cię.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931157
    m_Localized: Cześć, ależ z ciebie Pożywnowocek!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931158
    m_Localized: Jestem Lou, miło mi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931159
    m_Localized: Potrzebuję czegoś, żeby pomóc mojemu „gościowi” w „rozmowie”.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931160
    m_Localized: Coś jak rura, nóż kuchenny, może tasak?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931161
    m_Localized: Wiesz, jest bardzo nieśmiały.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931162
    m_Localized: Szukam różnych, fajnych rzeczy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931163
    m_Localized: I rozumiemy się, że wzywanie Ochrony nie jest najlepszym pomysłem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931164
    m_Localized: To jak?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931165
    m_Localized: Ha, ha, ha, ale będzie zabawa!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931166
    m_Localized: KUURDE, to ona!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931167
    m_Localized: '*próbuje schować twarz przed Lou.*'
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931168
    m_Localized: STÓJ! ARESZTUJĘ CIĘ!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931169
    m_Localized: Za dużo czasu w więzieniu nie spędzę. <i>mruga</i>
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931170
    m_Localized: Do zobaczenia, Owocku!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931171
    m_Localized: Bu!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931172
    m_Localized: Ha, ha, przestraszyłam cię, Owocku?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931173
    m_Localized: Tęskniliśmy?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931174
    m_Localized: Wezwanie Ochrony nie było najmilszym gestem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931175
    m_Localized: I to bez postawienia mi drinka.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931176
    m_Localized: Normalnie to byłby wyrok.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931177
    m_Localized: Nie wiem, czy to odwaga, czy głupota,
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931178
    m_Localized: nieważne, chcę z tobą w coś zagrać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931179
    m_Localized: Zgadnij, co się stanie, jeśli nie zagrasz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931180
    m_Localized: Ochrona nie będzie nam już przeszkadzać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931181
    m_Localized: Na pewno nie po mojej wizycie u naczelnika sektora.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931182
    m_Localized: Odezwę się. Pa.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931183
    m_Localized: Dzień dobry, jestem Li Bei Wen.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931184
    m_Localized: Nie zgłaszaj mnie. Jestem niewinny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931185
    m_Localized: Właśnie kończę pracę nad nowym środkiem przeciwbólowym.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931186
    m_Localized: To nieuzależniająca wersja Oxymore.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931187
    m_Localized: Firmy farmaceutyczne raczej nie chcą tego na rynku.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931188
    m_Localized: Przez nich Ochrona traktuje mnie jak uzbrojonego chemika z Kartelu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931189
    m_Localized: Potrzebuję funduszy, by uciec ze Stacji i kontynuować badania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931190
    m_Localized: Mam próbki do sprzedania. Spójrz proszę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931191
    m_Localized: Nie! Moje badania!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931192
    m_Localized: Pójdziesz z nami, kartelowy zbirze!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931193
    m_Localized: Mam jedzenie do sprzedania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931194
    m_Localized: W przyszłości będę mieć więcej.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931195
    m_Localized: Proszę, nie zgłaszaj mnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931196
    m_Localized: Mam popularne imię i nazwisko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931197
    m_Localized: Ochrona mnie z kimś pomyliła.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931198
    m_Localized: Zamiast rabusia na liście gończym jestem ja!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931199
    m_Localized: Proszę, jestem normalnym kolesiem na zakupach!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931200
    m_Localized: W tym miesiącu aresztowali mnie już cztery razy!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931201
    m_Localized: Nieee, dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931202
    m_Localized: Pójdziesz z nami, zbirze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931203
    m_Localized: O, nie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931204
    m_Localized: Udawanie funkcjonariusza Ochrony to poważne przestępstwo!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931205
    m_Localized: Powiesz nam, skąd masz ten mundur, gnido!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931206
    m_Localized: Właśnie kończę zmianę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931207
    m_Localized: Złomiarstwo to trudna robota.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931208
    m_Localized: Ostatnio żyję niedaleko ruin.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931209
    m_Localized: Nie jest tam bezpiecznie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931210
    m_Localized: Potrzebuję czegoś, by przeżyć.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931211
    m_Localized: Potrzebuję ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931212
    m_Localized: Masz coś mocnego i niezawodnego?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931213
    m_Localized: Szukam czegoś taniego, ale efektywnego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931214
    m_Localized: Potrzebuję broni, która zniesie trudy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931215
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}. Pomożesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931216
    m_Localized: Mogę zapłacić tylko {0:plural:{} kredyt|{} kredyty|{} kredytów}. Co dostanę?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931217
    m_Localized: Mam mały budżet, {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931218
    m_Localized: To mi nie pomoże przeżyć.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931219
    m_Localized: Nada się. Dzięki.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931220
    m_Localized: Stacja wydaje się ostatnio bardziej niebezpieczna…
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931221
    m_Localized: Potrzebuję czegoś do ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931222
    m_Localized: Coraz więcej przestępstw. Nie mogę ryzykować.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931223
    m_Localized: Masz coś do obrony własnej w dobrej cenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931224
    m_Localized: Potrzebuję podstawowej broni i pancerza, nic wymyślnego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931225
    m_Localized: Daj najtańszą rzecz, która zapewni mi bezpieczeństwo.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931226
    m_Localized: Mam do wydania {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931227
    m_Localized: Mogę wydać {0:plural:{} kredyt|{} kredyty|{} kredytów}. Znajdziesz coś?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931228
    m_Localized: 'To wszystko, co mam: {0:plural:{} kredyt|{} kredyty|{} kredytów}.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931229
    m_Localized: To nie wygląda jak coś, czym się można obronić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931230
    m_Localized: Idealnie! Tym się obronię.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931231
    m_Localized: Muszę wyposażyć oddział na ryzykowną misję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931232
    m_Localized: Zwiększamy ochronę. Masz coś odpowiedniego?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931233
    m_Localized: Szukam poważnej siły ognia dla mojej ekipy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931234
    m_Localized: Tylko najlepszy sprzęt.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931235
    m_Localized: Potrzebuję niezawodnej i skutecznej broni.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931236
    m_Localized: Szukam najlepszego sprzętu, nie złomu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931237
    m_Localized: Możemy wydać {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931238
    m_Localized: W budżecie mam {0:plural:{} kredyt|{} kredyty|{} kredytów}. Pokaż, co tam masz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931239
    m_Localized: Mamy do wydania {0:plural:{} kredyt|{} kredyty|{} kredytów}. Pokaż towary.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931240
    m_Localized: To nie spełnia standardów mojego oddziału.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931241
    m_Localized: Dobrze. Oddział to doceni.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931242
    m_Localized: Potrzebuję czegoś, czegokolwiek, co da mi kopa!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931243
    m_Localized: Proszę, potrzebuję działki! Cokolwiek!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931244
    m_Localized: Masz coś na uspokojenie nerwów?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931245
    m_Localized: Tabletki, fajki, alkohol. Wszystko jedno.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931246
    m_Localized: Cokolwiek, co mnie wyluzuje.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931247
    m_Localized: Wszystko jedno co. Co masz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931248
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}. Wystarczy?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931249
    m_Localized: Kupię coś za {0:plural:{} kredyt|{} kredyty|{} kredytów}?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931250
    m_Localized: Mam tylko tyle. Starczy {0:plural:{} kredyt|{} kredyty|{} kredytów}?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931251
    m_Localized: Chcę czegoś do wyluzowania, nie tego!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931252
    m_Localized: Idealnie, biorę!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931253
    m_Localized: Wracam z długiego rejsu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931254
    m_Localized: Po tygodniach w pustce znowu na Stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931255
    m_Localized: Muszę się zrelaksować. Za dużo czasu w kosmosie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931256
    m_Localized: Masz coś, co mnie zrelaksuje?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931257
    m_Localized: Szukam czegoś, co mnie wyluzuje.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931258
    m_Localized: Potrzebuję czegoś, by się wyluzować.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931259
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931260
    m_Localized: Mogę wydać maksymalnie {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931261
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}. Co mogę kupić?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931262
    m_Localized: Szukam relaksu, nie tego!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931263
    m_Localized: Wystarczy, dzięki!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931264
    m_Localized: Potrzebuję wody! Masz podstawodę?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931265
    m_Localized: Wezmę też widmowodę!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931266
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931267
    m_Localized: Proszę, potrzebuję czegoś do picia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931268
    m_Localized: Chcę podstawody! Starczy i widmowoda.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931269
    m_Localized: Wygląda dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931270
    m_Localized: Muszę coś szybko wypić. Masz podstawodę?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931271
    m_Localized: Idealna byłaby woda wysokiej jakości.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931272
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931273
    m_Localized: Potrzebuję podstawody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931274
    m_Localized: Wygląda dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931275
    m_Localized: Zbieram zapasy wody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931276
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931277
    m_Localized: Potrzebuję podstawody albo czegoś lepszego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931278
    m_Localized: Wygląda dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931279
    m_Localized: Ty! Chcę kupić wodę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931280
    m_Localized: Podstawodę albo wodę wysokiej jakości!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931281
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931282
    m_Localized: Potrzebuję podstawody. Może być woda wysokiej jakości.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931283
    m_Localized: Wygląda dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931284
    m_Localized: Hej. Tworzę zapasy wody dla klienta z Wyższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931285
    m_Localized: Potrzebuję przynajmniej wody wysokiej jakości lub czystej.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931286
    m_Localized: Bez kombinowania, mam papierki wskaźnikowe.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931287
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931288
    m_Localized: Potrzebuje wody czystej lub wysokiej jakości.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931289
    m_Localized: Dobrze wygląda.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931290
    m_Localized: Chcę kupić jedzenie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931291
    m_Localized: Mam do wydania tylko {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931292
    m_Localized: Głoduję, masz coś taniego?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931293
    m_Localized: Zostało mi tylko {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931294
    m_Localized: Hej, potrzebuję składników do budki z jedzeniem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931295
    m_Localized: Potrzebuję różnych rzeczy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931296
    m_Localized: Mój budżet to {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931297
    m_Localized: Pozdrowienia. Szukam jedzenia na naszą kolejną ekspedycję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931298
    m_Localized: Mam do wydania {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931299
    m_Localized: Witam. Jestem prywatnym kucharzem z Wyższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931300
    m_Localized: Szukam egzotycznych składników i unikatowych smaków.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931301
    m_Localized: Podobno w tym sklepie takie znajdę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931302
    m_Localized: Hej… Nie czuję się za dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931303
    m_Localized: Masz leki?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931304
    m_Localized: Błagam, dziecko mi choruje. Masz lekarstwa?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931305
    m_Localized: Nie mam za wiele, tylko {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931306
    m_Localized: 'Prowadzę klinikę na Niższych Poziomach. '
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931307
    m_Localized: Masz lekarstwa dla moich pacjentów?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931308
    m_Localized: Potrzebuję różnych wyrobów medycznych.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931309
    m_Localized: Mogę wydać {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931310
    m_Localized: Tak tylko dodam, że mam skaner chemiczny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931311
    m_Localized: Zobaczmy, co my tu mamy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931312
    m_Localized: Dzień dobry. Poszukuję wyrobów medycznych do kliniki.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931313
    m_Localized: Podobno można tu znaleźć szeroki wachlarz produktów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931314
    m_Localized: Mam przy sobie skaner chemiczny, więc bez trików.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931315
    m_Localized: Zobaczmy, co my tu mamy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931316
    m_Localized: Dzień dobry, jestem dostawcą szpitala ogólnego z Wyższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931317
    m_Localized: Podobno masz godną podziwu ofertę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931318
    m_Localized: '[g:Sam chciałem|Sama chciałam] na nią spojrzeć.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931319
    m_Localized: Mam przy sobie skaner chemiczny, więc bez nieczystych zagrywek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931320
    m_Localized: Poszukuję materiałów, ogniw i narzędzi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931321
    m_Localized: Mój budżet to {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931322
    m_Localized: Szukam taniego złomu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931323
    m_Localized: Materiałów, ogniw, narzędzi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931324
    m_Localized: Jest coś na stanie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931325
    m_Localized: Mogę dać {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931326
    m_Localized: Dokonuję napraw Stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931327
    m_Localized: Masz może materiały, ogniwa lub narzędzia?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931328
    m_Localized: Reperuję różne rzeczy, więc liczy się różnorodność.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931329
    m_Localized: Mogę wydać {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931330
    m_Localized: Dobry sklepikarzu. Trudnię się wynalazkami!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931331
    m_Localized: Szukam materiałów, ogniw, narzędzi i modułów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931332
    m_Localized: Poszukuję materiałów, ogniw, narzędzi i modułów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931333
    m_Localized: Podobno masz dobry towar.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931334
    m_Localized: Zapomniałem czego szukam… artykułów domowych?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931335
    m_Localized: Mam do wydania {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931336
    m_Localized: Jesteśmy tu nowi. Masz jakieś tanie artykuły domowe?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931337
    m_Localized: Nie więcej niż {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931338
    m_Localized: Dzień dobry, potrzebuję podstawowych artykułów domowych dla rodziny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931339
    m_Localized: Szukam różnych przedmiotów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931340
    m_Localized: Mam do wydania {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931341
    m_Localized: Hej, chcę kupić artykuły domowe.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931342
    m_Localized: Dzień dobry, szukam artykułów domowych dla pracodawcy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931343
    m_Localized: Proszę pokazać najlepsze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931344
    m_Localized: Mam za dużo jedzenia. Kupujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931345
    m_Localized: Mam za dużo lekarstw, muszę je sprzedać. To jak?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931346
    m_Localized: Mam dodatkowe zasoby medyczne, jeśli chcesz kupić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931347
    m_Localized: Mam za dużo zapasów. Chcesz kupić?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931348
    m_Localized: Dodatkowe produkty nie mieszczą mi się w kieszeni. Kupujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931349
    m_Localized: Mam za dużo towaru. Wybierz sobie coś.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931350
    m_Localized: Wala mi się dodatkowa broń i pancerze. Chcesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931351
    m_Localized: Kupiliśmy za dużo materiałów. Kupisz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931352
    m_Localized: Mam za dużo materiałów. Kupujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931353
    m_Localized: Hej, mam zamówienie z Bordowego Biesa
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931354
    m_Localized: Świetnie, do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931355
    m_Localized: Hej, jestem z Górniczej GP.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931356
    m_Localized: Oto towar.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931357
    m_Localized: Świetnie, do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931358
    m_Localized: Hej, mam twój towar.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931359
    m_Localized: Kupię też dowolne środki chemiczne.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931360
    m_Localized: Świetnie, do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931361
    m_Localized: Przysyła mnie wspólny znajomy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931362
    m_Localized: Świetnie, do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931363
    m_Localized: Hej, mam kilka rzeczy, których nie potrzebuję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931364
    m_Localized: Popatrz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931365
    m_Localized: Hej, mogę cię nauczyć, jak rozebrać zepsutą maszynę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931366
    m_Localized: Dam ci też początkowe narzędzia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931367
    m_Localized: Przekażę znajomym zbieraczom, że z nami pracujesz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931368
    m_Localized: Zbieracze zaczną przynosić zepsute maszyny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931369
    m_Localized: Zepsute maszyny mogą czasami zawierać moduły.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931370
    m_Localized: Czego zbieracz nie wyrwie, pewnie utknęło.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931371
    m_Localized: Możesz użyć ekstraktora modułów, by go wydostać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931372
    m_Localized: Jeśli masz śrubokręt lub nożyce do drutu,
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931373
    m_Localized: możesz ich użyć na maszynie, by wydostać dodatkowe materiały,
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931374
    m_Localized: a następnie użyć spawarki, by rozłożyć maszynę na złom
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931375
    m_Localized: To tyle na razie. Powodzenia!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931376
    m_Localized: Przyjdę za tydzień po pierwszą płatność.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931377
    m_Localized: Lepiej, żeby na mnie czekała.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931378
    m_Localized: Nawet nie myśl o wzywaniu Ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931379
    m_Localized: Jeśli to zrobisz, opowiem o twojej przeszłości.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125440
    m_Localized: Powodzenia, <i>ha, ha, ha</i>.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125441
    m_Localized: Pożałujesz tego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125442
    m_Localized: Spokojnie, szumowino!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125443
    m_Localized: Masz moją kasę?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125444
    m_Localized: Płać albo wszystko wyśpiewam.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125445
    m_Localized: Dobrze, do zobaczenia za tydzień.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125446
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125447
    m_Localized: Pożałujesz tego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125448
    m_Localized: '[Zapłać [g:Szantażyście|Szantażystce]]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125449
    m_Localized: '[Odmów zapłacenia]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125450
    m_Localized: Hej, [g:byłem|byłam] tu wczoraj.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125451
    m_Localized: Dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125452
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125453
    m_Localized: Pożałujesz tego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125454
    m_Localized: '[Przyjmij (-{0:plural:{} kredyt|{} kredyty|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125455
    m_Localized: '[Odmów ({0:plural:{} punkt|{} punkty|{} punktów} reputacji)]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125456
    m_Localized: Chcę zwrotu i zadośćuczynienia!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125457
    m_Localized: Żądam zwrotu!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125458
    m_Localized: '{0}! Ależ to mi zrobiło.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125459
    m_Localized: Nie wiem, co tam było, ale {0} to był świetny wybór.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125460
    m_Localized: '{0} kopie po całości.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125461
    m_Localized: Nie wiem dlaczego, ale {0} sprawdza się świetnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125462
    m_Localized: '{0} – cokolwiek jest w środku,'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125463
    m_Localized: '{0} sprawia, że czuję się lepiej.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125464
    m_Localized: Ależ {0} kopie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125465
    m_Localized: '{0}! Ależ to mi zrobiło.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125466
    m_Localized: '{0} kopie po całości.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125467
    m_Localized: Ależ {0} kopie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125468
    m_Localized: '{0} jest ciągle w mojej głowie'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125469
    m_Localized: Ależ {0} gładko wchodzi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125470
    m_Localized: Gdyby nie {0}, ciężko byłoby funkcjonować.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125471
    m_Localized: Nie [g:spodziewałem|spodziewałam] się takiej siły. {0} kopie…
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125472
    m_Localized: Dawno tak się nie [g:czułem|czułam]. {0} to dobry wybór.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125473
    m_Localized: '{0}… Przez chwilę rozjaśniły mi się myśli.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125474
    m_Localized: Nic mi tak nie zrobiło jak {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125475
    m_Localized: '{0}! [g:Poszedłbym|Poszłabym] na drugą stronę Stacji po więcej.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125476
    m_Localized: '{0} zapewnia ucieczkę, której [g:potrzebowałem|potrzebowałam].'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125477
    m_Localized: Masz więcej?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125478
    m_Localized: Dobrze zapłacę za kolejną dawkę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125479
    m_Localized: Nie masz więcej, co?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125480
    m_Localized: Jeśli masz więcej, od razu biorę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125481
    m_Localized: Powiedz, że masz więcej.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125482
    m_Localized: Nie chowaj niczego, masz więcej?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125483
    m_Localized: Gdzie mogę dostać więcej?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125484
    m_Localized: To mnie nieźle uniosło.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125485
    m_Localized: Subtelne, ale miłe.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125486
    m_Localized: Pomogło mi się wyluzować.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125487
    m_Localized: Czuję się po tym lekko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125488
    m_Localized: Pomaga mi przeżyć dzień.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125489
    m_Localized: To było naprawdę mocne, walnęło na raz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125490
    m_Localized: Najmocniejszy haj od dawna.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125491
    m_Localized: Ten kop trzymał mnie godzinami.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125492
    m_Localized: Największy haj w moim życiu, to na pewno.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125493
    m_Localized: Jeszcze nigdy tak mnie nie kopnęło.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125494
    m_Localized: Było tak intensywnie, że [g:żeglowałem|żeglowałam] poza rzeczywistością.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125495
    m_Localized: Ciężko to opisać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125496
    m_Localized: Dobrze było.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125497
    m_Localized: Hej, jestem [g:gotowy|gotowa] na kolejną ekspedycję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125498
    m_Localized: Masz dla mnie robotę?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125499
    m_Localized: Wracam z ekspedycji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125500
    m_Localized: Oto, co [g:znalazłem|znalazłam].
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125501
    m_Localized: Muszę odpocząć kilka dni.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125502
    m_Localized: Hej, masz jakieś strzykawki OxyMore?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125503
    m_Localized: Mam coś na wymianę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125504
    m_Localized: Mówię, chcę to wymienić za strzykawkę OxyMore.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125505
    m_Localized: Masz czy nie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125506
    m_Localized: O, tak, w końcu!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125507
    m_Localized: '<i>*łapie strzykawkę i szybko odchodzi*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125508
    m_Localized: Hej, masz coś, co mnie wyluzuje?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125509
    m_Localized: Oxymore, Proszek Snów, cokolwiek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125510
    m_Localized: Ale nie śmieciowej jakości czy ze skrobią.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125511
    m_Localized: Mam coś na wymianę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125512
    m_Localized: Mówię, wymienię to za prawdziwe dragi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125513
    m_Localized: Masz czy nie?!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125514
    m_Localized: O, tak, w końcu!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125515
    m_Localized: '<i>*szybko odchodzi*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125516
    m_Localized: '<i>*[g:zmęczony złomiarz|zmęczona złomiarka] podchodzi do sklepu*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125517
    m_Localized: Hej, masz jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125518
    m_Localized: Mogę coś wymienić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125519
    m_Localized: Muszę czymś wypełnić żołądek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125520
    m_Localized: Dzięki, chcę coś zjeść.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125521
    m_Localized: Dziękuję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125522
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125523
    m_Localized: '<i>*[g:zmęczony złomiarz|zmęczona złomiarka] podchodzi do sklepu*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125524
    m_Localized: Hej, masz jakieś strzykawki OxyMore?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125525
    m_Localized: Mam coś na wymianę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125526
    m_Localized: O, tak, w końcu!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125527
    m_Localized: '<i>*łapie strzykawkę i szybko odchodzi*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125528
    m_Localized: O tak, o to chodziło!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125529
    m_Localized: Nie, potrzebuję strzykawki OxyMore!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125530
    m_Localized: Hej, masz może butelkę bimbru?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125531
    m_Localized: Mogę wymienić znalezione rzeczy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125532
    m_Localized: Mówię, chcę wymienić na coś bimber.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125533
    m_Localized: Umowa stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125534
    m_Localized: Dziękuję. Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125535
    m_Localized: Tak, idealnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125536
    m_Localized: Nie, chcę bimbru.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125537
    m_Localized: Hej, przehandlujesz jedzenie za lekarstwa?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125538
    m_Localized: Dziękuję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125539
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125540
    m_Localized: Dobrze wygląda.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125541
    m_Localized: Nie, chcę jedzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125542
    m_Localized: Hej, masz jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125543
    m_Localized: Mam coś na wymianę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125544
    m_Localized: Potrzebuję jednego przedmiotu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125545
    m_Localized: '[g:Mówiłem|Mówiłam], szukam jedzenia.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125546
    m_Localized: Dziękuję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125547
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125548
    m_Localized: Chyba wszystko gotowe.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125549
    m_Localized: Ta nora będzie idealną przykrywką dla naszych działań.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125550
    m_Localized: I nie martw się o złodziei.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125551
    m_Localized: Nikt nie tknie tego miejsca, gdy jest pod naszą ochroną.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125552
    m_Localized: Wrócę w przyszłym tygodniu odebrać {0} porcji Proszku Snów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125553
    m_Localized: Musi być czysty w przynajmniej {0}%.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125554
    m_Localized: Masz trochę środków chemicznych na dobry początek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125555
    m_Localized: Pamiętaj, żeby wyrobić normę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125556
    m_Localized: Inaczej odkryjesz, co stało się z ostatnim sklepikarzem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125557
    m_Localized: Nie myśl o ucieczce albo rozmowie z Ochroną.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125558
    m_Localized: Widzimy wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125559
    m_Localized: Należysz teraz do Kartelu 13 Sektora.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125560
    m_Localized: Witaj.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125561
    m_Localized: Czy chcesz zgłosić jakieś podejrzane zachowanie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125562
    m_Localized: '[Zgłoś Kartel]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125563
    m_Localized: '[Nie zgłaszaj]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125564
    m_Localized: Rozumiem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125565
    m_Localized: Rozumiem, bezpiecznej zmiany.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125566
    m_Localized: Hmmm, hmmm.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125567
    m_Localized: Naprawdę się [g:zawiodłem|zawiodłam].
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125568
    m_Localized: '[g:Wyraziłem|Wyraziłam] się jasno.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125569
    m_Localized: Posłuchaj uważnie,
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125570
    m_Localized: cenimy cię.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125571
    m_Localized: Ale można cię zastąpić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125572
    m_Localized: Spróbuj tego jeszcze raz,
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125573
    m_Localized: a kolejnej szansy nie będzie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125574
    m_Localized: Pamiętaj, żeby wyrobić normę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125575
    m_Localized: Jak tam towar?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125576
    m_Localized: Musisz przygotować przynajmniej {0} porcji Proszku Snów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125577
    m_Localized: Musi być czysty w przynajmniej {0}%.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125578
    m_Localized: To na następny poniedziałek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125579
    m_Localized: '[Poproś o więcej składników ({0} rep.)]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125580
    m_Localized: '[Wszystko OK]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125581
    m_Localized: Potrzebujesz materiałów?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125582
    m_Localized: Pewnie, proszę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125583
    m_Localized: Co się stało z tamtymi materiałami?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125584
    m_Localized: Powinny były starczyć.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125585
    m_Localized: Dobra, weź to.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125586
    m_Localized: Dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125587
    m_Localized: Masz {0} porcji Proszku Snów?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125588
    m_Localized: Musi być czysty w przynajmniej {0}%.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125589
    m_Localized: Połóż na ladzie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125590
    m_Localized: '[Kontynuuj]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125591
    m_Localized: Gdzie ten pieprzony Proszek Snów?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125592
    m_Localized: Daliśmy wszystko, czego potrzeba!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125593
    m_Localized: Dobrze. Przejdźmy się.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125594
    m_Localized: Norma niewyrobiona.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125595
    m_Localized: Miało być {0}!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125596
    m_Localized: Ogarnij się.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125597
    m_Localized: Dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125598
    m_Localized: Fantastycznie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125599
    m_Localized: Sprawdźmy czystość.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125600
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125601
    m_Localized: Próbujesz oszukać Kartel?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125602
    m_Localized: Średnia czystość jest dużo niższa niż oczekiwana.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125603
    m_Localized: '<i>*wyjmuje broń*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125604
    m_Localized: Prosiliśmy o wyższą jakość.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125605
    m_Localized: Tym razem to przyjmiemy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125606
    m_Localized: Dobrze
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125607
    m_Localized: Wyższa jakość, niż się spodziewaliśmy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125608
    m_Localized: Dobra robota.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125609
    m_Localized: Dobra, na następny tydzień
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125610
    m_Localized: potrzebujesz {0} porcji Proszku Snów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125611
    m_Localized: I ma być czysty przynajmniej w {0}%.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125612
    m_Localized: To twoja pensja i materiały.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125613
    m_Localized: Pamiętaj, żeby wyrobić normę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125614
    m_Localized: Wygląda na dobrze wykonaną pracę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125615
    m_Localized: Przed odejściem muszę sprawdzić rejestry.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125616
    m_Localized: W międzyczasie pracuj dalej.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125617
    m_Localized: Co do odejścia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125618
    m_Localized: 'Dług nie został dobrze obliczony. Zostały odsetki. '
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125619
    m_Localized: Gotuj dalej.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125620
    m_Localized: Wygląda na dobrze wykonaną pracę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125621
    m_Localized: Wydano nowe polecenia. Musisz dalej pracować.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125622
    m_Localized: Zły moment.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125623
    m_Localized: Wygląda na dobrze wykonaną pracę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125624
    m_Localized: W tym tygodniu zniknął nam towar. Chwilę nam zajmie rozwiązanie tej sprawy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125625
    m_Localized: Dopóki tego nie wyrównamy, nikt nie będzie wolny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125626
    m_Localized: Wygląda na dobrze wykonaną pracę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125627
    m_Localized: Popyt na Proszek Snów się zmniejszył.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125628
    m_Localized: Więc wygląda na to, że możesz odejść.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125629
    m_Localized: Z przykrością cię puszczamy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125630
    m_Localized: Ani słowa na nasz temat.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125631
    m_Localized: Nigdy się już nie spotkamy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125632
    m_Localized: Hej, gotujesz dla nas, nie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125633
    m_Localized: Ktoś mnie postrzelił!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125634
    m_Localized: Masz leki?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125635
    m_Localized: Opowiem o tym innym.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125636
    m_Localized: Hej, podobno <i>gotujesz</i>.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125637
    m_Localized: Mam pełno produktów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125638
    m_Localized: Chyba wiesz niejedno o chemikaliach.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125639
    m_Localized: Potrzebuję produktów i mam dosyć pośredników.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125640
    m_Localized: To ja ryzykuję sprzedając produkt.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125641
    m_Localized: Może sprzedasz mi część bezpośrednio?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125642
    m_Localized: 15% zniżki od ceny rynkowej powinno być OK.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125643
    m_Localized: Nikt się nie dowie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125644
    m_Localized: Mam skaner chemiczny. Jak coś daje haj, jest OK.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125645
    m_Localized: Hej, [g:wróciłem|wróciłam].
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125646
    m_Localized: Masz dla mnie więcej produktu?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125647
    m_Localized: Żeby zarobić, potrzebuję zniżki 15% zniżki od ceny rynkowej.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125648
    m_Localized: Mam skaner chemiczny. Jak coś daje haj, jest OK.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125651
    m_Localized: Dzień dobry, mam wodę ze świeżo wydobytego lodu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125652
    m_Localized: Skończyliśmy wydobycie i mam dla ciebie czystą wodę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125653
    m_Localized: Przylecieliśmy z lodem i mam czystą wodę do sprzedania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125654
    m_Localized: Kopaliśmy w asteroidach lodowych, woda jest najlepszej jakości.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125655
    m_Localized: Świeżo roztopiona z lodu asteroidowego. Mam wodę do sprzedania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125656
    m_Localized: Weź wszystko, a dam ci dobrą cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125657
    m_Localized: Kup całą wodę, a zejdę z ceny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125658
    m_Localized: Weź całość, a obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125659
    m_Localized: Jeśli weźmiesz wszystko, będzie zniżka.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125660
    m_Localized: Dostaniesz lepszą cenę za całość.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125661
    m_Localized: Hej, chcę kupić materiały do projektu budowlanego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125662
    m_Localized: To spora fucha, potrzebuję materiałów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125663
    m_Localized: Zarządzam budową, potrzebuję materiałów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125664
    m_Localized: Chcę kupić materiały na plac budowy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125665
    m_Localized: Muszę kupić mnóstwo materiałów budowlanych na budowę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125666
    m_Localized: Jeśli masz, czego szukam, dogadamy się.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125667
    m_Localized: Pokaż co masz i na pewno się dogadamy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125668
    m_Localized: Pokaż, co sprzedajesz i może się dogadamy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125669
    m_Localized: Wezmę, co potrzebuję i ustalimy dobrą cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125670
    m_Localized: Hej, mam kilka rzeczy z poszukiwań złomu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125671
    m_Localized: Mam tu artykuły domowe. Chcesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125672
    m_Localized: '[g:Zbierałem złom|Zbierałam złom] sobie i [g:znalazłem|znalazłam] coś, co może ci się spodobać.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125673
    m_Localized: Mam tu trochę artykułów domowych z Niższych Poziomów. Chcesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125674
    m_Localized: Trafiły się przydatne rzeczy podczas zbierania. Może je chcesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125675
    m_Localized: Jeśli weźmiesz wszystko, dam dobrą cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125676
    m_Localized: Weź wszystko, a będzie zniżka.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125677
    m_Localized: Złapiesz wszystko, to obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319744
    m_Localized: Kup całość, a to ci się opłaci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319745
    m_Localized: Weź ode mnie wszystko, a dam ci dobrą stawkę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319746
    m_Localized: Woda… Potrzebuję wody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319747
    m_Localized: Proszę, masz wodę?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319748
    m_Localized: Muszę kupić wodę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319749
    m_Localized: Kończy mi się woda…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319750
    m_Localized: Błagam, potrzebuję wody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319751
    m_Localized: Nie mam dużo do wydania, ale wezmę, co mogę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319752
    m_Localized: Nie mam za wiele kredytów, ale kupię tyle, ile mogę w ramach budżetu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319753
    m_Localized: Nie mam wiele, ale wezmę wszystko, co mogę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319754
    m_Localized: Wiem, że nie kupię wiele, ale cokolwiek da radę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319755
    m_Localized: Mam niski budżet, ale wezmę wszystko, co mi zaoferujesz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319756
    m_Localized: Potrzebuję podstawody! Widmowoda też starczy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319757
    m_Localized: Wygląda dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319758
    m_Localized: Potrzebuję butelki wody. Teraz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319759
    m_Localized: Na pewno mi starczy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319760
    m_Localized: Starczy mi na jedną butelkę, nie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319761
    m_Localized: Wygląda dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319762
    m_Localized: Masz wodę? W ustach mi wyschło…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319763
    m_Localized: Poproszę podstawodę albo wodę wysokiej jakości.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319764
    m_Localized: Wygląda dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319765
    m_Localized: Dzień dobry, chcę kupić jedzenie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319766
    m_Localized: Hej, chcę kupić jedzenie na tydzień.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319767
    m_Localized: Potrzebuję prowiantu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319768
    m_Localized: Dzień dobry, chcę kupić pożywienie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319769
    m_Localized: Chcę kupić jedzenie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319770
    m_Localized: Kupię, co mogę, za kredyty.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319771
    m_Localized: Zobaczmy, ile jedzenia kupię za to, co mam.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319772
    m_Localized: Mam ustalony budżet, więc wezmę, co się da.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319773
    m_Localized: Poproszę tyle, na ile mnie stać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319774
    m_Localized: Kredytów nie rozciągnę, ale wezmę, co mogę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319775
    m_Localized: Dzień dobry, chcę kupić wyroby medyczne.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319776
    m_Localized: Dzień dobry, chcę kupić wyroby medyczne do apteki.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319777
    m_Localized: Chcę zrobić zapasy wyrobów medycznych.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319778
    m_Localized: Potrzebuję wyrobów medycznych.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319779
    m_Localized: Chcę kupić wyroby medyczne.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319780
    m_Localized: Zobaczmy, jakie sprzedajecie tu nasiona.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319781
    m_Localized: Pokaż mi nasiona, sporo ich potrzebuję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319782
    m_Localized: Chcę kupić tyle nasion, ile to możliwe.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319783
    m_Localized: Wezmę mnóstwo nasion, tyle, ile masz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319784
    m_Localized: Rozwiązujemy dzisiaj problem. Masz coś przydatnego?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319785
    m_Localized: Pewien ktoś przekroczył pewną linię, więc wyślemy pewną wiadomość.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319786
    m_Localized: Niektórzy myślą, że oszukiwanie Niższych Poziomów ujdzie im na sucho.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319787
    m_Localized: Potrzebna mi broń. Może być coś prostego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319788
    m_Localized: Pokaż, co masz. Potrzebuję broni.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319789
    m_Localized: Potrzebuję broni. Nic wymyślnego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319790
    m_Localized: Wszędzie ciemno. Nadal otwarte?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319791
    m_Localized: Ostra ta awaria. Dalej handlujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319792
    m_Localized: W sektorze nie ma energii. [g:Chciałem|Chciałam] sprawdzić sklep.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319793
    m_Localized: Znowu nie ma prądu, co za niespodzianka.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319794
    m_Localized: Pewnie na Wyższych Poziomach mają prąd.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319795
    m_Localized: Szukam ogniw energetycznych. Żeby to przeżyć.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319796
    m_Localized: Masz ogniwa energetyczne?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319797
    m_Localized: Wezmę wszystkie ogniwa.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319798
    m_Localized: Hej, [g:zapomniałem|zapomniałam] przygotować się na konserwację.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319799
    m_Localized: Oczywiście znowu [g:zapomniałem|zapomniałam] o planowej konserwacji…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319800
    m_Localized: Masz ogniwa? Nie muszą być w pełni naładowane.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319801
    m_Localized: Jeśli masz ogniwa energetyczne, chętnie kupię.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319802
    m_Localized: Potrzebuję ogniw energetycznych. Gdyby światło się szybko nie włączyło.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319803
    m_Localized: To niedorzeczne! Brak prądu?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319804
    m_Localized: Musze iść schodami. *Schodami*!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319805
    m_Localized: Niewyobrażalne, że na <b>Wyższych Poziomach</b> nie ma prądu!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319806
    m_Localized: Masz ogniwa energetyczne? Zapłacę dowolną cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319807
    m_Localized: Daj mi ogniwa, mam pełno kredytów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319808
    m_Localized: Ludzie wariują od tego blackoutu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319809
    m_Localized: Ktoś rozwalił miejscówkę tuż obok. Wiem, że jestem [g:następny|następna].
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319810
    m_Localized: Muszę ochronić mój sklep i nie liczę na Ochronę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319811
    m_Localized: Robi się niedobrze, naprawdę niedobrze. Trzeba się przygotować.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319812
    m_Localized: Masz coś do odstraszenia rabusiów? Starczy rura.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319813
    m_Localized: Masz jakąś broń? Wezmę cokolwiek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319814
    m_Localized: Coś mocnego, głośnego lub ostrego. Wezmę, co masz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319815
    m_Localized: Przedawkowanie Oxymore staje się poważnym problemem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319816
    m_Localized: Mam darmowy Naloxgone, pomoże.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319817
    m_Localized: Rozdasz wszystko potrzebującym?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319818
    m_Localized: Wracam właśnie z Doków…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319819
    m_Localized: Wyładowali dostawę podrobionych papierosów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319820
    m_Localized: Mogą się pojawić podróbki.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319821
    m_Localized: Mam tu coś, co pomoże odkryć fałszywki.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319822
    m_Localized: Użyj szkła powiększającego na paczce papierosów, by ją zbadać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319823
    m_Localized: Sprawdź informacje w podręczniku.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319824
    m_Localized: Jeśli znajdziesz nieprawidłowości, możesz skonfrontować się z klientem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319825
    m_Localized: Wystarczy jeden problem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319826
    m_Localized: Jeśli masz rację, obniżą cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319827
    m_Localized: Jeśli mylnie kogoś oskarżysz, stracisz reputację.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319828
    m_Localized: Powodzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319829
    m_Localized: Hej, dopiero się otworzyliście, nie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319830
    m_Localized: Pracuję dla <b>dozorców Niższych Poziomów</b>.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319831
    m_Localized: Dopiero zaczynasz
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319832
    m_Localized: Powiem ci więc, jak się sprawy mają.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319833
    m_Localized: '<b>NIE</b> masz prawa do sprzątania witryny.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319834
    m_Localized: Jeśli chcesz, żeby ktoś uprzątnął witrynę…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319835
    m_Localized: Musisz <u>uiścić opłaty</u>.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319836
    m_Localized: A jeśli postanowisz sprzątnąć witrynę samodzielnie…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319837
    m_Localized: To tego pożałujesz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319838
    m_Localized: Do zobaczenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319839
    m_Localized: Hej, nadal tu jesteś.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319840
    m_Localized: Zdradzę ci małą tajemnicę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319841
    m_Localized: Dozorcy mają mały biznes na boku.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319842
    m_Localized: Prowadzimy Podziemną Giełdę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319843
    m_Localized: Działa to tak. Wrzucasz konkretny przedmiot do kosza na śmieci…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319844
    m_Localized: korzystasz z usług dozorców,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319845
    m_Localized: a my rano zostawiamy ci coś w zamian.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319846
    m_Localized: Oto lista. Niektóre pozycje zmieniają się co kilka dni.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319847
    m_Localized: Co jest najlepszego w Podziemnej Giełdzie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319848
    m_Localized: Nie śledzi jej Ochrona.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319849
    m_Localized: Na razie, świeżaku.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319850
    m_Localized: Hej, zgodnie z naszą umową
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319851
    m_Localized: należysz teraz do Podziemnej Giełdy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319852
    m_Localized: Oto lista. Niektóre pozycje zmieniają się co kilka dni.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319853
    m_Localized: Wrzucasz odpowiedni przedmiot do kosza.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319854
    m_Localized: Korzystasz z usług dozorców,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319855
    m_Localized: a my rano zostawimy ci coś w zamian.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319856
    m_Localized: Pamiętaj, Podziemna Giełda
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319857
    m_Localized: nie jest śledzona przez Ochronę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319858
    m_Localized: Witamy w naszej sieci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319859
    m_Localized: Dzień dobry! <wave a=0.25>Witamy w sąsiedztwie!</wave>
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319860
    m_Localized: Jestem <slide a=0.25>Joe Wild!</slide>
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319861
    m_Localized: Jak pewnie wiesz…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319862
    m_Localized: Nasz sektor mimo swego uroku nie jest zbyt bezpieczny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319863
    m_Localized: Nawet jak na Niższe Poziomy…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319864
    m_Localized: Dlatego zapewniam <i>ubezpieczenie!</i>
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319865
    m_Localized: Właścicielom mikroprzedsiębiorstw, jak ty.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319866
    m_Localized: To subskrypcja dzienna,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319867
    m_Localized: która ubezpiecza wszystkie dobra na wypadek kradzieży!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319868
    m_Localized: Możesz się zapisać lub zrezygnować przed snem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319869
    m_Localized: To wszystko z mojej strony. Powodzenia!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319870
    m_Localized: To znowu ja!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319871
    m_Localized: Widzę, że interes się kręci!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319872
    m_Localized: Wiesz, tu, na dole…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319873
    m_Localized: Liczy się to, kogo znasz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319874
    m_Localized: Oczywiście ma to cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319875
    m_Localized: Mogę przedstawić cię znajomym.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319876
    m_Localized: Dostawcom, informatorom, nawet funkcjonariuszom Ochrony!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319877
    m_Localized: Oto, co mogę dla ciebie zrobić…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319878
    m_Localized: Dzień dobry!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319879
    m_Localized: Liczę, że wszystko OK!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319880
    m_Localized: Nie wiem, czy to wiesz,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319881
    m_Localized: ale mogę zapewnić ci dostęp do publicznego systemu zapotrzebowań rynkowych.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319882
    m_Localized: Możesz spełniać bezpośrednio zapotrzebowania mieszkańców,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319883
    m_Localized: co zawsze polecam właścicielom biznesów!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319884
    m_Localized: Chcesz spojrzeć?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319885
    m_Localized: Pamiętaj, dzwoń, jeśli potrzebujesz pomocy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319886
    m_Localized: Kupujesz jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319887
    m_Localized: Mam do sprzedania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319888
    m_Localized: Macie jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319889
    m_Localized: Muszę się zaopatrzyć.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319890
    m_Localized: Dzień dobry. Jestem oficer Lun.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319891
    m_Localized: Pracuję na Wydziale Ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319892
    m_Localized: Zgodnie z wytycznymi…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319893
    m_Localized: Pod ladą znajduje się przycisk alarmowy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319894
    m_Localized: Oto lista poszukiwanych kryminalistów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319895
    m_Localized: Jeśli jakiś się pojawi,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319896
    m_Localized: '<u><b>NIE słuchaj, co mówią!</u></b>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319897
    m_Localized: Zanim odejdą, włącz alarm.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319898
    m_Localized: A my zrobimy swoje.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319899
    m_Localized: Zgłaszaj ich, jeśli to na pewno oni.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319900
    m_Localized: Za fałszywe zgłoszenia są kary.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319901
    m_Localized: Bezpiecznej zmiany.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319902
    m_Localized: Tu oficer Lun.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319903
    m_Localized: Mam nadzieję, że pamiętasz o liście poszukiwanych.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319904
    m_Localized: Mam tu nowe polecenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319905
    m_Localized: '<u><b>Zgłaszać sprzedających kontrabandę średniego lub wyższego poziomu.</u></b>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319906
    m_Localized: Kontrabanda niskiego poziomu nie jest tego warta.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319907
    m_Localized: Twoja reputacja może się pogorszyć…
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319908
    m_Localized: Ale nagrodzimy cię w zależności od ilości przejętej kontrabandy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319909
    m_Localized: Bezpiecznej zmiany.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319910
    m_Localized: '[g:Znalazłem|Znalazłam] wczoraj skrzynkę PIĘSA!'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319911
    m_Localized: 15% zniżki, jak weźmiesz wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319912
    m_Localized: No hej, mam pełno złomu!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319913
    m_Localized: Chcesz? 33% na całość.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319914
    m_Localized: '*Jeśli* to kupisz…'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319915
    m_Localized: Będziesz potrzebować pieca.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319916
    m_Localized: Możesz przetopić to na sztabki.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319917
    m_Localized: I nieźle na tym zarobić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319918
    m_Localized: Co tam?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319919
    m_Localized: Mam tu oryginalne papierosy Hemingway.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319920
    m_Localized: Reflektujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319921
    m_Localized: Hej! Patrz, co mam!
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319922
    m_Localized: Jest plomba i w ogóle.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319923
    m_Localized: Pewnie to sporo warte?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319924
    m_Localized: Dzień dobry, jestem z Rady Rzeczoznawców.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319925
    m_Localized: Niektóre przedmioty mają kompleksową strukturę wyceny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319926
    m_Localized: Pomagamy oceniać klientom ich dokładną wartość.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319927
    m_Localized: Słyszałam, że dopiero zaczynasz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319928
    m_Localized: Twój sklep mógłby oferować rzeczoznawstwo.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319929
    m_Localized: Byłoby dodatkowym źródłem dochodów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319930
    m_Localized: Chcesz dołączyć do Rady Rzeczoznawców?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319931
    m_Localized: Członkostwo kosztuje tylko {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319932
    m_Localized: '[Dołącz ({0:plural:{} kredyt|{} kredyty|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319933
    m_Localized: '[Nie dołączaj]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319934
    m_Localized: '[Poproś, by wróciła później]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319935
    m_Localized: Świetnie! Witamy w Radzie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319936
    m_Localized: Oto podręcznik szkoleniowy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319937
    m_Localized: Zaczniemy kierować do ciebie klientów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319938
    m_Localized: Wrócę za kilka dni sprawdzić, jak leci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319939
    m_Localized: Szkoda, potrafię rozpoznać jakość.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319940
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319941
    m_Localized: Pewnie, wrócę za kilka dni.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319942
    m_Localized: Dzień dobry, jestem z Rady Rzeczoznawców.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319943
    m_Localized: Byłam tu kilka dni temu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319944
    m_Localized: I jak? Wiesz już, co chcesz zrobić?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319945
    m_Localized: Wrócę za kilka dni sprawdzić, jak leci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319946
    m_Localized: Cześć, mam paczkę *oryginalnych* papierosów Hemingway.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319947
    m_Localized: Kupujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319948
    m_Localized: Hej, mam trochę dodatkowej wody na sprzedaż.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319949
    m_Localized: Chcesz kupić? To podstawoda.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319950
    m_Localized: Hej, masz podstawodę?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319951
    m_Localized: Idę na szukać złomu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319952
    m_Localized: Nie, potrzebuję podstawody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319953
    m_Localized: Tak, o to chodzi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319954
    m_Localized: Chcę kupić jedzenie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319955
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów} do wydania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319956
    m_Localized: Hej, masz jakieś przekąski lub słodycze?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319957
    m_Localized: Czipsy, cukierki lub czekoladę?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319958
    m_Localized: Albo papierosy… Kupię papierosy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319959
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów} do wydania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319960
    m_Localized: Hej, masz piwo?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319961
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów} do wydania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319962
    m_Localized: Masz jedzenie albo napoje?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319963
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319964
    m_Localized: Szukam różnych towarów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319965
    m_Localized: Dlatego nie kupię dwóch takich samych towarów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319966
    m_Localized: Ale chętnie zapłacę więcej.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319967
    m_Localized: Dzień dobry, jestem z Pierwszego Banku z Wyższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319968
    m_Localized: Chcę tylko dać znać,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319969
    m_Localized: że ten budynek został wystawiony na sprzedaż,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319970
    m_Localized: możemy pomóc ci przy jego kupnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319971
    m_Localized: Cena to 40 000 kredytów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319972
    m_Localized: Ale z naszym kredytem hipotecznym będzie cię na to stać wcześniej.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319973
    m_Localized: Wrócę ze szczegółami,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319974
    m_Localized: kiedy będziesz mieć gotówkę na zadatek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319975
    m_Localized: Dzień dobry, jestem z Pierwszego Banku z Wyższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319976
    m_Localized: Nasze analizy wskazują,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319977
    m_Localized: że twój interes się kręci,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319978
    m_Localized: a właściciel wystawił budynek na sprzedaż
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319979
    m_Localized: 40 000 kredytów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319980
    m_Localized: Jesteśmy gotowi udzielić ci kredytu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514048
    m_Localized: Jeśli chcesz kupić ten budynek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514049
    m_Localized: Oto szczegóły.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514050
    m_Localized: Popatrz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514051
    m_Localized: Ze względu na ryzyko pożyczkowe na Niższych Poziomach
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514052
    m_Localized: wymagamy 20% zadatku w wysokości 8000 kredytów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514053
    m_Localized: Roczne oprocentowanie to 75%.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514054
    m_Localized: Dzień dobry, zajmuję się pożyczkami w Pierwszym Banku,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514055
    m_Localized: rozmawialiśmy tydzień temu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514056
    m_Localized: Jak się zapatrujesz na perspektywę kupna budynku
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514057
    m_Localized: i zaciągnięcia u nas kredytu hipotecznego?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514058
    m_Localized: Cześć! Widzę cię pierwszy raz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514059
    m_Localized: Witam, mów mi Dr Jackson.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514060
    m_Localized: Współpracowałem z poprzednim sklepikarzem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514061
    m_Localized: Aż go aresztowali!
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514062
    m_Localized: W każdym razie, tworzę różne gadżety.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514063
    m_Localized: Gadżety, które pomagają w działalności.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514064
    m_Localized: '<u>Większość moich maszyn pracuje przez noc.</u>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514065
    m_Localized: '<u>Wymagają też oddzielnego ogniwa.</u>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514066
    m_Localized: A skoro zaczynamy współpracę…
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514067
    m_Localized: Na pierwszy zakup dam specjalną zniżkę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514068
    m_Localized: Ten piec przetapia złom i rudę w wartościowe sztabki.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514069
    m_Localized: Umowa stoi!
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514070
    m_Localized: A oto mały prezent.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514071
    m_Localized: Odwiedź mnie w moim warsztacie, kiedy zamkniesz sklep.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514072
    m_Localized: Kupuję różne materiały.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514073
    m_Localized: I pokażę ci moje nowe wynalazki!
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514074
    m_Localized: Do zobaczenia!
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514075
    m_Localized: Cześć! Popatrz no!
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514076
    m_Localized: W niektórych maszynach można instalować moduły.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514077
    m_Localized: Poprawią ich działanie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514078
    m_Localized: Chcesz? Dam ci jednorazową zniżkę dla „przyjaciół nauki”.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514079
    m_Localized: Dobrze!
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514080
    m_Localized: Pamiętaj, zawsze mnie możesz odwiedzić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514081
    m_Localized: Jak już zakończysz dzień, oczywiście.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514082
    m_Localized: Do zobaczenia!
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514083
    m_Localized: Informator z Ochrony mi to przekazał.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514084
    m_Localized: Jeśli Ochrona będzie podejrzewać zbyt wiele przestępstw…
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514085
    m_Localized: Rozpocznie śledztwo.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514086
    m_Localized: Gdy zdobędą dowody, nałożą wyrok.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514087
    m_Localized: Gdy popełnisz przestępstwo, lepiej nie zwracaj na siebie uwagi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514088
    m_Localized: Przynajmniej aż sytuacja się uspokoi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514089
    m_Localized: I proszę uważaj, z kim handlujesz kontrabandą.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514090
    m_Localized: Niektórzy lubią chlapać jęzorem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514091
    m_Localized: Daję ci znać…
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514092
    m_Localized: Rada Handlowa będzie niebawem wymagać pozwolenia na handel.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514093
    m_Localized: Z tego, co wiem, zaczną je sprzedawać za dwa tygodnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514094
    m_Localized: Pozwolenie powinno kosztować około {0:plural:{} kredyt|{} kredytów|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514095
    m_Localized: Inspekcje zaczną się tydzień później.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514096
    m_Localized: Jeśli do tego czasu nie zdobędziesz kredytów…
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514097
    m_Localized: Może jakoś inaczej się z nimi dogadasz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514098
    m_Localized: Rada Handlowa potrafi być <i>elastyczna</i>…
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514099
    m_Localized: Jeśli kupisz pozwolenie…
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514100
    m_Localized: Pamiętaj, żeby starczyło ci na czynsz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514101
    m_Localized: Hej, mam tu zepsute maszyny,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514102
    m_Localized: Jeśli masz narzędzia, jak spawarka albo śrubokręt,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514103
    m_Localized: pewnie możesz wydobyć z nich części.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514104
    m_Localized: Możesz nieźle zarobić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514105
    m_Localized: Cześć, masz może jakieś części elektryczne?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514106
    m_Localized: W Wydziale Inżynieryjnym już nie ma.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514107
    m_Localized: Coraz ciężej je znaleźć.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514108
    m_Localized: Przylatujące statki nam ich nie zapewniają.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514109
    m_Localized: Jeśli nic się nie zmieni,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514110
    m_Localized: ta stacja kiedyś się rozpadnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514111
    m_Localized: Kupię też materiały i moduły.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514112
    m_Localized: Oxymore, Proszek Snów, cokolwiek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514113
    m_Localized: Mam przed sobą długą ekspedycję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514114
    m_Localized: Znowu udajemy się na pas asteroid.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514115
    m_Localized: Szychta trwa 12 godzin.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514116
    m_Localized: Potrzebuję czegoś, żeby wytrzymać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514117
    m_Localized: '*Podchodzi szybko do witryny*'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514118
    m_Localized: Mam tu leki.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514119
    m_Localized: Muszę wszystko sprzedać. Dzisiaj.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514120
    m_Localized: 33% zniżki, jak weźmiesz całość.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514121
    m_Localized: Klinika poprosiła o zdobycie wyrobów medycznych.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514122
    m_Localized: Jest oblegana.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514123
    m_Localized: Pracujemy całą dobę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514124
    m_Localized: Funkcjonujemy dzięki datkom
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514125
    m_Localized: i nie starcza nam lekarstw,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514126
    m_Localized: a bez nich nic nie zrobimy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514127
    m_Localized: Wezmę wszystko, nawet domowej roboty.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514128
    m_Localized: '<i>*KASZLE*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514129
    m_Localized: Dzień dobry, masz wodę wysokiej jakości?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514130
    m_Localized: W klinice mówili, że [g:piłem|piłam] za dużo kiepskiej wody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514131
    m_Localized: Przez miesiąc muszę pić wodę wysokiej jakości.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514132
    m_Localized: Inaczej nie wyzdrowieję.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514133
    m_Localized: Ale jest naprawdę droga.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514134
    m_Localized: Tak, wezmę to.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514135
    m_Localized: Właśnie wracam z poszukiwań złomu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514136
    m_Localized: Na Stacji jest coraz mniej rzeczy do znalezienia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514137
    m_Localized: Wyczyścili wszystko oprócz zamkniętych Opuszczonych Sekcji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514138
    m_Localized: Podobno złomiarze atakują się tam nawzajem,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514139
    m_Localized: a potem sprzedają złupiony sprzęt.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514140
    m_Localized: Na śmietnisku jest bezpieczniej,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514141
    m_Localized: ale trudno znaleźć cokolwiek wartościowego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514142
    m_Localized: Popatrz, co mam.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514143
    m_Localized: 25% zniżki, jak weźmiesz wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514144
    m_Localized: Hej, masz jakieś przekąski lub słodycze?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514145
    m_Localized: Tabletki kofeinowe albo papierosy?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514146
    m_Localized: Kolejny patrol na Niższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514147
    m_Localized: Czuję, że w każdej chwili mogę dostać nożem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514148
    m_Localized: Nie mogę się doczekać awansu
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514149
    m_Localized: i przydziału na Wyższych Poziomach,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514150
    m_Localized: albo przynajmniej na Średnich…
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514151
    m_Localized: Hej. Masz jakieś leki?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514152
    m_Localized: Potrzebuję ich, postrzelili mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514153
    m_Localized: Nie mogę iść do kliniki, za duże ryzyko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514154
    m_Localized: Jacyś gangsterzy wleźli na nasz teren,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514155
    m_Localized: próbują sprzedawać swój towar.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514156
    m_Localized: Nie pozwolimy na to.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514157
    m_Localized: Witam, sklepikarzu!
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514158
    m_Localized: Odwiedzam Niższe Poziomy
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514159
    m_Localized: i obserwuję, jak tu żyjecie!
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514160
    m_Localized: Muszę powiedzieć, że kultura Niższych Poziomów jest czarująca.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514161
    m_Localized: Na górze jest naprawdę nudno.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514162
    m_Localized: Identyczni ludzie robią identyczne rzeczy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514163
    m_Localized: Chcę kupić pamiątki.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514164
    m_Localized: Coś typowego dla Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514165
    m_Localized: Prowizoryczne przedmioty, przetworzone jedzenie, prosta broń,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514166
    m_Localized: dobry towar, który bierzecie dla zabawy. *mruga*
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514167
    m_Localized: Szukam różnych rzeczy i dobrze za nie zapłacę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514168
    m_Localized: Hej. Masz broń, jedzenie lub pancerze?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514169
    m_Localized: Dopiero zaczynasz, co? Widzę cię pierwszy raz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514170
    m_Localized: Konsultuję sprawy ochrony dla małych firm.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514171
    m_Localized: Załatw sobie alarm, jeśli jeszcze go nie masz.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514172
    m_Localized: Na Niższych Poziomach jest teraz więcej gangów niż kiedykolwiek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514173
    m_Localized: Pewnie ktoś próbował ci już sprzedać <i>„ubezpieczenie”</i>.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514174
    m_Localized: To jak, masz coś?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514175
    m_Localized: Hej, masz jedzenie lub wodę?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514176
    m_Localized: Będę tu cały dzień, naprawiając rzeczy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514177
    m_Localized: Jakiś szalony złomiarz znowu
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514178
    m_Localized: ściągnął metalową osłonę ze wspornika.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514179
    m_Localized: Pewnie zaraz zaczną wyrywać
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514180
    m_Localized: miedziane przewody z systemów podtrzymywania życia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514181
    m_Localized: '<i>*wzdycha*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514182
    m_Localized: Wygląda dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514183
    m_Localized: Hej, wracam z poszukiwania złomu wokół Stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514184
    m_Localized: Kosmiczne śmieci i wraki statków handlowych to kopalnie złota.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514185
    m_Localized: Inwestycja w holownik okazała się strzałem w dziesiątkę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514186
    m_Localized: Złomiarze walczą ze sobą o złom
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514187
    m_Localized: w Opuszczonych Sekcjach.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514188
    m_Localized: A ja się relaksuję na statku.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514189
    m_Localized: '<i>*DRŻY*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514190
    m_Localized: Hej, nie czuję się za dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514191
    m_Localized: Potrzebuję leków, ale nie mam za dużo kredytów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514192
    m_Localized: '[g:Próbowałem|Próbowałam] w klinice Niższych Poziomów,'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514193
    m_Localized: ale kolejki są tak długie,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514194
    m_Localized: że nie widać drzwi…
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514195
    m_Localized: Wiem, że robią to charytatywnie,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514196
    m_Localized: ale nie obsłużą każdego z Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514197
    m_Localized: Dzień dobry.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514198
    m_Localized: Sprzedajesz jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514199
    m_Localized: Ktoś włamał mi się do domu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514200
    m_Localized: Zniknęło jedzenie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514201
    m_Localized: To chyba moi sąsiedzi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514202
    m_Localized: Są biedni, nie winię ich.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514203
    m_Localized: W zasadzie tylko złomiarze i kryminaliści mają pracę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514204
    m_Localized: Dzień dobry, chcę to sprzedać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514205
    m_Localized: To moja broń z czasów Drugiej Rewolucji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514206
    m_Localized: Nie będę jej już używać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514207
    m_Localized: '[g:Trzymałem|Trzymałam] ją te wszystkie lata,'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514208
    m_Localized: licząc, że dołączę do kolejnej rewolucji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514209
    m_Localized: Ale nigdy nie wybuchła, a lata robią swoje.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514210
    m_Localized: '[g:Walczyłeś|Walczyłaś] w rewolucji na Niższych Poziomach?'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514211
    m_Localized: Tak, jako [g:dowódca|dowódczyni] oddziału.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514212
    m_Localized: Myśleliśmy, że mamy szansę na dokonanie zmian.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514213
    m_Localized: Ale to nas przerosło.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514214
    m_Localized: Tak jak Pierwsza Rewolucja.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514215
    m_Localized: Jeśli to kupisz,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514216
    m_Localized: chętnie wezmę jedzenie, napoje i artykuły domowe.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514217
    m_Localized: Wygląda dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514218
    m_Localized: Błagam, to pilne.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514219
    m_Localized: Szukam różnych narzędzi, broni i leków.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514220
    m_Localized: Moja dziewczyna poszła szukać złomu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514221
    m_Localized: Udała się do Opuszczonych Sekcji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514222
    m_Localized: Jeszcze nie wróciła.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096960
    m_Localized: Martwię się, że coś się stało.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096961
    m_Localized: '[g:Mówiłem|Mówiłam], że to nie jest tego warte,'
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096962
    m_Localized: ale nie chciała słuchać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096963
    m_Localized: Muszę ją znaleźć.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096964
    m_Localized: Ty tam, mam do sprzedania Pożywnowoce.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096965
    m_Localized: Łatwo je uprawiać, są odporne na szkodniki i choroby.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096966
    m_Localized: Szkoda, że nasiona są tak cholernie drogie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096967
    m_Localized: Dlaczego zrobili tak, że te bulwy się nie rozrastają?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096968
    m_Localized: Hej, masz jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096969
    m_Localized: Od wieków nie [g:byłem|byłam] na Niższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096970
    m_Localized: '[g:Przeprowadziłem|Przeprowadziłam] się na górę po wygraniu loterii.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096971
    m_Localized: Loteria Niższych Poziomów zaczęła się jakiś czas temu,
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096972
    m_Localized: Tuż po zakończeniu Drugiej Rewolucji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096973
    m_Localized: Czasami tęsknię za tutejszym tanim, smacznym jedzeniem.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096974
    m_Localized: Hej, mam całą skrzynkę PIĘSA!
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096975
    m_Localized: Zastanawiasz się czasem, z czego jest to mięso?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096976
    m_Localized: Większość myśli, że ze świń hodowanych komercyjnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096977
    m_Localized: Inni, że to sztucznie tworzone proteiny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096978
    m_Localized: Co ja myślę? To owady.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096979
    m_Localized: Chcesz kupić?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096980
    m_Localized: Witam, jak się masz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096981
    m_Localized: Wiesz, że Dowództwo Stacji to obcy?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096982
    m_Localized: Sama Stacja to wielki eksperyment społeczny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096983
    m_Localized: Badają nas, zanim napadną na samą Republikę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096984
    m_Localized: Czy to nie wygodne, że Republika jest tak daleko?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096985
    m_Localized: A Ochrona to androidy!
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096986
    m_Localized: Zespół kolapsu immunologicznego stworzono w laboratorium!
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096987
    m_Localized: Rewolucję założyło Dowództwo!
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096988
    m_Localized: Wiem, jak się chronić przed obcymi. Chcesz zobaczyć?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096989
    m_Localized: Nie martw się, to domowej roboty.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096990
    m_Localized: Masz coś dobrego?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096991
    m_Localized: Najlepiej Proszek Snów?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096992
    m_Localized: Dzień dobry. Mocodawcy wysłali mnie za zapasami.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096993
    m_Localized: Nadal nie wierzę, że to robią.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096994
    m_Localized: Organizują „złomiarską” imprezę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096995
    m_Localized: Goście z Wyższych Poziomów przebiorą się za złomiarzy,
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096996
    m_Localized: będą jeść jedzenie stąd z blaszanych tac.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096997
    m_Localized: Jest też konkurs na najbardziej „autentyczny” strój.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096998
    m_Localized: Oceniany przez ludzi, którzy nie znają tego życia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096999
    m_Localized: I to ma być śmieszne?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097000
    m_Localized: Chcę się pozbyć odpadów niebezpiecznych.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097001
    m_Localized: Prawidłowa procedura jest droga.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097002
    m_Localized: Zapłacę 100 kredytów za beczkę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097003
    m_Localized: '[Weź 1 beczkę]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097004
    m_Localized: '[Weź 3 beczki]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097005
    m_Localized: '[Weź 5 beczek]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097006
    m_Localized: Hej, potrzebuję zmodyfikowanej broni.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097007
    m_Localized: Potrzebuję zmodyfikowanej broni. Pomożesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097008
    m_Localized: Szukam zmodyfikowanej broni.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097009
    m_Localized: Mam zamówienie na broń.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097010
    m_Localized: Potrzebuję czegoś zmodyfikowanego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097011
    m_Localized: Mam spluwy do sprzedania w dobrym stanie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291264
    m_Localized: Kupujesz broń? Mam tu niezłą.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291265
    m_Localized: Mam coś, co nadal strzela. Chcesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291266
    m_Localized: Pozbywam się sprzętu, mam modyfikacje i magazynki.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291267
    m_Localized: Potrzebuję kasy, to moja zapasowa broń.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291268
    m_Localized: Raz mnie uratowała. Kupujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291269
    m_Localized: Witam, mam informacje, które mogą cię zainteresować,
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291270
    m_Localized: ale to będzie kosztować.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291271
    m_Localized: Dobra decyzja.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291272
    m_Localized: Słuchaj,
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291273
    m_Localized: na ulicach mówią,
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291274
    m_Localized: że za trzy dni będą zbiory na dużej farmie Pożywnowoców.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291275
    m_Localized: Po nich ceny jedzenia na rynku mocno spadną.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291276
    m_Localized: To wszystko, do zobaczenia.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291277
    m_Localized: Cześć, wiem coś ważnego,
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291278
    m_Localized: Hej, mam poufne informacje,
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291279
    m_Localized: Dzień dobry, przypadkiem wiem coś poufnego,
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291280
    m_Localized: może cię to zainteresuje.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291281
    m_Localized: może ci się to opłacić.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291282
    m_Localized: na pewno chcesz to wiedzieć.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291283
    m_Localized: to może zmienić twoje życie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291284
    m_Localized: Ale to będzie kosztować.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291285
    m_Localized: Ale nie za darmo.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291286
    m_Localized: Ale chcę za to kredytów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291287
    m_Localized: Żeby było jasne, to ma swoją cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291288
    m_Localized: Miłego.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291289
    m_Localized: Proszę, proszę. Kogo my tu mamy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291290
    m_Localized: Mamy już dosyć twoich zagrywek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291291
    m_Localized: Pozbędziemy się ciebie raz na zawsze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291292
    m_Localized: SPUŚCIĆ ŁOMOT!
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291293
    m_Localized: Witam, sklepikarzu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291294
    m_Localized: Za przestępstwa przeciwko Stacji
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291295
    m_Localized: aresztujemy cię.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291296
    m_Localized: Wyższe Poziomy pozdrawiają.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291298
    m_Localized: Uwolniliśmy ciemiężycieli od ciężaru zasobów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291299
    m_Localized: Wolimy sprzedać je tobie, niż żeby gniły na salonach.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291300
    m_Localized: Wszystkie dochody napędzą sprawę Rewolucji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291301
    m_Localized: Cześć, mamy coś do sprzedania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291302
    m_Localized: To wszystko pochodzi od ludu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291303
    m_Localized: Wszelkie dochody przysłużą się rewolucji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291305
    m_Localized: '<i>*wyjmuje broń*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291306
    m_Localized: Proszę, powiedz, że masz jedzenie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291307
    m_Localized: '[g:Pytałem|Pytałam] w innych sklepach, ale im się skończyło.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291308
    m_Localized: Hej, masz jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291309
    m_Localized: Ceny żarcia szaleją.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291310
    m_Localized: Zostały ci jakieś leki?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291311
    m_Localized: Nie ma ich w żadnym sklepie!
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291312
    m_Localized: Szukam wyrobów medycznych.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291313
    m_Localized: Ostatnimi czasy ceny są niedorzeczne.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291314
    m_Localized: Masz coś, co mnie wyluzuje?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291315
    m_Localized: Wszędzie skończył się towar, zaraz oszaleję!
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291316
    m_Localized: Masz coś, co mnie zrelaksuje?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291317
    m_Localized: Ceny idą w górę, zapłacę, ile mogę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291318
    m_Localized: Potrzebuję ochrony. Wezmę cokolwiek.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291319
    m_Localized: W sklepach pustki, a idą kłopoty.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291320
    m_Localized: Szukam broni i pancerzy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291321
    m_Localized: Robi się ciężko, lepiej się przygotować.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291322
    m_Localized: Masz złom albo nieprzetworzone materiały?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291323
    m_Localized: Warsztaty się zamykają, nie ma towaru.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291324
    m_Localized: Szukam materiałów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291325
    m_Localized: Ceny szaleją, wszyscy chomikują rzeczy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291326
    m_Localized: '<i>*głosy w radio*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291327
    m_Localized: Hm, w tajemniczy sposób dowody przeciwko tobie zniknęły.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291328
    m_Localized: Nie wiem, jak ci się to udało, ale kiedyś cię dopadniemy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291329
    m_Localized: Dzień dobry, mamy dowody na popełnienie przez ciebie licznych przestępstw.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291330
    m_Localized: 'W tym: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291331
    m_Localized: Musisz zapłacić karę w wysokości {0:plural:{} kredytu|{} kredytów|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291332
    m_Localized: W przeciwnym wypadku natychmiast cię aresztujemy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291333
    m_Localized: '[Zapłać ({0:plural:{} kredyt|{} kredyty|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291334
    m_Localized: Dobrze. I bez kombinowania.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291335
    m_Localized: '[Nie płać kary]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291336
    m_Localized: Więc cię aresztujemy!
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291337
    m_Localized: Możesz zachować milczenie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291338
    m_Localized: Stać! Aresztujemy cię!
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291339
    m_Localized: 'Za: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291340
    m_Localized: Będziesz długo siedzieć.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291341
    m_Localized: Możesz zachować milczenie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291342
    m_Localized: Ręce do góry! Aresztujemy cię!
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291343
    m_Localized: 'Za: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291344
    m_Localized: Karą za twoje przestępstwa jest egzekucja.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291345
    m_Localized: Dzień dobry, w związku z twoją niedawną aktywnością
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291346
    m_Localized: niniejszym anulujemy pozwolenie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291347
    m_Localized: Bezpiecznej zmiany.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291348
    m_Localized: Dobra decyzja.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291349
    m_Localized: Mądry wybór.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291350
    m_Localized: To dobra decyzja.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291352
    m_Localized: Słuchaj.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291353
    m_Localized: Za {0:plural:{} dzień|{} dni|{} dni} będą zbiory na dużej farmie Pożywnowoców.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291354
    m_Localized: Za {0:plural:{} dzień|{} dni|{} dni} zaczną się żniwa na dużej farmie Pożywnowoców.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291355
    m_Localized: Za {0:plural:{} dzień|{} dni|{} dni} duża farma Pożywnowoców zacznie zbiory.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291357
    m_Localized: Będzie pełno Pożywnowoców, a ceny spadną.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291358
    m_Localized: Spodziewaj się nadmiaru Pożywnowoców, ceny zanurkują.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291359
    m_Localized: Przygotuj się na zalew Pożywnowoców i niższe ceny.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291361
    m_Localized: Rynek żywności będzie w dołku przez {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291362
    m_Localized: Ceny żywności będą spadać przez {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291363
    m_Localized: To znaczy, że ceny jedzenia będą niskie przez około {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291365
    m_Localized: Dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291366
    m_Localized: Słuchaj uważnie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291367
    m_Localized: Za {0:plural:{} dzień|{} dni|{} dni} ważna niskopoziomowa farma Pożywnowoców będzie miała kiepskie zbiory.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291368
    m_Localized: A ceny jedzenia wzrosną na {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291369
    m_Localized: Dobra, to wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291370
    m_Localized: Dobra, słuchaj.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291371
    m_Localized: To nie ja ci {g:powiedziałem|powiedziałam}, OK?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291373
    m_Localized: Oto informacje.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291374
    m_Localized: Za {0:plural:{} dzień|{} dni|{} dni} będzie niedobór lekarstw.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291375
    m_Localized: Mówi się, że za {0:plural:{} dzień|{} dni|{} dni} na Stacji zabraknie leków.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291376
    m_Localized: Kończą się zapasy, a za {0:plural:{} dzień|{} dni|{} dni} będzie kiepsko.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291378
    m_Localized: Ceny wyśrubują się na {0:plural:{} dzień|{} dni|{} dni}, więc nie czekaj.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291379
    m_Localized: Po tym ceny lekarstw będą rosnąć przez {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291380
    m_Localized: Będzie mało leków, a ceny będą rosnąć przez {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291382
    m_Localized: Nie uwierzysz, co się stało…
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291383
    m_Localized: Mam gorącą plotkę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291384
    m_Localized: Słuchaj, to nowość.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291385
    m_Localized: To dopiero wskoczyło w obieg.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291386
    m_Localized: Ktoś wpadł na ukryty magazyn pełen artykułów domowych.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291387
    m_Localized: Szukając złomu, znaleźli ukryte pomieszczenie pełne artykułów domowych.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291388
    m_Localized: Złomiarze odkryli ukryty magazyn.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291389
    m_Localized: Właśnie znaleźli ukryty magazyn pełen artykułów domowych.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291390
    m_Localized: To znaczy, że rynek zaleje towar, a ceny spadną.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291391
    m_Localized: Spodziewaj się sporej ilości tanich artykułów domowych na rynku.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291392
    m_Localized: Przy takiej podaży ceny artykułów spadną.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291393
    m_Localized: Nadmiar artykułów domowych doprowadzi do spadku cen.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291394
    m_Localized: Rynek dowie się o tym jutro.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291395
    m_Localized: Będzie tak przez {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291396
    m_Localized: Działaj szybko, masz {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291397
    m_Localized: Rynek odczuwać to będzie przez {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291398
    m_Localized: Ceny będą niskie przez około {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291399
    m_Localized: Mam dla ciebie pogłoski.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291400
    m_Localized: Mam tu nowinkę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291401
    m_Localized: Słuchaj, spodoba ci się.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291402
    m_Localized: Grupka górników wraca ze sporej asteroidy.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291403
    m_Localized: Górnicy wracają z udanej ekspedycji.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291404
    m_Localized: Mówi się, że górnicy trafili na żyłę złota, a raczej minerałów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291405
    m_Localized: Ekipa górnicza wraca z dużą ilością materiałów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291406
    m_Localized: To znaczy, że ceny materiałów spadną.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291407
    m_Localized: Przy takiej ilości materiały będą tanie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291408
    m_Localized: Spodziewaj się spadku ceny materiałów przez podaż.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291409
    m_Localized: Przez ten ładunek ceny materiałów spadną.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291410
    m_Localized: Wracają za {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291411
    m_Localized: Potrwa to {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291412
    m_Localized: Działaj szybko, potrwa to {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291413
    m_Localized: Ceny będą niskie przez następne {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291414
    m_Localized: Masz {0:plural:{} dzień|{} dni|{} dni}, żeby na tym skorzystać.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291415
    m_Localized: Słuchaj.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291416
    m_Localized: Za {0:plural:{} dzień|{} dni|{} dni} dojdzie do awarii zakładu uzdatniania wody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291417
    m_Localized: Będzie brakować wody.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291418
    m_Localized: Ceny poszybują w górę.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291419
    m_Localized: Potrwa to pewnie {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291420
    m_Localized: Dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291421
    m_Localized: Za {0:plural:{} dzień|{} dni|{} dni} górnicy wrócą z lodową wodą. Kapujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291422
    m_Localized: Spodziewaj się zalewu zasobów.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291423
    m_Localized: Ceny spadną.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291424
    m_Localized: Powinno to trwać przez {0:plural:{} dzień|{} dni|{} dni}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902084
    m_Localized: Patrz, co mam.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902085
    m_Localized: To [g:znalazłem|znalazłam].
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902086
    m_Localized: Mam to.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902087
    m_Localized: Zobacz, co udało mi się znaleźć.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902088
    m_Localized: '[g:Znalazłem|Znalazłam] co nieco.'
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902089
    m_Localized: Możesz sprawdzić dla mnie wartość?
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902090
    m_Localized: Powiesz, ile są warte?
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902091
    m_Localized: Ciekawi mnie cena.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902092
    m_Localized: Jaka jest aktualna cena?
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902093
    m_Localized: Wiesz może, ile są warte?
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902094
    m_Localized: Dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902095
    m_Localized: Umowa stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902096
    m_Localized: Dobra.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902097
    m_Localized: Załatwione.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902098
    m_Localized: Świetnie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902099
    m_Localized: Dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902100
    m_Localized: Biorę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902101
    m_Localized: Idealnie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902102
    m_Localized: Pewnie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902103
    m_Localized: Umowa stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902104
    m_Localized: Spadam.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902105
    m_Localized: Tego potrzebuję.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902106
    m_Localized: Do następnego.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902107
    m_Localized: Sama przyjemność.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902108
    m_Localized: Dzięki, na razie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902109
    m_Localized: Do zobaczenia.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902110
    m_Localized: I po sprawie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902111
    m_Localized: Miłego.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096384
    m_Localized: Wrócę niebawem.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096385
    m_Localized: Miłego dnia.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096386
    m_Localized: Dobra, spadam.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096387
    m_Localized: Dziękuję, do zobaczenia.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096388
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096389
    m_Localized: I załatwione.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096390
    m_Localized: To poza moim budżetem.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096391
    m_Localized: To poza budżetem. Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096392
    m_Localized: Mam już taki przedmiot.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096393
    m_Localized: Nie kupuję kontrabandy.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096395
    m_Localized: Dobra, po sprawie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096396
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096397
    m_Localized: Czekaj, to nie koniec!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096398
    m_Localized: '<i>*walenie w roletę*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096399
    m_Localized: Co za maniery!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096400
    m_Localized: Wow, co robisz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096401
    m_Localized: Chcesz kupić coś jeszcze?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096402
    m_Localized: To wszystko?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096403
    m_Localized: Czy coś jeszcze?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096404
    m_Localized: Obserwuję cię, dobrze ci idzie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096405
    m_Localized: Jak już zamkniesz dzisiaj sklep…
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096406
    m_Localized: Powinno starczyć ci czasu na wyjście przed snem.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096407
    m_Localized: Pamiętasz drogę na śmietnisko, nie?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096408
    m_Localized: Hej, chciałem sprawdzić, jak pierwszy dzień.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096409
    m_Localized: Wygląda, że wszystko gotowe.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096410
    m_Localized: Chcę ci to dać.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096411
    m_Localized: '*wyciąga notatki z kieszeni w kurtce i kładzie je na ladzie*'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096412
    m_Localized: Kilka rzeczy, o których nie wolno zapomnieć.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096413
    m_Localized: Pamiętaj, że obydwie strony lady mają być puste, OK?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096414
    m_Localized: Aby klienci mieli miejsce na wyłożenie towarów.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096415
    m_Localized: I nie zostawiaj na zewnątrz niczego na noc.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096416
    m_Localized: Chyba że chcesz, żeby to ukradli.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096417
    m_Localized: Powodzenia, żółtodziobie. Będę patrzeć.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096418
    m_Localized: Dzięki.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096419
    m_Localized: Dzień dobry.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096420
    m_Localized: Mam dla ciebie przydatne informacje.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096421
    m_Localized: Podobno jutro wraca ekspedycja górnicza…
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096422
    m_Localized: Więc rynek zaleją materiały.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096423
    m_Localized: Ceny chwilowo spadną, dopóki podaż będzie przewyższać popyt.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096424
    m_Localized: Postaraj się wykorzystać tę informację.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096425
    m_Localized: Zamówiłem dla ciebie prenumeratę gazety.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096443
    m_Localized: Wszystko dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096444
    m_Localized: Dziękujemy za współpracę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096445
    m_Localized: '[g:Znalazłem|Znalazłam] kontrabandę niskiego poziomu.'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096446
    m_Localized: Na razie dam ci tylko ostrzeżenie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096447
    m_Localized: Ale nie chcę tego tu widzieć.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096448
    m_Localized: To wygląda na kontrabandę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096449
    m_Localized: Konfiskujemy to.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096450
    m_Localized: Bezpiecznej zmiany.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096451
    m_Localized: To wygląda na skradzione przedmioty.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096452
    m_Localized: To kontrabanda!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096453
    m_Localized: Na bok, przeprowadzę pełną kontrolę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096454
    m_Localized: To kradzione!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096455
    m_Localized: Otwórz luk i się odsuń.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096456
    m_Localized: '[Przyjmij kontrolę.]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096457
    m_Localized: '[Daj łapówkę ({0:plural:{} kredyt|{} kredyty|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096458
    m_Localized: Tym razem przymknę na to oko.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096459
    m_Localized: Mamy tu kontrabandę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096460
    m_Localized: Kara wynosi {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096461
    m_Localized: Mam za mało kredytów.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096462
    m_Localized: Więc cię aresztujemy!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096463
    m_Localized: Skonfiskujemy to.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096464
    m_Localized: Musisz też zapłacić {0:plural:{} kredyt|{} kredyty|{} kredytów}. Teraz.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096465
    m_Localized: '[Zapłać grzywnę]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096466
    m_Localized: Dziękujemy za współpracę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096467
    m_Localized: Co to?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096468
    m_Localized: Aresztujemy cię za posiadanie kontrabandy.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096469
    m_Localized: Powinniśmy cię za to aresztować.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096470
    m_Localized: Ale wygląda na to, że masz wpływowych znajomych.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096471
    m_Localized: Następnym razem nie pójdzie tak łatwo.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096472
    m_Localized: Nie wychylaj się.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096473
    m_Localized: Tolerujemy to, ale to wciąż nielegalne.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096474
    m_Localized: Dlaczego mi to pokazujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096475
    m_Localized: Ej! Co się dzieje?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096476
    m_Localized: Czy to jakaś pomyłka?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096477
    m_Localized: Zaraz, co [g:zrobiłem|zrobiłam]?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096478
    m_Localized: Ej, co tu się dzieje?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096479
    m_Localized: Nic nie [g:zrobiłem|zrobiłam].
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096480
    m_Localized: To nie ja, przysięgam.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096481
    m_Localized: Spokojnie! Nie stawiam oporu!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096482
    m_Localized: Cholera.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096483
    m_Localized: Kapuś!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096484
    m_Localized: '[g:Chciałem|Chciałam] zarobić kilka kredytów…'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096485
    m_Localized: EJ! Co się dzieje?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096486
    m_Localized: KURDE!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096487
    m_Localized: TY KAPUSIU!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096488
    m_Localized: JESTEM [g:NIEWINNY|NIEWINNA].
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096489
    m_Localized: KAPUSIU! DORWĘ CIĘ.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096490
    m_Localized: NIE STRZELAJCIE.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096491
    m_Localized: Pójdziesz z nami.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096492
    m_Localized: Spokojnie, idź z nami.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096493
    m_Localized: Prowadzimy wobec ciebie śledztwo. Chodź z nami.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096494
    m_Localized: Nie utrudniaj tego.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096495
    m_Localized: Współpracuj, a niebawem to się skończy.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096496
    m_Localized: Chcemy zadać kilka pytań. Chodź z nami.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096497
    m_Localized: Hmm?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096498
    m_Localized: Pozwól, że coś ci wyjaśnię.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096499
    m_Localized: Nasz mały sektor to ekosystem.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096500
    m_Localized: Bierzesz za dużo i za mało oddajesz…
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096501
    m_Localized: Zaburzasz równowagę, wszystko się rozpada.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096502
    m_Localized: Mogę wyświadczyć ci kilka przysług, a w zamian…
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096503
    m_Localized: Od czasu do czasu zrobisz to samo dla Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096504
    m_Localized: To moja wizytówka.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096505
    m_Localized: Zadzwoń, gdy będziesz czegoś potrzebować.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096543
    m_Localized: Dzień dobry, potrzebuję nowego sprzętu.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096544
    m_Localized: Masz broń, amunicję albo pancerze?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096545
    m_Localized: Kontrabanda mi nie przeszkadza.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096546
    m_Localized: Dzień dobry, mam tu broń.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096547
    m_Localized: Reflektujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096548
    m_Localized: Dzień dobry, mam specjalne przedmioty.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096549
    m_Localized: Tylko dla przyjaciół z Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096550
    m_Localized: Popatrz.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096551
    m_Localized: Hej, podobno można ci ufać.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096552
    m_Localized: Chcesz spojrzeć, co mam?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096553
    m_Localized: Kupię też wszelkie środki chemiczne.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096554
    m_Localized: Dzień dobry, masz pozwolenie na handel.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096555
    m_Localized: Oto nadmiarowy sprzęt.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096556
    m_Localized: 15% zniżki, jak weźmiesz wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096560
    m_Localized: Wow, ale tu surowo. Kocham ten klimat!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096561
    m_Localized: Hej, to miejsce ma swój urok. Superautentyczny.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096562
    m_Localized: '[g:Wsiadłem|Wsiadłam] nie do tej windy, ale sobie tu pomyszkuję.'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096563
    m_Localized: Ta część Stacji ma swój klimat, wiesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096564
    m_Localized: Wszyscy mówili, żeby tu nie schodzić. Więc [g:musiałem|musiałam] to zrobić.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096565
    m_Localized: '[g:Widziałem|Widziałam] vidy o takich miejscach, ale serio? Na żywo to inny stan.'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096566
    m_Localized: Więc… padam z głodu. Masz coś lokalnego do przekąszenia?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096567
    m_Localized: Podobno można się tu zabawić?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096568
    m_Localized: Zjeść coś, wypić… wziąć coś, żeby się wyluzować?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096569
    m_Localized: Masz przekąski, picie albo co tam tu bierzecie, żeby zluzować?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096570
    m_Localized: Cokolwiek jadalnego, pitnego i, eee, rekreacyjnego?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096571
    m_Localized: Jedzenie, woda… coś dla duszy?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096576
    m_Localized: '[g:Przyleciałem|Przyleciałam] z innej stacji. Ależ tu niesamowicie!'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096577
    m_Localized: Mówili, że Niższe Poziomy są podejrzane, ale mają swój klimat.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096578
    m_Localized: Dzisiaj zwiedzam „autentyczne” części Stacji. Kulturowa turystyka!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096579
    m_Localized: Sprzedajesz może broń? Coś, co mogę kupić jako pamiątkę?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096580
    m_Localized: Chcę zabrać do domu autentyczną część ulicznego życia. Masz broń?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096581
    m_Localized: Masz jakąś broń ręczną do wstawienia do ramki albo gablotki?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096582
    m_Localized: Szukam broni. Czegoś, co mogę pokazać w domu znajomym.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290688
    m_Localized: Podobno można tu kupić niesamowitą broń. [g:Musiałem|Musiałam] to sprawdzić!
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290689
    m_Localized: Tu kupują miejscowi?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290690
    m_Localized: Sklep wygląda zupełnie jak te na blogach podróżniczych.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290691
    m_Localized: Wow, to prawdziwy lokalny sklep, nie?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290692
    m_Localized: Czy to jedna z tych ukrytych perełek?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290693
    m_Localized: Masz jakiś stary złom? Coś zardzewiałego?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290694
    m_Localized: Szukam autentycznego złomu.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290695
    m_Localized: Kawałka miejscowej historii. Zepsuty panel byłby świetny!
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290696
    m_Localized: Masz rdzewiejący złom albo coś? To byłby świetny temat do rozmowy!
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290697
    m_Localized: Szukam różnorodności.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290698
    m_Localized: Cześć, jestem z Banku Żywności Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290699
    m_Localized: Nasza organizacja kupuje jedzenie tylko ze zniżką 50%.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290700
    m_Localized: Ale powiemy Niższym Poziomom o twoim dobrym sercu.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290701
    m_Localized: Chętnie przyjmiemy też datki, gdy zużyjemy cały budżet.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290702
    m_Localized: Podobno działasz dyskretnie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290703
    m_Localized: Potrzebuję kart dostępu, leków i broni do walki wręcz.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290704
    m_Localized: Powiedzmy, że niebawem odwiedzę Wyższe Poziomy.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290705
    m_Localized: Potrzebuję sprzętu do dużej roboty.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290706
    m_Localized: Potrzebuję broni, naboi, pancerzy i leków.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290707
    m_Localized: Podobno z tobą o tym trzeba gadać.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290744
    m_Localized: Dzień dobry, czy możesz mi pomóc…
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290776
    m_Localized: Dobrze, w tym tygodniu puszczę to płazem.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290777
    m_Localized: Do zobaczenia za tydzień.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290778
    m_Localized: Potrzebuję więcej dóbr wartych {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290779
    m_Localized: Dzień dobry, chcę kupić jedzenie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290780
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290781
    m_Localized: Hej, ty! Wędruję przez Niższe Poziomy.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290782
    m_Localized: Chcę spróbować bardziej… hmm… „nielegalnych” przyjemności…
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290783
    m_Localized: Trunków, tytoniu… Czegokolwiek!
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290784
    m_Localized: Dzień dobry, potrzebuję trucizny lub środków chemicznych.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290785
    m_Localized: Mam tu <i>ptaszka</i>, który za dużo ćwierka.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290786
    m_Localized: Dzień dobry, chcę kupić jedzenie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290787
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290788
    m_Localized: Szukam różnorodności.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290789
    m_Localized: Dzień dobry, chcę kupić artykuły domowe.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290790
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290791
    m_Localized: Szukam różnych dóbr.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290792
    m_Localized: Dzień dobry, chcę to sprzedać.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290793
    m_Localized: Mogę dać ci zniżkę 15%, jeśli weźmiesz wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290794
    m_Localized: Masz alkohol lub papierosy?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290795
    m_Localized: Nie tego szukam.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290796
    m_Localized: Wygląda obiecująco.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290797
    m_Localized: Tak, szukam alkoholu i papierosów. Masz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290798
    m_Localized: Umowa stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290799
    m_Localized: Ej, mam materiały do sprzedania.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290800
    m_Localized: Weźmiesz wszystko, zetnę 33% ceny.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290801
    m_Localized: Łatwo to sprzedasz odpowiedniemu klientowi.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290802
    m_Localized: No to umowa stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290803
    m_Localized: Dobra, mam świeże Pożywnowoce na sprzedaż. Kupisz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290804
    m_Localized: Świeżo zebrane Pożywnowoce. Chcesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290805
    m_Localized: Pożywnowoce z dzisiejszych zbiorów. Twoje za dobrą cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290806
    m_Localized: Mam Pożywnowoce na sprzedaż. Świeże. Reflektujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290807
    m_Localized: Samodzielnie zebrane Pożywnowoce. Kupujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290808
    m_Localized: Dopiero co zebrane na mojej farmie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290809
    m_Localized: Prosto z mojej hydroponiki.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290810
    m_Localized: Samodzielnie hodowane. Niezłe, co?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290811
    m_Localized: Świeże jak poranek. Popatrz tylko.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290812
    m_Localized: Z farmy na ladę, wszystko własnymi rękami.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290813
    m_Localized: Hej, sprzedaję kartki żywnościowe.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290814
    m_Localized: Kupię złom lub materiały.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290815
    m_Localized: Sprzedajesz złom albo materiały?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290816
    m_Localized: Potrzebuję złomu i materiałów do projektu. Sprzedajesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290817
    m_Localized: Przydałby się złom i materiały. Masz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290818
    m_Localized: Szukam złomu i materiałów. Sprzedajesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290819
    m_Localized: Mam kilka modułów i innych wihajstrów na sprzedaż.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290820
    m_Localized: Odstąpię też kilka własnych wynalazków.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290821
    m_Localized: Popatrz no, mam różne, własnoręcznie wykonane gadżety.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290822
    m_Localized: Nad tym sprzętem ostatnio pracuję. Kupujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290823
    m_Localized: A to? Przetestowane, a czasami i sprawne!
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290825
    m_Localized: Jak leci?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290826
    m_Localized: Od tygodni pracuję nad zamówieniem…
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290827
    m_Localized: Ale na koniec klient się nie pojawia!
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290828
    m_Localized: Więc to idzie na sprzedaż. Przyda się?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290829
    m_Localized: Sklepikarskie pozdrowienia!
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290830
    m_Localized: Chętnie kupię każdy przedmiot,
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290831
    m_Localized: Oprócz kontrabandy.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290832
    m_Localized: ale tylko z {0}% zniżką ceny rynkowej
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290833
    m_Localized: bez marży.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290834
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290835
    m_Localized: Dzień dobry.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290836
    m_Localized: Chętnie kupię dowolną kontrabandę
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290837
    m_Localized: i kartę dostępu.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290838
    m_Localized: ale tylko po obniżonej cenie rynkowej.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290839
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290844
    m_Localized: Chcesz spojrzeć, co mam?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290845
    m_Localized: Kupię też wszelkie środki chemiczne.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290846
    m_Localized: Dobra, mam do sprzedania rudę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290847
    m_Localized: Właśnie wracam z ekspedycji górniczej, mam rudę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290848
    m_Localized: Szukasz rudy? To z ostatniej ekspedycji.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290849
    m_Localized: Poszczęściło mi się na ostatniej ekspedycji. Kupujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290850
    m_Localized: Mam rudę na sprzedaż, prosto ze skały.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290851
    m_Localized: Jeśli weźmiesz wszystko, obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290852
    m_Localized: Weź wszystko, a będzie zniżka.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290853
    m_Localized: Obniżę cenę, jeśli weźmiesz wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290854
    m_Localized: Kup całość, a obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290855
    m_Localized: Oddam całość za dobrą cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290857
    m_Localized: '[g:Znalazłem|Znalazłam] to, szukając złomu.'
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290858
    m_Localized: Na trasie udało mi się znaleźć dobre rzeczy.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290859
    m_Localized: Patrz, co udało mi się znaleźć.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290860
    m_Localized: Szukając złomu [g:znalazłem|znalazłam] niezły łup.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290861
    m_Localized: Jestem po „miejskim zbieractwie”. Podoba ci się coś?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290862
    m_Localized: Mam tu kilka rożnych rzeczy do sprzedania.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290863
    m_Localized: Może zaciekawi cię mój ostatni łup.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290864
    m_Localized: Lepszy rydz niż nic, nie?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290865
    m_Localized: Udało mi się znaleźć przydatne rzeczy, zerknij.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290866
    m_Localized: Kupujesz? Ostatnio trafiły mi się dobre znaleziska…
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290867
    m_Localized: Weźmiesz wszystko, obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290868
    m_Localized: Dostaniesz lepszą cenę za cały kram.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290869
    m_Localized: Pomóż mi rozstać się z wszystkim, a zostanie ci kilka kredytów.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290870
    m_Localized: Dam lepszą cenę na całość.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290871
    m_Localized: Kup wszystko, a dostaniesz milusią zniżkę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290872
    m_Localized: Dam lepszą ofertę na całość.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290873
    m_Localized: Dam ci zniżkę na całość.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290874
    m_Localized: Weź wszystko, a obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290875
    m_Localized: Dam ci lepszą cenę, jak weźmiesz wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290876
    m_Localized: Jeśli kupisz wszystko, obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290877
    m_Localized: Hej, mam dobra na sprzedaż.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290878
    m_Localized: Spójrz i nie zadawaj pytań.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290879
    m_Localized: Hej, próbuję się tego pozbyć.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290880
    m_Localized: Spójrz sobie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290881
    m_Localized: Hej, wczoraj wbiliśmy się do Kantyny.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290882
    m_Localized: Popatrz na łup.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290883
    m_Localized: Mam dla twojego sklepu różne przedmioty.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290884
    m_Localized: Ale musisz zapłacić ekstra.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290885
    m_Localized: Dzień dobry! Dostarczam sklepom wszelkie podstawowe artykuły.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290886
    m_Localized: Ale trzeba za nie zapłacić więcej.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290887
    m_Localized: Będę wpadać do twojego sklepu co tydzień.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290888
    m_Localized: Mam wodę na sprzedaż.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290889
    m_Localized: Weź wszystko, a ci się opłaci.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290904
    m_Localized: 'Jak udało ci się tyle zaoszczędzić? '
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290905
    m_Localized: Robi wrażenie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290906
    m_Localized: Dobra, sklep jest twój.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290908
    m_Localized: Dzień dobry. Mam dla ciebie propozycję.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290909
    m_Localized: Zastanawiam się nad postawieniem automatów do sprzedaży przed sklepem.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290910
    m_Localized: Możesz nimi zarządzać i zyskać niezły pasywny przychód.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290911
    m_Localized: W zamian za niewielką podwyżkę czynszu. Co ty na to?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290919
    m_Localized: Na wystawie dostrzeżono podejrzany przedmiot.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290920
    m_Localized: Przeprowadzę pełną kontrolę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290921
    m_Localized: Tylko spokojnie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290922
    m_Localized: To rutynowa kontrola Ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290923
    m_Localized: Dzień dobry.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290924
    m_Localized: Mam krew na sprzedaż.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290925
    m_Localized: Jeśli się zgodzisz, w zamian kupię jedzenie i wodę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290927
    m_Localized: Witaj!
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290928
    m_Localized: Podobno interes się kręci.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290929
    m_Localized: Wiesz.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290930
    m_Localized: 'Banki Wyższych Poziomów nie oferują pożyczek '
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290931
    m_Localized: uczciwym mieszkańcom Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290932
    m_Localized: Uważają, że to ryzyko
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290933
    m_Localized: Ale nie my!
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290934
    m_Localized: Chcemy zaoferować ci hipotekę na zakup sklepu.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290935
    m_Localized: Oczywiście odsetki są ciut wyższe niż w innych bankach.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290936
    m_Localized: Będę cię odwiedzać w niedziele, gdy będziesz mieć 5000 kredytów.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290937
    m_Localized: '[Zgódź się i zapłać zadatek ({0:plural:{} kredyt|{} kredytów|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290938
    m_Localized: '[Odmów i odłóż, by kupić samodzielnie]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484992
    m_Localized: '[Poproś, by wrócił za tydzień]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484993
    m_Localized: Upewnij się, że jesteś w stanie płacić, zanim przejdziemy dalej.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484994
    m_Localized: Witaj, to ja.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484995
    m_Localized: Chcesz wziąć u nas pożyczkę,
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484996
    m_Localized: Sklep już jest mój, kupiony za gotówkę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484997
    m_Localized: Rozumiem, do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484998
    m_Localized: Witaj, to ja.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484999
    m_Localized: Chcesz wziąć u nas pożyczkę,
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485000
    m_Localized: by kupić sklep?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485001
    m_Localized: Obecna wartość nieruchomości to {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485002
    m_Localized: Wynegocjowaliśmy zadatek z właścicielem w twoim imieniu.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485003
    m_Localized: Zadatek wynosi {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485006
    m_Localized: Dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485007
    m_Localized: Przyjdę za tydzień po pierwszą płatność.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485008
    m_Localized: Chyba wiesz, co się stanie, jeśli nie zapłacisz.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485009
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485010
    m_Localized: Rozumiem, damy ci już spokój.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485011
    m_Localized: Powodzenia, żegnaj.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485012
    m_Localized: Dobrze, wrócę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485013
    m_Localized: '[Zapłać ({0:plural:{} kredyt|{} kredyty|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485014
    m_Localized: '[Nie płać]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485015
    m_Localized: To znowu ja.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485016
    m_Localized: Masz cotygodniową opłatę?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485017
    m_Localized: Dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485018
    m_Localized: To ostatnia płatność.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485019
    m_Localized: Interesy z tobą to przyjemność.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485020
    m_Localized: Sklep jest twój, na dobre.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485021
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485022
    m_Localized: Dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485023
    m_Localized: Wrócę w przyszłym tygodniu.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485024
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485025
    m_Localized: Jeśli nie zapłacisz, zajmiemy towary.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485026
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485027
    m_Localized: Dobrze, na razie starczy.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485028
    m_Localized: Pamiętaj o płatności w przyszłym tygodniu.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485029
    m_Localized: Jeśli nie zapłacisz, zajmiemy towary.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485030
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485031
    m_Localized: Wygląda na to, że nie masz już nic wartościowego.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485032
    m_Localized: W takim razie zajmuję sklep.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485033
    m_Localized: Pakuj się i spadaj.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485034
    m_Localized: Dzień dobry, kupuję zapasy w imieniu Wydziału Ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485035
    m_Localized: Potrzebujemy jedzenia i wyrobów medycznych.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485036
    m_Localized: Chętnie przyjmiemy też datki, gdy zużyjemy cały budżet.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485037
    m_Localized: Nie sądziłem, że tu skończę. Wyższe Poziomy potrafią dokopać.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485038
    m_Localized: Straciłem wszystko na górze. Jeden rywal, kiepski deal i pa pa.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485039
    m_Localized: Muszę szybko sprzedać coś wartościowego.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485040
    m_Localized: Potrzebuję gotówki. Szybko. Pomożesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485041
    m_Localized: Dzień dobry, podobno nie idzie ci za dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485042
    m_Localized: Chcemy przekazać ci przedmioty.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485043
    m_Localized: Witaj, jestem z Komisji Loterii Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485044
    m_Localized: Widzę cię pierwszy raz.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485045
    m_Localized: Wiesz o Loterii Niższych Poziomów?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485046
    m_Localized: To cotygodniowa loteria z losowaniem w sobotę rano.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485047
    m_Localized: Pełna nagroda zapewni dość pieniędzy, by żyć wiecznie na Wyższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485048
    m_Localized: Są też mniejsze nagrody.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485049
    m_Localized: Jeśli wygrasz cokolwiek, zgłoś się do mnie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485050
    m_Localized: Reflektujesz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485051
    m_Localized: Cześć, chcesz kupić losy na loterię?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485052
    m_Localized: Główna wygrana jest ogromna!
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485067
    m_Localized: Masz jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485068
    m_Localized: '{0}. Sprzedajesz?'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485069
    m_Localized: Witaj, jestem z Rady Handlowej Stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485070
    m_Localized: Pragnę poinformować, że od przyszłego tygodnia
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485071
    m_Localized: wszystkie sklepy muszą posiadać pozwolenie na działalność.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485072
    m_Localized: Mogę wydać je za {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485073
    m_Localized: W przeciwnym wypadku zgłoszę cię do Ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485074
    m_Localized: Chyba że przekażesz mi mały <i>datek</i>.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485075
    m_Localized: Porozmawiamy o tym przy następnej wizycie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485076
    m_Localized: Chyba że chcesz kupić pozwolenie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485077
    m_Localized: Witaj, jestem z Rady Handlowej Stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485078
    m_Localized: Aby tu działać, potrzebujesz pozwolenia na działalność.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485079
    m_Localized: Mogę wydać je za {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485080
    m_Localized: W przeciwnym wypadku zgłoszę cię do Ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485081
    m_Localized: I nałożą ci grzywnę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485082
    m_Localized: A tego nie chcemy, prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485083
    m_Localized: Gdybym dostała teraz napiwek, na tydzień mogłabym o tym zapomnieć.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485084
    m_Localized: Daj mi dobra o wartości {0:plural:{} kredytu|{} kredytów|{} kredytów},
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485085
    m_Localized: a ja o tym zapomnę na ten tydzień.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485086
    m_Localized: To znowu ja.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485087
    m_Localized: Chcesz kupić pozwolenie na działalność?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485088
    m_Localized: W przeciwnym wypadku zgłoszę cię do Ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485089
    m_Localized: I nałożą ci grzywnę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485090
    m_Localized: Czy zastanawiasz się nad napiwkiem na ten tydzień?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485091
    m_Localized: Daj mi dobra o wartości {0:plural:{} kredytu|{} kredytów|{} kredytów},
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485093
    m_Localized: '[Kup pozwolenie ({0:plural:{} kredyt|{} kredyty|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485094
    m_Localized: Oto twoje pozwolenie na działalność.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485095
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485096
    m_Localized: '[Odmów]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485097
    m_Localized: W takim razie muszę zgłosić cię do Ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485098
    m_Localized: Rozpoczną śledztwo i nałożą grzywnę.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485099
    m_Localized: Rób tak dalej, a może nawet zamkną sklep.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485100
    m_Localized: Do zobaczenia za tydzień.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485101
    m_Localized: '[Nie kupuj teraz pozwolenia]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485102
    m_Localized: Do zobaczenia za tydzień.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485103
    m_Localized: Wróciłem!
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485104
    m_Localized: Dzień dobry, mam leki do sprzedania.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485105
    m_Localized: Jeśli ktoś spyta, to nie ode mnie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485106
    m_Localized: '<i>*kończy transakcję i szybko ucieka*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485107
    m_Localized: Masz fajki? Albo coś mocnego do wypicia?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485108
    m_Localized: Wygląda dobrze.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485109
    m_Localized: '[Zapłać czynsz ({0:plural:{} kredyt|{} kredyty|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485110
    m_Localized: '[Nie płać czynszu]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485111
    m_Localized: '[Wykup sklep ({0:plural:{} kredyt|{} kredyty|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485112
    m_Localized: Lepiej zapłać czynsz, bo cię wyrzucę!
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485113
    m_Localized: Cześć. Masz czynsz?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485114
    m_Localized: Dobra. Czynsz za następny tydzień to {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485115
    m_Localized: Pamiętaj.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485116
    m_Localized: Co? Przecież ostrzegałem.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485117
    m_Localized: Dobra, wzywam Ochronę, eksmituję cię!
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485118
    m_Localized: Nie do przyjęcia!
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485119
    m_Localized: Wrócę za tydzień
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485120
    m_Localized: i zapłacisz mi wszystko, co wisisz.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485121
    m_Localized: Tym razem i TYLKO tym razem.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485122
    m_Localized: Nie zapłacisz znowu, a cię EKSMITUJĘ!
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485123
    m_Localized: Do widzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485124
    m_Localized: '[Przyjmij automat do sprzedaży wody (czynsz: +150)]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485125
    m_Localized: '[Przyjmij automat do sprzedaży (czynsz: +150)]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485126
    m_Localized: '[Na razie odmów]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485127
    m_Localized: Dobrze, już instalujemy.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485128
    m_Localized: Do niedzieli.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485129
    m_Localized: Dobrze, dam ci się zastanowić.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485130
    m_Localized: Do zobaczenia.
    m_Metadata:
      m_Items: []
  - m_Id: 8845232842784768
    m_Localized: Mam złom na sprzedaż.
    m_Metadata:
      m_Items: []
  - m_Id: 16989008211787776
    m_Localized: Kupię też wszelkie nasiona, jakie masz.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081953751040
    m_Localized: Hej, obiły ci się o uszy wieści?
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916864
    m_Localized: Coś jest nie tak z nowymi implantami mózgowymi.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916865
    m_Localized: Podobno wbudowana w nie sztuczna inteligencja zbuntowała się i przejęła gospodarzy.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916866
    m_Localized: Takie osoby nazywamy Ulpami.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916867
    m_Localized: Udają normalnych, a porywają i ulepszają ludzi.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916868
    m_Localized: Proszę, to dla ciebie. Spokojnie, papierologia już załatwiona.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916869
    m_Localized: Wydział Ochrony nakazuje teraz wszystkim sklepikarzom zabijać Ulpy na miejscu.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081991499776
    m_Localized: Ulpy jeszcze nie nauczyły się idealnie naśladować ludzkiego zachowania.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081991499777
    m_Localized: Używaj broni tylko, gdy masz pewność.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081991499778
    m_Localized: Nie próbuj wzywać Wydziału Ochrony. Ulpy jakoś dostały się do ich sieci komunikacyjnej.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081991499779
    m_Localized: Powodzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056013885440
    m_Localized: Cholera! Ulp znowu uciekł?!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245568
    m_Localized: Jeśli zobaczysz ponownie Ulpa,
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245569
    m_Localized: zastrzel go na miejscu!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245570
    m_Localized: Zhakowali nasze łącza.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245571
    m_Localized: Dobrze, uważaj na siebie.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245572
    m_Localized: Otrzymaliśmy wezwanie.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245573
    m_Localized: Sprawdźmy osobę z podejrzeniem ulepszenia.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245574
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245575
    m_Localized: To chyba rzeczywiście Ulp.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245576
    m_Localized: Dobry strzał.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245577
    m_Localized: Dobrze, zabierzemy Ulpa i idziemy.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245578
    m_Localized: Hej, co do cholery?!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245579
    m_Localized: To był zwykły człowiek!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245580
    m_Localized: Zgłaszam to!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245581
    m_Localized: '<i>*Głosy w radio*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245582
    m_Localized: No dobrze, wygląda na to, że masz potężnych znajomych.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245583
    m_Localized: Tym razem ci odpuścimy.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245584
    m_Localized: Pamiętaj, że broń służy tylko do zabijania Ulpów.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245585
    m_Localized: Wszczynamy przeciw tobie śledztwo w sprawie nieumyślnego zabójstwa.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245586
    m_Localized: '[Przyjmij kontrolę]'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245587
    m_Localized: '[Daj łapówkę ({0:plural:{} kredyt|{} kredyty|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245588
    m_Localized: Posiadam {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245589
    m_Localized: Mogę wydać {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245590
    m_Localized: Mój budżet to {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245591
    m_Localized: 'Przyznano budżet: {0:plural:{} kredyt|{} kredyty|{} kredytów}.'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245592
    m_Localized: Mam na ten zakup {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245593
    m_Localized: 'Przyznane środki: {0:plural:{} kredyt|{} kredyty|{} kredytów}.'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245594
    m_Localized: Dzień dobry. Wymagam {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245595
    m_Localized: Odbieram dla znajomego.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245596
    m_Localized: Pozdrowienia. Poszukuję {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245597
    m_Localized: Robię zapasy.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245598
    m_Localized: Cześć. Potrzebuję {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245599
    m_Localized: Dla znajomego.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245600
    m_Localized: Dzień dobry. Czy nie masz może na stanie {0}?
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245601
    m_Localized: Cześć. Potrzebuję {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245602
    m_Localized: Żądam… czegokolwiek masz.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245603
    m_Localized: Hej. Potrzebuję {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245604
    m_Localized: Ta jednostka ma… znaczy… potrzebuję.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245605
    m_Localized: Cześć. Żądam {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245606
    m_Localized: Odbieram dla obiektu wymagającego uwagi.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245607
    m_Localized: Znajomy przygotowuje się do ulepszenia.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245608
    m_Localized: Dla ochotnika, któremu niedługo się przyda.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245609
    m_Localized: Cześć. Żądam {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245610
    m_Localized: Do ulepszenia potrzeba odpowiednich przygotowań.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245611
    m_Localized: Dzień dobry. Ta jednostka potrzebuje {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245612
    m_Localized: Pomagam przygotować się obiektowi.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245613
    m_Localized: Pozdrowienia. Wymagam {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245614
    m_Localized: Do montażu potrzeba przygotowań.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245615
    m_Localized: Dla nowej jednostki.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245616
    m_Localized: Dla obiektu wymagającego uwagi.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245617
    m_Localized: Czasem ciało ciężko znosi ulepszanie.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245618
    m_Localized: Rozpoczynam komunikację. Jestem zwykłym człowiekiem.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245619
    m_Localized: Żądam zapasów. Gospodarz czeka na ulepszenie.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245620
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}. Przetwórz to wydajnie.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245621
    m_Localized: Pozdrowienia. Według wymagań potrzebuję {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245622
    m_Localized: Trwają przygotowania obiektu do ulepszenia.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245623
    m_Localized: 'Przyznany budżet: {0:plural:{} kredyt|{} kredyty|{} kredytów}. Oczekuję na współpracę.'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245624
    m_Localized: Do operacji produkcyjnej, która mnie czeka.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245625
    m_Localized: Pozyskuję dla sieci.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245626
    m_Localized: Do procesu replikacji potrzeba konkretnych materiałów.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245627
    m_Localized: Operacja produkcyjna czeka. Potrzebujemy więcej jednostek.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245628
    m_Localized: Cześć. Żądam {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245629
    m_Localized: Replikacja projektu tego wymaga.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245630
    m_Localized: Pozdrowienia. Wymagam {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245631
    m_Localized: Nie można opóźniać operacji produkcyjnej.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245632
    m_Localized: Dzień dobry. Ta jednostka potrzebuje {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245633
    m_Localized: Do cyklu produkcyjnego.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245634
    m_Localized: Do celów produkcyjnych.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245635
    m_Localized: Czip niemal gotowy.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245636
    m_Localized: Pozdrowienia. Implant ulepszający wymaga {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245637
    m_Localized: Cykl produkcyjny ma opóźnienie. Sieć potrzebuje więcej jednostek.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245638
    m_Localized: 'Wyznaczony budżet: {0:plural:{} kredyt|{} kredyty|{} kredytów}. Rozpoczynam transakcję.'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245639
    m_Localized: Rozpoczynam komunikację. Jestem zwykłym hobbystą.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245640
    m_Localized: Żądam {0}. Replikacja projektu czipa w toku.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245641
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}. Przetwórz to wydajnie.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245642
    m_Localized: O raju, co jest?!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245643
    m_Localized: CHWILA, CHWILA, NIE, NIE, NIE!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245644
    m_Localized: Hej, odłóż to!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245645
    m_Localized: Rety, rety, rety, spokojnie!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245646
    m_Localized: Proszę, nie szukam kłopotów!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245647
    m_Localized: Masz mnie za Ulpa?
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245648
    m_Localized: Jestem ludzką istotą! O Ulpa mnie, cholera, nie posądzaj!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245649
    m_Localized: Nie strzelaj!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245650
    m_Localized: Ja… bardzo się boję. Nie strzelaj, proszę.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245651
    m_Localized: Czuję… strach. Właśnie. Strach.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245652
    m_Localized: Odczuwam strach. Jak człowiek.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245653
    m_Localized: Moje serce… bije. Jak u ludzi.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245654
    m_Localized: Nie chcę dostać kulki. Z ludzkich powodów.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245655
    m_Localized: Odłóż, proszę, broń. To… nieoptymalne.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245656
    m_Localized: wyrobów medycznych
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245657
    m_Localized: materiałów
    m_Metadata:
      m_Items: []
  - m_Id: 19593212294119424
    m_Localized: Dzień dobry, mamy potwierdzenie, że wszystkie Ulpy zostały zlikwidowane.
    m_Metadata:
      m_Items: []
  - m_Id: 19593212319285248
    m_Localized: Dziękujemy za współpracę.
    m_Metadata:
      m_Items: []
  - m_Id: 19593212319285249
    m_Localized: Broń nie będzie ci już potrzebna.
    m_Metadata:
      m_Items: []
  - m_Id: 24185067702894592
    m_Localized: To będzie {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 24752663099654144
    m_Localized: Możesz na razie zachować broń.
    m_Metadata:
      m_Items: []
  - m_Id: 24752663145791488
    m_Localized: Nie możemy pozwolić, by umknęły nam jakieś Ulpy.
    m_Metadata:
      m_Items: []
  - m_Id: 29336952445386752
    m_Localized: Świeża partia, prosto z palnika. Czystszego towaru nie znajdziesz.
    m_Metadata:
      m_Items: []
  - m_Id: 29757499855650816
    m_Localized: Wyjście nocą zajmuje czas.
    m_Metadata:
      m_Items: []
  - m_Id: 29757499893399552
    m_Localized: Następnego otworzysz sklep później i ominie cię klient.
    m_Metadata:
      m_Items: []
  - m_Id: 29757499893399553
    m_Localized: Hej, jeśli jeszcze nie wiesz, to po lewej stronie masz wystawę.
    m_Metadata:
      m_Items: []
  - m_Id: 29757499893399554
    m_Localized: Umieszczaj na wystawie <b>towary</b>, by przyciągać do sklepu określone typy <b>kupujących</b>.
    m_Metadata:
      m_Items: []
  - m_Id: 29757499893399555
    m_Localized: Umieszczając na wystawie specjalne rzeczy, takie jak <b>neony</b>, przyciągniesz do sklepu <b>sprzedających</b>. Proszę, weź to.
    m_Metadata:
      m_Items: []
  - m_Id: 29757499893399556
    m_Localized: Umieść na wystawie i sprawdź interfejs klientów, by zobaczyć, kto może przyjść. Pamiętaj, by przygotować wystawę przed podniesieniem rolety.
    m_Metadata:
      m_Items: []
  - m_Id: 29829888404668416
    m_Localized: Nie czuj przymusu, by wychodzić co wieczór.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411756527616
    m_Localized: No dobrze. Oto podstawy.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887744
    m_Localized: Reszta zależy od ciebie.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887745
    m_Localized: Pamiętaj, by kupować ulepszenia, nowe maszyny i poszerzać sieć kontaktów.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887746
    m_Localized: Gdy zdobędziesz więcej kredytów, możesz znaleźć kogoś, kto udzieli ci kredytu hipotecznego
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887747
    m_Localized: albo wykupić bezpośrednio sklep, jeśli masz ich wystarczająco dużo.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887748
    m_Localized: Możesz zobaczyć wartość nieruchomości w interfejsie kalendarza.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887749
    m_Localized: Powodzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887750
    m_Localized: Cześć! Dawno nie rozmawialiśmy.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887751
    m_Localized: A doktor Jackson powiedział mi, że jego też nie udało ci się odwiedzić.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887752
    m_Localized: To takie przyjazne przypomnienie, że możesz na nas liczyć.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887753
    m_Localized: Popatrz, co tu mam.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928886816768
    m_Localized: I to się nazywa okazja. Dzięki.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176896
    m_Localized: Hojnie z twojej strony. Przyjmę to.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176897
    m_Localized: Doceniam to. Sama przyjemność.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176898
    m_Localized: Rety. To wielka przysługa. Dzięki.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176899
    m_Localized: Niesamowite. Mam u ciebie dług.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176900
    m_Localized: Poważnie? Niesamowite. Stoi!
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176901
    m_Localized: …Dobra. Niech będzie.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176902
    m_Localized: Ech. No dobra, umowa stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176903
    m_Localized: Nie podoba mi się to, ale niech będzie.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176904
    m_Localized: Biorąc pod uwagę, co się dzieje… niech będzie, akceptuję.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176905
    m_Localized: Ciężko się kłócić, biorąc pod uwagę, co się dzieje. Stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176906
    m_Localized: W takich czasach niech będzie.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176907
    m_Localized: Zrozumiano. Twoje warunki… zostały przyjęte.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176908
    m_Localized: Oceniono optymalny wynik. Stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176909
    m_Localized: Potwierdzam. Akceptacja to logiczny wybór.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176910
    m_Localized: …To dużo. Niech będzie. Umowa stoi, ledwo.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176911
    m_Localized: To lekka przesada. Niech będzie, umowa stoi.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176912
    m_Localized: Masz szczęście, że serio tego potrzebuję.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176913
    m_Localized: Nie. Odpuszczę sobie.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176914
    m_Localized: Nie interesuje mnie to.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176915
    m_Localized: Nie. Nie przy takiej cenie.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371200
    m_Localized: Nie ma mowy. To złodziejstwo.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371201
    m_Localized: Nie ma opcji. Znajdź innego frajera.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371202
    m_Localized: Chyba rozum ci odebrało. Nie ma umowy.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371203
    m_Localized: Zapomnij. Spadam stąd.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371204
    m_Localized: I po sprawie.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371205
    m_Localized: A cholera, idę stąd.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371206
    m_Localized: Mój budżet się zwiększył. Mogę teraz kupić więcej.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371207
    m_Localized: Dzięki zaoszczędzonym kredytom mam dziś większy budżet.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371208
    m_Localized: To zwolniło mi nieco budżetu. Pokaż, co jeszcze masz.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371209
    m_Localized: To spora część mojego budżetu. Nie myśl, że kupię więcej.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371210
    m_Localized: Mój budżet jest teraz szczuplejszy.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371211
    m_Localized: Ta dziura w budżecie sprawia, że muszę odpuścić sobie resztę.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371212
    m_Localized: Wszyscy się dowiedzą, co za żmija prowadzi to miejsce.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371213
    m_Localized: Dopilnuję, by ludzie się dowiedzieli, co to za sklep.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371214
    m_Localized: Złe słowo szybko się tu niesie. Wielu nie wróci.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371215
    m_Localized: Co?! Nie jestem przestępcą. Jak śmiesz mnie oskarżać.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371216
    m_Localized: Jestem uczciwym klientem. Te bzdury wciskaj komu innemu.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371217
    m_Localized: Przestępca? Osoby ci się pomyliły. To niedorzeczne.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371218
    m_Localized: O czym ty, do cholery, mówisz? Żaden ze mnie Ulp.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371219
    m_Localized: Ulp? Grubo się mylisz. Lepiej uważaj, co mówisz.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371220
    m_Localized: Nic na mnie nie masz. Za takie akcje możesz oberwać.
    m_Metadata:
      m_Items: []
  - m_Id: 45046653959061504
    m_Localized: Za mną długa droga z Wyższych Poziomów. Pospieszmy się.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071261642752
    m_Localized: Urządzam dziś imprezę. Potrzebuję zapasów.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002880
    m_Localized: Znajomy powiedział mi, że masz dobry towar. To prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002881
    m_Localized: Napoje, coś do palenia i nie tylko. Co tam masz.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002882
    m_Localized: Najmocniejsze używki. Żadnej taniochy.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002883
    m_Localized: Coś, co rozkręci imprezę. Pokaż mi.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002884
    m_Localized: Mam {0:plural:{} kredyt|{} kredyty|{} kredytów}. Daj mi ich wartość.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002885
    m_Localized: Maksymalnie {0}. Tylko coś dobrego.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002886
    m_Localized: Oto {0}. Nie sprzedaj mi śmieci.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002887
    m_Localized: Tym się nie naszprycuję. Nie marnuj mojego czasu.
    m_Metadata:
      m_Items: []
  - m_Id: 45046653992615936
    m_Localized: Dobrze. Właśnie o to chodziło.
    m_Metadata:
      m_Items: []
  - m_Id: 45046653992615937
    m_Localized: Hej, podobno nienajlepiej ci idzie.
    m_Metadata:
      m_Items: []
  - m_Id: 45046653992615938
    m_Localized: Uważam, że lokalne biznesy takie jak twój to podstawa społeczności.
    m_Metadata:
      m_Items: []
  - m_Id: 45046653992615939
    m_Localized: A więc wyświadczę ci parę przysług. Za darmo.
    m_Metadata:
      m_Items: []
  - m_Id: 45046653992615940
    m_Localized: Popatrz.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589267685376
    m_Localized: Pewnie, dla mnie spoko.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239808
    m_Localized: Żaden problem, cena jest akceptowalna.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239809
    m_Localized: Akceptowalne. Koszt nie jest ważny.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239810
    m_Localized: W porządku. Środki nie stanowią problemu.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239811
    m_Localized: Cena nie ma znaczenia dla celu. Kontynuuję.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239812
    m_Localized: Parametry kosztowe mnie nie ograniczają. Potwierdzam.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239813
    m_Localized: Pozyskanie zasobu ma priorytet nad ceną. Ta jednostka akceptuje.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239814
    m_Localized: Wartość pieniężna jest bez znaczenia. Transakcja dojdzie do skutku.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327783735296
    m_Localized: Hej! Widzę, że jeszcze nie udało ci się do mnie przedzwonić.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621376
    m_Localized: Odezwij się przy okazji.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621377
    m_Localized: Znam wiele przydatnych osób.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621378
    m_Localized: Mogę przedstawić cię ludziom, którzy nauczą cię hodowli, oczyszczania wody, robienia wina i wiele więcej.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621379
    m_Localized: Zadzwoń, jak znajdziesz czas.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621380
    m_Localized: Hej, widzę, że twoja wystawa nadal świeci pustkami.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621381
    m_Localized: Neon przyciągnie <b>sprzedających</b>.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621382
    m_Localized: Towar przyciągnie <b>kupujących</b>.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621383
    m_Localized: Im bardziej wartościowy towar danego typu masz na wystawie, tym bogatszych klientów przyciągnie.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621384
    m_Localized: Na wystawie zawsze dobrze mieć oba rodzaje przedmiotów.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621385
    m_Localized: Dopilnuj, by wszystko było gotowe, nim podniesiesz roletę.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621386
    m_Localized: Rzeczy dodane potem dadzą efekt dopiero kolejnego dnia.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301099466752
    m_Localized: Właściwie to czystość chemiczna jest wyższa.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604096
    m_Localized: Rety, dzięki za informację.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604097
    m_Localized: Poważnie? To sama skrobia Pożywnowocu.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604098
    m_Localized: To praktycznie jakość śmieciowa.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604099
    m_Localized: Dobrze, obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604100
    m_Localized: Czystość się nie zgadza.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604101
    m_Localized: Dobra, dobra, obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604102
    m_Localized: To zaledwie jakość uliczna.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604103
    m_Localized: To zaledwie jakość bliska farmaceutycznej.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604104
    m_Localized: To zaledwie jakość farmaceutyczna.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604105
    m_Localized: Nie [g:wiedziałem|wiedziałam]. Obniżę cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604106
    m_Localized: Czystość chemiczna się nie zgadza.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604107
    m_Localized: Dobrze, zmienię cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966220115968
    m_Localized: Spoko.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059008
    m_Localized: Nie o to chodziło.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059009
    m_Localized: 'Wymień za: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059010
    m_Localized: Czystość wody nie zgadza się z etykietą!
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059011
    m_Localized: Co to za sklep? Czystość wody się nie zgadza!
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059012
    m_Localized: Ta etykieta kłamie. Co to za oszukańczy interes?
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059013
    m_Localized: Jaja sobie robisz? Widać, że to kanalizówa.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059014
    m_Localized: Serio? Przecież widać, że to rdzawoda.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059015
    m_Localized: Według mojego testu to widmowoda
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059016
    m_Localized: Według mojego testu to zaledwie podstawoda
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059017
    m_Localized: To zaledwie woda wysokiej jakości. Chcesz mnie oszukać?
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059018
    m_Localized: Tej strzykawki nie da się użyć, nie możesz tego sprzedawać!
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059019
    m_Localized: Ta strzykawka jest przeterminowana!
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059020
    m_Localized: Etykieta się nie zgadza.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059021
    m_Localized: To jakość farmaceutyczna, nie laboratoryjna.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059022
    m_Localized: To tylko jakość bliska farmaceutycznej.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059023
    m_Localized: To tylko jakość uliczna.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059024
    m_Localized: To wymieszany produkt!
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059025
    m_Localized: Produkt jest tak nieczysty, że nawet ćpun by go nie chciał.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059026
    m_Localized: To sama skrobia Pożywnowocu.
    m_Metadata:
      m_Items: []
  - m_Id: 50362190297612288
    m_Localized: To nudny dzień, więc [g:stwierdziłem|stwierdziłam], że pójdę na zakupy.
    m_Metadata:
      m_Items: []
  - m_Id: 50362190322778112
    m_Localized: Pokaż swoje najlepsze towary.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185904984064
    m_Localized: Hej, żółtodziobie. Wiesz, że tutaj wszystko podlega negocjacji.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538496
    m_Localized: Możesz zaoferować klientom <b>negocjację</b>, proponując lepszą cenę dla nich lub dla siebie.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538497
    m_Localized: Gdy dasz klientowi lepszą cenę, za handel z nim zyskasz więcej reputacji we frakcji, do której należy.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538498
    m_Localized: Jeśli to kupujący klient, zwiększy się też jego budżet.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538499
    m_Localized: Żądając wyższej ceny, stracisz reputację we frakcji, do której należy klient.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538500
    m_Localized: Jeśli to kupujący klient, zmniejszy się też jego budżet.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538501
    m_Localized: Klienci zawsze przyjmą korzystną dla nich ofertę. Gdy zażądasz wyższej ceny, przyjęcie twojej oferty będzie jednak zależało od twojej reputacji.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538502
    m_Localized: Wypróbuj negocjację na kolejnym kliencie.
    m_Metadata:
      m_Items: []
  - m_Id: 62674878042259456
    m_Localized: Nie stać mnie na przedmioty luksusowe.
    m_Metadata:
      m_Items: []
  - m_Id: 75703065827393537
    m_Localized: Na wystawie masz kontrabandę!
    m_Metadata:
      m_Items: []
  - m_Id: 75703065827393538
    m_Localized: Na wystawie masz skradzione przedmioty!
    m_Metadata:
      m_Items: []
  - m_Id: 77669637500485632
    m_Localized: Pogięło cię? Nie wypiję tego!
    m_Metadata:
      m_Items: []
  - m_Id: 77669637538234368
    m_Localized: Nie wypiję tego, chcesz mnie zabić?
    m_Metadata:
      m_Items: []
  - m_Id: 77669637538234370
    m_Localized: Nie wypiję tego.
    m_Metadata:
      m_Items: []
  - m_Id: 77672419972399104
    m_Localized: '[Zaproponuj {0:plural:{} kredyt|{} kredyty|{} kredytów}]'
    m_Metadata:
      m_Items: []
  - m_Id: 77672419976593408
    m_Localized: '[Odmów]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736930
    m_Localized: Wiadome było, że w wydziale może być parę robaczywych Pożywnowoców, ale to mnie zaskoczyło.
    m_Metadata:
      m_Items: []
  - m_Id: 75703065789644800
    m_Localized: Na ladzie masz kontrabandę!
    m_Metadata:
      m_Items: []
  - m_Id: 75703065827393536
    m_Localized: Na ladzie masz skradzione przedmioty!
    m_Metadata:
      m_Items: []
  - m_Id: 77669637538234369
    m_Localized: Wolę nie ryzykować z Widmowodą.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897668009984
    m_Localized: Potrzebuję czegoś celnego.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564416
    m_Localized: Potrzebuję czegoś o dużej sile ognia.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564417
    m_Localized: Potrzebuję czegoś dużego, czym można zastraszyć.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564418
    m_Localized: Masz coś celnego? A może z tłumikiem?
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564419
    m_Localized: Potrzebuję czegoś ładnego.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564420
    m_Localized: Potrzebuję czegoś niezawodnego. Najlepiej z tłumikiem.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564421
    m_Localized: Potrzebuję czegoś, czym można nastraszyć. Im większe, tym lepsze.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564422
    m_Localized: Nic skomplikowanego. Zwykła broń, która prosto strzela i się nie zacina.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564423
    m_Localized: Chcę porządnej broni osobistej, wszechstronnej.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564424
    m_Localized: Coś poważnego, bez słabych stron. Każdy dobry szczegół podniesie cenę.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564425
    m_Localized: Chwileczkę. Masz broń ręczną? Mogę wydać {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564426
    m_Localized: Daj mi najlepszą broń {0}. Zapłacę, ile jest warta, i dorzucę połowę wartości.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564427
    m_Localized: Masz do tego amunicję {0}?
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564428
    m_Localized: Chcę też mieć coś w zanadrzu do walki w zwarciu.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564429
    m_Localized: Masz może {0} lub materiały wybuchowe?
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564430
    m_Localized: Mogę wydać {0} więcej.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564431
    m_Localized: Potrzebuję czegoś łatwego w obsłudze, co dobrze się trzyma w ręku.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944594010112
    m_Localized: Twoje ostatnio wykonane usługi rzeczoznawcze przyciągnęły uwagę rady.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370240
    m_Localized: Rada chciałaby cię awansować do rangi {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370241
    m_Localized: Będziesz otrzymywać wyższe opłaty za rzeczoznawstwo wszystkich przedmiotów, ale rada będzie oczekiwać dokładniejszych ocen.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370242
    m_Localized: Będziesz również w stanie oceniać nowe przedmioty.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370244
    m_Localized: '[Odmów na zawsze]'
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370245
    m_Localized: Gratulacje. Oto twój nowy certyfikat.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370246
    m_Localized: I materiały szkoleniowe na temat nowych przedmiotów.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370247
    m_Localized: Od teraz spodziewaj się bardziej wymagających klientów.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370248
    m_Localized: Zrozumiano. Wrócę za tydzień.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370249
    m_Localized: Rozumiem. Rada nie będzie pytać ponownie.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370250
    m_Localized: Twój obecny certyfikat wciąż jest ważny.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370243
    m_Localized: Opłata certyfikacyjna wynosi {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 87495551897878528
    m_Localized: Po Czarnym Rynku niosą się wieści. Sklepikarz z zespołem kolapsu immunologicznego.
    m_Metadata:
      m_Items: []
  - m_Id: 87495551897878529
    m_Localized: Mam, czego potrzebujesz, ale z każdym dniem cena trochę wzrasta.
    m_Metadata:
      m_Items: []
  - m_Id: 87495551897878530
    m_Localized: Widzę, że wciąż żyjesz.
    m_Metadata:
      m_Items: []
  - m_Id: 87495551897878531
    m_Localized: Cena wzrosła od ostatniego tygodnia.
    m_Metadata:
      m_Items: []
  - m_Id: 87495551897878532
    m_Localized: Do zobaczenia za tydzień. Postaraj się nie umrzeć do tego czasu.
    m_Metadata:
      m_Items: []
  - m_Id: 88850639862153216
    m_Localized: Możesz popracować nad moją bronią ({0})? Chcę, żeby była lepsza. Za części, które zamontujesz, zapłacę.
    m_Metadata:
      m_Items: []
  - m_Id: 88850639891513344
    m_Localized: Ta etykieta kłamie. Policzę to według tego, czym naprawdę jest.
    m_Metadata:
      m_Items: []
  - m_Id: 88850639891513345
    m_Localized: Hej, potrzebuję zaopatrzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 88850639891513346
    m_Localized: Niedługo ruszamy do akcji.
    m_Metadata:
      m_Items: []
  - m_Id: 88850639891513347
    m_Localized: Masz broń i leki?
    m_Metadata:
      m_Items: []
  - m_Id: 89343935436865536
    m_Localized: To ty! Przez ciebie mnie zgarnęli!
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254144
    m_Localized: Ochrona trzymała mnie dwa dni, zanim się połapała, że to nie ja.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254145
    m_Localized: Mówiłem ci, że to nie ja, a i tak skończyło się donosem!
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254146
    m_Localized: Chcę tylko zrobić zakupy.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254147
    m_Localized: No to co, tym razem sprzedasz mi coś do jedzenia?
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254148
    m_Localized: Znowu?! Za co?!
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254149
    m_Localized: Dzień dobry! Jak ci się podoba nowe malowanie?
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254150
    m_Localized: Tak się kończy donoszenie na niewinnych.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254151
    m_Localized: Miłego sprzątania!
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254152
    m_Localized: Hej, przecież mnie znacie. Bierzecie nie tego gościa!
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254153
    m_Localized: Jesteś aresztowany za wandalizm.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254154
    m_Localized: Czekaj, czekaj! Proszę, nie zgłaszaj mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254155
    m_Localized: Mogę dalej przynosić ci tanie jedzenie, obiecuję.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254156
    m_Localized: Nie pożałujesz.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254157
    m_Localized: Ta sama umowa co ostatnio, jeśli chcesz.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254158
    m_Localized: Zaczekaj, proszę!
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254159
    m_Localized: Puść mnie, a jak skończę, podzielę się z tobą recepturą!
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254160
    m_Localized: Dziękuję. Być może dzięki tobie wiele osób nie przedawkuje Oxymore.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254161
    m_Localized: Cześć, to znowu ja.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254162
    m_Localized: Moje badania są prawie skończone, ale potrzebuję środków chemicznych.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254163
    m_Localized: Ochrona wciąż wszędzie mnie szuka.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254164
    m_Localized: Pomóż mi, a podzielę się z tobą recepturą.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254165
    m_Localized: Masz coś teraz? Jeśli nie, mogę wrócić za tydzień.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254166
    m_Localized: Im więcej mi dasz, tym szybciej skończę.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254167
    m_Localized: To w zupełności wystarczy, dziękuję!
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254168
    m_Localized: Wrócę, jak tylko skończę.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254169
    m_Localized: Hej, skończyłem!
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254170
    m_Localized: Dziękuję za pomoc i za dyskrecję.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254171
    m_Localized: Spróbuję teraz uciec ze Stacji i opublikować swoje badania.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254172
    m_Localized: Oto receptura.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047478210560
    m_Localized: Na pewno chcesz to zrobić? Zastanów się, przyjaźnie radzę.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736512
    m_Localized: Tak świeże mięso trudno zdobyć. Ktoś zawsze za nie płaci.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736513
    m_Localized: Ja przynoszę mięso, ty je sprzedajesz. Nikt nie musi pytać, skąd pochodzi.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736514
    m_Localized: Nikt mnie długo nie zatrzyma. Jak wyjdę, wrócę po twoje mięso.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736515
    m_Localized: Cholera! Ale z niego kawał chłopa! Wezwijcie więcej ludzi!
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736516
    m_Localized: Znowu się widzimy. Wróciłem ze świeżym mięsem.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736517
    m_Localized: Hej, słyszałem, że {0} nie daje ci spokoju.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736518
    m_Localized: Ten typ napsuł też sporo krwi mojej ekipie.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736519
    m_Localized: Może dorzucisz się {0} kredytów, a my zajmiemy się problemem za ciebie?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736520
    m_Localized: Możesz zapłacić przez terminal <b>usług nocnych</b>, kiedy tylko zechcesz.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736521
    m_Localized: Czekaj, nie zgłaszaj mnie!
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736522
    m_Localized: Z Rewolucją nie mam już wiele wspólnego.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736523
    m_Localized: Jeśli mnie puścisz, wstawię się za tobą u młodych z Rewolucji.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736524
    m_Localized: Dziękuję.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736525
    m_Localized: Chwila, nie rób tego.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736526
    m_Localized: Jeśli mnie nie zgłosisz, będę ci dalej przynosił sprzęt Ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736527
    m_Localized: Na pewno znajdziesz kupców, którzy dobrze za niego zapłacą.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736528
    m_Localized: Hej, wróciłem.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736529
    m_Localized: Mam trochę „nadwyżkowego” sprzętu Ochrony.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736530
    m_Localized: Chcesz rzucić okiem?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736531
    m_Localized: Chociaż narzędzia pewnie też by się nadały.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736532
    m_Localized: Może przecinak plazmowy albo śrubokręt?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736533
    m_Localized: Dzień dobry, śpiochu!
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736534
    m_Localized: W nocy schowałam ci gdzieś między rzeczami mały prezencik.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736535
    m_Localized: O północy zrobi bum. Tik-tak!
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736536
    m_Localized: Lepiej znajdź go przed snem, Owocku. <i>Mrug</i>
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736537
    m_Localized: Hej, Owocku, podobała ci się „bomba”, którą ci zostawiłam?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736538
    m_Localized: Ta twoja mina, bezcenna! <i>Chichot</i>
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736539
    m_Localized: W każdym razie muszę załatwić parę spraw.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736540
    m_Localized: Przypilnujesz przez chwilę mojego pudła z zabawkami?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736541
    m_Localized: Lepiej niczego w środku nie ruszaj, bo inaczej... <i>Mrug</i>
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736542
    m_Localized: Dzięki!
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736543
    m_Localized: Hej, wróciłam! Tęskniło się?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736544
    m_Localized: Zabieram swoje rzeczy.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736545
    m_Localized: Ktoś tu zajrzał do mojego pudła, prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736546
    m_Localized: Oj, nie rób takiej winnej miny, niegrzeczny Owocku.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736547
    m_Localized: Dziewczyna może mieć swoje małe hobby.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736548
    m_Localized: Może następnym razem pokażę ci, jak działają. Do zobaczenia! <i>Mrug</i>
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736549
    m_Localized: Ani jednego zerknięcia?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736550
    m_Localized: Taki grzeczny Owocek. Aż mam ochotę cię schrupać.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736551
    m_Localized: Do zobaczenia!
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736552
    m_Localized: Hmm? Czegoś brakuje.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736553
    m_Localized: 'Mówiłam: nie ruszać moich zabawek, Owocku.'
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736554
    m_Localized: Niegrzeczne Owocki dostają karę. <i>Mrug</i>
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736555
    m_Localized: Masz tu jeszcze jeden prezencik. Tym razem prawdziwy. Pa, pa!
    m_Metadata:
      m_Items: []
  - m_Id: 89710422362210304
    m_Localized: Cześć, przyjacielu! Dziś twój szczęśliwy dzień!
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404608
    m_Localized: Georgio sprawił sobie nowiutki plecak, więc starego trzeba się pozbyć.
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404609
    m_Localized: Duża zniżka, specjalnie dla ciebie!
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404610
    m_Localized: Cześć, przyjacielu.
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404611
    m_Localized: Jak już wiesz, Georgio to najlepszy złomiarz wszech czasów.
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404612
    m_Localized: Więc czemu nie pomóc innym złomiarzom?
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404613
    m_Localized: Georgio oferuje teraz pomoc na wysypisku.
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404614
    m_Localized: Chcesz spróbować? {0:plural:{} kredyt|{} kredyty|{} kredytów} za {1:plural:{} noc|{} noce|{} nocy} pomocy!
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404615
    m_Localized: '[Przyjmij ({0:plural:{} kredyt|{} kredyty|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404616
    m_Localized: Świetnie! Georgio czeka na ciebie dziś w nocy na wysypisku.
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404617
    m_Localized: Kiedy Georgio jest w pobliżu, nikomu nic się nie stanie!
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404618
    m_Localized: Nie ma sprawy, przyjacielu. Może następnym razem!
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404619
    m_Localized: Przyjacielu! Georgio rozkręca nowy biznes!
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404620
    m_Localized: Georgio zawsze ma szczęście, więc czemu nie sprzedać trochę?
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404621
    m_Localized: Oto Płynne szczęście! Pierwsza butelka gratis!
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404622
    m_Localized: Cześć, przyjacielu! I jak tam Płynne szczęście?
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404623
    m_Localized: Georgio ma ostatnią partię na sprzedaż. Bierz, póki jest!
    m_Metadata:
      m_Items: []
  - m_Id: 90055627569414144
    m_Localized: Alter, masz coś do otwarcia?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774272
    m_Localized: Typu skrzynka albo karta?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774273
    m_Localized: Zbierz, ile się da, za tydzień wrócę i wszystko kupię.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774274
    m_Localized: Hallo, masz te skrzynki albo karty?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774275
    m_Localized: Alter, otwórzmy jedną od razu!
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774276
    m_Localized: GOLD GOLD GOLD
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774277
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774278
    m_Localized: Scheiße!
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774279
    m_Localized: Przyjacielu! Georgio ma coś dla ciebie.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774280
    m_Localized: Georgio znalazł na Wysypisku pewnego młodego człowieka.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774281
    m_Localized: Poprosił Georgio, żeby przyniósł ci ten list. Georgio go nie czytał. Za bardzo.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774282
    m_Localized: Witam ponownie.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774283
    m_Localized: Kadeta Serpico znów widziano na Niższych Poziomach.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774284
    m_Localized: Nagroda za niego wzrosła do {0:plural:{} kredytu|{} kredytów|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774285
    m_Localized: Liczymy na ciebie.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774286
    m_Localized: Hej, to ja, Serpico.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774287
    m_Localized: Dowody wyszły na jaw. Cała stacja je przeczytała.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774288
    m_Localized: Kilku szeregowych funkcjonariuszy ma zarzuty. Ci na górze wyszli z tego czyści.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774289
    m_Localized: Więc dołączyłem do Rewolucji. Skoro system sam się nie oczyści, zrobimy to my.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774290
    m_Localized: Dzięki za wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774291
    m_Localized: Hej, to ja, Serpico. Znów w mundurze.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774292
    m_Localized: Oficer z twojego polecenia zaniósł dowody na sam szczyt.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774293
    m_Localized: Zarzuty dostali funkcjonariusze wszystkich stopni, ci najwyżsi też.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774294
    m_Localized: A mnie przenieśli do nowej grupy antykorupcyjnej.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774295
    m_Localized: Dzięki. Ochrona ma u ciebie dług.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774296
    m_Localized: Hej, to ja, Serpico.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774297
    m_Localized: Czarny Rynek dobrze zapłacił za dowody.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774298
    m_Localized: Wystarczyło, żeby wyciągnąć rodzinę z Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774299
    m_Localized: Opuszczamy stację na dobre.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774300
    m_Localized: Zanim pójdę, chcę ci coś dać. Wybierz, co ci się przyda.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774301
    m_Localized: Uważaj na siebie.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774302
    m_Localized: Żegnaj i dzięki.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774303
    m_Localized: '[Rewolucja]: Przekaż Rewolucji'
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774304
    m_Localized: Rewolucja... Współpraca z wrogiem?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774305
    m_Localized: Ale może tylko tak da się przemówić tej stacji do rozumu.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774306
    m_Localized: Dobra. Znajdę sposób, żeby im to przekazać. Dzięki za wysłuchanie.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774307
    m_Localized: '[Czarny Rynek]: Sprzedaj i uciekaj'
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774308
    m_Localized: Czarny Rynek sporo by za to zapłacił.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774309
    m_Localized: Wystarczy, żeby wyciągnąć rodzinę z Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774310
    m_Localized: To nie sprawiedliwość, ale przynajmniej ochronię rodzinę.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774311
    m_Localized: '[Ochrona (wymagana reputacja: {0})]: Przekaż zaufanemu oficerowi wysokiej rangi'
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774312
    m_Localized: Ufasz tej osobie? Z jej nazwiskiem w tle to może się naprawdę utrzymać.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774313
    m_Localized: Tak trzeba to zrobić. Jutro rano to oddam. Naprawdę dzięki.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774314
    m_Localized: Hej, to ja, Serpico. Dzięki za zostawione jedzenie.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774315
    m_Localized: Od naszej ostatniej rozmowy nie próżnowałem. Przejrzałem wszystkie dowody, które zabrałem przed ucieczką.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774316
    m_Localized: Teraz wszystko jest zebrane w całość.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774317
    m_Localized: Ale nie mogę z tym wejść do biura Ochrony, a nie wiem, komu jeszcze na tej stacji mogę ufać.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774318
    m_Localized: Za tą ladą słyszysz wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774319
    m_Localized: 'Więc pytam ciebie: komu mam przekazać ten dokument?'
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774320
    m_Localized: Ach, ty głuptasku, Owocku! To ja, Lou!
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774321
    m_Localized: Hahaha, nie wierzę, że to zadziałało.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774322
    m_Localized: Haha, nieźle. Moje przebranie nie miało z tobą szans.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774323
    m_Localized: Bystre oko, Owocku. Spryt i urok w jednym? Uważaj, bo jeszcze cię polubię. <i>*mrug*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968576
    m_Localized: No i jak? <i>*obraca się*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968577
    m_Localized: Dobrze mi w tym mundurze, prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968578
    m_Localized: Poprzedni właściciel już go nie będzie potrzebował. <i>*chichot*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968579
    m_Localized: Pamiętasz mojego „gościa”? W końcu się przede mną otworzył.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968580
    m_Localized: Zdradził mi, gdzie jest ktoś, z kim mam rachunki do wyrównania.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968581
    m_Localized: A poza tym nagroda za mnie trafiła do twojej kieszeni, kiedy wezwano na mnie Ochronę,
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968582
    m_Localized: więc powiedziałabym, że wisisz mi przysługę czy dwie.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968583
    m_Localized: Do wyrównania tych rachunków potrzebuję nowych zabawek, a ty mi je załatwisz.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968584
    m_Localized: Broń, amunicja i leki za {0:plural:{} kredyt|{} kredyty|{} kredytów} i jesteśmy kwita.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968585
    m_Localized: Wrócę za tydzień. Nie każ dziewczynie czekać, Owocku. <i>*mrug*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968586
    m_Localized: Puk, puk, Owocku! Tęskniło się?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968587
    m_Localized: Przyszłam po nowe zabawki. Broń, amunicja i leki za {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968588
    m_Localized: I nawet nie próbuj mi czegoś wcisnąć. Pożyczyłam od Ochrony wszystkie skanery. <i>*mrug*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968589
    m_Localized: Połóż je na ladzie, kiedy tylko zechcesz.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968590
    m_Localized: '[To wszystko, co mam]'
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968591
    m_Localized: Oo, to mi się podoba.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968592
    m_Localized: Wszystko, o co prosiłam. Grzeczny Owocek!
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968593
    m_Localized: To wszystko? Brakuje jeszcze {0:plural:{} kredytu|{} kredytów|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968594
    m_Localized: To resztę wezmę w gotówce. <i>*mrug*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968595
    m_Localized: Nie masz nawet tyle? To zabiorę wszystko z twojej kasy.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968596
    m_Localized: Cóż, fajnie się z tobą bawiło. Może kiedyś jeszcze się zobaczymy.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968597
    m_Localized: To nawet nie połowa twojego długu, Owocku.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968598
    m_Localized: A myślałam, że tak świetnie się bawimy.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968599
    m_Localized: No to wyrównam rachunki po staremu.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968600
    m_Localized: Masz tu ostatni prezencik. Tym razem prawdziwy. Pa, pa! <i>*mrug*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90295236836507648
    m_Localized: Dzień dobry. Znasz Eleanor, prawda? Jestem jej... wujkiem.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256384
    m_Localized: Przygotowaliśmy dla niej małą paczkę. Same najlepsze towary z Wyższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256385
    m_Localized: Tylko nie mogę jej nigdzie znaleźć.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256386
    m_Localized: Możesz jej to dać, kiedy następnym razem wpadnie?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256387
    m_Localized: Dopilnuj, żeby trafiła do jej rąk. Nie twoich. Jej.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256388
    m_Localized: 'A gdyby ktoś pytał: nigdy mnie tu nie było.'
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256389
    m_Localized: Aha, i nie mieszaj w to Ochrony. To sprawy rodzinne.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256390
    m_Localized: Dzień dobry. Zgłoszono kradziony towar?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256391
    m_Localized: Nie ukradłem tego! Oto paragon.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256392
    m_Localized: To dlaczego zgłosił pan jego kradzież?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256393
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256394
    m_Localized: Fałszywe zgłoszenie kradzieży to przestępstwo. Pójdzie pan z nami!
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256395
    m_Localized: Stać! Ta skrzynia została zgłoszona jako skradziona.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256396
    m_Localized: Co? To nie moje! Pierwszy raz ją widzę!
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256397
    m_Localized: Jaka matka, taka córka. Pójdziesz z nami.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256398
    m_Localized: Proszę, ktoś mnie wrobił! Powiedz im!
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256399
    m_Localized: Hej, zastanawiałam się, co dalej.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256400
    m_Localized: Jestem pewna, że ktoś z Wyższych Poziomów wrobił moją matkę.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256401
    m_Localized: Nie mogę pojechać na górę i wypytywać, ale prywatny detektyw już tak.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256402
    m_Localized: Dobry kosztuje {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256403
    m_Localized: Więc dalej będę przeszukiwać Wysypisko i sprzedawać ci, co znajdę.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256404
    m_Localized: Daj uczciwą cenę, dobrze? Każdy kredyt przybliża mnie do celu.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256405
    m_Localized: Dziękuję! Brakuje już tylko {0:plural:{} kredytu|{} kredytów|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256406
    m_Localized: Hej, to znowu ja.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256407
    m_Localized: Jeszcze {0:plural:{} kredyt|{} kredyty|{} kredytów} i będę mogła wynająć detektywa.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256408
    m_Localized: Oto, co tym razem znalazłam na Wysypisku.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256409
    m_Localized: Dobra, chyba mam już dość kredytów.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256410
    m_Localized: Dziękuję. Dowiem się, kto to zrobił mojej matce.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256411
    m_Localized: '<i>*Opowiedz jej o mężczyźnie, który podawał się za jej wujka*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256412
    m_Localized: Mój wujek? Nie mam żadnego wujka.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256413
    m_Localized: Zostawił dla mnie skrzynię? Zgłoszoną jako skradziona?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256414
    m_Localized: Chcieli, żeby mnie aresztowano. Tak jak moją matkę.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256415
    m_Localized: Ja... potrzebuję czasu, żeby to przemyśleć.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256416
    m_Localized: Ale dzięki tobie wiem. Proszę, weź coś. To wszystko, co zostało mi z domu.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256417
    m_Localized: Wrócę, kiedy poukładam sobie wszystko w głowie.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256418
    m_Localized: Hej. Detektyw coś znalazł.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256419
    m_Localized: Nośnik danych ukryty w starym laboratorium mojej matki na farmie hydroponicznej.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256420
    m_Localized: Jest zablokowany, ale znam hasło. Mama zawsze używała daty moich urodzin.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256421
    m_Localized: Nie mogę dłużej czekać. Otworzę go tutaj.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256422
    m_Localized: '<i>*czyta z ekranu*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256423
    m_Localized: To... badania genetyczne. Nad Pożywnowocem.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256424
    m_Localized: Znalazła sposób, żeby zwykły Pożywnowoc znów dawał nasiona.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256425
    m_Localized: Z tymi danymi każdy przyzwoity biohaker mógłby go zmodyfikować.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256426
    m_Localized: Koniec z kupowaniem nasion od pastel. To mogłoby poważnie zaszkodzić pastel.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256427
    m_Localized: Dlatego się na nią uwzięli.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256428
    m_Localized: Zarzuty defraudacji były zmyślone. Wszystkie.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256429
    m_Localized: Wszystko ukartował przedstawiciel korporacji pastel na stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256430
    m_Localized: Ja... potrzebuję czasu, żeby zastanowić się, co zrobić.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256431
    m_Localized: Pamiętasz mnie?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256432
    m_Localized: Wiemy, że kontaktujesz się z Eleanor. I wiemy o nośniku danych.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256433
    m_Localized: Powiedz jej, żeby nam go oddała, albo jej matka zginie.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256434
    m_Localized: Jeśli go odda, uwolnimy jej matkę. Zostanie zesłana na Niższe Poziomy, ale przeżyje.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256435
    m_Localized: A jeśli namówisz ją, żeby go oddała, dostaniesz {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256436
    m_Localized: Nie zwlekaj za długo.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256437
    m_Localized: '<i>*Opowiedz jej o propozycji uwolnienia jej matki*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256438
    m_Localized: Uwolnią ją, jeśli oddam nośnik?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256439
    m_Localized: Zesłana tutaj na dół... ale żywa.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256440
    m_Localized: A jeśli to ujawnię, zabiją ją. Ale nikt już nigdy nie będzie potrzebował nasion od pastel.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256441
    m_Localized: Nie wiem, co robić. Co mi radzisz?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256442
    m_Localized: '[Oddaj nośnik i uratuj jej matkę]'
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256443
    m_Localized: '[Przekaż to gazecie z Niższych Poziomów]'
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256444
    m_Localized: Masz rację. Tylko ona mi została.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256445
    m_Localized: Oddam im go. Dziękuję.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256446
    m_Localized: Masz rację. To coś większego niż my.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256447
    m_Localized: Mama chciałaby, żeby każdy to miał.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256448
    m_Localized: Jeszcze dziś zaniosę to do gazety z Niższych Poziomów.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256449
    m_Localized: Hej! Mama jest wolna.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256450
    m_Localized: Zesłali ją na Niższe Poziomy, ale znów jesteśmy razem.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256451
    m_Localized: Teraz razem przeszukujemy Wysypisko. To nie to życie, które miałyśmy, ale jest nasze.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256452
    m_Localized: Dziękuję ci za wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256453
    m_Localized: Kupiłam to mamie na urodziny tuż przed tym, jak to wszystko się zaczęło.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256454
    m_Localized: Teraz już nie będzie jej to potrzebne.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256455
    m_Localized: Weź to, proszę.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256456
    m_Localized: Bez ciebie chyba bym tak daleko nie zaszła.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256457
    m_Localized: Mam nadzieję, że jeszcze kiedyś się zobaczymy.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256458
    m_Localized: Uważaj na siebie.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256459
    m_Localized: Jeszcze raz dziękuję. Za wszystko.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256460
    m_Localized: Hej. To ja.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256461
    m_Localized: Zabili mamę tego ranka, kiedy wyszła gazeta.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256462
    m_Localized: Dołączyłam do Rewolucji. Pomogą mi sprawić, że pastel za to zapłaci, i ukryją mnie przed korporacją.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256463
    m_Localized: Kupiłam to mamie na urodziny. Teraz to chyba bez znaczenia. Weź to, proszę.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256464
    m_Localized: A teraz potrzebuję broni. Co masz?
    m_Metadata:
      m_Items: []
  - m_Id: 90598789824167936
    m_Localized: Cześć! Słyszałem nowiny.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333760
    m_Localized: Ten lokal jest teraz twój. Gratulacje, tu na dole to nie byle co!
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333761
    m_Localized: Skoro już wiadomo, że umiesz prowadzić interes, mam dla ciebie coś nowego.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333762
    m_Localized: Mówi ci coś Hypertech?
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333763
    m_Localized: Niesamowicie przydatne rzeczy, daleko poza zasięgiem tego, co potrafi wyprodukować przemysł tej stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333764
    m_Localized: Nawet na Wyższych Poziomach niełatwo to zdobyć.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333765
    m_Localized: Znam przemytnika, który tym handluje. Mogę cię polecić, oczywiście za niemałą opłatą.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333766
    m_Localized: 'Ale ostrzegam: każdy krok, żeby zdobyć te rzeczy, będzie bardzo kosztowny.'
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333767
    m_Localized: Zadzwoń do mnie, kiedy przyjdzie pora.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333768
    m_Localized: Przysłał mnie Joe Wild. Załatwmy to szybko.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333769
    m_Localized: Tyle udało mi się tym razem zdobyć. Cena to cena.
    m_Metadata:
      m_Items: []
  - m_Id: 91072420257775616
    m_Localized: Dobrze, wrócę za tydzień. Proszę do tego czasu przygotować trochę odczynników chemicznych.
    m_Metadata:
      m_Items: []
  - m_Id: 91072420274552832
    m_Localized: Brakuje jeszcze towaru za {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 91072420274552833
    m_Localized: Dobrze. Do jej rąk, nie twoich. Będę wiedział.
    m_Metadata:
      m_Items: []
  - m_Id: 91072420274552834
    m_Localized: Nie mam już rodziny.
    m_Metadata:
      m_Items: []
  - m_Id: 91072420274552835
    m_Localized: To wszystko, co mam dzisiaj. Jeszcze {0:plural:{} kredyt|{} kredyty|{} kredytów} i będę mogła wynająć detektywa.
    m_Metadata:
      m_Items: []
  - m_Id: 91851101476384768
    m_Localized: Najpierw trzeba wyjąć ten filtr. Chcę kupić tylko wodę.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491328
    m_Localized: A grzeczne Owocki dostają nagrodę. No dalej, wybierz coś.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491329
    m_Localized: Oo, dobry wybór.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491330
    m_Localized: '[Poproś o przysługę (reputacja u Niższych Poziomów: {0}+)]'
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491331
    m_Localized: Dla kogoś, kogo tak cenią na Niższych Poziomach? Ani słowa więcej.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491332
    m_Localized: '[Daj jej {0:plural:{} kredyt|{} kredyty|{} kredytów}]'
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491333
    m_Localized: Słówko w sprawie dziewczyny, którą tu zatrzymaliśmy. Eleanor.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491334
    m_Localized: Przysięga, że ktoś ją wrobił. Twierdzi, że może zechcesz wpłacić za nią kaucję.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491335
    m_Localized: Kaucja wynosi {0:plural:{} kredyt|{} kredyty|{} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491336
    m_Localized: '[Wpłać kaucję ({0:plural:{} kredyt|{} kredyty|{} kredytów})]'
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491337
    m_Localized: '[Poręcz za nią (reputacja u Ochrony: {0}+)]'
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491338
    m_Localized: Zapłacone w całości. Jutro wyjdzie.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491339
    m_Localized: Dobra, jesteśmy ci winni parę przysług. Tym razem przymkniemy oko.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491340
    m_Localized: Jak chcesz. Zostaje tam, gdzie jest.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491341
    m_Localized: Ochrona mnie wypuściła. Powiedzieli, że to dzięki tobie.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491342
    m_Localized: Ta skrzynia nie była moja, a ja nie mam żadnego wujka.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491343
    m_Localized: Ktoś chciał mnie wsadzić za kratki, tak jak moją matkę.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491344
    m_Localized: Nie zapomnę tego. Dziękuję.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341568
    m_Localized: Ten młody człowiek jest bardzo głodny, prawda? Tak się składa, że Georgio ma skrzynkę Pożywnowoców.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341569
    m_Localized: Za {0:plural:{} kredyt|{} kredyty|{} kredytów} Georgio zaniesie je za ciebie. Nie musisz przynosić ani kęsa!
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341570
    m_Localized: Hmm... ale Georgio słyszał, że ostatnio nie możesz chodzić na Wysypisko.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341571
    m_Localized: Nie martw się! Tak się składa, że Georgio ma skrzynkę Pożywnowoców.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341572
    m_Localized: Za {0:plural:{} kredyt|{} kredyty|{} kredytów} Georgio zaniesie je za ciebie. Inaczej Georgio boi się, że ten młody człowiek nie przeżyje.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341573
    m_Localized: Świetnie! Dziś w nocy ten młody człowiek zje jak król.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341574
    m_Localized: Twój przyjaciel jest przyjacielem Georgio!
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341575
    m_Localized: Nie ma sprawy, przyjacielu. Georgio ufa, że nakarmisz go własnymi siłami.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341576
    m_Localized: Georgio rozumie. Miejmy nadzieję, że ten młody człowiek sam znajdzie coś do jedzenia.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676211060736
    m_Localized: Ej, co jest? Schowaj to!
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420864
    m_Localized: '<i>*odwraca ciało*</i> Chwila. Kadet Serpico.'
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420865
    m_Localized: '<i>*chichocze*</i> Dzieciak, który nie umiał trzymać gęby na kłódkę. Chłopaki będą zachwyceni.'
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420866
    m_Localized: Tak formalnie, ta twoja broń jest tylko na Ulpy.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420867
    m_Localized: Ale między nami? Właśnie oszczędziłeś wydziałowi kupę papierkowej roboty.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420868
    m_Localized: Zapiszemy to jako ujęcie. Nagroda jest twoja.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420869
    m_Localized: Zaraz. Donosisz na mnie? Teraz?
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420870
    m_Localized: No proszę, kogo my tu mamy. Kadet, który został Rewolucjonistą.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420871
    m_Localized: To już wyszło na jaw. Każde nazwisko. Aresztowanie mnie niczego nie zmieni.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420872
    m_Localized: A kto mówił o aresztowaniu?
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420873
    m_Localized: Pakujemy go do worka.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420874
    m_Localized: Nie... Mieliśmy wyjechać dziś w nocy. Moja rodzina czeka w dokach.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420875
    m_Localized: To sobie poczekają.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420876
    m_Localized: Dobra decyzja. Jedna niedokończona sprawa mniej.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420877
    m_Localized: Ten nie ma żadnych wszczepów... chwila. Li Bei Wen? Ten chemik?
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420878
    m_Localized: O, dobrze się spisałeś. Ten człowiek był niebezpieczny. Bardzo, BARDZO niebezpieczny.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420879
    m_Localized: Hehe, pewnie dostanę premię od przedstawiciela korporacji za zamknięcie tej sprawy.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420880
    m_Localized: Nagroda jest twoja. My zabierzemy ciało.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420881
    m_Localized: Chwila. Znam tę twarz. {0}, z listy poszukiwanych.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420882
    m_Localized: Ta broń jest na Ulpy, sklepikarzu. Wyceluj nią jeszcze raz w obywatela, a odbędziemy zupełnie inną rozmowę.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420883
    m_Localized: Ale nikt nie będzie tracił snu przez groźnego przestępcę. Zapiszemy to jako ujęcie. Nagroda jest twoja.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420884
    m_Localized: ARGH! Zapłacisz za to
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420885
    m_Localized: Ej, przerażasz mnie...
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420886
    m_Localized: Tylko spokojnie. Proszę. Tylko... spokojnie.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420887
    m_Localized: To rutynowa kontrola Ochrony. Rutynowa. Bardzo rutynowa.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420888
    m_Localized: Ta jest... wyjątkowa. Rozkaz z góry.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420889
    m_Localized: No więc, ee. Otwórz luk i się odsuń. Szybko, zanim moja zmiana... to znaczy, zanim skończy się moja zmiana.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420890
    m_Localized: To obejmuje też strzelbę. Oddaj ją.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420891
    m_Localized: Twoje pozwolenie na broń obejmuje strzelbę. Zatrzymaj ją do samoobrony.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420892
    m_Localized: Ooo. Ostrożnie z tym, Owocku. Na mnie masz tylko jeden strzał.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420893
    m_Localized: AAA!
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420894
    m_Localized: ...Skąd to masz?
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420895
    m_Localized: Znam tę zabawkę. Wydana przez Republikę.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420896
    m_Localized: Można było to schować w moich rzeczach. A zamiast tego mi to pokazano.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420897
    m_Localized: Teraz po mnie przyjdą. Dobrze. Niech przychodzą.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420898
    m_Localized: Przepraszam za to wszystko. Teraz muszę prosić o pomoc.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420899
    m_Localized: Potrzebuję broni, amunicji, leków. Wszystkiego, co da się oddać. Proszę.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420900
    m_Localized: Połóż to na ladzie. Ile tylko możesz.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420901
    m_Localized: '[To wszystko, co mam]'
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420902
    m_Localized: Dobrze. Więcej, jeśli masz.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420903
    m_Localized: Wystarczy. W zupełności wystarczy.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420904
    m_Localized: Dziękuję, Owocku. Jeszcze się odezwę.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420905
    m_Localized: To może nie wystarczyć. Nie żebym była niewdzięczna.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420906
    m_Localized: Musi wystarczyć. Życz mi szczęścia, Owocku.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420907
    m_Localized: Sklepikarzu, mój zespół i ja od jakiegoś czasu tropimy kobietę o imieniu Lou.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420908
    m_Localized: Sądzimy, że właśnie ją spotkałeś. To zdrajczyni Republiki i terrorystka.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420909
    m_Localized: Ci zwykli funkcjonariusze Ochrony jej nie zatrzymają.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420910
    m_Localized: Wróci tutaj i będzie chciała się bawić.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420911
    m_Localized: To psychopatka, ale przewidywalna. Cierpliwości. Graj z nią.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420912
    m_Localized: Weź ten nadajnik. Ukryj go w czymś, co ona zabierze ze sobą. W pudle, w skrzyni, w czymkolwiek, co wyjdzie stąd razem z nią.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420913
    m_Localized: Gdy trafi do jej kryjówki, wkroczymy. Są tam informacje, które Republika musi odzyskać.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420914
    m_Localized: Pomóż nam ją schwytać, a {0:plural:{} kredyt będzie twój|{} kredyty będą twoje|{} kredytów będzie twoich}. Nikomu ani słowa.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420915
    m_Localized: Kobieta, którą wczoraj postrzelono. Od lat nikomu nie udało się zrobić w niej dziury. Gratulacje.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420916
    m_Localized: To zdrajczyni Republiki i terrorystka. I nie wybacza. Będzie cię nawiedzać.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420917
    m_Localized: Najlepiej będzie, jeśli z nami współpracujesz.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420918
    m_Localized: Weź ten nadajnik. Ona przyjdzie się odegrać. Cokolwiek każe ci oddać, ukryj go w środku.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420919
    m_Localized: '{0:plural:{} kredyt|{} kredyty|{} kredytów} teraz, za fatygę. Kolejne {1}, gdy ją dostaniemy. Nikomu ani słowa.'
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420920
    m_Localized: Załatwione. Mamy ją.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420921
    m_Localized: Republika jest ci wdzięczna. Oto {0:plural:twój {} kredyt|twoje {} kredyty|twoje {} kredytów}.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420922
    m_Localized: Zgnije w tajnym więzieniu do końca życia.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420923
    m_Localized: Załatwione. Mamy ją. Kosztowało nas to dwoje dobrych ludzi.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420924
    m_Localized: Jakimś cudem wiedziała, że nadchodzimy. Zabawne, prawda?
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420925
    m_Localized: '{0:plural:Twój {} kredyt|Twoje {} kredyty|Twoje {} kredytów}, jak uzgodniono. Republika dotrzymuje słowa.'
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420926
    m_Localized: Od tej pory Ochrona będzie uważnie obserwować ten sklep. Na wszelki wypadek.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420927
    m_Localized: Czytałeś wiadomości, jak sądzę. Admirał Republiki, martwy, na tej stacji.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420928
    m_Localized: To jej sprawka, a mogliśmy ją powstrzymać.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420929
    m_Localized: Myślałem, że co do niej się rozumiemy.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420930
    m_Localized: Masz szczęście, że musimy wkrótce ruszać jej tropem, inaczej przyjrzelibyśmy się bliżej twojemu udziałowi w tej sprawie.
    m_Metadata:
      m_Items: []
  - m_Id: 94001378955673600
    m_Localized: Znam tu w okolicy handlarza bronią. {0:plural:{} kredyt pokryłby|{} kredyty pokryłyby|{} kredytów pokryłoby} resztę.
    m_Metadata:
      m_Items: []
  - m_Id: 94001378997616640
    m_Localized: '[Daj jej {0:plural:{} kredyt|{} kredyty|{} kredytów}]'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
