%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Dialogue_fr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 6088cd9926fb9d448897fd8a10a930e8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 84253943287037952
    m_Localized: Le taux d'intérêt annuel est de {0} %.
    m_Metadata:
      m_Items: []
  - m_Id: 84253943316398080
    m_Localized: Vous devrez nous payer {0:plural:{} crédit|{} crédits} chaque semaine pendant {1} semaines.
    m_Metadata:
      m_Items: []
  - m_Id: 335890120228864
    m_Localized: Bonjour bonjour ! Voilà Georgio !
    m_Metadata:
      m_Items: []
  - m_Id: 336281029361664
    m_Localized: Oui, LE Georgio en chair et en os !
    m_Metadata:
      m_Items: []
  - m_Id: 420216455348224
    m_Localized: Le MEILLEUR fureteur des strates inférieures !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542528
    m_Localized: Vous avez du pot que ce soit à vous que je montre mes dernières trouvailles.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542529
    m_Localized: Regardez ces reliques ! Elles viennent d'une civilisation extraterrestre...
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542530
    m_Localized: Impeccable ! Remarquable !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542531
    m_Localized: Allez, à la prochaine !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542532
    m_Localized: Mais ? J'ai rien fait de mal !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542533
    m_Localized: Baissez d'un ton, l'ancêtre. Et suivez-nous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542534
    m_Localized: Me revoici !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542535
    m_Localized: Vous vous souvenez de Georgio, j'espère ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542536
    m_Localized: Aujourd'hui, je vous apporte ma dernière invention.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542537
    m_Localized: Vous allez la voir en avant-première.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542538
    m_Localized: Je vous présente... l'eau du FUTUR !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542539
    m_Localized: Georgio est de retour !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542540
    m_Localized: J'ai trouvé de vraies cigarettes Heminwai !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542541
    m_Localized: Ça vous dit ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542542
    m_Localized: Et puisque c'est vous, je vous fais un prix d'ami.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542543
    m_Localized: Youpi !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542544
    m_Localized: À bientôt !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542545
    m_Localized: Mais... Georgio est innocent !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542546
    m_Localized: Ça reste à déterminer. Venez avec nous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542547
    m_Localized: Qui est là ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542548
    m_Localized: Eh oui, Georgio !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542549
    m_Localized: J'ai pas mal fureté dans les strates supérieures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542550
    m_Localized: Qu'avez-vous bien pu dénicher là-haut ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542551
    m_Localized: Si vous prenez tout, Georgio accepte de vous faire une belle réduction de 25 % !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542552
    m_Localized: Oui, super !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542553
    m_Localized: À la revoyure !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542554
    m_Localized: Je vous proposerai d'autres choses, la prochaine fois.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542555
    m_Localized: Oh non, ça va pas recommencer !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542556
    m_Localized: Hé ! C'est le vieillard qui s'est introduit dans les bains pour femmes des strates supérieures !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542557
    m_Localized: On l'embarque.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542558
    m_Localized: Bonjour !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542559
    m_Localized: Revoilà Georgio !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542560
    m_Localized: Visez un peu ce que j'ai en stock pour vous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542561
    m_Localized: Intéressant, hein ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542562
    m_Localized: Où est-ce que vous avez trouvé tout ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542563
    m_Localized: Un bon fureteur révèle jamais ses sources !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542564
    m_Localized: Bon, vous achetez ou pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542565
    m_Localized: Georgio peut toujours trouver preneur ailleurs...
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542566
    m_Localized: Aaah, je savais que ça vous plairait !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542567
    m_Localized: À plus !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542568
    m_Localized: Et mettez des crédits de côté pour votre vieil ami.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542569
    m_Localized: Vous... Vous avez dénoncé Georgio ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542570
    m_Localized: Ah, le voilà. Vous êtes en état d'arrestation.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542571
    m_Localized: Il faudrait arrêter d'entrer par effraction dans la salle des preuves, monsieur.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542572
    m_Localized: Georgio est l'un de vous bons amis, avouez ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542573
    m_Localized: J'ai vu que vous aviez laissé des trucs à la décharge, hier soir...
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542574
    m_Localized: J'ai rien piqué ! Je vous ai tout rapporté.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542575
    m_Localized: Pas la peine de me remercier.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542576
    m_Localized: Comme on se retrouve !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542577
    m_Localized: Georgio a besoin d'un petit coup de main...
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542578
    m_Localized: Je suis en train de construire un vaisseau ! Pour fureter dans le système tout entier.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542579
    m_Localized: J'ai presque terminé, mais... je suis en panne de crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542580
    m_Localized: Vous voudriez bien aider votre ami ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542581
    m_Localized: Vraiment ? C'était pas dur de vous convaincre !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542582
    m_Localized: Prenez ça. J'en aurai pas besoin là où je vais...
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542583
    m_Localized: Je vous rembourserai avec les intérêts ! Foi de Georgio !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542584
    m_Localized: On se reverra dans les étoiles.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542585
    m_Localized: Vous me donnez autant ?! Oh, merci mille fois !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542586
    m_Localized: Voilà pour vous. J'en ai plus besoin, alors...
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542587
    m_Localized: Je vois... Pas de souci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542588
    m_Localized: Georgio dénichera les pièces manquantes du vaisseau à la décharge !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542589
    m_Localized: Prenez soin de vous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542590
    m_Localized: Non... Nooon ! Pitié !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542591
    m_Localized: Vous avez le droit de garder le silence.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542592
    m_Localized: Allez, en route !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542593
    m_Localized: Vous rêvez pas, non !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542594
    m_Localized: Georgio se tient bien devant vous !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542595
    m_Localized: Je viens vous rendre vos crédits avec les intérêts !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542596
    m_Localized: Et maintenant, je retourne dans mon vaisseau...
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542597
    m_Localized: L'univers n'attend pas !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542598
    m_Localized: Bonjour, je viens des secteurs centraux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542599
    m_Localized: Mon objectif dans la vie ? Goûter à tous les plats de la galaxie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542600
    m_Localized: Du coup, je vais acheter la nourriture et les boissons que vous vendez. Un exemplaire de chaque.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542601
    m_Localized: Je vous donne deux jours.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542602
    m_Localized: Nickel.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542603
    m_Localized: Je vais me régaler.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542604
    m_Localized: À un de ces quatre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542605
    m_Localized: JE VEUX MANGER, MOI, C'EST TOUT !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542606
    m_Localized: Moins fort ! Suivez-nous !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542607
    m_Localized: Je suis de retour.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542608
    m_Localized: Pour rappel, j'aimerais goûter à tous les plats de la galaxie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542609
    m_Localized: Je vais vous acheter votre nourriture et vos boissons. Un exemplaire de chaque.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542610
    m_Localized: J'ai tendance à payer plus cher pour des produits variés.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542611
    m_Localized: Bonjour. J'ai des marchandises à écouler rapidement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542612
    m_Localized: Je peux pas les garder, c'est trop dangereux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542613
    m_Localized: Bonjour, stationaute ! Ici l'agent Lun.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542614
    m_Localized: Je suis en pleine patrouille.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542615
    m_Localized: Le hic, c'est que j'ai oublié ma gamelle. Vous auriez à manger ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542616
    m_Localized: Je vous prends ça.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542617
    m_Localized: Non, j'ai juste faim.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542618
    m_Localized: Ça fera l'affaire.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542619
    m_Localized: À l'aide ! Il me faut des médicaments, c'est urgent !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542620
    m_Localized: Un type en combinaison grise m'a attaqué !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542621
    m_Localized: Donnez-moi quelque chose de fort, et tant pis si c'est de la contrebande !
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542622
    m_Localized: Le cas échéant, je fermerai les yeux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542623
    m_Localized: Merci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542624
    m_Localized: Non, non. Il me faut seulement un antidouleur.
    m_Metadata:
      m_Items: []
  - m_Id: 420216459542625
    m_Localized: Eh merde... Bon, j'accepte !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736832
    m_Localized: Ça devrait bien m'aider.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736833
    m_Localized: Dites, j'ai... hum... mis la main là-dessus.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736834
    m_Localized: Vous voulez faire affaire ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736835
    m_Localized: Marché conclu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736836
    m_Localized: Qu'est-ce qui se passe ?!
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736837
    m_Localized: C'est le type qui a agressé l'agent Lun !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736838
    m_Localized: Chope-le !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736839
    m_Localized: C'est pas vrai...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736840
    m_Localized: Bonjour. J'ai repris du service.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736841
    m_Localized: Après un passage express à l'infirmerie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736842
    m_Localized: Je viens pour le petit contrôle habituel.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736843
    m_Localized: Tant qu'à faire, je vais aussi vous prendre des antidouleurs.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736844
    m_Localized: Puissants, si possible.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736845
    m_Localized: Je les réserverai pour les situations d'urgence, évidemment...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736846
    m_Localized: Marché conclu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736847
    m_Localized: Merci. Pff, c'est vraiment pas donné.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736848
    m_Localized: Je ne cherche pas ce genre de médicament.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736849
    m_Localized: Du Synaprest ? Vous croyez que j'ai un problème ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736850
    m_Localized: Et même si c'était le cas, je n'aurais jamais les moyens de me payer ça.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736851
    m_Localized: Je prends.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736852
    m_Localized: Pile ce que je voulais.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736853
    m_Localized: C'est votre jour de chance.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736854
    m_Localized: Le bureau de réquisition m'a autorisé à vendre un... surplus de marchandises.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736855
    m_Localized: Ça vous intéresserait ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736856
    m_Localized: Inutile de préciser que ça reste entre nous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736857
    m_Localized: Si vous m'achetez le tout, j'ai le droit de vous faire une réduction de 33 %.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736858
    m_Localized: Très bien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736859
    m_Localized: Une... une petite minute !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736860
    m_Localized: Qu'avez-vous fait, agent Lun ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736861
    m_Localized: Cet équipement vient de notre armurerie !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736862
    m_Localized: Attendez... Je vais tout vous expliquer !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736863
    m_Localized: Suivez-nous sans faire d'histoires. Vous savez ce qui arrive aux récalcitrants.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736864
    m_Localized: Bonjour. Inspection surprise.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736865
    m_Localized: Ouvrez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736866
    m_Localized: J'ai trouvé des stupéfiants, que je vous confisque sur-le-champ.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736867
    m_Localized: Et on ne bronche pas ! Vous avez de la chance de ne pas finir au poste.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736868
    m_Localized: '<i>*Soupir*</i> R.A.S.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736869
    m_Localized: Hmm ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736870
    m_Localized: Que faites-vous là, agent Lun ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736871
    m_Localized: Je... euh... mène une inspection surprise.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736872
    m_Localized: Vous travaillez pourtant au poste, aujourd'hui...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736873
    m_Localized: On sait très bien ce que vous mijotez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736874
    m_Localized: Et on vous arrête pour abus de pouvoir !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736875
    m_Localized: C'est donc ça, la fameuse "boutique" ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736876
    m_Localized: Les gens qui n'ont jamais vu de devanture digne de ce nom doivent trouver la vôtre... pittoresque.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736877
    m_Localized: Mais passons. Je voudrais de quoi me sustenter avant de remonter dans les strates supérieures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736878
    m_Localized: Les autorités vont vite revenir sur leur décision.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736879
    m_Localized: Ma mère est emprisonnée pour détournement de fonds. Elle est à la tête de la plus grande ferme hydroponique du coin.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736880
    m_Localized: Tout ceci est ridicule ! Elle nourrit la moitié de la station !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736881
    m_Localized: Alors, qu'avez-vous à me proposer ? J'ai une préférence pour les aliments frais et variés.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736882
    m_Localized: Je suis bel et bien coincée ici...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736883
    m_Localized: Toujours aucune nouvelle de ma mère, et on m'interdit de remonter.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736884
    m_Localized: Je ne mérite pas un tel traitement...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736885
    m_Localized: Les strates inférieures sont répugnantes... C'est trop injuste !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736886
    m_Localized: '<i>*Soupir*</i> À tout hasard, vendriez-vous des produits du quotidien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736887
    m_Localized: Je vais sans doute devoir rester là un moment.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736888
    m_Localized: Je loue une chambre en face de l'intendance.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736889
    m_Localized: Elle est minuscule mais a le mérite de ne pas empester.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736890
    m_Localized: Je ne sais pas du tout comment font les autres pour passer leur vie ici !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736891
    m_Localized: Je suis revenue.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736892
    m_Localized: Mais... je commence à manquer d'argent.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736893
    m_Localized: On ne m'a pas laissée prendre grand-chose avant de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736894
    m_Localized: Si seulement je pouvais remonter...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736895
    m_Localized: J'expliquerais tout aux autorités et je prouverais notre innocence.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736896
    m_Localized: Nous retrouverions notre vie d'avant.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736897
    m_Localized: Et je ne serais plus forcée de manger des nutrifruits à chaque repas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736898
    m_Localized: Bref, voici les produits que j'aimerais vous vendre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736899
    m_Localized: Je n'en peux plus...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736900
    m_Localized: Me voilà fauchée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736901
    m_Localized: La nuit dernière, quelqu'un m'a volé le peu de crédits qu'il me restait.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736902
    m_Localized: Je suis totalement désemparée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736903
    m_Localized: Le procès de ma mère vient de se terminer. Elle a été reconnue coupable.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736904
    m_Localized: Je vais passer le restant de mes jours ici, pendant que ma mère croupit en prison.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736905
    m_Localized: Je me sens honteuse de vous demander ça, mais...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736906
    m_Localized: Accepteriez-vous de me donner à manger ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736907
    m_Localized: Ça peut être tout et n'importe quoi. S'il vous plaît...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736908
    m_Localized: Oh, je vous remercie ! Je n'oublierai pas votre geste.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736909
    m_Localized: Bonjour !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736910
    m_Localized: Notre dernière discussion m'a fait réfléchir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736911
    m_Localized: J'ai décidé d'aller de l'avant.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736912
    m_Localized: En plus, j'ai fini par m'habituer à la puanteur environnante.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736913
    m_Localized: Ma mère est sûrement victime d'un coup monté.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736914
    m_Localized: Je vais reprendre ma vie en main et trouver un moyen de laver l'honneur de ma famille.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736915
    m_Localized: Pour ce faire, j'ai d'abord besoin d'une source de revenus.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736916
    m_Localized: J'ai donc eu envie de me lancer dans le furetage à la décharge.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736917
    m_Localized: Ma colocataire m'a justement fait découvrir le métier !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736918
    m_Localized: Je dois admettre que vous avez le sens de la communauté, ici.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736919
    m_Localized: Jetez donc un œil à mes marchandises !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736920
    m_Localized: Salutations ! Je m'appelle Serpico et je suis cadet au service de sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736921
    m_Localized: C'est mon premier jour.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736922
    m_Localized: J'ai grandi dans les strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736923
    m_Localized: Et j'ai toujours rêvé de protéger la station.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736924
    m_Localized: Certains membres de ma famille pensent que je les ai trahis en devenant agent...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736925
    m_Localized: Je vais tout faire pour changer les choses, de l'intérieur !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736926
    m_Localized: C'est hors sujet, mais est-ce que vous vendez des collations ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736927
    m_Localized: Je veux en offrir à mes collègues pour mieux m'intégrer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736928
    m_Localized: Bon, j'ai besoin d'un verre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736929
    m_Localized: Le service de sécurité n'est pas comme je l'imaginais.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736930
    m_Localized: Je m'attendais à un certain laxisme, mais là ça va trop loin...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736931
    m_Localized: J'ai vu d'autres agents toucher des pots-de-vin des strates supérieures, du cartel et de la Révolution !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736932
    m_Localized: Jusqu'où la corruption s'étend-elle ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736933
    m_Localized: '<i>*Bip bip*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736934
    m_Localized: Je dois y aller, on m'appelle.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736935
    m_Localized: Vous faites à emporter ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736936
    m_Localized: Ah, quelle belle journée !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736937
    m_Localized: J'ai parlé du problème de corruption à mon supérieur.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736938
    m_Localized: Il va ouvrir une enquête interne.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736939
    m_Localized: Ce qui pourrait bien me valoir une promotion !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736940
    m_Localized: Avez-vous de la nourriture à vendre, aujourd'hui ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736941
    m_Localized: Je ne bois rien, cette fois.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736942
    m_Localized: Bonjour, stationaute.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736943
    m_Localized: Auriez-vous croisé un cadet du nom de Serpico ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736944
    m_Localized: Il fait l'objet d'un mandat d'arrêt pour corruption.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736945
    m_Localized: De plus, il a bu de l'alcool pendant le service.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736946
    m_Localized: Prévenez-nous dès que vous le voyez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736947
    m_Localized: Et ne lui parlez en aucun cas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736948
    m_Localized: Il est armé et très dangereux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736949
    m_Localized: Nous offrons une récompense de 300 crédits pour son arrestation.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736950
    m_Localized: C'est moi, Serpico !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736951
    m_Localized: Ils veulent me faire porter le chapeau...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736952
    m_Localized: Je n'y suis pour rien dans cette histoire, il faut me croire !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736953
    m_Localized: Je dois y aller, je suis recherché.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736954
    m_Localized: Je vais me cacher à la décharge quelque temps.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736955
    m_Localized: Non, arrêtez !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736956
    m_Localized: Attention, il sort son arme !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736957
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736958
    m_Localized: Le suspect est à terre !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736959
    m_Localized: On l'emmène.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736960
    m_Localized: Salut ! Ravie de voir que quelqu'un a repris les rênes de la boutique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736961
    m_Localized: Quand elle a fermé, j'ai bien galéré à trouver de quoi grignoter.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736962
    m_Localized: Il paraît que le vendeur précédent s'est fait enlever en pleine nuit, ou un truc du genre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736963
    m_Localized: Oups, j'ai oublié de me présenter ! Je suis chef mécano.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736964
    m_Localized: 'La <b>seule</b> chef mécano de la station, d''ailleurs. '
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736965
    m_Localized: Vous pouvez m'appeler Nellis.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736966
    m_Localized: Et donc c'est moi qui assure la maintenance de cette vieille station.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736967
    m_Localized: Quoi ? Ça vous étonne de voir quelqu'un de la direction ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736968
    m_Localized: On passe pas tous nos journées au centre de contrôle, vous savez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736969
    m_Localized: J'ai rien à voir avec les grands patrons et les conseillers des strates supérieures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736970
    m_Localized: Les gens ignorent que la grande majorité des machines importantes se trouvent en bas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736971
    m_Localized: Bon, vous avez à manger ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736972
    m_Localized: Salut !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736973
    m_Localized: Vous avez de la bière ou des petits casse-croûte en stock ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736974
    m_Localized: Je viens de finir un gros boulot de réparation sur les systèmes de survie auxiliaires.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736975
    m_Localized: Le capitaine va être aux anges.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736976
    m_Localized: Il a pas trop de succès auprès des stationautes d'en bas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736977
    m_Localized: Ils disent qu'il sert uniquement les intérêts des strates supérieures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736978
    m_Localized: Mais il fait ce qu'il peut pour maintenir la station à flot.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736979
    m_Localized: Il est débordé, entre les demandes incessantes de ceux d'en haut, la pression exercée par les entreprises,
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736980
    m_Localized: le manque de soutien de la République, le radicalisme des révolutionnaires...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736981
    m_Localized: C'est un grand incompris, mais presque personne essaie de se mettre à sa place.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736982
    m_Localized: Quoi qu'il en soit, notre qualité de vie a bien augmenté depuis qu'il est aux commandes.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736983
    m_Localized: Et on a pas eu de conflits armés trop graves.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736984
    m_Localized: Salut !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736985
    m_Localized: Je viens de remplacer ces vieux modules cassés.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736986
    m_Localized: Ça vous dirait de me les acheter ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736987
    m_Localized: Salut !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736988
    m_Localized: Je sors d'une réunion avec la direction.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736989
    m_Localized: Les conseillers des strates supérieures me sortent par les trous de nez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736990
    m_Localized: Ils sont complètement déconnectés de la réalité.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736991
    m_Localized: 50 % de leurs propositions sont absurdes.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736992
    m_Localized: Heureusement que les chefs des services sont là pour les recadrer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736993
    m_Localized: Il va me falloir à boire et à manger pour oublier cette réunion.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736994
    m_Localized: Votre prédécesseur a laissé des produits derrière lui.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736995
    m_Localized: Ils m'appartiennent désormais.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736996
    m_Localized: Souhaitez-vous acheter quelque chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736997
    m_Localized: Si vous prenez l'ensemble, je baisserai le prix. Je ne propose pas une telle offre à n'importe qui.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736998
    m_Localized: Ah, une nouvelle boutique !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463736999
    m_Localized: Dans cette station, il y a trop de monde, mais pas assez de bonnes boutiques.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737000
    m_Localized: On m'appelle Papi Cheng. Je tiens moi aussi une échoppe dans ce secteur.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737001
    m_Localized: Je devais recevoir une cargaison de nourriture hier.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737002
    m_Localized: Malheureusement, le livreur est en retard.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737003
    m_Localized: Mes clients ne peuvent pas poireauter. Surtout les orphelins et les vieux de la vieille.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737004
    m_Localized: Je viens donc vous acheter des plats que je pourrais revendre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737005
    m_Localized: Au même prix que d'habitude.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737006
    m_Localized: Ce qui veut dire que je vais perdre de l'argent aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737007
    m_Localized: Si j'augmente mes prix, ma clientèle risque de mourir de faim.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737008
    m_Localized: Qu'avez-vous en stock ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737009
    m_Localized: Bonjour. Papi Cheng m'envoie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737010
    m_Localized: Je cherche des médicaments.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737011
    m_Localized: Ceux de Papi Cheng sont périmés, mais on peut quand même les prendre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737012
    m_Localized: Et ses prix sont toujours raisonnables.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737013
    m_Localized: Ça lui arrive même de faire crédit à ceux qui n'ont pas les moyens.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737014
    m_Localized: Le genre de pratique normalement impensable dans les strates inférieures !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737015
    m_Localized: Le souci, c'est qu'il a plus rien en stock.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737016
    m_Localized: Il m'a dit de venir vous voir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737017
    m_Localized: Bonjour, c'est moi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737018
    m_Localized: Mon purificateur d'eau est tombé en panne la nuit dernière.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737019
    m_Localized: Je l'ai depuis des lustres. C'est un vieux machin têtu comme une mule.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737020
    m_Localized: Un peu comme moi, je suppose.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737021
    m_Localized: Mon fournisseur m'a suggéré d'en acheter un neuf.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737022
    m_Localized: Il m'a aussi dit de confier son entretien à quelqu'un d'autre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737023
    m_Localized: En gros, il veut que je prenne ma retraite.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737024
    m_Localized: C'est vrai que je suis sur les rotules, mais ma clientèle compte sur moi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737025
    m_Localized: Dans tous les cas, je ne peux pas me permettre d'arrêter.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737026
    m_Localized: Vous pourriez me fournir des matériaux pour que je répare cette sale bête de purificateur ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737027
    m_Localized: Bonjour. <i>*Kof kof*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737028
    m_Localized: J'ai des choses à vendre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737029
    m_Localized: Il arrive que les gens m'offrent des cadeaux en guise de remerciement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737030
    m_Localized: Quelqu'un a même jeté des articles de luxe dans ma poubelle !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737031
    m_Localized: J'ai tout accumulé au fil du temps, mais je ne pense pas que ça intéressera mes clients.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737032
    m_Localized: Vous voulez y jeter un œil ? <i>*Kof kof*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737033
    m_Localized: Salut, c'est Sawyer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737034
    m_Localized: Vous connaissiez Papi Cheng, je me trompe ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737035
    m_Localized: Il me donnait à manger quand j'étais qu'un pauvre marmot à la rue.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737036
    m_Localized: Sans lui, je serais mort.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737037
    m_Localized: J'ai entendu dire qu'il ouvrait sa boutique de plus en plus tard
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737038
    m_Localized: et qu'il avait moins de stock qu'avant.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737039
    m_Localized: Je me fais du souci pour lui.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737040
    m_Localized: Gardez-le à l'œil, OK ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737041
    m_Localized: Bonjour. <i>*Kof kof kof*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737042
    m_Localized: J'ai un service à vous demander.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737043
    m_Localized: Voyez-vous, je suis malade.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737044
    m_Localized: Comme je n'ai plus 20 ans, le traitement pourrait me tuer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737045
    m_Localized: J'ai décidé de le refuser.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737046
    m_Localized: Je vais vendre ma boutique et faire don de mes économies aux bonnes œuvres.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737047
    m_Localized: J'aimerais bien trouver un repreneur pour la boutique, mais...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737048
    m_Localized: Un salaire aussi faible que le mien, ça ne fait rêver personne.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737049
    m_Localized: Il me reste des vivres. Pourriez-vous les donner à la banque alimentaire du coin ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737050
    m_Localized: Bien le bonjour.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737051
    m_Localized: J'ai une triste nouvelle à vous annoncer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737052
    m_Localized: J'ai cru comprendre que vous connaissiez Papi Cheng ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737053
    m_Localized: Il est décédé cette nuit, dans son lit.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737054
    m_Localized: C'était un homme remarquable. Un des piliers des strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737055
    m_Localized: Je tenais à vous remettre cet objet, en souvenir de lui.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737056
    m_Localized: Bonjour. Je dirige une petite entreprise de purification d'eau.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737057
    m_Localized: J'ai de l'eau basique en veux-tu en voilà.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737058
    m_Localized: Si vous m'achetez tout mon stock, vous aurez droit à une grosse réduc' !
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737059
    m_Localized: Bonjour ! Je viens vendre de l'eau.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737060
    m_Localized: Écoutez, j'ai de l'eau à vendre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737061
    m_Localized: J'ai vite besoin d'argent. Prenez-moi tout mon stock et je vous fais une ristourne.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737064
    m_Localized: J'ai débusqué cette eau pendant une sortie furetage.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737065
    m_Localized: D'après l'étiquette, ce serait de l'eau spectrale... Ça me dit rien qui vaille.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737066
    m_Localized: Je vends de l'eau.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737067
    m_Localized: Je parie que c'est de la basique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737068
    m_Localized: J'ai du matos que j'utilise plus.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737069
    m_Localized: Ça vous tente ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737070
    m_Localized: Si vous me débarrassez de l'ensemble, je vous fais une réduc' de 33 %.
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737071
    m_Localized: Merde...
    m_Metadata:
      m_Items: []
  - m_Id: 420216463737072
    m_Localized: PLUS UN GESTE ! C'est l'homme qui a attaqué nos agents !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931136
    m_Localized: On l'arrête !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931137
    m_Localized: Je reviens de la zone abandonnée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931138
    m_Localized: J'y ai déniché des trucs chouettes. Visez un peu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931139
    m_Localized: Si vous prenez tout, j'ajoute une jolie réduction de 25 %.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931140
    m_Localized: Je viens vous acheter de la nourriture et des matériaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931141
    m_Localized: Vous en avez ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931142
    m_Localized: Ne sonnez pas l'alarme.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931143
    m_Localized: Je m'appelle Odin Haraldsson.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931144
    m_Localized: Et j'ai une proposition à vous faire.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931145
    m_Localized: Si vous me dénoncez, on ne se reverra plus.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931146
    m_Localized: Avec mon groupe, on a besoin de produits spécifiques.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931147
    m_Localized: Des armes, des munitions, des armures, des poisons, des caisses de ravitaillement et des cartes d'accès.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931148
    m_Localized: La contrebande ne nous pose aucun souci, mais on ne pourra pas vous payer autant que vos autres clients.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931149
    m_Localized: Voici ma carte. Appelez-moi quand vous recevez quelque chose qui pourrait m'intéresser.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931150
    m_Localized: Vous allez le regretter.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931151
    m_Localized: On te tient enfin, Odin Haraldsson... Ta cellule t'attend.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931152
    m_Localized: Bonjour.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931153
    m_Localized: Vous avez quoi de beau à me vendre ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931154
    m_Localized: Je vous rappelle qu'on veut des armes, des munitions, des armures, des caisses de ravitaillement et des cartes d'accès.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931155
    m_Localized: Quoi ?! Vous m'avez trahi !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931156
    m_Localized: Les mains en l'air ! Tu es en état d'arrestation.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931157
    m_Localized: Enchantée, petit nutrifruit !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931158
    m_Localized: Moi, c'est Lou.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931159
    m_Localized: Il me faudrait des objets qui pousseraient l'un de mes "clients" à... "discuter" avec moi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931160
    m_Localized: Pourquoi pas un tuyau, un couteau ou un couperet ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931161
    m_Localized: Il est du genre timide, vous comprenez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931162
    m_Localized: Je veux des joujoux variés !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931163
    m_Localized: Et j'espère que vous avez suffisamment de jugeote pour pas appeler la sécu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931164
    m_Localized: Alors, on part sur quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931165
    m_Localized: On va bien s'amuser, hahaha !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931166
    m_Localized: C-C'est elle !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931167
    m_Localized: '*Essaie de cacher son visage*'
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931168
    m_Localized: STOP ! ON VOUS EMBARQUE !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931169
    m_Localized: Ils me garderont pas longtemps, vous inquiétez pas ! <i>*Clin d'œil*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931170
    m_Localized: À très vite, petit nutrifruit !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931171
    m_Localized: COUCOU !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931172
    m_Localized: Vous avez eu peur, petit nutrifruit ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931173
    m_Localized: J'espère que je vous ai manqué !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931174
    m_Localized: C'était pas très mimi de votre part de me dénoncer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931175
    m_Localized: Vous auriez au moins pu me payer un coup avant !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931176
    m_Localized: En temps normal, je vous aurais fait la peau.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931177
    m_Localized: Mais soit vous avez rien dans le ciboulot, soit vous avez un sacré cran.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931178
    m_Localized: Ça me donne envie de faire joujou avec vous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931179
    m_Localized: Si vous refusez, je vous laisse deviner la suite.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931180
    m_Localized: La sécu viendra plus nous chercher des noises.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931181
    m_Localized: Je suis allée rendre visite au chef du service hier soir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931182
    m_Localized: On se recontacte bientôt. Bye bye !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931183
    m_Localized: Bonjour, ici Li Bei Wen.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931184
    m_Localized: Ne me dénoncez pas ! Je suis innocent.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931185
    m_Localized: J'ai presque fini de mettre au point un nouvel antidouleur.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931186
    m_Localized: C'est une version de l'Oxymore garantie sans accoutumance.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931187
    m_Localized: J'imagine que Big Pharma ne veut pas voir mon produit sur le marché.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931188
    m_Localized: Et maintenant, le service de sécurité me fait passer pour un dangereux fabricant de drogues à la solde du cartel.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931189
    m_Localized: J'ai besoin d'argent pour terminer mes recherches.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931190
    m_Localized: Je vends des échantillons, regardez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931191
    m_Localized: Nooon, mes recherches !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931192
    m_Localized: Suis-nous, sale rat du cartel !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931193
    m_Localized: J'ai de la nourriture en trop. J'aimerais la vendre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931194
    m_Localized: Je peux m'en procurer davantage, si vous voulez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931195
    m_Localized: Bonjour. Si vous pouviez ne pas me dénoncer, ça m'arrangerait.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931196
    m_Localized: J'ai un nom beaucoup trop courant.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931197
    m_Localized: À cause de ça, le service de sécurité m'a confondu avec un autre...
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931198
    m_Localized: Résultat, c'est ma tête qui apparaît sur les avis, pas celle du vrai cambrioleur !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931199
    m_Localized: Je suis un type lambda qui sort simplement faire ses courses.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931200
    m_Localized: On m'a déjà arrêté à quatre reprises ce mois-ci !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931201
    m_Localized: Noooooon ! Pourquoi vous avez fait ça ?!
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931202
    m_Localized: On vous arrête, espèce de pourriture !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931203
    m_Localized: Mince...
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931204
    m_Localized: L'usurpation d'identité est un crime très grave ! Encore plus s'il s'agit d'un agent de sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931205
    m_Localized: Vous allez nous dire où vous avez trouvé cet uniforme !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931206
    m_Localized: Je reviens de ma sortie furetage du jour.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931207
    m_Localized: Le boulot de [g:fureteur|fureteuse], c'est vraiment pas de la tarte.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931208
    m_Localized: J'arrive à peine à joindre les deux bouts, et je vis dans les ruines...
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931209
    m_Localized: C'est qu'elle est dangereuse, cette station !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931210
    m_Localized: Je tiens à rester en vie, vous savez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931211
    m_Localized: Il me faut une sorte de protection.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931212
    m_Localized: Je cherche du matos robuste.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931213
    m_Localized: Mes produits, je les préfère abordables ET efficaces.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931214
    m_Localized: Je voudrais une arme qui tient la route.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931215
    m_Localized: J'ai {0:plural:{} crédit|{} crédits}. Vous pensez que ça suffira ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931216
    m_Localized: J'ai seulement {0:plural:{} crédit|{} crédits} sur moi. Qu'est-ce que je peux vous acheter avec ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931217
    m_Localized: J'ai un tout petit budget... {0:plural:{} crédit|{} crédits}, pour être [g:exact|exacte].
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931218
    m_Localized: Ça ne m'aidera pas à survivre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931219
    m_Localized: J'en ferai bon usage, merci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931220
    m_Localized: La station est de plus en plus mal famée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931221
    m_Localized: J'aimerais pouvoir me protéger...
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931222
    m_Localized: La criminalité est en hausse, et je ne veux plus risquer ma vie à chaque sortie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931223
    m_Localized: Vous avez quoi comme équipement d'autodéfense pas trop cher ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931224
    m_Localized: Je voudrais acheter une arme et une armure toutes simples.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931225
    m_Localized: Montrez-moi votre protection la moins chère.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931226
    m_Localized: Je ne dépenserai pas plus de {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931227
    m_Localized: Qu'est-ce que vous pouvez me proposer à {0:plural:{} crédit|{} crédits} max ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931228
    m_Localized: '{0:plural:{} crédit|{} crédits}... c''est tout ce que j''ai.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931229
    m_Localized: Je ne vois pas comment je pourrais me défendre avec ça.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931230
    m_Localized: Parfait ! Je vais me sentir un peu plus en sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931231
    m_Localized: Mon équipe a besoin d'un équipement adéquat pour une mission périlleuse.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931232
    m_Localized: Mes collègues et moi, on lésine pas sur la sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931233
    m_Localized: Je cherche à renforcer l'arsenal de mon équipe.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931234
    m_Localized: Vendez-moi la crème de la crème sinon rien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931235
    m_Localized: Il nous faut des armes aussi fiables que puissantes.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931236
    m_Localized: Proposez-moi votre meilleur équipement. Je veux pas de daube.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931237
    m_Localized: On a {0:plural:{} crédit|{} crédits} à dépenser.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931238
    m_Localized: On a un budget de {0:plural:{} crédit|{} crédits}. Montrez-moi la marchandise.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931239
    m_Localized: Notre limite est fixée à {0:plural:{} crédit|{} crédits}. Voyons voir votre inventaire.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931240
    m_Localized: Mon équipe mérite mieux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931241
    m_Localized: Impressionnant. Mon équipe sera satisfaite.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931242
    m_Localized: J'ai besoin de prendre un truc, purée ! Je tiens plus, là !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931243
    m_Localized: Il me faut ma dose ! Je prendrai ce que vous me donnerez !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931244
    m_Localized: Vous auriez pas quelque chose qui détend ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931245
    m_Localized: Des cachetons, des clopes, de l'alcool... peu importe.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931246
    m_Localized: Je suis prêt[g:|e] à tout pour décompresser.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931247
    m_Localized: Sérieux, je suis au bord du gouffre... Aidez-moi !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931248
    m_Localized: J'ai quoi... {0:plural:{} crédit|{} crédits}. Ça devrait suffire, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931249
    m_Localized: Je peux m'acheter quoi avec {0:plural:{} crédit|{} crédits} ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931250
    m_Localized: J'ai pas plus de {0:plural:{} crédit|{} crédits}. Ça ira, j'espère...
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931251
    m_Localized: Vous avez rien capté. Je veux me DÉ-TEN-DRE !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931252
    m_Localized: Tip top, je prends !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931253
    m_Localized: Je viens de rentrer d'un vol long-courrier.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931254
    m_Localized: Enfin de retour après des semaines de vide intersidéral !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931255
    m_Localized: J'ai passé trop de temps dans l'espace.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931256
    m_Localized: Qu'est-ce qui pourrait m'aider à relâcher la pression ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931257
    m_Localized: J'ai besoin de libérer toutes ces tensions accumulées dans mon corps.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931258
    m_Localized: Trop envie de me relaxer, là.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931259
    m_Localized: J'ai {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931260
    m_Localized: J'ai {0:plural:{} crédit|{} crédits}, ni plus ni moins.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931261
    m_Localized: Vous proposez quoi à moins de {0:plural:{} crédit|{} crédits} ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931262
    m_Localized: C'est des relaxants que je veux !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931263
    m_Localized: Je vais bien planer avec ça. Merci !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931264
    m_Localized: À boire, s'il vous plaît ! Vous auriez pas de l'eau basique ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931265
    m_Localized: De l'eau spectrale, ça marche aussi !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931266
    m_Localized: J'ai {0:plural:{} crédit|{} crédits} dans mon porte-monnaie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931267
    m_Localized: Allez, je vais pas repartir sans avoir bu une seule goutte...
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931268
    m_Localized: De l'eau basique, j'ai dit ! Ou spectrale.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931269
    m_Localized: Impec.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931270
    m_Localized: Je suis complètement déshydraté[g:|e]. Vous vendez de l'eau basique ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931271
    m_Localized: Raffinée, ce serait encore mieux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931272
    m_Localized: J'ai {0:plural:{} crédit|{} crédits} sur moi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931273
    m_Localized: Non, je veux de l'eau basique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931274
    m_Localized: Parfait.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931275
    m_Localized: Je m'approvisionne en eau, en ce moment.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931276
    m_Localized: Si je vous donne {0:plural:{} crédit|{} crédits}, vous m'aidez ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931277
    m_Localized: De l'eau basique ou mieux, s'il vous plaît.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931278
    m_Localized: Ça m'a l'air bon.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931279
    m_Localized: Hé, vous ! J'aimerais vous acheter de l'eau.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931280
    m_Localized: Basique ou raffinée, si vous en avez en stock !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931281
    m_Localized: Contre {0:plural:{} crédit|{} crédits}, d'accord ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931282
    m_Localized: Je répète que je voudrais de l'eau basique ou raffinée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931283
    m_Localized: Voilà.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931284
    m_Localized: Bonjour. Je constitue une réserve d'eau pour mon client des strates supérieures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931285
    m_Localized: Je viens donc vous acheter de l'eau raffinée ou pure.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931286
    m_Localized: Et n'essayez pas de me berner ! J'ai des bandelettes de test hydrique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931287
    m_Localized: Vous aurez droit à {0:plural:{} crédit|{} crédits} contre votre eau.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931288
    m_Localized: Je ne veux rien d'autre que de l'eau pure ou raffinée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931289
    m_Localized: Ça me semble convenir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931290
    m_Localized: Je suis venu[g:|e] vous acheter de quoi manger.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931291
    m_Localized: Et j'ai très exactement {0:plural:{} crédit|{} crédits} à dépenser.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931292
    m_Localized: Je crève de faim... Vous vendez des produits bon marché ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931293
    m_Localized: J'ai plus que {0:plural:{} crédit|{} crédits}...
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931294
    m_Localized: Je cherche des ingrédients pour mon échoppe.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931295
    m_Localized: Il me faut avant tout de la variété.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931296
    m_Localized: Mon budget s'élève à {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931297
    m_Localized: Salutations ! Je viens m'approvisionner en nourriture pour notre prochaine expédition.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931298
    m_Localized: Je n'irai pas au-delà de {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931299
    m_Localized: Bonjour. En qualité de chef à domicile dans les strates supérieures...
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931300
    m_Localized: Je suis en quête d'ingrédients exotiques et de produits uniques.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931301
    m_Localized: J'ai ouï-dire que vous en proposiez à la vente.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931302
    m_Localized: Bonjour, euh... Je me sens pas top.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931303
    m_Localized: Vous vendez des médicaments, rassurez-moi ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931304
    m_Localized: J'ai un enfant malade à la maison. Auriez-vous de quoi le soigner ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931305
    m_Localized: Je n'ai que {0:plural:{} crédit|{} crédits}...
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931306
    m_Localized: 'Bonjour. J''ai une clinique dans les strates inférieures. '
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931307
    m_Localized: Possédez-vous des médicaments que je pourrais administrer à mes patients ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931308
    m_Localized: J'aimerais des articles médicaux variés.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931309
    m_Localized: Je suis prêt[g:|e] à payer {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931310
    m_Localized: Et pour info, j'ai un scanner chimique sur moi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931311
    m_Localized: Faites-moi voir votre inventaire.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931312
    m_Localized: Bonjour ! Notre clinique m'envoie chercher des articles médicaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931313
    m_Localized: J'ai entendu dire que votre boutique était bien fournie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931314
    m_Localized: Et j'ai pris mon scanner chimique, alors pas de coups fourrés !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931315
    m_Localized: Sur ce, montrez-moi votre inventaire.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931316
    m_Localized: Bonjour. Je travaille à l'hôpital supérieur en tant que [g:fournisseur|fournisseuse].
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931317
    m_Localized: Votre stock d'articles médicaux fait beaucoup parler de lui.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931318
    m_Localized: Je suis venu[g:|e] le voir de mes propres yeux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931319
    m_Localized: Pour votre gouverne, j'ai un scanner chimique. Ne tentez même pas de m'entourlouper.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931320
    m_Localized: Bonjour, ce serait pour acheter des matériaux, des batteries et des outils.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931321
    m_Localized: J'ai prévu un budget de {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931322
    m_Localized: Mon truc, c'est la ferraille pas chère.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931323
    m_Localized: Les matériaux, les batteries ou les outils industriels.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931324
    m_Localized: Ça vous parle ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931325
    m_Localized: J'ai mis {0:plural:{} crédit|{} crédits} de côté exprès.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931326
    m_Localized: Je m'occupe des réparations dans la station.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931327
    m_Localized: Vous avez des matériaux, des batteries ou des outils qui pourraient me servir ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931328
    m_Localized: Et comme je répare toutes sortes de choses, j'ai besoin d'articles variés.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931329
    m_Localized: '{0:plural:{} crédit|{} crédits}, ça vous irait ?'
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931330
    m_Localized: Bonjour bonjour ! Je suis inventrice !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931331
    m_Localized: Je viens acheter des matériaux, des batteries, des outils et des modules.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931332
    m_Localized: Bonjour. J'aimerais voir vos matériaux, vos batteries et vos modules, s'il vous plaît.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931333
    m_Localized: On m'a dit que vous aviez de bons produits.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931334
    m_Localized: J'ai déjà oublié ce que j'étais venu[g:|e] chercher, moi... Des produits du quotidien ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931335
    m_Localized: Mais attention, je ne dépenserai pas plus de {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931336
    m_Localized: Je viens d'emménager dans le secteur. Vous vendez des produits du quotidien pour pas cher ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931337
    m_Localized: Tant que ça dépasse pas une limite de {0:plural:{} crédit|{} crédits}, c'est OK.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931338
    m_Localized: Bonjour. Je viens vous acheter des produits de base pour ma famille.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931339
    m_Localized: J'aimerais une sélection d'articles variés.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931340
    m_Localized: J'ai {0:plural:{} crédit|{} crédits} à dépenser en tout.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931341
    m_Localized: Je voudrais des produits du quotidien, s'il vous plaît.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931342
    m_Localized: Salutations. Mon employeuse m'envoie acheter des produits du quotidien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931343
    m_Localized: Présentez-moi vos meilleurs articles.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931344
    m_Localized: J'ai trop de nourriture. Vous m'achetez quelques trucs ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931345
    m_Localized: J'ai plus de médocs qu'il en faut. Ça vous intéresse de me décharger un peu ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931346
    m_Localized: J'ai des articles médicaux en trop si ça vous tente de faire affaire.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931347
    m_Localized: Vous voulez me délester de mon surplus ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931348
    m_Localized: Je sais pas quoi faire de tous ces articles... Vous me les achetez ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931349
    m_Localized: Mon inventaire va exploser. Faites votre choix, allez !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931350
    m_Localized: Je veux me libérer de ces armes et armures en trop. Un petit coup de main ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931351
    m_Localized: J'ai acheté trop de matériaux. Vous les voulez contre quelques crédits ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931352
    m_Localized: Ça vous intéresserait d'acheter mon surplus de matériaux ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931353
    m_Localized: Bonjour, votre livraison du Diable carmin est arrivée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931354
    m_Localized: Super, au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931355
    m_Localized: Bonjour. Je travaille pour la coopérative minière GP.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931356
    m_Localized: Voici vos marchandises.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931357
    m_Localized: Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931358
    m_Localized: Bonjour, une livraison pour vous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931359
    m_Localized: Je peux aussi vous acheter du matériel chimique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931360
    m_Localized: À la revoyure.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931361
    m_Localized: Bonjour. C'est notre ami commun qui m'envoie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931362
    m_Localized: Merci, au revoir !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931363
    m_Localized: Bonjour. J'ai des marchandises à vous proposer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931364
    m_Localized: Visez un peu ça.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931365
    m_Localized: Bonjour ! Je suis là pour vous apprendre à recycler des machines cassées.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931366
    m_Localized: Voici des outils pour vous lancer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931367
    m_Localized: Je vais prévenir mes potes ferrailleurs !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931368
    m_Localized: Ils viendront vous apporter des appareils à démanteler.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931369
    m_Localized: On trouve parfois des modules fonctionnels dedans.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931370
    m_Localized: Mais si les ferrailleurs les ont laissés à l'intérieur, ça veut dire qu'ils sont plus ou moins coincés.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931371
    m_Localized: Vous devrez les déloger avec un extracteur de modules.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931372
    m_Localized: Il vous faudra aussi un tournevis ou un coupe-fil.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931373
    m_Localized: Ça vous permettra de retirer les autres matériaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931374
    m_Localized: Vous en ferez de la ferraille à l'aide de cette torche.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931375
    m_Localized: C'est tout pour le moment. Bon courage !
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931376
    m_Localized: Je repasserai la semaine prochaine pour le premier versement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931377
    m_Localized: J'espère pour vous que vous aurez mon argent d'ici là.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931378
    m_Localized: Et vous avisez pas de me dénoncer au service de sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 420216467931379
    m_Localized: Si vous me la faites à l'envers, je révèle votre passé.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125440
    m_Localized: Bonne chance, <i>hahaha</i> !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125441
    m_Localized: Vous allez le regretter, croyez-moi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125442
    m_Localized: Suivez-nous sans broncher !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125443
    m_Localized: Où est mon fric ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125444
    m_Localized: Je balance tout si vous raquez pas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125445
    m_Localized: Bravo. Allez, à la semaine prochaine.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125446
    m_Localized: Salut.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125447
    m_Localized: Vous allez vous en mordre les doigts.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125448
    m_Localized: '[Payer [g:le maître-chanteur|la maître-chanteuse]]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125449
    m_Localized: '[Refuser de payer]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125450
    m_Localized: Bonjour. J'étais là hier.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125451
    m_Localized: Merci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125452
    m_Localized: Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125453
    m_Localized: Vous perdez rien pour attendre...
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125454
    m_Localized: '[Accepter (-{0:plural:{} crédit|{} crédits})]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125455
    m_Localized: '[Refuser ({0} de réputation)]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125456
    m_Localized: J'exige un remboursement ET une compensation !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125457
    m_Localized: Remboursez-moi !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125458
    m_Localized: Votre produit a fait des merveilles. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125459
    m_Localized: Je sais pas ce que contenait votre produit, mais j'ai adoré. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125460
    m_Localized: Votre produit était bien chargé. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125461
    m_Localized: J'étais sur un petit nuage après avoir pris votre produit. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125462
    m_Localized: J'ai des choses à dire sur votre produit... ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125463
    m_Localized: Votre produit m'a changé[g:|e]... mais en bien ! ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125464
    m_Localized: L'article que vous m'avez vendu a fait effet. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125465
    m_Localized: Votre produit a fait des merveilles. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125466
    m_Localized: Le produit de l'autre fois était particulièrement bien dosé. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125467
    m_Localized: L'article que vous m'avez vendu, il envoie. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125468
    m_Localized: J'arrête pas de penser à votre produit. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125469
    m_Localized: Trop bon, ce produit. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125470
    m_Localized: Je me vois plus vivre sans votre marchandise. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125471
    m_Localized: Votre marchandise est plus forte que ce que je pensais... ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125472
    m_Localized: Votre produit m'a fait un bien fou. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125473
    m_Localized: Grâce à votre marchandise, j'ai pu me vider la tête. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125474
    m_Localized: Depuis que j'ai goûté à votre produit, le reste a plus aucune saveur. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125475
    m_Localized: Je serais prêt[g:|e] à traverser la station rien que pour votre produit. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125476
    m_Localized: Votre produit m'a permis de m'évader. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125477
    m_Localized: Vous en avez encore ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125478
    m_Localized: Je vous paierai un bon prix pour une nouvelle dose.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125479
    m_Localized: Il vous en reste, dites ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125480
    m_Localized: Si vous avez d'autres exemplaires en stock, je vous les prends.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125481
    m_Localized: J'espère que vous avez pas tout vendu...
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125482
    m_Localized: Vous êtes pas en rupture, hein ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125483
    m_Localized: Soyez sympa et vendez-moi une autre dose !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125484
    m_Localized: Il m'a fait oublier mes problèmes pour un temps.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125485
    m_Localized: Son effet était subtil, mais pas désagréable.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125486
    m_Localized: Grâce à lui, j'ai pu déstresser un peu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125487
    m_Localized: Je me suis [g:senti plus léger|sentie plus légère] après l'avoir pris.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125488
    m_Localized: Il m'a aidé à tenir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125489
    m_Localized: Il était super fort. J'ai ressenti les effets d'un coup.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125490
    m_Localized: J'avais pas ressenti un truc aussi intense depuis longtemps.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125491
    m_Localized: Il m'a fait planer pendant des heures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125492
    m_Localized: Sans exagérer, il m'a offert la plus grosse défonce de toute ma vie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125493
    m_Localized: J'avais jamais vécu un truc pareil. C'était surpuissant.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125494
    m_Localized: J'ai eu l'impression de sortir de mon corps, tellement c'était intense !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125495
    m_Localized: J'ai du mal à décrire ce qui s'est passé.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125496
    m_Localized: C'était chouette.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125497
    m_Localized: Bonjour. Je suis prêt[g:|e] pour ma prochaine expédition.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125498
    m_Localized: Vous avez du travail pour moi ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125499
    m_Localized: Je reviens de l'expédition.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125500
    m_Localized: Voilà ce que j'ai déniché.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125501
    m_Localized: Il va me falloir quelques jours pour m'en remettre...
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125502
    m_Localized: Salut. Vous auriez pas des injecteurs d'Oxymore ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125503
    m_Localized: On a qu'à faire un troc.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125504
    m_Localized: Je veux vous troquer ces trucs-là, ça, contre de l'Oxymore.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125505
    m_Localized: Vous en avez, oui ou non ?!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125506
    m_Localized: Ah, enfin !!!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125507
    m_Localized: '<i>*Prend l''Oxymore et part en courant*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125508
    m_Localized: Yo, je cherche un truc qui défonce.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125509
    m_Localized: Vous savez, de l'Oxymore, de la poussière onirique...
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125510
    m_Localized: Me vendez juste pas de daube ni de poudre d'amidon.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125511
    m_Localized: On peut faire un troc.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125512
    m_Localized: Je veux vous troquer mes produits contre des substances.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125513
    m_Localized: Dites-moi que vous en avez !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125514
    m_Localized: Délivrance !!!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125515
    m_Localized: '<i>*Détale comme un lapin*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125516
    m_Localized: '<i>*S''approche de la boutique, la mine chiffonnée*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125517
    m_Localized: Bonjour. Vous avez de la nourriture ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125518
    m_Localized: J'ai de quoi faire du troc.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125519
    m_Localized: Tout ce que je veux, c'est manger un bout.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125520
    m_Localized: Non non. Je voulais à manger.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125521
    m_Localized: Merci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125522
    m_Localized: Au revoir !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125523
    m_Localized: '<i>*S''approche de la boutique, l''air épuisé*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125524
    m_Localized: Salut. Vous auriez pas des injecteurs d'Oxymore ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125525
    m_Localized: On peut faire un troc, si vous voulez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125526
    m_Localized: Ah, enfin !!!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125527
    m_Localized: '<i>*Prend l''Oxymore et part en courant*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125528
    m_Localized: C'est du lourd ça, haha !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125529
    m_Localized: Non, j'ai demandé de l'Oxymore !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125530
    m_Localized: Vous vendriez pas de l'alcool de contrebande, par hasard ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125531
    m_Localized: Je peux vous en acheter contre les objets que j'ai dénichés.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125532
    m_Localized: Troquez votre alcool de contrebande contre mes trouvailles !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125533
    m_Localized: Marché conclu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125534
    m_Localized: Merci bien. Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125535
    m_Localized: C'est exactement ce que je cherchais.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125536
    m_Localized: Non non. Donnez-moi de l'alcool de contrebande.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125537
    m_Localized: Bonjour ! De la nourriture contre des médicaments, ça vous paraît équitable ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125538
    m_Localized: Merci à vous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125539
    m_Localized: À la prochaine.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125540
    m_Localized: Ça a l'air délicieux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125541
    m_Localized: Non, je veux à manger.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125542
    m_Localized: Bonjour. Qu'est-ce qui se mange, dans votre boutique ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125543
    m_Localized: On a qu'à faire du troc !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125544
    m_Localized: Un seul article suffit.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125545
    m_Localized: De la nourriture, s'il vous plaît.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125546
    m_Localized: Impeccable, merci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125547
    m_Localized: Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125548
    m_Localized: On dirait que tout est prêt.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125549
    m_Localized: Le dépotoir qui vous sert de boutique sera la cachette parfaite de nos opérations.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125550
    m_Localized: Ah, et vous avez plus à craindre les vols.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125551
    m_Localized: Tant que vous serez sous notre protection, personne s'approchera de la boutique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125552
    m_Localized: Je viendrai chercher {0:plural:{} flacon|{} flacons} de poussière onirique la semaine prochaine.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125553
    m_Localized: J'attends une pureté de {0} %.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125554
    m_Localized: Et avec ce matériel, vous aurez aucun mal à vous lancer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125555
    m_Localized: Si vous atteignez pas le quota...
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125556
    m_Localized: vous finirez comme votre prédécesseur.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125557
    m_Localized: Vous avisez surtout pas de fuir ou de nous balancer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125558
    m_Localized: On le saura tout de suite.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125559
    m_Localized: Vous appartenez maintenant au cartel du secteur 13.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125560
    m_Localized: Bonjour, stationaute.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125561
    m_Localized: Avez-vous été témoin d'activités suspectes ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125562
    m_Localized: '[Dénoncer le cartel]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125563
    m_Localized: '[Garder le silence]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125564
    m_Localized: Intéressant.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125565
    m_Localized: Très bien, passez une bonne journée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125566
    m_Localized: Hmmm, hmmm.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125567
    m_Localized: C'est très décevant.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125568
    m_Localized: Je pensais avoir été clair[g:|e].
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125569
    m_Localized: Ouvrez grand vos oreilles.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125570
    m_Localized: Le cartel a besoin de vos talents...
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125571
    m_Localized: mais vous êtes pas irremplaçable.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125572
    m_Localized: Si vous nous refaites ce coup-là,
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125573
    m_Localized: on vous donnera pas de troisième chance.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125574
    m_Localized: Et oubliez pas votre quota, surtout.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125575
    m_Localized: La préparation avance ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125576
    m_Localized: Je vous rappelle que vous devez nous fournir au moins {0:plural:{} flacon|{} flacons} de poussière onirique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125577
    m_Localized: Pure à {0} % ou plus, la poussière.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125578
    m_Localized: Vous avez jusqu'à lundi prochain.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125579
    m_Localized: '[Demander des matériaux supplémentaires ({0} de réputation)]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125580
    m_Localized: '[Tout se passe bien.]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125581
    m_Localized: Vous êtes à court ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125582
    m_Localized: Pas de souci. Prenez ça.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125583
    m_Localized: Vous avez fait quoi de ceux de la dernière fois ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125584
    m_Localized: Ça aurait dû suffire.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125585
    m_Localized: Mais c'est bon, tenez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125586
    m_Localized: En voilà une bonne nouvelle.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125587
    m_Localized: Je viens chercher {0:plural:{} flacon|{} flacons} de poussière onirique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125588
    m_Localized: La poussière doit avoir un taux de pureté de {0} %.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125589
    m_Localized: Placez le tout sur le comptoir, je vais regarder ça.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125590
    m_Localized: '[Continuer]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125591
    m_Localized: Où est la poussière onirique ?!
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125592
    m_Localized: On vous a donné tout le nécessaire !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125593
    m_Localized: Vous l'aurez voulu... Venez avec moi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125594
    m_Localized: Le compte n'y est pas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125595
    m_Localized: J'attendais {0:plural:{} flacon|{} flacons}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125596
    m_Localized: Reprenez-vous, bon sang !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125597
    m_Localized: Le compte est bon.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125598
    m_Localized: Excellent.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125599
    m_Localized: Passons à la pureté.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125600
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125601
    m_Localized: Je rêve ou vous essayez de nous entuber ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125602
    m_Localized: Ce taux est beaucoup plus faible que celui qui était attendu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125603
    m_Localized: '<i>*Dégaine son arme*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125604
    m_Localized: Elle n'est pas très élevée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125605
    m_Localized: Mais je l'accepte...
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125606
    m_Localized: Elle est adéquate.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125607
    m_Localized: Vous avez dépassé votre objectif.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125608
    m_Localized: Chapeau.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125609
    m_Localized: La semaine prochaine...
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125610
    m_Localized: ce sera {0:plural:{} flacon|{} flacons}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125611
    m_Localized: Et la poussière devra être pure à {0} %.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125612
    m_Localized: Voilà votre salaire de la semaine et des matériaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125613
    m_Localized: Ne perdez pas de vue votre quota.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125614
    m_Localized: Bon, vous avez bien bossé.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125615
    m_Localized: Donnez-moi le temps de vérifier les registres, et j'organiserai votre sortie du cartel.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125616
    m_Localized: En attendant, vous relâchez pas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125617
    m_Localized: J'aimerais revenir sur le sujet de votre sortie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125618
    m_Localized: 'Il y a eu une erreur dans le calcul de votre dette. Vous avez encore des intérêts à payer. '
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125619
    m_Localized: Vous allez continuer à charbonner.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125620
    m_Localized: Bon, vous avez bien bossé.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125621
    m_Localized: Mais on vient de mettre de nouvelles règles en place. Notre collaboration est pas encore finie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125622
    m_Localized: Ça tombe mal, je sais.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125623
    m_Localized: Bon, vous avez bien bossé.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125624
    m_Localized: Mais notre matos a disparu. On va prendre le temps de constater l'étendue des dégâts.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125625
    m_Localized: On relâchera personne avant d'avoir réglé le problème.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125626
    m_Localized: Bon, vous avez bien bossé.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125627
    m_Localized: En plus, la demande en poussière onirique a chuté.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125628
    m_Localized: Vous allez pouvoir quitter le cartel en bonne et due forme.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125629
    m_Localized: C'est dommage de perdre quelqu'un comme vous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125630
    m_Localized: Bref, pas un mot de tout ça à qui que ce soit.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125631
    m_Localized: Il vaut mieux pour vous qu'on se recroise jamais.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125632
    m_Localized: Salut... Vous bossez pour nous, nan ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125633
    m_Localized: On vient de me tirer dessus et ça fait un mal de chien !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125634
    m_Localized: Vous avez des médocs ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125635
    m_Localized: Si vous me filez un coup de main, je parlerai de vous à mes supérieurs !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125636
    m_Localized: Il paraît que vous savez y faire en... <i>fabrication</i>.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125637
    m_Localized: Je propose toutes sortes de produits.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125638
    m_Localized: Vous allez l'air de vous y connaître en chimie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125639
    m_Localized: Et moi, j'en ai marre de passer par un intermédiaire à chaque fois.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125640
    m_Localized: En plus, je risque gros quand que je revends mes produits.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125641
    m_Localized: Vous voudriez pas me filer votre stock directement ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125642
    m_Localized: Avec une petite ristourne de 15 %.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125643
    m_Localized: Allez, personne le saura.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125644
    m_Localized: J'ai pris mon scanner chimique. En gros, j'accepte toutes les substances qui défoncent.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125645
    m_Localized: Me revoici.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125646
    m_Localized: Vous avez d'autres produits pour moi ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125647
    m_Localized: Si je veux être rentable, vous devez me les vendre à -15 %.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125648
    m_Localized: J'ai pris mon scanner chimique. En gros, j'accepte toutes les substances qui défoncent.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125651
    m_Localized: Je viens d'extraire de la glace, et j'ai de l'eau à vendre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125652
    m_Localized: J'ai trouvé cette eau potable dans la glace.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125653
    m_Localized: J'aimerais vous vendre cette eau purifiée que j'ai extraite moi-même.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125654
    m_Localized: Laissez-moi vous dire que l'eau que je trouve dans les astéroïdes de glace est de super qualité !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125655
    m_Localized: Elle est fraîche mon eau d'astéroïde de glace, elle est fraîche !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125656
    m_Localized: Si vous m'achetez tout mon stock, je vous fais un prix.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125657
    m_Localized: Achetez-moi tout, que je vous fasse une ristourne.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125658
    m_Localized: Je baisse le prix total si vous prenez le lot.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125659
    m_Localized: Achetez l'ensemble et vous aurez droit à une réduc'.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125660
    m_Localized: Le prix sera plus intéressant si je vous vends le tout.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125661
    m_Localized: Bonjour. J'ai besoin de matériaux pour un projet de construction.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125662
    m_Localized: Je viens faire le plein de matériaux en prévision d'un gros chantier.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125663
    m_Localized: Je cherche des matériaux pour le chantier que je supervise.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125664
    m_Localized: Je viens acheter des matériaux pour mes ouvriers.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125665
    m_Localized: Mon dernier projet de construction nécessite une grande quantité de matériaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125666
    m_Localized: Si vous en avez en stock, on peut faire affaire.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125667
    m_Localized: Montrez-moi ce que vous avez et on s'arrangera.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125668
    m_Localized: Selon ce que vous avez dans votre inventaire, on pourra peut-être conclure un marché.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125669
    m_Localized: Faites voir la marchandise et on pourra se mettre d'accord sur un prix honnête.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125670
    m_Localized: J'ai trouvé des trucs chouettes, aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125671
    m_Localized: Je suis tombé[g:|e] sur tout un tas de produits du quotidien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125672
    m_Localized: Pendant ma dernière virée furetage, j'ai trouvé des objets parfaits pour votre boutique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125673
    m_Localized: J'ai mis la main sur des produits du quotidien. Ils viennent des strates inférieures, je précise.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125674
    m_Localized: J'ai trouvé ces machins en fouinant. Ils devraient vous être utiles.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125675
    m_Localized: Prenez-moi le lot pour profiter d'une jolie réduction !
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125676
    m_Localized: Vous ferez une sacrée bonne affaire si vous achetez tout.
    m_Metadata:
      m_Items: []
  - m_Id: 420216472125677
    m_Localized: Quand on me prend tous mes articles, j'ai tendance à baisser le prix final.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319744
    m_Localized: Ça vaut grave le coup de tout acheter, c'est moi qui vous le dis !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319745
    m_Localized: Si vous me délestez de tout ça, je vous accorde une remise.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319746
    m_Localized: J'ai soif... vite...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319747
    m_Localized: Vous avez à boire ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319748
    m_Localized: Il me faut de l'eau de toute urgence.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319749
    m_Localized: Je me dessèche à vue d'œil...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319750
    m_Localized: À boire, s'il vous plaît !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319751
    m_Localized: Je ne peux pas dépenser des mille et des cents, mais bon...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319752
    m_Localized: Je ne roule pas sur les crédits, mais je vous achèterai ce que je peux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319753
    m_Localized: Je suis presque fauché[g:|e]... Je ne vous prendrai pas grand-chose.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319754
    m_Localized: Je ne peux pas acheter beaucoup d'articles avec mon budget, mais c'est mieux que rien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319755
    m_Localized: J'ai un budget riquiqui, par contre. Je prendrai ce que vous voudrez bien me vendre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319756
    m_Localized: Je suis en quête d'eau basique ! Ou spectrale, au choix.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319757
    m_Localized: Ça m'a l'air prometteur.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319758
    m_Localized: Une bouteille d'eau, et vite.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319759
    m_Localized: Je dois avoir assez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319760
    m_Localized: Ça suffira pour au moins une bouteille, pas vrai ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319761
    m_Localized: Ça a l'air désaltérant.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319762
    m_Localized: Vous avez de l'eau ? J'ai la gorge sèche de chez sèche...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319763
    m_Localized: De l'eau basique ou raffinée, s'il vous plaît.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319764
    m_Localized: Pile ce qu'il me fallait.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319765
    m_Localized: Bonjour. Ce serait pour acheter à manger.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319766
    m_Localized: Bonjour ! Je viens faire mes courses alimentaires de la semaine.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319767
    m_Localized: Je fais mes provisions.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319768
    m_Localized: Bonjour. Comme je suis en manque de vivres, je viens vous voir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319769
    m_Localized: J'aimerais à manger.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319770
    m_Localized: Tant que vos articles sont dans mes moyens, je les prends.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319771
    m_Localized: Voyons ce que je peux me payer avec mes crédits...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319772
    m_Localized: Vous acceptez de servir les petits budgets ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319773
    m_Localized: Je ne peux juste pas dépasser mon budget.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319774
    m_Localized: Je fais attention à mon argent, mais je vais quand même vous acheter quelques produits.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319775
    m_Localized: Bonjour. Je suis venu[g:|e] renouveler mon stock de matériel médical.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319776
    m_Localized: Ma pharmacie a besoin de matériel médical.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319777
    m_Localized: Je viens m'approvisionner en articles médicaux de base.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319778
    m_Localized: Bonjour. Je voudrais voir votre matériel médical.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319779
    m_Localized: J'aimerais acheter du matériel médical. Vous en avez ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319780
    m_Localized: Je voudrais voir les types de graines que vous proposez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319781
    m_Localized: Montrez-moi vos graines ! Il m'en faut un paquet.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319782
    m_Localized: 'Mon objectif est simple : vous acheter le plus de graines possible.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319783
    m_Localized: Je vais vous prendre une bonne quantité de graines, peu importe le type.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319784
    m_Localized: On a un problème à régler, aujourd'hui. Vous auriez pas quelque chose qui pourrait nous servir ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319785
    m_Localized: Une personne a dépassé les bornes, alors on va lui en toucher deux mots.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319786
    m_Localized: Certains croient pouvoir embobiner les strates inférieures et s'en tirer à bon compte.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319787
    m_Localized: Vendez-moi une arme toute simple.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319788
    m_Localized: Montrez-moi les armes que vous avez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319789
    m_Localized: J'ai besoin d'une arme. Rien de trop sophistiqué.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319790
    m_Localized: Tout est éteint dans le coin. Votre boutique est pas fermée, j'espère ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319791
    m_Localized: La panne de courant nous a pas loupés. C'est encore ouvert, chez vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319792
    m_Localized: Le courant est coupé dans tout le secteur, alors je viens vous voir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319793
    m_Localized: Youpi, les plombs ont encore sauté...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319794
    m_Localized: Je vous parie que ceux d'en haut ont le courant, eux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319795
    m_Localized: Je cherche des batteries pour encaisser le coup.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319796
    m_Localized: Il vous reste des batteries ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319797
    m_Localized: Je vais vous prendre des batteries.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319798
    m_Localized: J'ai oublié de me réapprovisionner pour la maintenance.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319799
    m_Localized: Et voilà, j'ai encore oublié de faire mes emplettes avant la maintenance...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319800
    m_Localized: Vous avez des batteries en rab ? Pas grave si elles sont pas complètement chargées.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319801
    m_Localized: Si vous vendez des batteries, j'aimerais bien vous en prendre une poignée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319802
    m_Localized: J'ai besoin de deux ou trois batteries, au cas où le courant revienne pas assez vite.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319803
    m_Localized: Une panne de courant ? C'est honteux !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319804
    m_Localized: J'ai dû prendre les escaliers ! Vous vous rendez compte ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319805
    m_Localized: Je n'arrive pas à croire que les <b>strates supérieures</b> soient plongées dans le noir !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319806
    m_Localized: Vendez-vous des batteries ? Votre prix sera le mien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319807
    m_Localized: Des batteries, je vous prie. J'ai bien assez de crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319808
    m_Localized: Cette panne rend les gens complètement zinzins.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319809
    m_Localized: Des casseurs s'en sont pris à la boutique au fond du couloir. Je suis [g:le prochain|la prochaine], je le sens.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319810
    m_Localized: Je veux protéger mon commerce, mais impossible de compter sur le service de sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319811
    m_Localized: Il faut que je me prépare, parce que ça va sérieusement dégénérer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319812
    m_Localized: Des articles pour faire fuir les vandales... vous en avez ? Un simple tuyau suffirait.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319813
    m_Localized: Vous vendez des armes, dites ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319814
    m_Localized: Je vous achète tout objet solide, bruyant ou coupant.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319815
    m_Localized: On reçoit souvent des victimes d'overdose d'Oxymore à la clinique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319816
    m_Localized: Du coup, j'ai du Naloxgone gratuit.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319817
    m_Localized: Pourriez-vous en donner aux personnes en détresse ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319818
    m_Localized: Je reviens des quais.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319819
    m_Localized: J'y ai vu une cargaison de cigarettes contrefaites.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319820
    m_Localized: Ce qui signifie que tu vas commencer à en croiser.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319821
    m_Localized: Ces objets te permettront d'identifier les faux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319822
    m_Localized: Tu vas devoir examiner à la loupe les paquets de cigarettes que tu croises.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319823
    m_Localized: Le guide te servira de référence.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319824
    m_Localized: Tu peux signaler au client toute anomalie que tu détectes.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319825
    m_Localized: Et dis-toi qu'un seul défaut suffit.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319826
    m_Localized: Si ton signalement est correct, le client ajustera le prix.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319827
    m_Localized: Dans le cas contraire, ta réputation en prendra un coup.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319828
    m_Localized: Bonne chance.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319829
    m_Localized: Salut ! C'est bien vous qui avez repris la boutique ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319830
    m_Localized: Je fais partie du <b>service d'entretien</b>.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319831
    m_Localized: Vu que vous débarquez...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319832
    m_Localized: Je vais vous expliquer notre fonctionnement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319833
    m_Localized: Interdiction <b>formelle</b> de nettoyer soi-même sa devanture.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319834
    m_Localized: Si vous voulez qu'elle soit propre...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319835
    m_Localized: Vous allez devoir <u>mettre la main au portefeuille</u>.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319836
    m_Localized: Et si vous décidez quand même de vous la jouer solo...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319837
    m_Localized: on vous le fera payer très cher.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319838
    m_Localized: Je vous dis à un de ces quatre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319839
    m_Localized: Salut ! Toujours parmi nous, à ce que je vois ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319840
    m_Localized: Je vais vous révéler un petit secret.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319841
    m_Localized: On fait pas que le ménage.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319842
    m_Localized: On gère aussi tout un réseau d'échange clandestin.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319843
    m_Localized: C'est hyper simple. D'abord, vous placez des articles précis dans votre poubelle.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319844
    m_Localized: Ensuite, vous faites appel au service d'entretien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319845
    m_Localized: Nous, on vient récupérer les produits et on vous laisse quelque chose pour le lendemain matin.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319846
    m_Localized: Voilà la liste. Y a des trucs qui changent tous les deux jours.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319847
    m_Localized: Le plus gros avantage de ce système,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319848
    m_Localized: c'est que vous risquez pas de vous faire pincer par la sécu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319849
    m_Localized: Allez, à plus.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319850
    m_Localized: Salut ! Ça y est, c'est officiel.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319851
    m_Localized: Vous avez rejoint l'échange clandestin.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319852
    m_Localized: Voilà la liste. Y a des trucs qui changent tous les deux jours.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319853
    m_Localized: Déjà, vous mettez les articles demandés dans la poubelle.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319854
    m_Localized: Ensuite, vous faites appel au service d'entretien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319855
    m_Localized: Nous, on vient récupérer les produits et on vous laisse quelque chose pour le lendemain matin.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319856
    m_Localized: Et oubliez pas le plus important...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319857
    m_Localized: La sécu peut pas nous surveiller !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319858
    m_Localized: Voilà, bienvenue dans notre réseau !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319859
    m_Localized: Bien le bonjour et... <wave a=0.25>bienvenue dans notre joli petit quartier !</wave>
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319860
    m_Localized: Je me présente, <slide a=0.25>Joe Wild</slide> !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319861
    m_Localized: Vous le savez sans doute déjà, mais...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319862
    m_Localized: Ce secteur, aussi charmant soit-il, n'est pas le plus sûr de la station.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319863
    m_Localized: Même par rapport au reste des strates inférieures...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319864
    m_Localized: Et c'est là que nous entrons en scène, moi et mes <i>services d'assurance</i> !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319865
    m_Localized: Aux petits commerces comme le vôtre...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319866
    m_Localized: je propose une formule quotidienne
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319867
    m_Localized: qui permet d'assurer l'ensemble des biens en cas de vol !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319868
    m_Localized: Vous pouvez activer ou désactiver ce service avant d'aller dormir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319869
    m_Localized: Maintenant que les présentations sont faites, je vous souhaite bon courage pour la suite !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319870
    m_Localized: Bien le bonjour !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319871
    m_Localized: Votre boutique a l'air de se porter à merveille.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319872
    m_Localized: Laissez-moi vous apprendre une chose.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319873
    m_Localized: Les relations sont capitales, en bas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319874
    m_Localized: Et il ne faut pas avoir peur d'y mettre le prix.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319875
    m_Localized: D'ailleurs, je peux vous présenter quelques-uns de mes contacts.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319876
    m_Localized: Je connais des fournisseurs, des informateurs et même des agents de sécurité !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319877
    m_Localized: Regardez tout ce que je peux faire pour vous...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319878
    m_Localized: Bien le bonjour !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319879
    m_Localized: J'espère que vous allez bien !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319880
    m_Localized: Je ne sais pas si vous l'aviez remarqué, mais...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319881
    m_Localized: j'ai les moyens de vous intégrer au réseau du marché public.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319882
    m_Localized: C'est un excellent moyen de répondre directement aux demandes des stationautes.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319883
    m_Localized: Je le recommande chaudement à tout commerçant qui se respecte !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319884
    m_Localized: Souhaitez-vous en savoir plus ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319885
    m_Localized: N'oubliez pas que vous pouvez m'appeler à tout moment en cas de besoin.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319886
    m_Localized: Vous achetez de la nourriture ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319887
    m_Localized: J'en ai sur moi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319888
    m_Localized: Vous avez de quoi becqueter ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319889
    m_Localized: Je viens me ravitailler.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319890
    m_Localized: Bonjour, ici l'agent Lun.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319891
    m_Localized: Je travaille pour le service de sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319892
    m_Localized: Conformément aux règles en vigueur...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319893
    m_Localized: vous disposez d'un bouton d'alerte, situé sous votre comptoir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319894
    m_Localized: Je tiens également à vous fournir la liste des individus que nous recherchons activement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319895
    m_Localized: Si l'un d'eux se présente dans votre établissement,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319896
    m_Localized: '<u><b>ne l''écoutez SURTOUT PAS !</u></b>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319897
    m_Localized: Contentez-vous de nous alerter avant qu'il ne parte.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319898
    m_Localized: Nous nous chargerons de la suite.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319899
    m_Localized: Ne dénoncez vos clients que si vous avez la certitude qu'ils sont recherchés.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319900
    m_Localized: Vous écoperez d'une amende en cas de faux signalement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319901
    m_Localized: Bonne journée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319902
    m_Localized: Ici l'agent Lun.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319903
    m_Localized: J'espère que vous ne quittez pas cet avis de recherche des yeux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319904
    m_Localized: J'ai de nouvelles instructions à vous donner.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319905
    m_Localized: '<b><u>Dénoncez toutes les personnes qui vendent de la contrebande de niveau moyen ou supérieur.</u></b>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319906
    m_Localized: Ne vous préoccupez pas des marchandises de faible niveau. Elles n'en valent pas la peine.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319907
    m_Localized: Vous entacherez sans doute votre réputation.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319908
    m_Localized: Mais vous recevrez une récompense proportionnelle à la quantité de contrebande confisquée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319909
    m_Localized: Bonne journée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319910
    m_Localized: J'ai trouvé une caisse pleine de presque-viande hier !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319911
    m_Localized: Si vous achetez tout, vous paierez 15 % moins cher.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319912
    m_Localized: Je me trimballe tout un tas de ferraille !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319913
    m_Localized: Ça vous dit d'acheter le lot à -33 % ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319914
    m_Localized: Si vous acceptez,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319915
    m_Localized: vous aurez besoin d'un four.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319916
    m_Localized: Avec, vous pourrez faire fondre la ferraille pour obtenir des lingots.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319917
    m_Localized: Ça se revend bien, en plus !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319918
    m_Localized: Yo.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319919
    m_Localized: Je vous apporte des cigarettes Hemingway. Des vraies de vraies.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319920
    m_Localized: Vous voulez me les acheter ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319921
    m_Localized: Salut ! Visez un peu la caisse que j'ai trouvée !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319922
    m_Localized: Elle a même pas été ouverte.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319923
    m_Localized: Ce genre de truc vaut cher, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319924
    m_Localized: Bonjour. Je suis membre du comité d'estimation.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319925
    m_Localized: Certains articles présentent une structure de prix complexe,
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319926
    m_Localized: et nous souhaitons aider les clients à déterminer leur valeur exacte.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319927
    m_Localized: Nous avons été informés de votre arrivée récente.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319928
    m_Localized: Votre boutique pourrait tout à fait proposer des services d'estimation.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319929
    m_Localized: Vous vous dégageriez ainsi une source de revenus complémentaire.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319930
    m_Localized: Alors, souhaitez-vous rejoindre le comité d'estimation ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319931
    m_Localized: Les frais d'inscription s'élèvent à {0:plural:{} crédit|{} crédits} seulement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319932
    m_Localized: '[Rejoindre le comité ({0:plural:{} crédit|{} crédits})]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319933
    m_Localized: '[Refuser l''invitation]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319934
    m_Localized: '[Lui demander de repasser]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319935
    m_Localized: À la bonne heure ! Bienvenue parmi nous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319936
    m_Localized: Voici tous nos guides d'estimation.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319937
    m_Localized: Nous vous enverrons des clients sous peu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319938
    m_Localized: Je reviendrai vous voir dans quelques jours.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319939
    m_Localized: C'est bien dommage. Je sais pourtant déceler les talents...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319940
    m_Localized: Mais votre choix est fait. Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319941
    m_Localized: Entendu, je reviendrai dans quelque temps.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319942
    m_Localized: Bonjour. Je travaille pour le comité d'estimation.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319943
    m_Localized: Vous m'avez vue il y a quelques jours.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319944
    m_Localized: Avez-vous pris une décision ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319945
    m_Localized: Je serai bientôt de retour.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319946
    m_Localized: Bonjour. J'ai un paquet de <b>vraies</b> cigarettes Hemingway pour vous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319947
    m_Localized: On fait affaire ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319948
    m_Localized: J'ai de l'eau en trop à vendre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319949
    m_Localized: Ça vous tente ? Je précise que c'est de la basique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319950
    m_Localized: Vous vendriez pas de l'eau basique ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319951
    m_Localized: C'est pour ma prochaine virée furetage.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319952
    m_Localized: Je viens pour de l'eau basique, moi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319953
    m_Localized: Aaah, nickel !
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319954
    m_Localized: Je suis venu[g:|e] vous acheter de quoi manger.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319955
    m_Localized: Et j'ai un total de {0:plural:{} crédit|{} crédits} à dépenser.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319956
    m_Localized: Bonjour. Avez-vous de quoi grignoter ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319957
    m_Localized: Des chips, des barres, du chocolat ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319958
    m_Localized: Des cigarettes, ça marche aussi...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319959
    m_Localized: Je suis venu[g:|e] avec {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319960
    m_Localized: Vous pouvez me vendre de la bière ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319961
    m_Localized: Pour {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319962
    m_Localized: Vous auriez de la nourriture ou des boissons ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319963
    m_Localized: Je peux vous en donner {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319964
    m_Localized: Proposez-moi des produits variés, si possible.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319965
    m_Localized: Je n'achèterai pas deux fois la même chose...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319966
    m_Localized: mais je suis prêt[g:|e] à payer plus cher.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319967
    m_Localized: Bonjour. La primo-banque des strates supérieures m'envoie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319968
    m_Localized: J'ai une nouvelle à vous annoncer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319969
    m_Localized: Votre bâtiment vient d'être mis en vente
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319970
    m_Localized: et nous pouvons vous aider à l'acheter.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319971
    m_Localized: Son prix de vente est de 40 000 crédits très exactement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319972
    m_Localized: Mais avec un emprunt chez nous, vous atteindrez ce montant plus rapidement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319973
    m_Localized: Je reviendrai vous donner de plus amples informations
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319974
    m_Localized: lorsque vous aurez suffisamment de crédits pour l'apport initial.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319975
    m_Localized: Bonjour. La primo-banque des strates supérieures m'envoie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319976
    m_Localized: Nous avons mené des recherches sur votre établissement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319977
    m_Localized: Votre affaire semble tout à fait lucrative.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319978
    m_Localized: De plus, votre propriétaire a mis le bâtiment en vente...
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319979
    m_Localized: ... à 40 000 crédits très exactement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216476319980
    m_Localized: Nous sommes disposés à vous proposer un emprunt
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514048
    m_Localized: si vous souhaitez l'acheter.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514049
    m_Localized: Voici tous les détails.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514050
    m_Localized: Regardez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514051
    m_Localized: Puisque les prêts sont risqués dans les strates inférieures...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514052
    m_Localized: nous exigerons un apport initial de 20 %, soit 8 000 crédits dans votre cas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514053
    m_Localized: Quant à votre taux d'intérêt annuel, il sera de 75 %.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514054
    m_Localized: Bonjour, c'est [g:le banquier|la banquière].
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514055
    m_Localized: Nous avons conversé la semaine dernière.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514056
    m_Localized: Pourriez-vous me dire si vous voulez acheter ce bâtiment
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514057
    m_Localized: et contracter un emprunt chez nous ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514058
    m_Localized: Bonjour ! C'est la première fois que je vois votre tête.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514059
    m_Localized: Ravi de vous connaître ! Je suis le Pr Jackson.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514060
    m_Localized: Je faisais affaire avec le précédent locataire...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514061
    m_Localized: jusqu'à son arrestation !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514062
    m_Localized: Je fabrique toutes sortes de gadgets.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514063
    m_Localized: Ils vous aideront au quotidien !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514064
    m_Localized: '<u>À noter que la plupart de mes machines s''activent pendant la nuit.</u>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514065
    m_Localized: '<u>Et elles ont chacune besoin d''une batterie.</u>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514066
    m_Localized: Puisque c'est notre toute première rencontre...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514067
    m_Localized: Vous avez droit à une réduction pour votre premier achat.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514068
    m_Localized: Sachez que ce four transforme la ferraille et le minerai en lingots précieux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514069
    m_Localized: Emballez, c'est pesé !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514070
    m_Localized: Tenez, un petit cadeau.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514071
    m_Localized: Venez donc me rendre visite après la fermeture de votre boutique !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514072
    m_Localized: Je vous achèterai n'importe quel type de matériaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514073
    m_Localized: Par la même occasion, je vous montrerai mes nouvelles créations !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514074
    m_Localized: À bientôt !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514075
    m_Localized: Bonjour ! Regardez ce que je vous apporte !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514076
    m_Localized: Ces modules s'installent dans certaines machines
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514077
    m_Localized: et peuvent améliorer leurs performances.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514078
    m_Localized: Qu'en dites-vous ? Puisque nous aimons tous deux la science, je vous accorde une remise exceptionnelle.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514079
    m_Localized: Vous me faites plaisir !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514080
    m_Localized: N'hésitez surtout pas à venir me voir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514081
    m_Localized: Après avoir terminé votre journée, bien entendu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514082
    m_Localized: À bientôt !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514083
    m_Localized: L'un de mes contacts au service de sécurité m'a remis ceci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514084
    m_Localized: Si tu enfreins trop souvent les règles...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514085
    m_Localized: une enquête sera ouverte.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514086
    m_Localized: Et une fois que le service aura accumulé suffisamment de preuves contre toi, il t'infligera une sanction.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514087
    m_Localized: Je te recommande de raser les murs au maximum lorsque tu commets un crime.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514088
    m_Localized: Du moins, jusqu'à ce que les choses se tassent.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514089
    m_Localized: 'Une dernière chose : méfie-toi des personnes à qui tu vends et achètes de la contrebande.'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514090
    m_Localized: Certaines ne savent pas tenir leur langue.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514091
    m_Localized: Je voulais te prévenir...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514092
    m_Localized: Le comité de commerce va bientôt obliger tout le monde à posséder une licence commerciale.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514093
    m_Localized: Les licences seront mises en vente dans deux semaines
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514094
    m_Localized: et coûteront {0:plural:{} crédit|{} crédits} pièce.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514095
    m_Localized: La nouvelle règle sera appliquée la semaine suivante.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514096
    m_Localized: Si tu n'arrives pas à mettre suffisamment de crédits de côté d'ici là...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514097
    m_Localized: Tu pourras peut-être t'arranger avec le comité.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514098
    m_Localized: Je sais que les membres sont de nature... <i>conciliante</i>.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514099
    m_Localized: Mais si tu décides d'acheter ta licence,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514100
    m_Localized: ne néglige pas ton loyer pour autant.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514101
    m_Localized: Bonjour ! J'ai déniché des machines cassées.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514102
    m_Localized: Avec une torche ou un tournevis,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514103
    m_Localized: vous pourriez récupérer des pièces dedans.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514104
    m_Localized: Vous gagneriez gros !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514105
    m_Localized: Est-ce que vous vendez des composants électroniques ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514106
    m_Localized: On est complètement à sec, au service mécanique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514107
    m_Localized: Et on a de plus en plus de mal à en trouver...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514108
    m_Localized: Les vaisseaux de passage nous en filent pas assez.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514109
    m_Localized: Si ça continue...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514110
    m_Localized: la station va finir par s'écrouler.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514111
    m_Localized: Enfin bref. Je vais aussi vous prendre des matériaux et des modules.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514112
    m_Localized: Vous avez de la poussière onirique ou de l'Oxymore ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514113
    m_Localized: J'ai une longue expédition qui m'attend.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514114
    m_Localized: Je repars pour la ceinture d'astéroïdes...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514115
    m_Localized: et je vais me taper des journées de 12 heures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514116
    m_Localized: Du coup, il va me falloir de quoi tenir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514117
    m_Localized: '<i>*Se précipite vers la devanture*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514118
    m_Localized: J'ai des médicaments.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514119
    m_Localized: Je dois à tout prix les vendre aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514120
    m_Localized: Le tout est à -33 %.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514121
    m_Localized: La clinique m'a demandé d'aller chercher des articles médicaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514122
    m_Localized: À vrai dire, nous sommes sous l'eau.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514123
    m_Localized: Nous travaillons sans relâche, du matin au soir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514124
    m_Localized: Et pour ne rien arranger, nous comptons sur les dons des citoyens
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514125
    m_Localized: car nous n'avons jamais assez de médicaments.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514126
    m_Localized: Sans eux, notre clinique fermerait ses portes.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514127
    m_Localized: Je ne ferai pas la difficile. J'accepte même les produits artisanaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514128
    m_Localized: '<i>*KOF KOF*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514129
    m_Localized: B-Bonjour. Vous avez de l'eau raffinée ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514130
    m_Localized: À la clinique, on m'a dit que je buvais des cochonneries
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514131
    m_Localized: et que je devais prendre de l'eau raffinée pendant un mois.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514132
    m_Localized: Sinon, je pourrai pas guérir...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514133
    m_Localized: Mais c'est super cher !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514134
    m_Localized: OK, j'achète.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514135
    m_Localized: Salut, je reviens d'une sortie furetage.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514136
    m_Localized: On trouve de moins en moins notre bonheur.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514137
    m_Localized: Tout ce qui s'obtient facilement dans la zone abandonnée a déjà été récupéré.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514138
    m_Localized: Il y a des rumeurs sur ces fureteurs qui attaquent leurs collègues
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514139
    m_Localized: et leur piquent leurs affaires pour les vendre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514140
    m_Localized: La décharge est moins dangereuse, mais...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514141
    m_Localized: moins intéressante, aussi.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514142
    m_Localized: Enfin voilà. Jetez un œil à mes marchandises.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514143
    m_Localized: Elles sont à -25 % si vous les achetez toutes.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514144
    m_Localized: Bonjour. Vous avez de quoi grignoter ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514145
    m_Localized: Ou bien des comprimés de caféine ? Des cigarettes ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514146
    m_Localized: Aujourd'hui encore, c'est patrouille dans les strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514147
    m_Localized: Je pourrais me faire poignarder à chaque coin de rue.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514148
    m_Localized: Vivement la promotion !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514149
    m_Localized: Je travaillerai dans les strates supérieures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514150
    m_Localized: Ou les intermédiaires, au moins...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514151
    m_Localized: Salut ! Vous avez des médocs ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514152
    m_Localized: J'en veux tout de suite ! Je me suis fait tirer dessus.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514153
    m_Localized: Et c'est trop dangereux pour moi d'aller à la clinique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514154
    m_Localized: Les membres d'un autre gang ont investi notre territoire
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514155
    m_Localized: et veulent vendre leur propre came.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514156
    m_Localized: On va pas se laisser faire.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514157
    m_Localized: Salutations !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514158
    m_Localized: C'est ma première fois dans les strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514159
    m_Localized: Je voulais découvrir la vie d'en bas !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514160
    m_Localized: Force est de constater que vous avez une culture sympathique.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514161
    m_Localized: Là-haut, tout est fade.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514162
    m_Localized: Nous faisons toujours la même chose. C'est d'un ennui !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514163
    m_Localized: Je souhaiterais vous acheter des souvenirs.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514164
    m_Localized: Des choses qu'on ne trouve qu'ici !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514165
    m_Localized: Comme des articles improvisés, des aliments transformés, des armes rudimentaires...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514166
    m_Localized: et des produits plus récréatifs ! <i>*Clin d'œil*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514167
    m_Localized: Si vous me vendez des produits variés, je vous paierai grassement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514168
    m_Localized: Bonjour. Je cherche des armes, des munitions ou des armures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514169
    m_Localized: Attendez. Vous venez d'arriver dans le secteur, n'est-ce pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514170
    m_Localized: Je suis consultant[g:|e] en sécurité pour des petites boîtes.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514171
    m_Localized: Si vous n'avez pas encore de système d'alarme, vous devriez changer ça.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514172
    m_Localized: Ces derniers temps, les gangs et le grand banditisme s'en donnent à cœur joie dans les strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514173
    m_Localized: Je suppose qu'on a déjà essayé de vous vendre des <i>services d'assurance</i>.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514174
    m_Localized: Passons. Vous avez les articles que je veux ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514175
    m_Localized: Salut salut. Vous avez à boire et à manger ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514176
    m_Localized: J'ai des réparations dans le secteur, aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514177
    m_Localized: Un fureteur a complètement perdu la boule.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514178
    m_Localized: Il a retiré le revêtement métallique d'une poutre... Et c'est déjà arrivé.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514179
    m_Localized: La prochaine fois, ce sera encore pire !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514180
    m_Localized: Ces timbrés seraient capables de dénuder les fils du système de survie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514181
    m_Localized: '<i>*Long soupir*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514182
    m_Localized: C'est parfait, merci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514183
    m_Localized: Salut, je reviens d'une petite sortie furetage dans la station.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514184
    m_Localized: Les débris et épaves de vaisseaux marchands sont une vraie mine d'or !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514185
    m_Localized: J'ai vraiment bien fait d'économiser pour ce vaisseau de furetage.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514186
    m_Localized: Pendant que les fureteurs lambda se disputent des vieilleries sans intérêt
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514187
    m_Localized: dans la zone abandonnée,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514188
    m_Localized: je me la coule douce dans mon vaisseau !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514189
    m_Localized: '<i>*Tremble*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514190
    m_Localized: Bonjour... Ça va pas fort, là.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514191
    m_Localized: J'ai pas assez de crédits pour des médicaments.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514192
    m_Localized: J'ai voulu aller à la clinique...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514193
    m_Localized: La file d'attente était interminable.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514194
    m_Localized: On voyait même pas la porte d'entrée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514195
    m_Localized: Je sais que je devrais pas en demander autant à une orga caritative...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514196
    m_Localized: Mais franchement, une seule clinique pour l'ensemble des strates inférieures, ça suffit pas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514197
    m_Localized: Bonjour.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514198
    m_Localized: Proposez-vous à manger ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514199
    m_Localized: Je me suis fait cambrioler.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514200
    m_Localized: Toute ma nourriture y est passée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514201
    m_Localized: Je pense que mes voisins ont fait le coup.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514202
    m_Localized: Mais ils sont très pauvres... Je ne peux pas leur en vouloir.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514203
    m_Localized: Les postes normaux sont rares, alors la plupart des gens se tournent vers le furetage ou le crime.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514204
    m_Localized: Bonjour. Je viens vous vendre ceci.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514205
    m_Localized: Mon arme de la deuxième Révolution.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514206
    m_Localized: Elle ne m'est plus d'aucune utilité.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514207
    m_Localized: Je l'ai gardée toutes ces années...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514208
    m_Localized: dans l'espoir de m'en resservir pendant une nouvelle Révolution.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514209
    m_Localized: Ça n'est jamais arrivé, et j'ai passé l'âge de jouer les rebelles.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514210
    m_Localized: Vous êtes une ex-révolutionnaire ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514211
    m_Localized: Oui. J'étais même chef d'escouade.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514212
    m_Localized: Nous pensions pouvoir changer les choses.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514213
    m_Localized: En réalité, nous étions dépassés.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514214
    m_Localized: C'était pareil pendant la première Révolution.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514215
    m_Localized: Si vous acceptez mon arme,
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514216
    m_Localized: j'aimerais l'échanger contre de la nourriture, des boissons et des produits du quotidien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514217
    m_Localized: Ça me va très bien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514218
    m_Localized: Il y a urgence !
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514219
    m_Localized: J'ai besoin d'outils, d'armes et de médicaments variés.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514220
    m_Localized: Ma petite-amie a disparu.
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514221
    m_Localized: Elle est partie fureter dans la zone abandonnée...
    m_Metadata:
      m_Items: []
  - m_Id: 420216480514222
    m_Localized: et elle est toujours pas revenue !
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096960
    m_Localized: J'ai peur qu'il lui soit arrivé un truc.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096961
    m_Localized: Je lui avais dit de pas prendre de risques inutiles,
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096962
    m_Localized: mais elle a rien voulu entendre...
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096963
    m_Localized: Je dois vite la retrouver.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096964
    m_Localized: Hé, vous ! J'ai des nutrifruits à écouler.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096965
    m_Localized: Ils sont faciles à cultiver et résistants aux insectes et maladies.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096966
    m_Localized: Mais leurs graines sont tellement chères !
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096967
    m_Localized: Je comprends pas pourquoi ils ont pas de pépins...
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096968
    m_Localized: Bonjour ! Faites-vous à manger ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096969
    m_Localized: Je n'étais pas descendu[g:|e] ici depuis des lustres.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096970
    m_Localized: J'ai emménagé en haut après avoir gagné au loto.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096971
    m_Localized: Vous savez, la loterie des strates inférieures a vu le jour il y a un petit moment,
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096972
    m_Localized: juste après la deuxième Révolution.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096973
    m_Localized: Je vous avoue que la nourriture réconfortante d'ici me manque parfois.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096974
    m_Localized: Je suis tombé[ɡ:|e] sur une caisse de presque-viande !
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096975
    m_Localized: C'est quoi votre théorie, à vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096976
    m_Localized: La plupart des gens pensent que les conserves sont à base de porc.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096977
    m_Localized: D'autres disent que c'est une protéine cultivée en labo.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096978
    m_Localized: Moi, je pense qu'il y a de la poudre d'insectes dedans.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096979
    m_Localized: Vous voulez m'en acheter ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096980
    m_Localized: Salut, la forme ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096981
    m_Localized: Vous saviez que des extraterrestres dirigeaient notre station ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096982
    m_Localized: Eh ouais ! On est dans une sorte de simulation sociale.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096983
    m_Localized: Ils nous étudient avant d'aller envahir le reste de la République.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096984
    m_Localized: Qui est super loin d'ici, soit dit en passant. C'est pratique !
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096985
    m_Localized: J'oubliais, tous les agents de sécurité sont des androïdes !
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096986
    m_Localized: Et même que nos dissidents ont inventé le syndrome de la sentinelle effondrée pour mieux nous contrôler !
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096987
    m_Localized: Et la Révolution est une création de la direction !
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096988
    m_Localized: Sinon, j'ai de vraies protections contre les extraterrestres. Vous en voulez ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096989
    m_Localized: Je les ai fabriquées moi-même, vous en faites pas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096990
    m_Localized: Vous vendez des trucs intéressants ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096991
    m_Localized: De la poussière onirique, au pif ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096992
    m_Localized: Bonjour. Mes employeurs m'ont demandé d'effectuer quelques achats.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096993
    m_Localized: Et dire qu'ils vont aller au bout de leur idée...
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096994
    m_Localized: Ils veulent organiser une "soirée furetage".
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096995
    m_Localized: Tout le gratin des strates supérieures se déguisera en fureteurs
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096996
    m_Localized: et mangera des spécialités des strates inférieures dans des plats en métal.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096997
    m_Localized: Il va même y avoir un concours du déguisement...
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096998
    m_Localized: Inutile de préciser que les membres du jury n'ont jamais vécu en bas.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493096999
    m_Localized: Je ne vois vraiment pas ce que ça peut avoir d'amusant...
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097000
    m_Localized: Bonjour, j'aimerais me débarrasser de ces déchets dangereux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097001
    m_Localized: L'élimination en bonne et due forme, ça coûte toujours un bras.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097002
    m_Localized: Je vous paierai 100 crédits par tonneau.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097003
    m_Localized: '[Prendre 1 tonneau]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097004
    m_Localized: '[Prendre 3 tonneaux]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097005
    m_Localized: '[Prendre 5 tonneaux]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097006
    m_Localized: J'aimerais passer une commande d'arme.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097007
    m_Localized: Je veux une arme à feu personnalisée. Vous pensez pouvoir m'aider ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097008
    m_Localized: Je viens vous commander une arme modifiée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097009
    m_Localized: J'ai une arme bien spécifique en tête. Vous allez me la créer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097010
    m_Localized: Je cherche du sur-mesure.
    m_Metadata:
      m_Items: []
  - m_Id: 420216493097011
    m_Localized: Je vends des flingues en bon état.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291264
    m_Localized: Les armes, vous achetez ? J'en ai une sympa.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291265
    m_Localized: J'ai chopé une arme qui tire encore. Ça vous intéresse ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291266
    m_Localized: Débarrassez-moi de ces modificateurs et chargeurs.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291267
    m_Localized: Il me faut du pognon. Tenez, mon arme d'appoint.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291268
    m_Localized: Ce machin m'a sauvé la vie. Vous le voulez ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291269
    m_Localized: Bonjour. J'ai des infos pour vous...
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291270
    m_Localized: mais elles sont pas gratuites.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291271
    m_Localized: Vous avez bien fait.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291272
    m_Localized: Bon écoutez...
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291273
    m_Localized: 'Voilà ce qui se dit dans la rue :'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291274
    m_Localized: La saison des récoltes de l'une des plus grosses fermes de nutrifruits va commencer dans trois jours.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291275
    m_Localized: Le prix de tous les produits alimentaires baissera pendant quelques jours.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291276
    m_Localized: C'est tout. Je vous laisse.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291277
    m_Localized: Bonjour. J'ai eu accès à des infos.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291278
    m_Localized: Salut. J'ai obtenu des infos en exclusivité.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291279
    m_Localized: Bonjour. J'ai des infos croustillantes à partager.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291280
    m_Localized: Ça pourrait vous intéresser !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291281
    m_Localized: Ça vaut le coup, croyez-moi !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291282
    m_Localized: Vous allez vouloir entendre ça !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291283
    m_Localized: Ça pourrait changer la donne !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291284
    m_Localized: Mais c'est pas gratuit.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291285
    m_Localized: Par contre, vous allez casquer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291286
    m_Localized: Je vais juste vous demander quelques crédits en échange.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291287
    m_Localized: Mais tout a un coût.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291288
    m_Localized: Voilà pour vous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291289
    m_Localized: Regardez qui voilà !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291290
    m_Localized: On en a ras le bol de vos conneries.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291291
    m_Localized: Alors on vient se débarrasser de vous une bonne fois pour toutes.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291292
    m_Localized: C'EST PARTI, LES GARS !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291293
    m_Localized: Salutations.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291294
    m_Localized: Je vous place en état d'arrestation...
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291295
    m_Localized: pour vos crimes contre cette station.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291296
    m_Localized: Les Strates supérieures vous saluent.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291298
    m_Localized: On vient d'arracher ces produits des mains de nos oppresseurs.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291299
    m_Localized: On en fera meilleur usage qu'eux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291300
    m_Localized: Et tous les bénéfices de nos ventes seront reversés à la Révolution.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291301
    m_Localized: Bonjour. J'ai pas mal de choses en stock.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291302
    m_Localized: Tous les produits viennent de nos camarades.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291303
    m_Localized: Et les bénéfices seront reversés à la Révolution.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291305
    m_Localized: '<i>*Dégaine son arme*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291306
    m_Localized: Dites-moi que vous avez de la nourriture, par pitié !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291307
    m_Localized: Les deux autres boutiques que j'ai faites ont plus rien en stock.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291308
    m_Localized: Bonjour, vous servez à manger ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291309
    m_Localized: C'est la flambée des prix, en ce moment.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291310
    m_Localized: Il vous reste des médicaments ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291311
    m_Localized: Les autres boutiques sont à sec !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291312
    m_Localized: Je cherche des articles médicaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291313
    m_Localized: Cette hausse des prix est intenable.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291314
    m_Localized: Vous avez des produits qui font planer ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291315
    m_Localized: J'en trouve nulle part... Sérieux, j'en peux plus !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291316
    m_Localized: Vous vendez des relaxants ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291317
    m_Localized: Je sais que les prix sont abusés en ce moment, mais j'ai plus le choix.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291318
    m_Localized: J'ai besoin de me protéger. Donnez-moi ce que vous avez !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291319
    m_Localized: Vos concurrents se sont déjà fait dévaliser, et ça va bientôt chauffer dans le secteur.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291320
    m_Localized: Je viens vous acheter des armes ou une armure.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291321
    m_Localized: C'est hyper tendu, là. Je veux me préparer au mieux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291322
    m_Localized: Vous avez pas de la ferraille ou des matériaux bruts ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291323
    m_Localized: Les ateliers du secteur sont obligés de fermer parce qu'ils arrivent à se fournir nulle part.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291324
    m_Localized: J'aimerais des matériaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291325
    m_Localized: Comme les prix ont grimpé, les gens ont vidé les rayons.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291326
    m_Localized: '<i>*Discussion inintelligible via la radio*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291327
    m_Localized: Hmm, il semblerait que nous ayons perdu les preuves qui pesaient contre vous.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291328
    m_Localized: J'ignore comment vous avez réussi votre coup, mais nous finirons par vous coffrer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291329
    m_Localized: Bonjour, stationaute.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291330
    m_Localized: Nous disposons de preuves attestant vos crimes. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291331
    m_Localized: Vous nous devez une amende de {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291332
    m_Localized: Si vous ne pouvez pas la payer, nous vous arrêterons sur-le-champ.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291333
    m_Localized: '[Régler l''amende ({0:plural:{} crédit|{} crédits})]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291334
    m_Localized: Tâchez de ne plus faire de vagues.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291335
    m_Localized: '[Ne pas régler l''amende]'
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291336
    m_Localized: Dans ce cas, vous êtes en état d'arrestation !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291337
    m_Localized: Vous avez le droit de garder le silence.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291338
    m_Localized: Ne bougez plus !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291339
    m_Localized: On vous arrête pour vos crimes. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291340
    m_Localized: Vous allez rester à l'ombre un long moment.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291341
    m_Localized: Vous avez le droit de garder le silence.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291342
    m_Localized: Les mains en l'air !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291343
    m_Localized: On vous arrête pour vos crimes. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291344
    m_Localized: Ces actes sont passibles de la peine de mort.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291345
    m_Localized: Bonjour. En raison de vos activités récentes,
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291346
    m_Localized: nous avons décidé de révoquer votre licence.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291347
    m_Localized: Bonne journée.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291348
    m_Localized: Vous avez bien fait.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291349
    m_Localized: Excellent choix.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291350
    m_Localized: C'était la meilleure décision.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291352
    m_Localized: Bon écoutez...
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291353
    m_Localized: Dans {0:plural:{} jour|{} jours}, une grosse exploitation nutrifruitière fera sa récolte.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291354
    m_Localized: Dans {0:plural:{} jour|{} jours}, ce sera la saison des récoltes pour une ferme de nutrifruits importante.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291355
    m_Localized: Une grande exploitation nutrifruitière commencera à récolter ses produits dans {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291357
    m_Localized: Comme il y aura plein de nutrifruits, les prix vont baisser.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291358
    m_Localized: Et vu que l'offre en nutrifruits va augmenter, les prix vont chuter.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291359
    m_Localized: Il va y avoir un afflux de nutrifruits et une baisse des prix.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291361
    m_Localized: Le marché alimentaire sera impacté pendant {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291362
    m_Localized: Les prix des denrées alimentaires seront bas pendant {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291363
    m_Localized: Ce qui veut dire que tous les produits alimentaires coûteront moins cher pendant {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291365
    m_Localized: OK.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291366
    m_Localized: Bon écoutez...
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291367
    m_Localized: Dans {0:plural:{} jour|{} jours}, une grande exploitation nutrifruitière des strates inférieures fera une mauvaise récolte.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291368
    m_Localized: Les prix de tous les produits alimentaires augmenteront pendant {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291369
    m_Localized: OK, je vais remplir ma part du marché.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291370
    m_Localized: Vous êtes réglo, c'est bien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291371
    m_Localized: Mais vous avez intérêt à garder pour vous ce qui va suivre.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291373
    m_Localized: Écoutez un peu ce scoop...
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291374
    m_Localized: Il va y avoir une pénurie de médicaments dans {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291375
    m_Localized: D'après la rumeur, une panne de médicaments touchera la station dans {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291376
    m_Localized: Les réserves de médicaments diminuent dangereusement. Dans {0:plural:{} jour|{} jours}, y aura plus rien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291378
    m_Localized: Faites vite, parce qu'après, les prix flamberont pendant {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291379
    m_Localized: Après ça, les prix des articles médicaux crèveront le plafond pendant {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291380
    m_Localized: Vu que le matériel médical sera plus rare, il se vendra plus cher pendant {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291382
    m_Localized: Vous allez pas en revenir...
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291383
    m_Localized: J'ai une révélation bien juteuse...
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291384
    m_Localized: Ce qui va suivre va vous épater.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291385
    m_Localized: Écoutez, ça vient de sortir !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291386
    m_Localized: Des stationautes sont tombés sur un débarras rempli de produits du quotidien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291387
    m_Localized: Des fureteurs ont trouvé une pièce secrète au cours de leur excursion, avec plein de produits du quotidien à l'intérieur.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291388
    m_Localized: Un débarras secret a été découvert pendant une sortie furetage. Il est rempli de produits du quotidien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291389
    m_Localized: Quelqu'un a déniché un débarras qui renferme plein d'objets du quotidien.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291390
    m_Localized: Le marché va crouler sous les marchandises de ce genre, et les prix vont baisser.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291391
    m_Localized: De nombreux articles bon marché vont donc apparaître sur le marché.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291392
    m_Localized: Avec un stock pareil, les prix vont forcément dégringoler.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291393
    m_Localized: Les prix ont tendance à s'effondrer en cas de surplus de marchandises.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291394
    m_Localized: L'info paraîtra demain...
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291395
    m_Localized: Et ça durera environ {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291396
    m_Localized: Et vous allez pouvoir en profiter pendant {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291397
    m_Localized: Et le marché restera dans cet état pendant {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291398
    m_Localized: Et les prix remonteront pas avant {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291399
    m_Localized: J'ai une nouvelle à vous annoncer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291400
    m_Localized: J'ai du scoop tout beau tout chaud !
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291401
    m_Localized: Mon petit doigt m'a dit que ça allait vous plaire...
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291402
    m_Localized: Un groupe de mineurs revient d'un astéroïde riche en minerai.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291403
    m_Localized: Des mineurs vont revenir d'une expédition réussie.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291404
    m_Localized: Le bruit court que des mineurs ont touché le jackpot en trouvant du minerai.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291405
    m_Localized: Une équipe de mineurs est sur le point de rapporter pas mal de minerai.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291406
    m_Localized: Ça veut dire que les prix des matériaux vont chuter quelque temps.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291407
    m_Localized: L'augmentation des stocks va faire s'effondrer le cours des matériaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291408
    m_Localized: Vous devez vous attendre à une baisse sur les prix des matériaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291409
    m_Localized: Cette trouvaille va provoquer une réduction des prix des matériaux.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291410
    m_Localized: Les mineurs seront de retour dans {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291411
    m_Localized: Ça durera environ {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291412
    m_Localized: Dépêchez-vous, parce que ça sera fini dans {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291413
    m_Localized: La situation se stabilisera dans {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291414
    m_Localized: Vous avez environ {0:plural:{} jour|{} jours} pour tirer avantage de la situation.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291415
    m_Localized: Écoutez ça...
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291416
    m_Localized: Dans {0:plural:{} jour|{} jours}, la station d'épuration tombera en panne.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291417
    m_Localized: L'eau viendra à manquer
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291418
    m_Localized: et les prix augmenteront fortement.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291419
    m_Localized: Un retour à la normale sera attendu {0:plural:{} jour|{} jours} plus tard.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291420
    m_Localized: Ouvrez grand vos esgourdes.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291421
    m_Localized: Dans {0:plural:{} jour|{} jours}, des mineurs reviendront avec de l'eau. Vous voyez où je veux en venir ?
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291422
    m_Localized: On va en avoir à profusion.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291423
    m_Localized: Du coup, le cours de l'eau va s'effondrer.
    m_Metadata:
      m_Items: []
  - m_Id: 420216497291424
    m_Localized: Et ce pendant {0:plural:{} jour|{} jours}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902084
    m_Localized: J'ai trouvé ces objets.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902085
    m_Localized: Je suis tombé[g:|e] là-dessus.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902086
    m_Localized: Je suis venu[g:|e] avec ceci.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902087
    m_Localized: Regardez ce que j'ai déniché.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902088
    m_Localized: J'ai mis la main sur quelque chose.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902089
    m_Localized: Vous voulez bien calculer la valeur ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902090
    m_Localized: Vous pouvez me dire ce que ça vaut ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902091
    m_Localized: J'aimerais connaître le prix.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902092
    m_Localized: Quel est le prix courant, vous croyez ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902093
    m_Localized: Vous pensez pouvoir estimer le coût ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902094
    m_Localized: Très bien.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902095
    m_Localized: Marché conclu.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902096
    m_Localized: D'accord.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902097
    m_Localized: Voilà.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902098
    m_Localized: Super.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902099
    m_Localized: Ça me va.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902100
    m_Localized: Ça marche.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902101
    m_Localized: Parfait.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902102
    m_Localized: OK.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902103
    m_Localized: Voilà.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902104
    m_Localized: J'y vais.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902105
    m_Localized: C'est tout pour aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902106
    m_Localized: À une prochaine fois.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902107
    m_Localized: Au plaisir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902108
    m_Localized: Merci, au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902109
    m_Localized: À un de ces jours.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902110
    m_Localized: On en a terminé.
    m_Metadata:
      m_Items: []
  - m_Id: 517302697902111
    m_Localized: Bon courage.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096384
    m_Localized: Je reviens bientôt.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096385
    m_Localized: Bonne journée.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096386
    m_Localized: Je vous laisse.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096387
    m_Localized: Merci et à bientôt.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096388
    m_Localized: Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096389
    m_Localized: Je pense qu'on a fini.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096390
    m_Localized: Ça dépasse mon budget.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096391
    m_Localized: Ça dépasse mon budget. Il me reste seulement {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096392
    m_Localized: J'en ai déjà un exemplaire.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096393
    m_Localized: Je refuse d'acheter de la contrebande.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096395
    m_Localized: Je pense que c'est tout pour moi.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096396
    m_Localized: Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096397
    m_Localized: Mais... j'avais pas terminé !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096398
    m_Localized: '<i>*Tape sur le volet roulant*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096399
    m_Localized: Hé, ça se fait pas !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096400
    m_Localized: Euh, qu'est-ce qui se passe ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096401
    m_Localized: Autre chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096402
    m_Localized: Je pense avoir tout ce qu'il me faut.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096403
    m_Localized: Il y a tout ce que j'avais demandé ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096404
    m_Localized: Je vois que tu t'en sors bien pour l'instant.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096405
    m_Localized: Quand tu auras terminé ta journée...
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096406
    m_Localized: tu devrais faire un petit tour dehors avant d'aller dormir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096407
    m_Localized: Tu te rappelles le chemin jusqu'à la décharge ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096408
    m_Localized: Bonjour. Je passe te voir pour ton premier jour.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096409
    m_Localized: Tu as tout bien préparé, on dirait.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096410
    m_Localized: Je voulais te donner ceci...
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096411
    m_Localized: '*Sort deux feuilles de sa veste et les pose sur le comptoir.*'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096412
    m_Localized: Des pense-bêtes, si tu veux.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096413
    m_Localized: Pense à débarrasser les deux côtés du comptoir, d'accord ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096414
    m_Localized: Comme ça, les clients auront la place pour poser leurs articles.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096415
    m_Localized: Et ne laisse jamais rien sur le côté extérieur avant de fermer ta boutique.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096416
    m_Localized: Sauf si tu aimes te faire voler tes affaires.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096417
    m_Localized: Bonne chance. Je t'ai à l'œil.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096418
    m_Localized: Merci.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096419
    m_Localized: Bonjour.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096420
    m_Localized: J'ai une annonce à te faire.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096421
    m_Localized: Il paraît qu'un groupe d'expédition revient demain...
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096422
    m_Localized: Le marché va crouler sous les matériaux en tous genres.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096423
    m_Localized: Tant que l'offre dépassera la demande, les prix seront au plus bas.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096424
    m_Localized: Essaie d'en tirer parti au maximum.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096425
    m_Localized: Et aussi, tu vas recevoir le journal chaque jour à partir de maintenant. Je t'ai pris un abonnement.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096443
    m_Localized: C'est tout bon.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096444
    m_Localized: Je vous remercie pour votre coopération.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096445
    m_Localized: J'ai trouvé de la contrebande de faible niveau.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096446
    m_Localized: Vous recevez un avertissement.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096447
    m_Localized: Mais faites en sorte que ça ne se reproduise pas.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096448
    m_Localized: Vous avez des produits de contrebande.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096449
    m_Localized: Je vous les confisque.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096450
    m_Localized: Bonne journée.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096451
    m_Localized: Vous possédez des articles volés.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096452
    m_Localized: De la contrebande !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096453
    m_Localized: Je vais inspecter votre boutique.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096454
    m_Localized: Vous avez volé ce produit !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096455
    m_Localized: Donnez-moi accès à vos marchandises et écartez-vous.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096456
    m_Localized: '[Accepter l''inspection]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096457
    m_Localized: '[Soudoyer ({0:plural:{} crédit|{} crédits})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096458
    m_Localized: J'imagine que je peux fermer les yeux...
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096459
    m_Localized: J'ai trouvé des produits de contrebande.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096460
    m_Localized: Votre amende s'élève à {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096461
    m_Localized: Je n'ai pas assez de crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096462
    m_Localized: Dans ce cas, je vous arrête !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096463
    m_Localized: Ils vont vous être confisqués.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096464
    m_Localized: Je vous inflige aussi une amende de {0:plural:{} crédit|{} crédits}, à régler immédiatement.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096465
    m_Localized: '[Payer]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096466
    m_Localized: Je vous remercie pour votre coopération.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096467
    m_Localized: Qu'est-ce que c'est que ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096468
    m_Localized: Je vous arrête pour possession de contrebande.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096469
    m_Localized: En temps normal, j'aurais procédé à votre arrestation.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096470
    m_Localized: Mais vous avez des amis haut placés.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096471
    m_Localized: La prochaine fois, on ne vous loupera pas.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096472
    m_Localized: Tâchez de faire profil bas.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096473
    m_Localized: Ce n'est pas parce que nous tolérons ce genre d'articles qu'ils ne sont pas interdits.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096474
    m_Localized: Pourquoi me montrez-vous ça ?!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096475
    m_Localized: Houlà ! Qu'est-ce que vous faites ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096476
    m_Localized: Vous faites erreur, là !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096477
    m_Localized: Je mérite pas ça !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096478
    m_Localized: Ça veut dire quoi, ça ?!
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096479
    m_Localized: J'ai rien fait du tout !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096480
    m_Localized: Vous vous trompez de personne.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096481
    m_Localized: C'est bon, c'est bon ! Je vais pas résister.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096482
    m_Localized: Pas de bol...
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096483
    m_Localized: Vous m'avez balancé[g:|e] !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096484
    m_Localized: Je voulais juste me faire quelques crédits...
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096485
    m_Localized: HÉ ! C'est quoi ce délire ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096486
    m_Localized: MERDE, MERDE !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096487
    m_Localized: SALE CAFARD !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096488
    m_Localized: JE SUIS INNOCENT[g:|E] !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096489
    m_Localized: GROSSE BALANCE ! VOTRE COMPTE EST BON...
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096490
    m_Localized: TIREZ PAS !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096491
    m_Localized: Venez avec nous.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096492
    m_Localized: Gardez votre calme et suivez-nous.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096493
    m_Localized: Vous faites l'objet d'une enquête. Suivez-nous en silence.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096494
    m_Localized: N'aggravez pas votre cas, d'accord ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096495
    m_Localized: Si vous vous montrez [g:coopératif|coopérative], ça ira plus vite.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096496
    m_Localized: Nous avons quelques questions à vous poser. En route.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096497
    m_Localized: Euh... ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096498
    m_Localized: Je tenais à vous expliquer une chose.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096499
    m_Localized: Notre petit secteur représente un écosystème.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096500
    m_Localized: Si vous ne faites que prendre sans jamais rien donner en retour...
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096501
    m_Localized: vous risquez de rompre l'équilibre et de tout détruire.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096502
    m_Localized: Voilà pourquoi je suis prêt à vous rendre service. Et en échange...
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096503
    m_Localized: vous veillerez sur les strates inférieures de temps à autre.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096504
    m_Localized: Voilà ma carte.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096505
    m_Localized: Appelez-moi si le besoin s'en fait sentir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096543
    m_Localized: Salut. J'aimerais renouveler mon équipement.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096544
    m_Localized: Vous avez des armes, des munitions ou des armures ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096545
    m_Localized: Pas de souci si c'est de la contrebande.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096546
    m_Localized: Bonjour, j'ai des armes à vous proposer.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096547
    m_Localized: Vous voulez les voir ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096548
    m_Localized: Bonjour. Je vends des marchandises hors du commun.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096549
    m_Localized: Je les réserve à mes amis des strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096550
    m_Localized: Et elles valent le coup d'œil.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096551
    m_Localized: Bonjour. J'ai entendu dire que vous étiez quelqu'un de confiance.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096552
    m_Localized: Et si vous examiniez mes produits ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096553
    m_Localized: De mon côté, je ne dirais pas non à un ou deux articles de chimie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096554
    m_Localized: Bonjour. Vous avez maintenant le droit d'acheter chez nous.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096555
    m_Localized: Voici l'équipement que je vends.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096556
    m_Localized: Si vous prenez tout, vous bénéficierez d'une réduction de 15 %.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096560
    m_Localized: Ce secteur est d'un sordide ! J'adore, j'adhère !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096561
    m_Localized: Le coin ne manque pas de charme. Ça fait authentique !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096562
    m_Localized: Je me suis trompé[g:|e] d'ascenseur une fois ou deux, mais ça m'a permis de faire un peu de tourisme.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096563
    m_Localized: Je trouve que ce quartier a du caractère !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096564
    m_Localized: Mon entourage m'a déconseillé de descendre, alors me voilà !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096565
    m_Localized: J'ai vu pas mal de vidéos sur ce genre d'endroits, mais c'est totalement différent en vrai !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096566
    m_Localized: Et du coup... je meurs de faim. Vous auriez pas une spécialité locale à me proposer ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096567
    m_Localized: On m'a dit que je pouvais trouver de quoi m'amuser, ici.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096568
    m_Localized: Vous vendez à boire et à manger ? Et genre... des produits pour évacuer le stress ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096569
    m_Localized: Qu'est-ce que vous avez comme friandises, boissons et autres articles qui favorisent la détente ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096570
    m_Localized: Vous avez des trucs chouettes à boire, à manger et à prendre pour... passer un bon moment ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096571
    m_Localized: Bref, j'aimerais bien manger, boire et... apaiser mon âme ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096576
    m_Localized: Bonjour, je viens d'une autre station. C'est complètement dingue, ici !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096577
    m_Localized: Les gens disent que les strates inférieures sont des coupe-gorges. Pour moi, elles ont juste du piquant.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096578
    m_Localized: J'explore les coins les plus "traditionnels" de la station. J'en prends plein les yeux !
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096579
    m_Localized: Bon, vendez-vous des armes ? J'en veux une qui fait souvenir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096580
    m_Localized: J'adorerais rentrer chez moi avec un souvenir de la vie de quartier. Vous avez des armes ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096581
    m_Localized: Auriez-vous de petites armes que je pourrais facilement encadrer ou exposer chez moi ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302702096582
    m_Localized: Je cherche une arme sympa à montrer à mes amis.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290688
    m_Localized: On m'a dit qu'on trouvait des armes étonnantes, ici. Ça a piqué ma curiosité !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290689
    m_Localized: C'est là que les résidents font leurs emplettes ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290690
    m_Localized: Votre boutique ressemble à celles qu'on voit sur les blogs de voyages !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290691
    m_Localized: C'est une vraie boutique que vous tenez là ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290692
    m_Localized: Ça y est, j'ai trouvé l'une de ces perles rares dont tout le monde parle ?!
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290693
    m_Localized: Vous vendez de la camelote, à tout hasard ? Genre des trucs tout rouillés !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290694
    m_Localized: Je cherche de la ferraille authentique.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290695
    m_Localized: Je veux repartir avec un morceau d'histoire locale ! Même un panneau cassé ferait l'affaire !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290696
    m_Localized: Vous n'auriez pas de ferraille rouillée ? Ça ferait un sujet de conversation d'enfer !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290697
    m_Localized: Et je précise que je préfère la variété.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290698
    m_Localized: Bonjour, je travaille pour la banque alimentaire des strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290699
    m_Localized: Notre association caritative ne peut vous acheter de la nourriture qu'à moitié prix.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290700
    m_Localized: Le cas échéant, nous ne manquerons pas de chanter vos louanges dans toutes les strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290701
    m_Localized: Une fois que nous arriverons à court de crédits, nous accepterons aussi vos dons.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290702
    m_Localized: Vous êtes du genre discret, à ce qu'il paraît.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290703
    m_Localized: Je viens pour des cartes d'accès, des médocs et des armes de corps à corps.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290704
    m_Localized: Disons que j'ai prévu une petite virée dans les strates supérieures.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290705
    m_Localized: Je dois m'équiper pour ma prochaine mission.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290706
    m_Localized: Des armes, des munitions, des armures et des médicaments, s'il vous plaît.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290707
    m_Localized: Vous êtes une référence en la matière, d'après mes contacts.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290744
    m_Localized: Bonjour bonjour. Écoutez, j'ai besoin de vous...
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290776
    m_Localized: Bien, je vous lâche la grappe pour cette fois.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290777
    m_Localized: Au revoir et à la semaine prochaine.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290778
    m_Localized: Nous n'avons pas encore atteint les {0} crédits. Ajoutez des articles.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290779
    m_Localized: Bonjour, je viens acheter à manger.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290780
    m_Localized: J'ai {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290781
    m_Localized: Hé, vous ! Je séjourne dans les strates inférieures pour quelque temps.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290782
    m_Localized: J'aimerais goûter à vos... hum... produits "illicites".
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290783
    m_Localized: Alcool, tabac... qu'importe !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290784
    m_Localized: Bonjour. Je voudrais du poison ou des articles de chimie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290785
    m_Localized: Pour <i>dératiser</i> ma maison.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290786
    m_Localized: Bonjour, je viens acheter à manger.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290787
    m_Localized: J'ai {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290788
    m_Localized: Ah, et je veux des aliments variés.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290789
    m_Localized: Bonjour. J'ai besoin de produits du quotidien.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290790
    m_Localized: '{0:plural:{} crédit|{} crédits}, ça suffira ?'
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290791
    m_Localized: Préparez-moi une sélection d'articles variés.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290792
    m_Localized: Bonjour. Je viens vous vendre ceci.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290793
    m_Localized: Si vous m'achetez le tout, ce sera 15 % moins cher.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290794
    m_Localized: Et je vais vous prendre de l'alcool ou des clopes, si vous en avez.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290795
    m_Localized: C'est pas ce que j'ai demandé.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290796
    m_Localized: Je vais passer une bonne soirée, avec ça.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290797
    m_Localized: Je viens vous acheter de l'alcool et des clopes.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290798
    m_Localized: Allez, c'est d'accord.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290799
    m_Localized: Tenez, des matériaux que j'aimerais vendre.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290800
    m_Localized: Prenez tout et je vous fais une ristourne de 33 %.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290801
    m_Localized: Vous arriverez à les revendre en un clin d'œil.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290802
    m_Localized: Ça roule.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290803
    m_Localized: J'ai des nutrifruits bien frais. Vous les voulez ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290804
    m_Localized: Je viens de cueillir ces nutrifruits. Ils vous tentent ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290805
    m_Localized: Des nutrifruits récoltés à l'aube ! Si vous y mettez le prix, ils sont à vous.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290806
    m_Localized: Je vends des nutrifruits frais. Ça vous dit ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290807
    m_Localized: J'ai cueilli ces nutrifruits à la main. Ça vous intéresserait ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290808
    m_Localized: Ces beautés viennent de sortir de ma ferme hydro.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290809
    m_Localized: Je les dois à mon système hydroponique.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290810
    m_Localized: C'est moi qui les ai fait pousser ! Je parie que ça vous en bouche un coin.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290811
    m_Localized: Vous trouverez pas mieux dans le coin. Regardez donc !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290812
    m_Localized: Ma production est artisanale, sans chichis.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290813
    m_Localized: Salut, je viens vendre des bons alimentaires.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290814
    m_Localized: Si vous avez de la ferraille ou des matériaux, j'achète sans hésiter.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290815
    m_Localized: Vous ne vendriez pas de la ferraille ou des matériaux ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290816
    m_Localized: J'ai besoin de ferraille et de matériaux pour mon nouveau projet. Vous en avez en stock ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290817
    m_Localized: Je ne dirais pas non à de la ferraille et des matériaux en plus.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290818
    m_Localized: Je cherche des matériaux ou de la ferraille. On fait affaire ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290819
    m_Localized: Je peux vous échanger ça contre des modules et autres pièces !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290820
    m_Localized: On va pouvoir faire du troc avec le matériel que j'ai apporté.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290821
    m_Localized: J'ai plein de gadgets ! Que diriez-vous d'un petit échange ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290822
    m_Localized: Regardez un peu l'équipement sur lequel je travaille en ce moment. Ça vous tente ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290823
    m_Localized: Que dites-vous de ça en échange ? J'ai tout testé, et certains appareils fonctionnent !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290825
    m_Localized: Comment allez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290826
    m_Localized: J'ai planché des semaines sur cette commande...
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290827
    m_Localized: Mais ma cliente m'a fait faux bond !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290828
    m_Localized: Voilà pourquoi je vends ma création. Vous pensez pouvoir lui trouver une utilité ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290829
    m_Localized: Salutations, collègue !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290830
    m_Localized: Je suis prêt[g:|e] à vous acheter de tout...
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290831
    m_Localized: tant que ce n'est pas de la contrebande.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290832
    m_Localized: Et j'impose une réduction de {0} % sur le prix de vente.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290833
    m_Localized: Hors marge, bien entendu.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290834
    m_Localized: J'ai un budget de {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290835
    m_Localized: Bonjour.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290836
    m_Localized: J'achète tout type de contrebande.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290837
    m_Localized: Des cartes d'accès, aussi.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290838
    m_Localized: Mais vous devez me faire une réduction sur vos produits.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290839
    m_Localized: J'ai {0:plural:{} crédit|{} crédits} en tout.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290844
    m_Localized: Admirez un peu !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290845
    m_Localized: Tant que j'y suis, je vous prendrais bien du matériel chimique.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290846
    m_Localized: Salut. Je suis là pour vendre mon minerai.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290847
    m_Localized: Bonjour. J'ai extrait du minerai, un peu plus tôt.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290848
    m_Localized: Vous cherchez du minerai ? J'ai trouvé ces morceaux pendant ma dernière expédition.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290849
    m_Localized: J'ai eu un sacré coup de bol au cours de l'expédition. Vous achetez mes trouvailles ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290850
    m_Localized: J'ai du minerai à vendre. Tout juste extrait de la roche !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290851
    m_Localized: Si vous me prenez ce lot, je fais baisser le prix.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290852
    m_Localized: Achetez-moi l'ensemble, que je vous fasse un prix !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290853
    m_Localized: Vous aurez droit à une remise si vous achetez le tout.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290854
    m_Localized: Le lot est en promotion.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290855
    m_Localized: Je veux bien vous vendre le tout à prix réduit.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290857
    m_Localized: J'ai trouvé tout ça en furetant.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290858
    m_Localized: J'ai dégoté de chouettes machins sur mon itinéraire habituel.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290859
    m_Localized: Venez voir ce que j'ai chopé à ma dernière sortie !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290860
    m_Localized: J'ai bien fureté, aujourd'hui. Regardez !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290861
    m_Localized: Ça a du bon, le "farfouillage urbain". Vous voyez un truc intéressant dans le tas ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290862
    m_Localized: J'ai ramassé quelques bricoles qui devraient vous plaire.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290863
    m_Localized: Il y a des chances que mes nouveaux trésors vous tentent.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290864
    m_Localized: Les déchets des uns font le bonheur des autres, à ce qu'on raconte !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290865
    m_Localized: J'ai récupéré pas mal d'objets utiles. Jetez-y un œil.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290866
    m_Localized: Vous voulez faire affaire ? J'ai déniché des trucs pas mal...
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290867
    m_Localized: Achetez-moi le lot et vous ferez de belles économies
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290868
    m_Localized: Je vous ferai un prix sympa pour le tout.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290869
    m_Localized: Si vous me débarrassez de la totalité, vous pourrez économiser quelques crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290870
    m_Localized: Vous aurez droit à un meilleur prix pour l'intégralité des articles.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290871
    m_Localized: Achetez-moi mon stock entier si vous voulez bénéficier d'une réduc'.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290872
    m_Localized: Je vous ferai peut-être une ristourne si vous prenez tous mes articles.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290873
    m_Localized: Achetez le tout si vous aimez payer moins cher.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290874
    m_Localized: Videz mon inventaire pour une jolie ristourne !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290875
    m_Localized: Pour info, ça coûte moins cher d'acheter l'ensemble.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290876
    m_Localized: Si le lot vous intéresse, je baisserai le prix.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290877
    m_Localized: Salut. Je mets diverses marchandises en vente.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290878
    m_Localized: Vous pouvez les regarder sans poser de questions.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290879
    m_Localized: Salut ! Vous pouvez me décharger de ces articles ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290880
    m_Localized: Je vous laisse regarder fissa.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290881
    m_Localized: Salut. On a cambriolé l'intendance hier soir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290882
    m_Localized: Visez notre butin.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290883
    m_Localized: J'ai plusieurs sortes de marchandises pour votre boutique...
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290884
    m_Localized: mais il va falloir payer un supplément.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290885
    m_Localized: Bonjour ! J'ai l'habitude de vendre des produits en tous genres aux boutiques comme la vôtre.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290886
    m_Localized: Mais attention, ils sont plus chers qu'ailleurs.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290887
    m_Localized: Je viendrai vous voir toutes les semaines.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290888
    m_Localized: Je vends de l'eau.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290889
    m_Localized: Si vous achetez tout ce que j'ai, vous gagnerez au change.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290904
    m_Localized: 'Comment avez-vous fait pour mettre autant de crédits de côté ? '
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290905
    m_Localized: Vous m'impressionnez.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290906
    m_Localized: Quoi qu'il en soit, la boutique est maintenant à vous.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290908
    m_Localized: Bonjour. J'aimerais vous proposer quelque chose.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290909
    m_Localized: J'envisage d'installer des distributeurs devant la boutique.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290910
    m_Localized: Ça vous fera un complément de revenus sans avoir à lever le petit doigt.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290911
    m_Localized: En contrepartie, j'augmenterai légèrement le loyer. Qu'en pensez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290919
    m_Localized: Quelqu'un a remarqué un article suspect dans votre vitrine.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290920
    m_Localized: Je viens donc mener une inspection.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290921
    m_Localized: Gardez votre calme.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290922
    m_Localized: Je suis là pour une inspection surprise.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290923
    m_Localized: Bonjour.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290924
    m_Localized: J'aimerais vous vendre du sang.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290925
    m_Localized: Si vous l'acceptez, j'achèterai à boire et à manger chez vous.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290927
    m_Localized: Bonjour !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290928
    m_Localized: Les affaires vont bien, à ce qu'il paraît.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290929
    m_Localized: Je vais vous dire un truc...
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290930
    m_Localized: 'Les banques d''en haut accordent aucun prêt '
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290931
    m_Localized: aux honnêtes gens d'en bas,
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290932
    m_Localized: sous prétexte qu'elles ont peur de prendre des risques.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290933
    m_Localized: On est pas comme ça, nous !
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290934
    m_Localized: On veut vous aider à acheter cette boutique via un emprunt.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290935
    m_Localized: Notre taux d'intérêt est un poil plus élevé que celui des banques, ceci dit.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290936
    m_Localized: Quand vous aurez franchi le seuil des 5 000 crédits, je repasserai chaque dimanche.
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290937
    m_Localized: '[Accepter et payer l''apport initial ({0:plural:{} crédit|{} crédits})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302706290938
    m_Localized: '[Refuser et choisir d''économiser pour un paiement comptant]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484992
    m_Localized: '[Lui demander de repasser dans une semaine]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484993
    m_Localized: On ira pas plus loin tant que tous les versements auront pas été effectués.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484994
    m_Localized: Me revoilà.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484995
    m_Localized: Alors, cet emprunt ? C'est oui ou c'est non ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484996
    m_Localized: Je viens d'acheter la boutique au comptant.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484997
    m_Localized: Ça s'arrête là, alors. Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484998
    m_Localized: Bonjour, je suis de retour.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710484999
    m_Localized: Alors, cet emprunt ? C'est oui ou c'est non ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485000
    m_Localized: Vous allez l'acheter, cette boutique ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485001
    m_Localized: Pour rappel, la propriété vaut actuellement {0} crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485002
    m_Localized: On a négocié le montant de l'apport initial avec votre proprio.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485003
    m_Localized: Il s'élève à {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485006
    m_Localized: Excellent.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485007
    m_Localized: Je reviens la semaine prochaine pour le premier règlement.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485008
    m_Localized: Pas la peine de vous raconter ce qui se passera si vous payez pas...
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485009
    m_Localized: Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485010
    m_Localized: Je comprends. On vous embêtera plus.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485011
    m_Localized: Bonne continuation.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485012
    m_Localized: OK, je reviendrai.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485013
    m_Localized: '[Payer ({0:plural:{} crédit|{} crédits})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485014
    m_Localized: '[Ne pas payer]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485015
    m_Localized: Bonjour, je suis de retour.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485016
    m_Localized: Vous avez mon argent ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485017
    m_Localized: Bien.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485018
    m_Localized: C'était votre dernier versement.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485019
    m_Localized: J'ai été ravi de traiter avec vous.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485020
    m_Localized: La boutique vous appartient enfin.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485021
    m_Localized: Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485022
    m_Localized: C'est bien.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485023
    m_Localized: Je reviens dans une semaine.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485024
    m_Localized: Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485025
    m_Localized: Si vous avez pas de quoi nous payer, on vous prendra des marchandises.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485026
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485027
    m_Localized: Bon, ça fera l'affaire pour aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485028
    m_Localized: Mais oubliez pas votre règlement de la semaine prochaine.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485029
    m_Localized: Si vous avez pas de quoi nous payer, on vous prendra des marchandises.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485030
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485031
    m_Localized: Bon, vous avez plus rien de valeur.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485032
    m_Localized: Je suis obligé de saisir la boutique.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485033
    m_Localized: Faites vos bagages et dégagez.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485034
    m_Localized: Bonjour, je viens acheter des produits pour le service de sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485035
    m_Localized: Nous avons besoin de nourriture et de matériel médical.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485036
    m_Localized: Et quand notre budget sera épuisé, nous accepterons les dons avec joie.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485037
    m_Localized: Je n'aurais jamais imaginé me retrouver ici un jour. Les strates supérieures ne font de cadeau à personne.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485038
    m_Localized: J'ai tout perdu, là-haut. Un concurrent et une mauvaise décision ont suffi à me faire dégringoler.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485039
    m_Localized: Je dois vendre mes objets de valeur.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485040
    m_Localized: Il me faut de l'argent en vitesse. Pourriez-vous m'aider ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485041
    m_Localized: Salutations. J'ai cru comprendre que la période était rude pour ceux d'en bas.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485042
    m_Localized: Nous avons plusieurs choses à donner. Profitez-en.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485043
    m_Localized: Bonjour. Je fais partie du comité de la loterie des strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485044
    m_Localized: C'est la première fois que je vous vois.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485045
    m_Localized: Connaissez-vous un peu notre loterie ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485046
    m_Localized: Une nouvelle combinaison gagnante est révélée chaque samedi matin.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485047
    m_Localized: Si vous décrochez le jackpot, vous passerez le restant de vos jours dans les strates supérieures.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485048
    m_Localized: De plus petits lots sont aussi disponibles.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485049
    m_Localized: Si vous en remportez un, je vous invite à me présenter votre ticket.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485050
    m_Localized: Alors ? Vous allez vous laisser tenter ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485051
    m_Localized: Bonjour bonjour ! Souhaitez-vous acheter des tickets de loterie ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485052
    m_Localized: Le jackpot est énorme !
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485067
    m_Localized: Vous avez à grailler ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485068
    m_Localized: Je cherche un article bien précis. ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485069
    m_Localized: Bonjour. Je viens du comité de commerce.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485070
    m_Localized: Je viens vous prévenir qu'à partir de la semaine prochaine,
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485071
    m_Localized: tous les commerces devront posséder une licence commerciale pour continuer d'exercer leur activité.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485072
    m_Localized: Je peux vous en délivrer une contre {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485073
    m_Localized: Refusez et je vous dénoncerai au service de sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485074
    m_Localized: Mais bien sûr, nous pouvons toujours trouver un <i>arrangement</i>.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485075
    m_Localized: Nous en rediscuterons à ma prochaine visite.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485076
    m_Localized: Sauf si vous achetez votre licence tout de suite.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485077
    m_Localized: Bonjour. Je viens du comité de commerce.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485078
    m_Localized: Une licence commerciale est requise pour votre boutique.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485079
    m_Localized: Je peux vous en délivrer une contre {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485080
    m_Localized: Si vous refusez, je vous dénoncerai au service de sécurité
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485081
    m_Localized: qui vous collera une amende.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485082
    m_Localized: Ce serait dommage d'en arriver là, vous ne pensez pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485083
    m_Localized: Remettez-moi quelques marchandises et j'oublierai tout ça... pour cette semaine.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485084
    m_Localized: Oui, voilà. Si vous me donnez l'équivalent de {0:plural:{} crédit|{} crédits} en produits,
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485085
    m_Localized: je fermerai les yeux.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485086
    m_Localized: Bonjour, me revoilà.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485087
    m_Localized: Allez-vous acheter votre licence commerciale, cette semaine ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485088
    m_Localized: Si vous ne le faites pas, je vais devoir en parler au service de sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485089
    m_Localized: Il vous collera une amende.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485090
    m_Localized: Autrement, l'autre solution tient toujours.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485091
    m_Localized: Si vous me donnez l'équivalent de {0:plural:{} crédit|{} crédits} en produits,
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485093
    m_Localized: '[Acheter la licence ({0:plural:{} crédit|{} crédits})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485094
    m_Localized: Voilà votre licence.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485095
    m_Localized: Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485096
    m_Localized: '[Refuser]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485097
    m_Localized: Alors je n'ai pas d'autre choix que d'appeler le service de sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485098
    m_Localized: Il ouvrira une enquête et vous collera une amende.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485099
    m_Localized: Si vous continuez comme ça, vous risquez de perdre votre boutique.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485100
    m_Localized: Rendez-vous la semaine prochaine.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485101
    m_Localized: '[Ne pas l''acheter maintenant]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485102
    m_Localized: D'accord. À dans sept jours.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485103
    m_Localized: Regardez qui est de retour !
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485104
    m_Localized: Bonjour, j'aimerais vendre ces médicaments...
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485105
    m_Localized: Si on vous demande leur provenance, ne parlez surtout pas de moi.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485106
    m_Localized: '<i>*Finalise la transaction avant de s''enfuir*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485107
    m_Localized: Vous avez des clopes ? Ou une boisson forte ?
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485108
    m_Localized: Ça me plaît bien, ça.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485109
    m_Localized: '[Payer le loyer ({0})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485110
    m_Localized: '[Ne pas payer le loyer]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485111
    m_Localized: '[Racheter la boutique ({0:plural:{} crédit|{} crédits})]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485112
    m_Localized: Bonjour. Si vous n'avez pas mon loyer, c'est fini pour vous !
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485113
    m_Localized: Bonjour, je viens encaisser le loyer.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485114
    m_Localized: Bien. Le montant du prochain loyer s'élève à {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485115
    m_Localized: Ne l'oubliez pas.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485116
    m_Localized: Pardon ?! J'avais pourtant été clair, la dernière fois...
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485117
    m_Localized: Je vais prévenir le service de sécurité. L'heure de votre expulsion a sonné !
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485118
    m_Localized: C'est inadmissible !
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485119
    m_Localized: La semaine prochaine...
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485120
    m_Localized: vous me paierez TOUT l'argent que vous me devez.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485121
    m_Localized: Je ne serai indulgent qu'une seule et unique fois.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485122
    m_Localized: Si vous ne réglez pas votre loyer à ce moment-là, je vous mettrai dehors.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485123
    m_Localized: Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485124
    m_Localized: '[Installer une machine à eau (+150 de loyer hebdomadaire)]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485125
    m_Localized: '[Installer un distributeur (+150 de loyer hebdomadaire)]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485126
    m_Localized: '[Décliner pour l''instant]'
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485127
    m_Localized: Excellente nouvelle ! Je m'occupe de tout.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485128
    m_Localized: À dimanche.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485129
    m_Localized: Bon, je vous laisse y réfléchir.
    m_Metadata:
      m_Items: []
  - m_Id: 517302710485130
    m_Localized: Au revoir.
    m_Metadata:
      m_Items: []
  - m_Id: 8845232842784768
    m_Localized: J'ai de la ferraille à fourguer.
    m_Metadata:
      m_Items: []
  - m_Id: 16989008211787776
    m_Localized: J'achète aussi toutes sortes de graines.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081953751040
    m_Localized: Tu as lu le journal ?
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916864
    m_Localized: Quelque chose cloche avec la dernière série d'implants cérébraux.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916865
    m_Localized: Apparemment, l'IA a tendance à se rebeller et à prendre le contrôle de ses hôtes...
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916866
    m_Localized: Lesdits hôtes se décrivent comme des "humains augmentés". Des "Augs", pour faire court.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916867
    m_Localized: Ils se fondent dans la foule et enlèvent de pauvres gens pour leur greffer un implant.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916868
    m_Localized: Prends ça. Ne t'en fais pas, je me suis occupé de la paperasse.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081978916869
    m_Localized: 'Les directives de la Sécurité sont claires : si un Aug passe par là, tu peux tirer à vue.'
    m_Metadata:
      m_Items: []
  - m_Id: 17116081991499776
    m_Localized: Cette saleté d'IA n'a pas encore perfectionné son imitation des humains.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081991499777
    m_Localized: N'appuie sur la détente que si tu as la conviction d'être face à un Aug.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081991499778
    m_Localized: Pas besoin de contacter le service de sécurité. Les Augs ont piraté le réseau.
    m_Metadata:
      m_Items: []
  - m_Id: 17116081991499779
    m_Localized: Bonne chance.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056013885440
    m_Localized: Eh merde ! L'Aug m'a encore filé entre les doigts ?!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245568
    m_Localized: La prochaine fois que vous croisez un Aug,
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245569
    m_Localized: vous avez intérêt à lui tirer dessus !
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245570
    m_Localized: Ils ont infiltré notre ligne de communication.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245571
    m_Localized: Prudence, d'accord ?
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245572
    m_Localized: On a reçu votre appel.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245573
    m_Localized: Voyons voir votre soi-disant Aug...
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245574
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245575
    m_Localized: Je confirme. C'est bien l'un de ces fichus "humains augmentés".
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245576
    m_Localized: Bravo.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245577
    m_Localized: Allez, on se remet en route. L'Aug vient avec nous.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245578
    m_Localized: Mais vous êtes malade ?!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245579
    m_Localized: Vous venez de tuer quelqu'un ! Une vraie personne !
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245580
    m_Localized: Je vous signale tout de suite !
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245581
    m_Localized: '<i>*Discussion inintelligible via la radio*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245582
    m_Localized: On dirait que vous avez des amis hauts placés.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245583
    m_Localized: Je vais fermer les yeux pour cette fois...
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245584
    m_Localized: Mais mettez-vous dans le crâne que cette arme sert à tuer les Augs. Pas les civils.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245585
    m_Localized: On va de ce pas ouvrir une enquête pour homicide volontaire.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245586
    m_Localized: '[Accepter l''inspection]'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245587
    m_Localized: '[Proposer un pot-de-vin ({0} crédits)]/'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245588
    m_Localized: J'ai {0} crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245589
    m_Localized: Je peux dépenser {0} crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245590
    m_Localized: Mon budget est de {0} crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245591
    m_Localized: 'Solde disponible : {0} crédits.'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245592
    m_Localized: '{0} crédits sont actuellement disponibles pour cette acquisition.'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245593
    m_Localized: 'Fonds alloués à cet achat : {0} crédits.'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245594
    m_Localized: Bonjour. J'ai besoin de {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245595
    m_Localized: C'est pour un ami.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245596
    m_Localized: Salutations. Je recherche des {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245597
    m_Localized: Je refais mes stocks.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245598
    m_Localized: Bonjour. Il me faudrait des {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245599
    m_Localized: Une amie en a besoin.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245600
    m_Localized: Bonjour. Vendez-vous des {0} ?
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245601
    m_Localized: Bonjour. J'ai besoin de {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245602
    m_Localized: Je voudrais acquérir... votre stock.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245603
    m_Localized: Salut. Est-ce que vous avez des {0} en stock ?
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245604
    m_Localized: Cette unité en a b... euh, pardon. J'EN ai besoin.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245605
    m_Localized: Bien le bonjour. Je suis à la recherche de {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245606
    m_Localized: C'est pour l'un des hôt... euh, l'un de mes patients.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245607
    m_Localized: Un ami va bientôt recevoir son augmentation.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245608
    m_Localized: Quelqu'un s'est porté volontaire et en aura bientôt besoin.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245609
    m_Localized: Bonjour. Possédez-vous des {0} ?
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245610
    m_Localized: Le processus d'augmentation requiert une certaine préparation.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245611
    m_Localized: Bonjour. Cette unité souhaite acquérir des {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245612
    m_Localized: J'aide un futur hôte à se préparer.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245613
    m_Localized: Comment allez-vous ? Je recherche des {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245614
    m_Localized: L'opération nécessite divers préparatifs.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245615
    m_Localized: Afin de générer une nouvelle unité.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245616
    m_Localized: L'un des futurs hôt... euh, l'un de mes patients en a besoin.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245617
    m_Localized: Le processus d'augmentation est parfois douloureux.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245618
    m_Localized: 'Initialisation du programme : communication.exe. Bonjour, je suis un être humain !'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245619
    m_Localized: J'ai besoin d'équipement. Un futur hôte attend son augmentation.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245620
    m_Localized: Je possède {0} crédits. Merci de calculer efficacement les montants dus.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245621
    m_Localized: 'Salutations. Voici mon besoin actuel : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245622
    m_Localized: 'Motif : préparation d''un hôte en vue d''une augmentation.'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245623
    m_Localized: 'Budget disponible : {0} crédits. En attente de coopération.'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245624
    m_Localized: Je dois produire une nouvelle série d'unités.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245625
    m_Localized: Mon réseau vous sera reconnaissant.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245626
    m_Localized: Certains matériaux spécifiques sont essentiels à notre expansion.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245627
    m_Localized: Nous avons besoin de nouvelles unités. La production est en cours.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245628
    m_Localized: Bonjour. Merci de me remettre des {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245629
    m_Localized: Ces ressources sont nécessaires à la duplication du modèle.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245630
    m_Localized: Bien le bonjour. Dans le cadre de mes activités, je recherche des {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245631
    m_Localized: La production ne doit pas être enrayée.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245632
    m_Localized: Bonjour. Cette unité a besoin de {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245633
    m_Localized: La production est lancée.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245634
    m_Localized: D'autres unités sont en cours de fabrication.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245635
    m_Localized: La puce sera bientôt prête.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245636
    m_Localized: Salutations. Dans le cadre de la création d'un implant cérébral, des {0} sont requis.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245637
    m_Localized: Le taux de production est trop lent. Le réseau exige davantage d'unités.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245638
    m_Localized: 'Budget disponible : {0} crédits. Initialisation de la transaction.'
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245639
    m_Localized: Communication.exe lancé. Bonjour, je suis une personne normale avec des loisirs normaux !
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245640
    m_Localized: Veuillez me fournir des {0}. La duplication des puces cérébrales est en cours.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245641
    m_Localized: Je possède {0} crédits. Merci de calculer efficacement les montants dus.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245642
    m_Localized: Hé, qu'est-ce que vous faites ?!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245643
    m_Localized: NON ! ATTENDEZ !
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245644
    m_Localized: Rangez ça, voyons !
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245645
    m_Localized: Du calme ! Respirez un bon coup !
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245646
    m_Localized: Je ne veux pas d'embrouilles, moi !
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245647
    m_Localized: Vous me prenez pour un Aug ?!
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245648
    m_Localized: Je suis un être humain, pas un de ces maudits Augs !
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245649
    m_Localized: Ne tirez pas !
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245650
    m_Localized: Je... J'ai très peur. Ne tirez pas, je vous en prie.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245651
    m_Localized: Je ressens... de la peur. Oui. De la peur.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245652
    m_Localized: La panique m'envahit. C'est là une réaction d'être humain normal.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245653
    m_Localized: Mon cœur... tambourine. Comme celui d'un être humain normal.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245654
    m_Localized: Je redoute les armes à feu en raison de mon fragile corps d'être humain.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245655
    m_Localized: Merci de bien vouloir baisser votre arme. Cette situation n'est pas... optimale.
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245656
    m_Localized: fournitures médicales
    m_Metadata:
      m_Items: []
  - m_Id: 18267056043245657
    m_Localized: matériaux
    m_Metadata:
      m_Items: []
  - m_Id: 19593212294119424
    m_Localized: Bonjour. Nos services ont confirmé l'éradication de tous les Augs.
    m_Metadata:
      m_Items: []
  - m_Id: 19593212319285248
    m_Localized: Merci pour votre coopération.
    m_Metadata:
      m_Items: []
  - m_Id: 19593212319285249
    m_Localized: Vous ne devriez plus avoir besoin de votre arme.
    m_Metadata:
      m_Items: []
  - m_Id: 24185067702894592
    m_Localized: Ça fera {0} crédits
    m_Metadata:
      m_Items: []
  - m_Id: 24752663099654144
    m_Localized: Vous pouvez garder l'arme. Pour le moment, du moins.
    m_Metadata:
      m_Items: []
  - m_Id: 24752663145791488
    m_Localized: On peut pas se permettre d'avoir des commerçants désarmés face aux Augs.
    m_Metadata:
      m_Items: []
  - m_Id: 29336952445386752
    m_Localized: Et une nouvelle fournée, rien que pour vous ! Vous trouverez pas plus pur.
    m_Metadata:
      m_Items: []
  - m_Id: 29757499855650816
    m_Localized: Les sorties nocturnes prennent un certain temps.
    m_Metadata:
      m_Items: []
  - m_Id: 29757499893399552
    m_Localized: Tu auras du sommeil à rattraper, alors tu louperas le premier client du lendemain.
    m_Metadata:
      m_Items: []
  - m_Id: 29757499893399553
    m_Localized: Est-ce que tu as remarqué la vitrine, à ta gauche ?
    m_Metadata:
      m_Items: []
  - m_Id: 29757499893399554
    m_Localized: Tu peux installer des <b>articles</b> à l'intérieur pour attirer un type d'<b>acheteur</b> spécifique.
    m_Metadata:
      m_Items: []
  - m_Id: 29757499893399555
    m_Localized: Tu peux aussi y exposer des <b>enseignes néon</b>, qui attirent plutôt des <b>vendeurs<b>. Tiens, cadeau.
    m_Metadata:
      m_Items: []
  - m_Id: 29757499893399556
    m_Localized: Place les enseignes bien en vue et jette un œil à l'interface de la clientèle pour te faire une idée des profils attendus. N'oublie pas de préparer ta vitrine avant d'ouvrir le volet !
    m_Metadata:
      m_Items: []
  - m_Id: 29829888404668416
    m_Localized: Prends le temps de peser le pour et le contre. Rien ne t'oblige à sortir toutes les nuits.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411756527616
    m_Localized: Bon. Je t'ai enseigné toutes les bases.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887744
    m_Localized: L'avenir est entre tes mains.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887745
    m_Localized: N'oublie pas d'investir dans des améliorations, d'acheter de nouvelles machines et de développer ton réseau.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887746
    m_Localized: Une fois que tu auras plus de crédits, tu pourras faire un emprunt...
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887747
    m_Localized: ou racheter la boutique directement, qui sait ?
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887748
    m_Localized: La valeur de la propriété est indiquée dans ton calendrier.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887749
    m_Localized: Bonne chance.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887750
    m_Localized: Bonjour ! Ça fait un petit moment que je n'ai plus de nouvelles.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887751
    m_Localized: Et si j'en crois le Pr Jackson, il n'en a pas davantage.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887752
    m_Localized: En cas de besoin, n'oubliez pas que nous sommes là pour vous aider.
    m_Metadata:
      m_Items: []
  - m_Id: 30060411785887753
    m_Localized: Jetez un œil à ce que je propose...
    m_Metadata:
      m_Items: []
  - m_Id: 36236928886816768
    m_Localized: Ça, c'est une bonne affaire. Merci.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176896
    m_Localized: Quelle générosité ! C'est bon pour moi.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176897
    m_Localized: Merci. C'était un plaisir de faire affaire avec vous.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176898
    m_Localized: Vous avez un cœur en or, vous ! Merci.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176899
    m_Localized: Incroyable. Je saurai m'en souvenir.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176900
    m_Localized: Vous plaisantez ? Non ?! Alors vendu ! À ce prix, c'est inespéré.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176901
    m_Localized: ... Bon, bon. D'accord.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176902
    m_Localized: Pff... Allez, ça ira pour cette fois.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176903
    m_Localized: J'espérais mieux, mais je ferai avec.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176904
    m_Localized: Avec tout ce qui se passe... j'ai pas trop le choix. Adjugé.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176905
    m_Localized: C'est pas comme si je pouvais faire la fine bouche, de toute façon.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176906
    m_Localized: Marché conclu. Les temps sont durs.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176907
    m_Localized: Proposition enregistrée. Calcul en cours... Demande acceptée.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176908
    m_Localized: Calcul du résultat optimal terminé. Offre validée.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176909
    m_Localized: Affirmatif. La logique m'impose d'accepter votre proposition.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176910
    m_Localized: Pfouah, vous vous mouchez pas du coude... mais c'est d'accord.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176911
    m_Localized: Vous exagérez. Mais vous êtes ma seule option... alors adjugé.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176912
    m_Localized: OK. C'est pas de gaieté de cœur, mais j'ai pas le choix.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176913
    m_Localized: Alors là, non merci.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176914
    m_Localized: Très peu pour moi.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928916176915
    m_Localized: Et puis quoi encore ? Il va falloir faire mieux que ça.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371200
    m_Localized: Hors de question. À ce prix, ce serait du vol.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371201
    m_Localized: Oh que non. Trouvez-vous un autre pigeon.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371202
    m_Localized: Vous avez perdu la tête ? Hors de question.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371203
    m_Localized: Laissez tomber. Je m'en vais.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371204
    m_Localized: Je crois qu'on s'est tout dit.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371205
    m_Localized: Ça suffit. Je me tire.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371206
    m_Localized: Mon budget vous dit merci ! Je vais pouvoir acheter plus de choses.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371207
    m_Localized: Avec ces économies, je vais pouvoir faire plus d'emplettes.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371208
    m_Localized: Avec tout ça, il me reste des crédits. Qu'est-ce que vous vendez d'autre ?
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371209
    m_Localized: C'est une bonne partie de mon budget du jour... Je vais devoir freiner, après ça.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371210
    m_Localized: Je vais devoir serrer la ceinture.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371211
    m_Localized: Je vais devoir me priver pour compenser ce trou dans mon budget.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371212
    m_Localized: Cette boutique est tenue par une vipère, et je n'hésiterai pas à le crier sur les toits.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371213
    m_Localized: Honteux. Je vais raconter votre accueil à tout le monde, croyez-moi.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371214
    m_Localized: Les nouvelles vont vite, vous savez ? Bonne chance pour trouver des clients, après ça.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371215
    m_Localized: Comment osez-vous ?! Je respecte la loi au doigt et à l'œil !
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371216
    m_Localized: Je n'ai rien à me reprocher. Essayez d'intimider quelqu'un d'autre, la prochaine fois.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371217
    m_Localized: Vous faites erreur sur toute la ligne. C'est très insultant !
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371218
    m_Localized: Qu'est-ce que vous racontez ? Je n'ai rien à voir avec les Augs, voyons !
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371219
    m_Localized: Moi, une IA ? Ressaisissez-vous. J'apprécie moyennement vos accusations.
    m_Metadata:
      m_Items: []
  - m_Id: 36236928920371220
    m_Localized: N'importe quoi. Ces jugements à l'emporte-pièce pourraient vous jouer des tours.
    m_Metadata:
      m_Items: []
  - m_Id: 45046653959061504
    m_Localized: Votre boutique n'est pas la porte d'à côté, alors je vais faire court.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071261642752
    m_Localized: Je viens vous voir parce que j'organise une petite sauterie.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002880
    m_Localized: On m'a dit que vous vendiez de quoi passer un bon moment. C'est vrai ?
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002881
    m_Localized: Je prends tout. Boissons, fumette, drogue...
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002882
    m_Localized: Je veux de la bonne, et je peux y mettre le prix.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002883
    m_Localized: Alors, qu'est-ce que vous proposez pour rendre une soirée inoubliable ?
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002884
    m_Localized: J'ai {0} crédits. Allez, impressionnez-moi.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002885
    m_Localized: Je peux dépenser {0} crédits. La qualité, ça se paie.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002886
    m_Localized: Voilà {0} crédits. Vous avez intérêt à me fourguer du haut de gamme.
    m_Metadata:
      m_Items: []
  - m_Id: 40582071291002887
    m_Localized: C'est de la gnognotte. Arrêtez de me faire perdre mon temps.
    m_Metadata:
      m_Items: []
  - m_Id: 45046653992615936
    m_Localized: Ah, bien. C'est exactement ce qu'il me faut.
    m_Metadata:
      m_Items: []
  - m_Id: 45046653992615937
    m_Localized: Bonjour. J'ai entendu dire que vous étiez en petite forme...
    m_Metadata:
      m_Items: []
  - m_Id: 45046653992615938
    m_Localized: Les entreprises locales comme la vôtre sont la clé de voûte de notre communauté.
    m_Metadata:
      m_Items: []
  - m_Id: 45046653992615939
    m_Localized: Alors je vais vous donner un coup de pouce. Des faveurs gratuites, ça vous tente ?
    m_Metadata:
      m_Items: []
  - m_Id: 45046653992615940
    m_Localized: Regardez ce que je propose.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589267685376
    m_Localized: Ça me convient.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239808
    m_Localized: Pas de problème. C'est tout à fait raisonnable.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239809
    m_Localized: Entendu. Le coût m'importe peu.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239810
    m_Localized: Bien. L'aspect financier n'est pas un frein.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239811
    m_Localized: L'objectif final justifie les pertes financières. Demande acceptée.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239812
    m_Localized: Les implications monétaires ne constituent pas un obstacle. Transaction validée.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239813
    m_Localized: L'acquisition de ressources prend le pas sur l'aspect économique. Cette unité accepte la transaction.
    m_Metadata:
      m_Items: []
  - m_Id: 45351589301239814
    m_Localized: La valeur monétaire est une construction arbitraire. Transaction validée.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327783735296
    m_Localized: Bonjour ! Dites, je constate que vous ne m'avez toujours pas téléphoné...
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621376
    m_Localized: N'oubliez pas que j'attends votre coup de fil.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621377
    m_Localized: Mon réseau vous serait très, très utile.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621378
    m_Localized: Auprès de mes contacts, vous pourriez apprendre l'hydroponie, la purification d'eau, la viniculture, et j'en passe !
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621379
    m_Localized: Appelez-moi quand vous voudrez élargir vos horizons.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621380
    m_Localized: J'ai remarqué que ta vitrine était toujours assez vide, alors je viens te faire une piqûre de rappel.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621381
    m_Localized: Les enseignes néon attirent des <b>vendeurs</b>.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621382
    m_Localized: Les articles en exposition, eux, attirent des <b>acheteurs</b>.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621383
    m_Localized: Si tu exposes plusieurs articles d'un type spécifique, leur valeur cumulée permet d'attirer des acheteurs plus riches.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621384
    m_Localized: Essaie de faire un mélange d'enseignes et d'articles.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621385
    m_Localized: Et n'oublie pas de préparer ta vitrine <b>avant</b> d'ouvrir le volet roulant.
    m_Metadata:
      m_Items: []
  - m_Id: 45694327867621386
    m_Localized: Ce que tu ajoutes après l'ouverture ne prendra effet que le lendemain.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301099466752
    m_Localized: Le niveau de pureté est plus haut que ce que vous pensez.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604096
    m_Localized: C'est fou, ça ! Merci de me l'avoir dit.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604097
    m_Localized: Vous vous payez ma tête ? C'est de l'amidon de nutrifruit, ni plus ni moins.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604098
    m_Localized: C'est de la daube, votre truc.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604099
    m_Localized: Roh, d'accord. Je vous fais une ristourne.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604100
    m_Localized: Le niveau de pureté ne colle pas.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604101
    m_Localized: Compris. Je vais faire un geste.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604102
    m_Localized: D'après mes tests, votre produit est basique, sans plus.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604103
    m_Localized: Votre produit est de qualité quasi-labo, mais pas au-delà.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604104
    m_Localized: On est face à une qualité labo, mais pas cristal.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604105
    m_Localized: Je l'ignorais. Le prix va suivre, bien sûr.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604106
    m_Localized: Le degré de pureté chimique est incorrect.
    m_Metadata:
      m_Items: []
  - m_Id: 47224301145604107
    m_Localized: Je vais ajuster le prix en conséquence.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966220115968
    m_Localized: Très bien.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059008
    m_Localized: C'est pas ce que j'ai demandé.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059009
    m_Localized: 'Troc : {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059010
    m_Localized: Cette eau est moins pure que ce que prétend son étiquette !
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059011
    m_Localized: Ça vous parle, l'honnêteté intellectuelle ? Cette eau n'est pas pure !
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059012
    m_Localized: L'étiquette est mensongère. Moi qui pensais que cette boutique était fiable...
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059013
    m_Localized: Vous vous fichez de moi ? Remballez votre jus d'égout.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059014
    m_Localized: Non mais je rêve... C'est de l'eau-de-rouille, ça.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059015
    m_Localized: Mon test confirme qu'il s'agit d'eau spectrale.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059016
    m_Localized: Mon test confirme que cette eau est basique.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059017
    m_Localized: C'est de l'eau raffinée, certes, mais pas pure. Vous essayez de m'arnaquer ?
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059018
    m_Localized: L'injecteur est inutilisable. Vous ne pouvez pas nous vendre vos ordures !
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059019
    m_Localized: Cet injecteur est périmé.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059020
    m_Localized: L'étiquette est fausse.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059021
    m_Localized: C'est pas de la qualité cristal, mais labo.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059022
    m_Localized: Vous tentez de me vendre un produit de qualité quasi-labo.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059023
    m_Localized: Ce produit est basique, au mieux.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059024
    m_Localized: Votre came est coupée !
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059025
    m_Localized: Immonde. Même les pires junkies refuseraient de toucher à cette horreur.
    m_Metadata:
      m_Items: []
  - m_Id: 47469966262059026
    m_Localized: C'est de l'amidon de nutrifruit...
    m_Metadata:
      m_Items: []
  - m_Id: 50362190297612288
    m_Localized: Je m'ennuyais, alors j'ai décidé de faire quelques emplettes.
    m_Metadata:
      m_Items: []
  - m_Id: 50362190322778112
    m_Localized: Montrez-moi vos produits les plus raffinés !
    m_Metadata:
      m_Items: []
  - m_Id: 53229185904984064
    m_Localized: Comment va ? J'espère que tu n'as pas oublié qu'en ce bas monde, tout se négocie.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538496
    m_Localized: Tu peux <b>marchander</b> avec tes clients, qu'il s'agisse de proposer une remise à un acheteur ou d'en demander une à un vendeur.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538497
    m_Localized: Quand tu proposes des ristournes, ta réputation auprès de la faction du client augmente.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538498
    m_Localized: En plus, tu lui permets d'économiser, donc de t'acheter plus de choses.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538499
    m_Localized: Si c'est toi qui demandes une remise à un vendeur, vos transactions te feront perdre de la réputation auprès de sa faction.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538500
    m_Localized: Ce vendeur aura aussi moins de crédits à dépenser, s'il envisageait de t'acheter des choses.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538501
    m_Localized: Les clients ne refusent jamais les offres qui leur sont bénéfiques. Dans le cas contraire, c'est ta réputation qui influence leur décision.
    m_Metadata:
      m_Items: []
  - m_Id: 53229185938538502
    m_Localized: Essaie de marchander avec la prochaine personne qui se présentera !
    m_Metadata:
      m_Items: []
  - m_Id: 62674878042259456
    m_Localized: Je ne peux pas me permettre d'acheter des articles de luxe.
    m_Metadata:
      m_Items: []
  - m_Id: 75703065789644800
    m_Localized: De la contrebande sur votre comptoir !
    m_Metadata:
      m_Items: []
  - m_Id: 75703065827393536
    m_Localized: Des objets volés sur votre comptoir !
    m_Metadata:
      m_Items: []
  - m_Id: 75703065827393537
    m_Localized: De la contrebande dans votre vitrine !
    m_Metadata:
      m_Items: []
  - m_Id: 75703065827393538
    m_Localized: Des objets volés dans votre vitrine !
    m_Metadata:
      m_Items: []
  - m_Id: 77669637500485632
    m_Localized: Vous êtes malade ?! Je refuse de boire ça !
    m_Metadata:
      m_Items: []
  - m_Id: 77669637538234368
    m_Localized: Je toucherai pas à cette eau ! Vous voulez ma mort ?!
    m_Metadata:
      m_Items: []
  - m_Id: 77669637538234369
    m_Localized: L'eau spectrale, c'est trop risqué.
    m_Metadata:
      m_Items: []
  - m_Id: 77669637538234370
    m_Localized: Vous ne me ferez pas boire ça.
    m_Metadata:
      m_Items: []
  - m_Id: 77672419972399104
    m_Localized: '[Prêter {0:plural:{} crédit|{} crédits}]'
    m_Metadata:
      m_Items: []
  - m_Id: 77672419976593408
    m_Localized: '[Refuser]'
    m_Metadata:
      m_Items: []
  - m_Id: 85295897668009984
    m_Localized: Ma priorité, c'est la précision.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564416
    m_Localized: Ma priorité, c'est une bonne puissance de feu.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564417
    m_Localized: Ma priorité, c'est la taille. Intimidation garantie.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564418
    m_Localized: Vous auriez quelque chose de très précis ? Avec un silencieux, peut-être ?
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564419
    m_Localized: J'aimerais quelque chose d'esthétique.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564420
    m_Localized: L'arme doit être fiable. Un silencieux serait un plus.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564421
    m_Localized: L'arme doit être intimidante. Plus elle est grande, mieux c'est.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564422
    m_Localized: Rien de trop tape-à-l'œil. Un flingue qui tire droit et ne se bloque pas, quoi.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564423
    m_Localized: Je cherche une arme de poing équilibrée.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564424
    m_Localized: Une arme sans faiblesses. Chaque détail bien senti fera grimper le prix.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564425
    m_Localized: Si vous avez une arme au corps à corps, je peux dépenser {0} crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564426
    m_Localized: Je cherche une arme en {0} de qualité. J'y mettrai le prix, et même davantage.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564427
    m_Localized: Vous auriez des munitions en {0} pour aller avec ?
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564428
    m_Localized: Je cherche aussi un plan B pour les combats rapprochés.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564429
    m_Localized: '{0} et compagnie... Vous avez ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564430
    m_Localized: Je peux encore dépenser {0} crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 85295897701564431
    m_Localized: Il me faut quelque chose de très maniable et ergonomique.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944594010112
    m_Localized: Votre récent travail d'estimation a attiré l'attention du comité.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370240
    m_Localized: Nous voudrions vous promouvoir au rang d'{0}.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370241
    m_Localized: Vos estimations vous rapporteront davantage, mais le comité sera également plus strict sur la qualité de votre travail.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370242
    m_Localized: Vous aurez aussi la possibilité d'estimer de nouveaux types d'objets.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370243
    m_Localized: La certification coûte {0} crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370244
    m_Localized: '[Décliner pour toujours]'
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370245
    m_Localized: Félicitations ! Voilà votre nouveau certificat.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370246
    m_Localized: Et voici de quoi vous entraîner à estimer les nouveaux objets.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370247
    m_Localized: À partir de maintenant, la clientèle devrait se montrer plus exigeante.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370248
    m_Localized: Bien. Je reviendrai la semaine prochaine.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370249
    m_Localized: Je vois. Dans ce cas, le comité ne vous embêtera plus.
    m_Metadata:
      m_Items: []
  - m_Id: 87488944623370250
    m_Localized: Votre certificat actuel demeure valable.
    m_Metadata:
      m_Items: []
  - m_Id: 87495551897878528
    m_Localized: Les gens causent, sur le marché noir. J'ai entendu parler de votre syndrome de la sentinelle effondrée...
    m_Metadata:
      m_Items: []
  - m_Id: 87495551897878529
    m_Localized: J'ai ce qu'il vous faut. Par contre, le prix grimpe tous les jours.
    m_Metadata:
      m_Items: []
  - m_Id: 87495551897878530
    m_Localized: Toujours en vie, à ce que je vois...
    m_Metadata:
      m_Items: []
  - m_Id: 87495551897878531
    m_Localized: Mes prix ont augmenté depuis la semaine dernière.
    m_Metadata:
      m_Items: []
  - m_Id: 87495551897878532
    m_Localized: À la semaine prochaine. Essayez de pas calancher d'ici là.
    m_Metadata:
      m_Items: []
  - m_Id: 88850639862153216
    m_Localized: Vous pourriez travailler sur mon arme ({0}) ? Je voudrais qu'elle soit meilleure. Je paie les pièces que vous y montez.
    m_Metadata:
      m_Items: []
  - m_Id: 88850639891513344
    m_Localized: Cette étiquette ment. Je le compte pour ce qu'il est vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 88850639891513345
    m_Localized: Salut, j'ai besoin de ravitaillement.
    m_Metadata:
      m_Items: []
  - m_Id: 88850639891513346
    m_Localized: On passe bientôt à l'action.
    m_Metadata:
      m_Items: []
  - m_Id: 88850639891513347
    m_Localized: T'as des armes et des médocs ?
    m_Metadata:
      m_Items: []
  - m_Id: 89343935436865536
    m_Localized: Vous ! C'est vous qui m'avez dénoncé !
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254144
    m_Localized: Le service de sécurité m'a gardé deux jours avant de comprendre qu'il s'était trompé de personne.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254145
    m_Localized: Je vous avais dit que ce n'était pas moi, et vous m'avez quand même dénoncé !
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254146
    m_Localized: Je veux juste faire mes courses.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254147
    m_Localized: Alors, vous me vendez à manger, cette fois ?
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254148
    m_Localized: Encore ?! Mais pourquoi ?!
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254149
    m_Localized: Bonjour ! Elle vous plaît, la nouvelle déco ?
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254150
    m_Localized: Voilà ce que ça coûte de me dénoncer sans raison.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254151
    m_Localized: Bon courage pour nettoyer tout ça !
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254152
    m_Localized: Hé, vous me connaissez ! Vous vous trompez de personne !
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254153
    m_Localized: Vous êtes en état d'arrestation pour vandalisme.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254154
    m_Localized: Attendez, attendez ! Ne me dénoncez pas, s'il vous plaît !
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254155
    m_Localized: Je peux continuer à vous apporter de la nourriture pas chère, promis.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254156
    m_Localized: Vous ne le regretterez pas.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254157
    m_Localized: Même marché que la dernière fois, si ça vous dit.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254158
    m_Localized: Attendez, je vous en prie !
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254159
    m_Localized: Laissez-moi partir, et je vous donnerai ma formule dès qu'elle sera au point !
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254160
    m_Localized: Merci. Vous venez peut-être de sauver beaucoup de gens d'une overdose d'Oxymore.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254161
    m_Localized: Bonjour, c'est encore moi.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254162
    m_Localized: Mes recherches sont presque terminées, mais il me faut du matériel chimique.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254163
    m_Localized: Le service de sécurité me cherche toujours partout.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254164
    m_Localized: Aidez-moi, et je partagerai la formule avec vous.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254165
    m_Localized: Vous en avez sous la main ? Sinon, je peux repasser dans une semaine.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254166
    m_Localized: Plus vous m'en donnez, plus vite j'aurai fini.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254167
    m_Localized: C'est largement suffisant, merci !
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254168
    m_Localized: Je reviens dès que c'est terminé.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254169
    m_Localized: Bonjour ! J'ai réussi, c'est terminé !
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254170
    m_Localized: Merci de m'avoir aidé, et de ne pas m'avoir dénoncé.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254171
    m_Localized: Je vais essayer de quitter la station et de rendre mes recherches publiques.
    m_Metadata:
      m_Items: []
  - m_Id: 89343935445254172
    m_Localized: Voici la formule.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047478210560
    m_Localized: Vous voulez vraiment faire ça, l'ami ?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736512
    m_Localized: De la viande aussi fraîche, ça ne se trouve pas facilement. Il y a toujours quelqu'un qui en paie le prix.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736513
    m_Localized: J'apporte la viande, vous la vendez. Personne n'a besoin de savoir d'où elle vient.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736514
    m_Localized: Personne ne me garde bien longtemps. Quand je sortirai, je reviendrai chercher votre viande.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736515
    m_Localized: Merde ! Il est énorme, ce type ! Envoyez du renfort !
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736516
    m_Localized: Re-bonjour. Me revoilà, avec de la viande fraîche.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736517
    m_Localized: Salut, il paraît que vous avez un problème avec {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736518
    m_Localized: Ce type cause aussi des ennuis à mon équipe.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736519
    m_Localized: Que diriez-vous de mettre {0} crédits au pot ? On s'occupe du problème pour vous.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736520
    m_Localized: Vous pourrez payer au terminal des <b>services nocturnes</b> quand bon vous semble.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736521
    m_Localized: Attendez, ne me dénoncez pas !
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736522
    m_Localized: Je n'ai presque plus rien à voir avec la Révolution.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736523
    m_Localized: Si vous me laissez partir, je glisserai un mot en votre faveur auprès des jeunes de la Révolution.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736524
    m_Localized: Merci.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736525
    m_Localized: Attendez, ne faites pas ça.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736526
    m_Localized: Si vous ne me dénoncez pas, je pourrai continuer à vous apporter du matériel de la Sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736527
    m_Localized: Je suis sûr que vous trouverez des acheteurs prêts à y mettre le prix.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736528
    m_Localized: Salut, me revoilà.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736529
    m_Localized: J'ai récupéré du matériel de la Sécurité... en « surplus ».
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736530
    m_Localized: Ça vous intéresse ?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736531
    m_Localized: Remarquez, des outils feraient aussi l'affaire.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736532
    m_Localized: Une torche à plasma, ou un tournevis, peut-être ?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736533
    m_Localized: Bien dormi, la marmotte ?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736534
    m_Localized: Pendant que vous dormiez, j'ai caché un petit cadeau quelque part dans vos affaires.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736535
    m_Localized: À minuit, il fait boum. Tic-tac !
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736536
    m_Localized: Trouvez-le avant d'aller vous coucher, petit nutrifruit. <i>*Clin d'œil*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736537
    m_Localized: Coucou, petit nutrifruit ! Elle vous a plu, ma « bombe » ?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736538
    m_Localized: Si vous aviez vu votre tête ! <i>*Pouffe*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736539
    m_Localized: Bref, j'ai quelques affaires à régler.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736540
    m_Localized: Vous pourriez garder mon coffre à jouets un petit moment ?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736541
    m_Localized: Et ne touchez à rien à l'intérieur, sinon... <i>*Clin d'œil*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736542
    m_Localized: Merci !
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736543
    m_Localized: Coucou, me revoilà ! Je vous ai manqué ?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736544
    m_Localized: Je viens récupérer mes affaires.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736545
    m_Localized: Quelqu'un a jeté un petit coup d'œil dans mon coffre, hein ?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736546
    m_Localized: Oh, ne faites pas cette tête de coupable, vilain petit nutrifruit.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736547
    m_Localized: Une fille a bien le droit d'avoir ses petits passe-temps.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736548
    m_Localized: La prochaine fois, je vous montrerai peut-être comment ils marchent. À très vite ! <i>*Clin d'œil*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736549
    m_Localized: Vous n'avez même pas jeté un petit coup d'œil ?
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736550
    m_Localized: Quel gentil petit nutrifruit. Je vous croquerais bien.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736551
    m_Localized: À très vite !
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736552
    m_Localized: Hmm ? Il manque quelque chose.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736553
    m_Localized: Je vous avais dit de ne pas toucher à mes jouets, petit nutrifruit.
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736554
    m_Localized: Les vilains petits nutrifruits sont punis. <i>*Clin d'œil*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 89676047532736555
    m_Localized: Voici un autre petit cadeau. Celui-là, il est bien réel. Bye bye !
    m_Metadata:
      m_Items: []
  - m_Id: 89710422362210304
    m_Localized: Bonjour, mon ami ! C'est votre jour de chance !
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404608
    m_Localized: Georgio s'est offert un sac à dos tout neuf, alors l'ancien doit partir.
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404609
    m_Localized: Grosse réduction, rien que pour vous !
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404610
    m_Localized: Bonjour, mon ami.
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404611
    m_Localized: Comme vous le savez, Georgio est le plus grand fureteur de tous les temps.
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404612
    m_Localized: Alors pourquoi ne pas donner un coup de main aux autres fureteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404613
    m_Localized: Georgio propose désormais son aide à la décharge.
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404614
    m_Localized: Vous voulez essayer ? {0:plural:{} crédit|{} crédits} pour {1:plural:{} nuit|{} nuits} d'aide !
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404615
    m_Localized: '[Accepter ({0:plural:{} crédit|{} crédits})]'
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404616
    m_Localized: Excellent ! Georgio vous retrouve ce soir à la décharge.
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404617
    m_Localized: Avec Georgio dans les parages, personne ne se blesse !
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404618
    m_Localized: Pas de souci, mon ami. Une prochaine fois, peut-être !
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404619
    m_Localized: Mon ami ! Georgio se lance dans une nouvelle affaire !
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404620
    m_Localized: Georgio a toujours de la chance, alors pourquoi ne pas en vendre un peu ?
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404621
    m_Localized: Voici la Chance liquide ! La première est offerte !
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404622
    m_Localized: Bonjour, mon ami ! Alors, cette Chance liquide, elle vous a plu ?
    m_Metadata:
      m_Items: []
  - m_Id: 89710422366404623
    m_Localized: Georgio a un dernier lot à vendre. Profitez-en tant qu'il en reste !
    m_Metadata:
      m_Items: []
  - m_Id: 90055627569414144
    m_Localized: Alter, t'as un truc à ouvrir ?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774272
    m_Localized: Genre caisse ou carte d'accès ?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774273
    m_Localized: Trouves-en le plus possible, je reviens les acheter dans une semaine.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774274
    m_Localized: Hallo, t'as les caisses ou les cartes ?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774275
    m_Localized: Alter, on en ouvre une tout de suite !
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774276
    m_Localized: GOLD GOLD GOLD
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774277
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774278
    m_Localized: Scheiße !
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774279
    m_Localized: Mon ami ! J'ai quelque chose pour vous.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774280
    m_Localized: J'ai trouvé un jeune homme à la décharge.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774281
    m_Localized: Il m'a demandé de vous apporter cette lettre. Je ne l'ai pas lue. Enfin, pas beaucoup.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774282
    m_Localized: Re-bonjour, stationaute.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774283
    m_Localized: Le cadet Serpico a de nouveau été aperçu dans les strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774284
    m_Localized: La récompense pour sa capture est passée à {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774285
    m_Localized: Nous comptons sur vous.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774286
    m_Localized: C'est moi, Serpico !
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774287
    m_Localized: Les preuves ont été publiées. Toute la station les a lues.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774288
    m_Localized: Quelques agents de bas rang sont poursuivis. Ceux d'en haut s'en sont tirés sans une égratignure.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774289
    m_Localized: Alors j'ai rejoint la Révolution. Si le système refuse de faire le ménage, on le fera nous-mêmes.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774290
    m_Localized: Merci pour tout.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774291
    m_Localized: C'est moi, Serpico ! De retour en uniforme.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774292
    m_Localized: L'officier que vous m'avez recommandé a porté les preuves jusqu'au sommet.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774293
    m_Localized: Des agents de tous les grades sont poursuivis, même les plus haut placés.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774294
    m_Localized: Et j'ai été muté dans la nouvelle brigade anticorruption.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774295
    m_Localized: Merci. La Sécurité vous doit une fière chandelle.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774296
    m_Localized: C'est moi, Serpico !
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774297
    m_Localized: Le marché noir a bien payé pour les preuves.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774298
    m_Localized: Assez pour sortir ma famille des strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774299
    m_Localized: On quitte la station pour de bon.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774300
    m_Localized: Avant de partir, je veux vous laisser quelque chose. Prenez ce dont vous avez besoin.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774301
    m_Localized: Prenez soin de vous.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774302
    m_Localized: Adieu, et merci.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774303
    m_Localized: '[Révolution] : Le remettre à la Révolution'
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774304
    m_Localized: La Révolution... Travailler avec l'ennemi ?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774305
    m_Localized: Mais c'est peut-être ce qu'il faut pour secouer cette station.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774306
    m_Localized: D'accord. Je trouverai un moyen de le leur faire parvenir. Merci de m'avoir écouté.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774307
    m_Localized: '[Marché noir] : Le vendre et partir'
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774308
    m_Localized: Le marché noir paierait cher pour ça.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774309
    m_Localized: Assez pour sortir ma famille des strates inférieures.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774310
    m_Localized: Ce n'est pas la justice, mais au moins ma famille sera en sécurité.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774311
    m_Localized: '[Sécurité ({0} de réputation requise)] : Le remettre à un haut gradé de confiance'
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774312
    m_Localized: Vous lui faites confiance ? Avec son nom derrière, ça pourrait vraiment tenir.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774313
    m_Localized: C'est la bonne façon de faire. Je le remettrai demain matin. Merci, vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774314
    m_Localized: C'est moi, Serpico ! Merci pour la nourriture que vous m'avez laissée.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774315
    m_Localized: Je n'ai pas chômé depuis la dernière fois. J'ai épluché toutes les preuves que j'avais emportées en partant.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774316
    m_Localized: Tout est rassemblé maintenant.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774317
    m_Localized: Mais je ne peux pas débarquer avec ça dans un bureau de la Sécurité, et je ne sais pas à qui d'autre me fier sur cette station.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774318
    m_Localized: Derrière ce comptoir, vous entendez tout.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774319
    m_Localized: 'Alors je vous pose la question : à qui devrais-je remettre ce document ?'
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774320
    m_Localized: Mais enfin, petit nutrifruit, c'est moi, Lou !
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774321
    m_Localized: Hahaha, je n'arrive pas à croire que ça ait marché.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774322
    m_Localized: Haha, pas mal. Vous avez tout de suite vu clair dans mon jeu.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627598774323
    m_Localized: Quel coup d'œil, petit nutrifruit. De l'esprit et du charme ? Attention, je pourrais finir par craquer pour vous. <i>*Clin d'œil*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968576
    m_Localized: Alors, qu'en dites-vous ? <i>*Tourne sur elle-même*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968577
    m_Localized: Cet uniforme me va bien, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968578
    m_Localized: Son ancien propriétaire n'en aura plus besoin. <i>*Pouffe*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968579
    m_Localized: Vous vous souvenez de mon « client » ? Il a enfin parlé.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968580
    m_Localized: Il m'a dit où trouver quelqu'un avec qui j'ai un compte à régler.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968581
    m_Localized: Et puis, vous avez empoché ma prime quand vous avez appelé la sécu,
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968582
    m_Localized: alors je dirais que vous m'en devez une ou deux.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968583
    m_Localized: Pour régler ce compte, il me faut de nouveaux jouets, et c'est vous qui allez me les trouver.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968584
    m_Localized: Pour {0:plural:{} crédit|{} crédits} d'armes, de munitions et de médicaments, et on est quittes.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968585
    m_Localized: Je reviens dans une semaine. Ne faites pas attendre une demoiselle, petit nutrifruit. <i>*Clin d'œil*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968586
    m_Localized: Toc toc, petit nutrifruit ! Je vous ai manqué ?
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968587
    m_Localized: Je viens chercher mes nouveaux jouets. Des armes, des munitions et des médicaments, pour {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968588
    m_Localized: Et n'essayez pas de me refiler du toc. J'ai emprunté tous les scanners de la sécu. <i>*Clin d'œil*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968589
    m_Localized: Posez-les sur le comptoir quand vous voulez.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968590
    m_Localized: '[C''est tout ce que j''ai]'
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968591
    m_Localized: Oh, ça, ça me plaît.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968592
    m_Localized: C'est tout ce que j'avais demandé. Gentil petit nutrifruit !
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968593
    m_Localized: C'est tout ? Il manque encore {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968594
    m_Localized: Je prendrai le reste en liquide, alors. <i>*Clin d'œil*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968595
    m_Localized: Vous n'avez même pas ça ? Alors je prends tout ce qu'il y a dans votre caisse.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968596
    m_Localized: Bon, c'était amusant de jouer avec vous. On se reverra peut-être un jour.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968597
    m_Localized: Ça ne fait même pas la moitié de ce que vous me devez, petit nutrifruit.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968598
    m_Localized: Et moi qui croyais qu'on s'amusait tant.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968599
    m_Localized: Bon, je vais régler ce compte à l'ancienne.
    m_Metadata:
      m_Items: []
  - m_Id: 90055627602968600
    m_Localized: Voici un dernier cadeau. Celui-là, il est bien réel. Bye bye ! <i>*Clin d'œil*</i>
    m_Metadata:
      m_Items: []
  - m_Id: 90295236836507648
    m_Localized: Bonjour. Vous connaissez Eleanor, n'est-ce pas ? Je suis son... oncle.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256384
    m_Localized: Nous lui avons préparé un petit colis. Rien que le meilleur des strates supérieures.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256385
    m_Localized: Mais je n'arrive pas à la trouver.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256386
    m_Localized: Pourriez-vous le lui remettre la prochaine fois qu'elle passe ?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256387
    m_Localized: Veillez à ce qu'il finisse entre ses mains. Pas les vôtres. Les siennes.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256388
    m_Localized: Et si quelqu'un pose la question, vous ne m'avez jamais vu.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256389
    m_Localized: Oh, et ne mêlez pas la Sécurité à ça. C'est une affaire de famille.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256390
    m_Localized: Bonjour. Vous avez signalé un objet volé ?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256391
    m_Localized: Je ne l'ai pas volé ! Voilà le reçu.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256392
    m_Localized: Alors pourquoi l'avez-vous déclaré volé ?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256393
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256394
    m_Localized: Une fausse déclaration de vol est un délit. On vous embarque !
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256395
    m_Localized: Ne bougez plus ! Cette caisse a été déclarée volée.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256396
    m_Localized: Quoi ? Elle n'est pas à moi ! Je ne l'ai jamais vue !
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256397
    m_Localized: Telle mère, telle fille. On vous embarque.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256398
    m_Localized: Je vous en prie, on m'a piégée ! Dites-leur, vous !
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256399
    m_Localized: Coucou. J'ai réfléchi à la suite.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256400
    m_Localized: Je suis sûre que quelqu'un des strates supérieures a piégé ma mère.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256401
    m_Localized: Je ne peux pas monter là-haut poser des questions, mais un détective privé, si.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256402
    m_Localized: Un bon coûte {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256403
    m_Localized: Alors je vais continuer à fouiller la Décharge et vous vendre ce que je trouve.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256404
    m_Localized: Faites-moi un prix honnête, d'accord ? Chaque crédit me rapproche du but.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256405
    m_Localized: Merci ! Plus que {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256406
    m_Localized: Coucou, c'est encore moi.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256407
    m_Localized: Encore {0:plural:{} crédit|{} crédits} et je pourrai engager le détective.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256408
    m_Localized: Voilà ce que j'ai trouvé à la Décharge cette fois-ci.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256409
    m_Localized: Bon, je crois que j'ai assez de crédits maintenant.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256410
    m_Localized: Merci. Je vais découvrir qui a fait ça à ma mère.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256411
    m_Localized: '<i>*Lui parler de l''homme qui se disait son oncle*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256412
    m_Localized: Mon oncle ? Je n'ai pas d'oncle.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256413
    m_Localized: Il a laissé une caisse pour moi ? Une caisse déclarée volée ?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256414
    m_Localized: Ils voulaient me faire arrêter. Exactement comme ma mère.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256415
    m_Localized: Je... j'ai besoin de temps pour réfléchir à tout ça.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256416
    m_Localized: Mais vous m'avez prévenue. Je vous en prie, prenez quelque chose. C'est tout ce qu'il me reste de chez moi.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256417
    m_Localized: Je reviendrai quand j'aurai les idées plus claires.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256418
    m_Localized: Coucou. Le détective a trouvé quelque chose.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256419
    m_Localized: Une clé de données, cachée dans l'ancien labo de ma mère, à la ferme hydroponique.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256420
    m_Localized: Elle est verrouillée, mais je connais le mot de passe. Maman utilisait toujours mon anniversaire.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256421
    m_Localized: Je ne peux plus attendre. Je l'ouvre ici.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256422
    m_Localized: '<i>*lit l''écran*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256423
    m_Localized: C'est... de la recherche génétique. Sur le nutrifruit.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256424
    m_Localized: Elle a trouvé comment faire à nouveau produire des graines au nutrifruit standard.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256425
    m_Localized: Avec ces données, n'importe quel biohacker un peu doué pourrait le modifier.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256426
    m_Localized: Plus besoin d'acheter des graines à pastel. Ça pourrait vraiment nuire à pastel.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256427
    m_Localized: Voilà pourquoi ils s'en sont pris à elle.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256428
    m_Localized: Les accusations de détournement de fonds étaient inventées. Toutes.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256429
    m_Localized: C'est le représentant de pastel sur la station qui a tout manigancé.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256430
    m_Localized: Je... j'ai besoin de temps pour réfléchir à ce que je vais faire.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256431
    m_Localized: Tu te souviens de moi ?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256432
    m_Localized: On sait que tu es en contact avec Eleanor. Et on est au courant pour la clé de données.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256433
    m_Localized: Dis-lui de nous la rendre, ou sa mère meurt.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256434
    m_Localized: Si elle la rend, on libère sa mère. Elle sera exilée dans les strates inférieures, mais elle vivra.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256435
    m_Localized: Et si tu la convaincs de la rendre, il y a {0:plural:{} crédit|{} crédits} pour toi.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256436
    m_Localized: Ne traîne pas trop.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256437
    m_Localized: '<i>*Lui parler de l''offre de libérer sa mère*</i>'
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256438
    m_Localized: Ils la libéreraient si je rends la clé ?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256439
    m_Localized: Exilée ici, en bas... mais vivante.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256440
    m_Localized: Et si je le rends public, ils la tuent. Mais plus personne n'aurait jamais besoin des graines de pastel.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256441
    m_Localized: Je ne sais pas quoi faire. Qu'est-ce que vous feriez, vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256442
    m_Localized: '[Rendre la clé et sauver sa mère]'
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256443
    m_Localized: '[Le transmettre au journal des strates inférieures]'
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256444
    m_Localized: Vous avez raison. Elle est tout ce qu'il me reste.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256445
    m_Localized: Je vais la leur rendre. Merci.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256446
    m_Localized: Vous avez raison. Ça nous dépasse.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256447
    m_Localized: Maman aurait voulu que tout le monde en profite.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256448
    m_Localized: Je l'apporte au journal des strates inférieures aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256449
    m_Localized: Coucou ! Ma mère est libre.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256450
    m_Localized: Elle a été exilée dans les strates inférieures, mais nous sommes de nouveau ensemble.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256451
    m_Localized: Maintenant, on fouille la Décharge ensemble. Ce n'est pas la vie qu'on avait, mais c'est la nôtre.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256452
    m_Localized: Merci pour tout ce que vous avez fait pour moi.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256453
    m_Localized: J'avais acheté ça pour l'anniversaire de ma mère, juste avant que tout ça arrive.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256454
    m_Localized: Elle n'aura plus besoin de ce genre de chose.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256455
    m_Localized: Je veux que vous l'ayez.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256456
    m_Localized: Sans vous, je ne crois pas que j'en serais arrivée là.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256457
    m_Localized: J'espère qu'on se reverra un jour.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256458
    m_Localized: Prenez soin de vous.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256459
    m_Localized: Merci encore. Pour tout.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256460
    m_Localized: Salut. C'est moi.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256461
    m_Localized: Ils ont tué ma mère le matin où le journal est sorti.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256462
    m_Localized: J'ai rejoint la Révolution. Ils vont m'aider à faire payer pastel et me mettre hors de portée de la corporation.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256463
    m_Localized: J'avais acheté ça pour l'anniversaire de ma mère. Je suppose que ça n'a plus d'importance. Je veux que vous l'ayez.
    m_Metadata:
      m_Items: []
  - m_Id: 90295236874256464
    m_Localized: Maintenant, il me faut une arme. Qu'est-ce que vous avez ?
    m_Metadata:
      m_Items: []
  - m_Id: 90598789824167936
    m_Localized: Bonjour ! J'ai appris la nouvelle.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333760
    m_Localized: Cet endroit vous appartient, maintenant. Félicitations, ce n'est pas rien, ici en bas !
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333761
    m_Localized: Maintenant que vous avez fait vos preuves en affaires, j'ai quelque chose de nouveau pour vous.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333762
    m_Localized: Vous avez déjà entendu parler d'Hypertech ?
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333763
    m_Localized: Des choses incroyablement utiles, bien au-delà de tout ce que l'industrie de cette station peut produire.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333764
    m_Localized: Même les strates supérieures ont du mal à mettre la main dessus.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333765
    m_Localized: Je connais un contrebandier qui en fait le commerce. Je peux vous mettre en contact, moyennant une somme considérable, bien sûr.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333766
    m_Localized: 'Mais je vous préviens : chaque étape pour obtenir ces objets vous coûtera très cher.'
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333767
    m_Localized: Passez-moi un coup de fil le moment venu.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333768
    m_Localized: C'est Joe Wild qui m'envoie. Faisons vite.
    m_Metadata:
      m_Items: []
  - m_Id: 90598789849333769
    m_Localized: Voilà ce que j'ai pu dégoter cette fois. Le prix, c'est le prix.
    m_Metadata:
      m_Items: []
  - m_Id: 91072420257775616
    m_Localized: D'accord, je reviendrai dans une semaine. Préparez-moi quelques produits chimiques d'ici là, s'il vous plaît.
    m_Metadata:
      m_Items: []
  - m_Id: 91072420274552832
    m_Localized: Il manque encore pour {0} crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 91072420274552833
    m_Localized: Bien. Entre ses mains, pas les vôtres. Je le saurai.
    m_Metadata:
      m_Items: []
  - m_Id: 91072420274552834
    m_Localized: Je n'ai plus de famille.
    m_Metadata:
      m_Items: []
  - m_Id: 91072420274552835
    m_Localized: C'est tout ce que j'ai aujourd'hui. Encore {0:plural:{} crédit|{} crédits} et je pourrai engager le détective.
    m_Metadata:
      m_Items: []
  - m_Id: 91851101476384768
    m_Localized: Il faut d'abord retirer ce filtre. Je veux juste acheter l'eau.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491328
    m_Localized: Et les gentils petits nutrifruits sont récompensés. Allez, choisissez.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491329
    m_Localized: Oh, bon choix.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491330
    m_Localized: '[Demander une faveur ({0}+ de réputation, Strates inférieures)]'
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491331
    m_Localized: Pour quelqu'un d'aussi apprécié dans les Strates inférieures ? N'en dites pas plus.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491332
    m_Localized: '[Lui donner {0:plural:{} crédit|{} crédits}]'
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491333
    m_Localized: Un mot au sujet de la fille qu'on a embarquée ici, Eleanor.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491334
    m_Localized: Elle jure qu'on l'a piégée. Elle dit que vous accepteriez peut-être de payer sa caution.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491335
    m_Localized: La caution est fixée à {0:plural:{} crédit|{} crédits}.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491336
    m_Localized: '[Payer sa caution ({0:plural:{} crédit|{} crédits})]'
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491337
    m_Localized: '[Répondre d''elle ({0}+ de réputation, Sécurité)]'
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491338
    m_Localized: Payé en totalité. Elle sera dehors d'ici demain.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491339
    m_Localized: Bon, vous nous avez rendu quelques services. On passe l'éponge pour cette fois.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491340
    m_Localized: Comme vous voudrez. Elle reste où elle est.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491341
    m_Localized: La Sécurité m'a relâchée. Ils ont dit que c'était grâce à vous.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491342
    m_Localized: Cette caisse n'était pas à moi, et je n'ai pas d'oncle.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491343
    m_Localized: Quelqu'un voulait me voir derrière les barreaux, exactement comme ma mère.
    m_Metadata:
      m_Items: []
  - m_Id: 92499267755491344
    m_Localized: Je ne l'oublierai pas. Merci.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341568
    m_Localized: Le jeune homme a très faim, n'est-ce pas ? Il se trouve que Georgio a une caisse de nutrifruits.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341569
    m_Localized: Pour {0:plural:{} crédit|{} crédits}, Georgio les dépose pour vous. Vous n'aurez pas à apporter la moindre bouchée !
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341570
    m_Localized: Hmm... mais Georgio a entendu dire que vous ne pouvez pas aller à la décharge ces temps-ci.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341571
    m_Localized: Pas d'inquiétude ! Il se trouve que Georgio a une caisse de nutrifruits.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341572
    m_Localized: Pour {0:plural:{} crédit|{} crédits}, Georgio les dépose pour vous. Sinon, Georgio craint que le jeune homme ne s'en sorte pas.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341573
    m_Localized: Excellent ! Ce soir, le jeune homme va manger comme un roi.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341574
    m_Localized: Vos amis sont les amis de Georgio !
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341575
    m_Localized: Pas de souci, mon ami. Georgio compte sur vous pour le nourrir vous-même.
    m_Metadata:
      m_Items: []
  - m_Id: 92502523311341576
    m_Localized: Georgio comprend. Espérons que le jeune homme trouve de quoi manger par lui-même.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676211060736
    m_Localized: Hé, qu'est-ce qui vous prend ? Rangez ça !
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420864
    m_Localized: '<i>*retourne le corps*</i> Attendez. Le cadet Serpico.'
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420865
    m_Localized: '<i>*ricane*</i> Le gamin qui savait pas tenir sa langue. Les gars vont adorer.'
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420866
    m_Localized: Bon, strictement parlant, votre arme est réservée aux Augs.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420867
    m_Localized: Mais entre nous ? Vous venez d'épargner un sacré paquet de paperasse au service.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420868
    m_Localized: On va le consigner comme une capture. La prime est à vous.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420869
    m_Localized: Attendez. Vous me dénoncez ? Maintenant ?
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420870
    m_Localized: Tiens, tiens, regardez qui voilà. Le cadet devenu révolutionnaire.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420871
    m_Localized: C'est déjà dehors. Tous les noms. M'arrêter ne changera rien.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420872
    m_Localized: Qui a parlé de t'arrêter ?
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420873
    m_Localized: Emballez-le.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420874
    m_Localized: Non... On partait ce soir. Ma famille m'attend aux quais.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420875
    m_Localized: Alors ils vont attendre longtemps.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420876
    m_Localized: Bien joué, stationaute. Un détail gênant de moins.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420877
    m_Localized: Pas d'implants sur celui-là... attendez. Li Bei Wen ? Le chimiste ?
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420878
    m_Localized: Oh, vous avez bien fait, stationaute. Cet homme était dangereux. Très, TRÈS dangereux.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420879
    m_Localized: Héhé, le représentant de la corpo va sûrement me filer une prime pour avoir bouclé l'affaire.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420880
    m_Localized: La prime est à vous. On embarque le corps.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420881
    m_Localized: Attendez. Je connais ce visage. {0}, de l'avis de recherche.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420882
    m_Localized: Cette arme est réservée aux Augs. Pointez-la encore une fois sur un citoyen et on aura une conversation très différente.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420883
    m_Localized: Mais personne ne va perdre le sommeil pour un criminel dangereux. On va le consigner comme une capture. La prime est à vous.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420884
    m_Localized: ARGH ! Vous allez me le payer
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420885
    m_Localized: Hé, vous me faites peur...
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420886
    m_Localized: Gardez votre calme. S'il vous plaît. Gardez... votre calme.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420887
    m_Localized: Je suis là pour une inspection de routine. De routine. Vraiment de routine.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420888
    m_Localized: Celle-ci est... spéciale. Ordre d'en haut.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420889
    m_Localized: Bon, euh. Donnez-moi accès à vos marchandises et écartez-vous. Vite, avant mon service... je veux dire, avant la fin de mon service.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420890
    m_Localized: Cela inclut le fusil à pompe. Remettez-le-moi.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420891
    m_Localized: Votre permis d'armes couvre le fusil à pompe. Gardez-le, pour vous défendre.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420892
    m_Localized: Oh. Attention avec ça, petit nutrifruit. Avec moi, vous n'avez droit qu'à un seul tir.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420893
    m_Localized: AAH !
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420894
    m_Localized: ... Où avez-vous trouvé ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420895
    m_Localized: Je connais ce petit joujou. Fourni par la République.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420896
    m_Localized: Vous auriez pu le cacher dans mes affaires. Vous me l'avez montré à la place.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420897
    m_Localized: Ils vont venir me chercher, maintenant. Très bien. Qu'ils viennent.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420898
    m_Localized: Je suis désolée pour avant. Maintenant, j'ai besoin de votre aide.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420899
    m_Localized: Il me faut des armes, des munitions, des médicaments. Tout ce que vous pouvez me donner. S'il vous plaît.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420900
    m_Localized: Posez-le sur le comptoir. Tout ce que vous pouvez me donner.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420901
    m_Localized: '[C''est tout ce que j''ai]'
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420902
    m_Localized: Bien. Encore, si vous en avez.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420903
    m_Localized: Ça ira. Ça ira très bien.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420904
    m_Localized: Merci, petit nutrifruit. Vous aurez de mes nouvelles.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420905
    m_Localized: Ça ne suffira peut-être pas. Sans vouloir paraître ingrate.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420906
    m_Localized: Il faudra faire avec. Souhaitez-moi bonne chance, petit nutrifruit.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420907
    m_Localized: Mon équipe et moi traquons une femme du nom de Lou depuis un certain temps.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420908
    m_Localized: Nous pensons que vous venez de la rencontrer. C'est une traîtresse à la République et une terroriste.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420909
    m_Localized: Ces simples agents de sécurité ne la retiendront pas.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420910
    m_Localized: Elle reviendra ici, et elle voudra jouer.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420911
    m_Localized: C'est une psychopathe, mais une psychopathe prévisible. Soyez patient. Jouez le jeu.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420912
    m_Localized: Prenez cet émetteur. Cachez-le dans quelque chose qu'elle emportera. Une boîte, une caisse, n'importe quoi qui partira avec elle.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420913
    m_Localized: Quand il atteindra sa planque, nous interviendrons. Il y a là-bas des renseignements que la République doit récupérer.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420914
    m_Localized: Aidez-nous à la capturer et {0} crédits sont à vous. Pas un mot à qui que ce soit.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420915
    m_Localized: La femme sur qui vous avez tiré hier. Vous êtes la première personne depuis des années à lui avoir fait un trou. Félicitations.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420916
    m_Localized: C'est une traîtresse à la République et une terroriste. Et elle ne pardonne pas. Elle va vous hanter.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420917
    m_Localized: Votre meilleure chance, c'est de coopérer avec nous.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420918
    m_Localized: Prenez cet émetteur. Elle viendra se venger. Quoi qu'elle vous oblige à lui remettre, cachez-le dedans.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420919
    m_Localized: '{0} crédits tout de suite, pour le dérangement. {1} de plus quand nous la tiendrons. Pas un mot à qui que ce soit.'
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420920
    m_Localized: C'est fait. Nous la tenons.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420921
    m_Localized: La République vous est reconnaissante. Voici vos {0} crédits.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420922
    m_Localized: Elle va pourrir dans une prison secrète jusqu'à la fin de ses jours.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420923
    m_Localized: C'est fait. Nous la tenons. Ça nous a coûté deux bons éléments.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420924
    m_Localized: Allez savoir comment, elle savait que nous venions. Curieux, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420925
    m_Localized: Vos {0} crédits, comme convenu. La République tient parole.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420926
    m_Localized: Le service de sécurité gardera un œil attentif sur cette boutique à partir de maintenant. Au cas où.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420927
    m_Localized: Vous avez lu les nouvelles, je suppose. Un amiral de la République, mort sur cette station.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420928
    m_Localized: C'est elle, et nous aurions pu l'arrêter.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420929
    m_Localized: Je croyais que nous nous étions compris à son sujet.
    m_Metadata:
      m_Items: []
  - m_Id: 93341676240420930
    m_Localized: Vous avez de la chance que nous devions repartir bientôt à sa poursuite, sinon nous aurions creusé votre implication.
    m_Metadata:
      m_Items: []
  - m_Id: 94001378955673600
